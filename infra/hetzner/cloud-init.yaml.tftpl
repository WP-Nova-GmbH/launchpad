#cloud-config
# First-boot provisioning for the single relay host. Everything ends up on
# this one machine: Postgres, the relay Node server, Caddy terminating TLS
# for ${relay_domain}, and Docker for the org machines the relay provisions.
#
# The heavy lifting lives in /opt/provision/provision.sh so a transient
# failure (apt mirror, network) can be fixed by re-running that script by
# hand; it is idempotent. Progress lands in /var/log/launchpad-provision.log.
package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - git
  - postgresql
  # node-gyp toolchain: the workspace's native modules (node-pty) build from
  # source during pnpm install.
  - build-essential
  - python3

write_files:
  - path: /etc/systemd/system/launchpad-relay.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Launchpad Connect relay
      After=network-online.target postgresql.service docker.service
      Wants=network-online.target

      [Service]
      Type=simple
      WorkingDirectory=/opt/launchpad
      # Machine-owned values written at provision time: database URL, issuer.
      EnvironmentFile=/etc/launchpad-relay/provisioned.env
      # Operator-owned secrets (Clerk, GitHub App, Hetzner token, ...). The
      # '-' lets the unit start before the operator has copied them over; the
      # relay exits on the missing Clerk key and retries until the file lands.
      EnvironmentFile=-/etc/launchpad-relay/relay.env
      ExecStart=/usr/bin/node infra/relay/scripts/dev-server.ts
      Restart=always
      RestartSec=10

      [Install]
      WantedBy=multi-user.target

  - path: /opt/provision/Caddyfile
    permissions: "0644"
    content: |
      ${relay_domain} {
        reverse_proxy 127.0.0.1:8610
      }

  - path: /usr/local/bin/launchpad-relay-migrate
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      # Applies the relay's Drizzle migrations to the local Postgres.
      set -euo pipefail
      source /etc/launchpad-relay/provisioned.env
      cd /opt/launchpad/infra/relay
      RELAY_DATABASE_URL="$DEV_RELAY_DATABASE_URL" pnpm exec drizzle-kit migrate

  - path: /usr/local/bin/launchpad-relay-update
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      # Deploys the latest relay: pull, install, migrate, rebuild the executor
      # image, restart.
      set -euo pipefail
      cd /opt/launchpad
      git pull --ff-only
      corepack install
      pnpm install --frozen-lockfile
      /usr/local/bin/launchpad-relay-migrate
      docker build -t t3code-executor-dev -f infra/executor-image/Dockerfile .
      systemctl restart launchpad-relay

  - path: /opt/provision/provision.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive

      # Node 24, the relay's runtime (mirrors infra/relay/scripts/machine-bootstrap.sh).
      if ! command -v node >/dev/null; then
        curl -fsSL https://deb.nodesource.com/setup_24.x | bash -
        apt-get install -y nodejs
      fi
      corepack enable

      # Docker, which the relay uses to run org machines as containers here.
      if ! command -v docker >/dev/null; then
        install -m 0755 -d /etc/apt/keyrings
        curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
        chmod a+r /etc/apt/keyrings/docker.asc
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" \
          > /etc/apt/sources.list.d/docker.list
        apt-get update
        apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin
      fi

      # Caddy, terminating TLS for the relay domain.
      if ! command -v caddy >/dev/null; then
        curl -1sLf https://dl.cloudsmith.io/public/caddy/stable/gpg.key \
          | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
        curl -1sLf https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt \
          > /etc/apt/sources.list.d/caddy-stable.list
        apt-get update
        apt-get install -y caddy
      fi
      cp /opt/provision/Caddyfile /etc/caddy/Caddyfile
      systemctl reload caddy

      # Relay database, with a machine-generated password that never leaves
      # this box: it goes into Postgres and provisioned.env, nowhere else.
      if [[ ! -f /etc/launchpad-relay/provisioned.env ]]; then
        password="$(openssl rand -hex 24)"
        sudo -u postgres psql -v ON_ERROR_STOP=1 -c "CREATE ROLE launchpad_relay LOGIN PASSWORD '$${password}'"
        sudo -u postgres psql -v ON_ERROR_STOP=1 -c "CREATE DATABASE launchpad_relay OWNER launchpad_relay"
        install -m 0750 -d /etc/launchpad-relay
        umask 077
        cat > /etc/launchpad-relay/provisioned.env <<EOF
      DEV_RELAY_DATABASE_URL=postgres://launchpad_relay:$${password}@127.0.0.1:5432/launchpad_relay
      DEV_RELAY_ISSUER=https://${relay_domain}
      EOF
      fi

      # Relay source, dependencies, schema, and the executor image org
      # machines boot from.
      if [[ ! -d /opt/launchpad/.git ]]; then
        git clone ${source_git_url} /opt/launchpad
      fi
      cd /opt/launchpad
      corepack install
      pnpm install --frozen-lockfile
      /usr/local/bin/launchpad-relay-migrate
      docker build -t t3code-executor-dev -f infra/executor-image/Dockerfile .

      systemctl daemon-reload
      systemctl enable --now launchpad-relay
      echo "provision: done; the relay restarts until /etc/launchpad-relay/relay.env exists"

runcmd:
  - [bash, -c, "bash /opt/provision/provision.sh >> /var/log/launchpad-provision.log 2>&1"]
