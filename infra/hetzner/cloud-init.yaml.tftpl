#cloud-config
# First-boot provisioning for the single relay host. The host carries
# Postgres, Caddy terminating TLS for ${relay_domain}, and Docker; the relay
# itself runs as a container built on this box by infra/hetzner/deploy.sh,
# which rsyncs the developer's working tree here — no Git remote involved.
#
# The heavy lifting lives in /opt/provision/provision.sh so a transient
# failure (apt mirror, network) can be fixed by re-running that script by
# hand; it is idempotent. Progress lands in /var/log/launchpad-provision.log.
package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - rsync
  - postgresql

write_files:
  - path: /etc/systemd/system/launchpad-relay.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Launchpad Connect relay
      After=network-online.target postgresql.service docker.service
      Wants=network-online.target
      Requires=docker.service

      [Service]
      Type=simple
      ExecStartPre=-/usr/bin/docker rm -f launchpad-relay
      # host network: the relay binds loopback for Caddy and must reach the
      # loopback endpoints its Docker machines advertise. The socket mount is
      # how it provisions those machines as sibling containers.
      ExecStart=/usr/bin/docker run --name launchpad-relay \
        --network=host \
        --env-file /etc/launchpad-relay/provisioned.env \
        --env-file /etc/launchpad-relay/relay.env \
        -v /var/run/docker.sock:/var/run/docker.sock \
        launchpad-relay
      ExecStop=/usr/bin/docker stop launchpad-relay
      Restart=always
      RestartSec=10

      [Install]
      WantedBy=multi-user.target

  - path: /opt/provision/Caddyfile
    permissions: "0644"
    content: |
      ${relay_domain} {
        reverse_proxy 127.0.0.1:8610
      }

  - path: /usr/local/bin/launchpad-relay-migrate
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      # Applies the relay's Drizzle migrations to the local Postgres, using
      # the drizzle-kit inside the current relay image.
      set -euo pipefail
      docker run --rm --network=host \
        --env-file /etc/launchpad-relay/provisioned.env \
        --workdir /opt/launchpad/infra/relay \
        launchpad-relay \
        bash -c 'RELAY_DATABASE_URL="$DEV_RELAY_DATABASE_URL" pnpm exec drizzle-kit migrate'

  - path: /opt/provision/provision.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive

      # Docker: runs the relay container and the org-machine containers.
      if ! command -v docker >/dev/null; then
        install -m 0755 -d /etc/apt/keyrings
        curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
        chmod a+r /etc/apt/keyrings/docker.asc
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" \
          > /etc/apt/sources.list.d/docker.list
        apt-get update
        apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin
      fi

      # Caddy, terminating TLS for the relay domain.
      if ! command -v caddy >/dev/null; then
        curl -1sLf https://dl.cloudsmith.io/public/caddy/stable/gpg.key \
          | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
        curl -1sLf https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt \
          > /etc/apt/sources.list.d/caddy-stable.list
        apt-get update
        apt-get install -y caddy
      fi
      cp /opt/provision/Caddyfile /etc/caddy/Caddyfile
      systemctl reload caddy

      # Relay database, with a machine-generated password that never leaves
      # this box: it goes into Postgres and provisioned.env, nowhere else.
      if [[ ! -f /etc/launchpad-relay/provisioned.env ]]; then
        password="$(openssl rand -hex 24)"
        sudo -u postgres psql -v ON_ERROR_STOP=1 -c "CREATE ROLE launchpad_relay LOGIN PASSWORD '$${password}'"
        sudo -u postgres psql -v ON_ERROR_STOP=1 -c "CREATE DATABASE launchpad_relay OWNER launchpad_relay"
        install -m 0750 -d /etc/launchpad-relay
        umask 077
        cat > /etc/launchpad-relay/provisioned.env <<EOF
      DEV_RELAY_DATABASE_URL=postgres://launchpad_relay:$${password}@127.0.0.1:5432/launchpad_relay
      DEV_RELAY_ISSUER=https://${relay_domain}
      EOF
      fi
      # Present-but-empty until the operator fills it, so the relay unit's
      # --env-file never refuses to start.
      touch /etc/launchpad-relay/relay.env
      chmod 600 /etc/launchpad-relay/relay.env

      # The rsync target deploy.sh ships the working tree into.
      install -d /opt/launchpad

      systemctl daemon-reload
      systemctl enable launchpad-relay
      echo "provision: done; run infra/hetzner/deploy.sh from the repository to deploy the relay"

runcmd:
  - [bash, -c, "bash /opt/provision/provision.sh >> /var/log/launchpad-provision.log 2>&1"]
