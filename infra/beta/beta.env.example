# Use one unquoted KEY=value per line. Keep the filled file private.
BETA_HOSTNAME=relay-beta.example.com
BETA_TUNNEL_TOKEN=
CLOUDFLARE_API_TOKEN=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional when the host also has an address behind NAT that Linux cannot discover.
# E2B_HOST_ADDRESSES=10.0.1.232,203.0.113.10

# Add when connecting workflow integrations. Use literal \n for the GitHub PEM.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=
# LINEAR_WORKFLOW_CLIENT_ID=
# LINEAR_WORKFLOW_CLIENT_SECRET=
# LINEAR_WORKFLOW_ORGANIZATION_ID=
# LINEAR_WORKFLOW_WEBHOOK_SECRET=
# LINEAR_WORKFLOW_WEBHOOK_GENERATION=
# LINEAR_WORKFLOW_ADMISSION_ENABLED=false
