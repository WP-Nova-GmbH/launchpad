# Required: Relay API and managed tunnel domains
# Production adopts retained DNS zones in your Cloudflare account. The API
# zone serves relay.<zone> in production and relay-<stage>.<zone> for personal
# stages. Managed environment endpoints are provisioned below the tunnel zone.
RELAY_API_ZONE_NAME=example.com
RELAY_TUNNEL_ZONE_NAME=tunnels.example.com

# Optional: inactive tunnel cleanup. Start with dry-run, verify the cleanup
# logs, then set enabled. Unset and off both disable cleanup.
# RELAY_TUNNEL_CLEANUP_MODE=off

# Optional: Relay domain override
# Set this only when the derived relay hostname should not be used.
# RELAY_DOMAIN=relay.example.com

# Required when the local dev relay (scripts/dev-server.ts, `vp run dev:full`)
# is reached through a cloudflared tunnel: the public origin clients use.
# Without it the dev relay defaults to http://127.0.0.1:8610 as its issuer and
# rejects every DPoP token exchange from tunnel clients as invalid_dpop,
# because the client's `resource` (the tunnel URL) never matches the issuer.
# DEV_RELAY_ISSUER=https://relay-dev.example.com

# `vp run dev:vm` creates/reuses a dedicated relay tunnel and its proxied CNAME,
# then starts the relay, connector and desktop app together. It validates
# existing DNS and refuses to overwrite a conflicting record.
# Configure the Cloudflare credentials below and the E2B host/runner once.
# It derives the hostname as relay-<namespace>.<RELAY_API_ZONE_NAME>, with
# RELAY_TUNNEL_ZONE_NAME as the fallback API zone. A hostname override is optional.
# MANAGED_ENDPOINT_NAMESPACE=dev-stefan
# DEV_RELAY_HOSTNAME=relay-dev.example.com
# The command supplies DEV_RELAY_ISSUER, E2B_PUBLIC_RELAY_URL and the desktop
# relay URL automatically. Local-only tunnel-disable flags are ignored by this command.

# Required: Clerk
# Get the keys from the Clerk Dashboard under API keys. Set the JWT audience to
# the `aud` claim configured on the `t3-relay` JWT template.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_AUDIENCE=t3-code-relay

# Optional: per-thread E2B VMs. Configure every E2B value before enabling.
# The loopback API/proxy URLs below use Lima's forwarded ports on macOS.
# RELAY_THREAD_VM_PROVISIONING_ENABLED=true
# E2B_API_URL=http://127.0.0.1:3000
# E2B_SANDBOX_URL=http://127.0.0.1:3002
# E2B_API_KEY=<host-team-key>
# E2B_HOST_ID=local-lima
# E2B_MAX_RUNNING_VMS=1
# `vp run dev:vm` builds the runner from this checkout when no image is selected,
# then reuses it. Run `vp run build:vm-template` explicitly to rebuild after code
# changes. Both require the Linux host and E2B services to already be running.
# The Node dev relay reads infra/relay/.t3/e2b-template.json automatically;
# no archive paths, checksums or template IDs need to be copied here.
# Optional: read a selection file copied from a separate build machine.
# E2B_TEMPLATE_FILE=/absolute/path/to/e2b-template.json
# Compute host IP addresses to block from VM outbound traffic, comma separated.
# `vp run dev:vm` detects these from the existing launchpad-e2b Lima host on
# macOS when both E2B URLs use loopback. Leave unset or blank for detection;
# explicit addresses are preserved. Native Linux and remote hosts require this.
# E2B_HOST_ADDRESSES=<host-ipv4>,<host-ipv6>
# Must match DEV_RELAY_ISSUER above and be reachable over trusted HTTPS from
# the VMs. Loopback URLs do not work here. These settings do not create a route.
# E2B_PUBLIC_RELAY_URL=https://relay-dev.example.com
# Full host and runner setup: docs/operations/e2b-host-setup.md.

# Optional: local-only VM client connections (Node dev relay, no public tunnel).
# Requires the E2B configuration above and RELAY_TUNNEL_CLEANUP_MODE=off.
# Unset CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID and RELAY_TUNNEL_ZONE_NAME,
# including the tunnel zone near the top of this file, before enabling this mode.
# The VM-to-relay HTTPS route above is still required.
# DEV_RELAY_PORT=8610
# DEV_RELAY_LOCAL_VM_CONNECTIONS=1
# T3CODE_DISABLE_MANAGED_TUNNELS=1

# Optional: private VM previews. The preview domain must not share cookies with
# the relay, any Launchpad web app, or Clerk. Both protected-origin lists are
# required when previews are enabled; include every browser app and auth origin.
# RELAY_THREAD_VM_PREVIEW_BASE_URL=https://vm-preview.example.net
# RELAY_THREAD_VM_APP_ORIGINS=https://app.example.com
# RELAY_THREAD_VM_AUTH_ORIGINS=https://clerk.example.com

# Optional: Cloudflare managed endpoints
# With all three set, the self-hosted relay provisions a Cloudflare tunnel and
# DNS record per environment or machine, so clients elsewhere can reach it.
# Without them it refuses to provision, and machine endpoints stay unroutable.
# The token needs Account > Cloudflare Tunnel > Edit, Zone > Zone > Read,
# and Zone > DNS > Edit. Cloudflare may label tunnel editing as
# Cloudflare One Connector: cloudflared > Edit.
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...
# RELAY_TUNNEL_ZONE_NAME=tunnels.example.com
# Namespace prefixed to provisioned hostnames; defaults to `prod`.
# MANAGED_ENDPOINT_NAMESPACE=prod

# Optional: update source for manually connected organization computers.
# MACHINE_SOURCE_GIT_URL=https://github.com/WP-Nova-GmbH/launchpad.git

# Apple Push Notification service (required unless APNS_ENABLED=false)
# Set APNS_ENABLED=false for an Android-only development relay.
# Get these values from your Apple Developer account. Use `sandbox` for
# development APNs credentials and `production` for production credentials.
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=...
APNS_KEY_ID=...
APNS_BUNDLE_ID=...
APNS_PRIVATE_KEY=...

# Optional: Android push. Set this secret to the service account JSON from
# Firebase Project settings > Service accounts. Never put it in an app build.
# FCM_SERVICE_ACCOUNT={...}
