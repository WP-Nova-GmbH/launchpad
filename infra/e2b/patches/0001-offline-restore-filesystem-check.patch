+//go:build linux
+
+package rootfs
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestPrepareRestoreFilesystem(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range []struct {
+		name        string
+		outcome     RecoverOutcome
+		recoveryErr error
+		checkOutput []byte
+		checkErr    error
+		wantCheck   bool
+		wantSuccess bool
+	}{
+		{name: "verified", outcome: RecoverOutcomeReplayed, checkOutput: rcStream(0), wantCheck: true, wantSuccess: true},
+		{name: "recovery could not launch", outcome: RecoverOutcomeFailedOpen},
+		{name: "recovery failed", outcome: RecoverOutcomeFailed, recoveryErr: errors.New("device unavailable")},
+		{name: "unrepaired filesystem", outcome: RecoverOutcomeReplayed, checkOutput: rcStream(4), wantCheck: true},
+		{name: "check could not launch", outcome: RecoverOutcomeReplayed, checkErr: errors.New("systemd unavailable"), wantCheck: true},
+		{name: "missing result", outcome: RecoverOutcomeReplayed, wantCheck: true},
+		{name: "check unexpectedly wrote", outcome: RecoverOutcomeReplayed, checkOutput: rcStream(1), wantCheck: true},
+		{name: "success text with failed process", outcome: RecoverOutcomeReplayed, checkOutput: rcStream(0), checkErr: errors.New("interrupted"), wantCheck: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			checked := false
+			err := prepareRestoreFilesystem(t.Context(), "/dev/nbd0",
+				func(context.Context, string) (RecoverOutcome, RecoverReason, error) {
+					return tc.outcome, "", tc.recoveryErr
+				},
+				func(context.Context, string) ([]byte, error) {
+					checked = true
+					return tc.checkOutput, tc.checkErr
+				})
+			require.Equal(t, tc.wantCheck, checked)
+			if tc.wantSuccess {
+				require.NoError(t, err)
+			} else {
+				require.ErrorIs(t, err, ErrRestoreFilesystemUnverified)
+			}
+		})
+	}
+}
+
+func TestPrepareRestoreFilesystemCancelled(t *testing.T) {
+	t.Parallel()
+	ctx, cancel := context.WithCancel(t.Context())
+	checked := false
+	err := prepareRestoreFilesystem(ctx, "/dev/nbd0",
+		func(context.Context, string) (RecoverOutcome, RecoverReason, error) {
+			cancel()
+			return RecoverOutcomeReplayed, RecoverReasonNothingToDo, nil
+		},
+		func(context.Context, string) ([]byte, error) {
+			checked = true
+			return rcStream(0), nil
+		})
+	require.ErrorIs(t, err, context.Canceled)
+	require.False(t, checked)
+}
+
+func TestPrepareRestoreFilesystemRefusesOtherDevices(t *testing.T) {
+	t.Parallel()
+	for _, path := range []string{"/dev/sda", "/tmp/disk.img", "/dev/nbd0/../sda"} {
+		require.ErrorIs(t, PrepareRestoreFilesystem(t.Context(), path), errDeviceRefused)
+	}
+}
