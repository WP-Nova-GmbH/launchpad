+//go:build linux
+
+package rootfs
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"time"
+)
+
+// FsVerifyTimeout bounds a full read-only scan, which is more expensive than
+// journal replay. Neither a timeout nor unavailable host tooling verifies a disk.
+const FsVerifyTimeout = 5 * time.Minute
+
+var ErrRestoreFilesystemUnverified = errors.New("prepared restore filesystem could not be verified")
+
+// PrepareRestoreFilesystem recovers and checks an unmounted, private COW copy of
+// a saved rootfs without executing any guest code or mounting it in the host
+// kernel. The caller owns the NBD device and must exclude concurrent writers.
+// Never pass the source VM's live disk: journal replay writes to this copy.
+// Success verifies filesystem structure, not application-level data integrity.
+func PrepareRestoreFilesystem(ctx context.Context, devicePath string) error {
+	if !nbdDevicePath.MatchString(devicePath) {
+		return fmt.Errorf("%w %q", errDeviceRefused, devicePath)
+	}
+
+	return prepareRestoreFilesystem(ctx, devicePath, RecoverFilesystem,
+		func(ctx context.Context, path string) ([]byte, error) {
+			return runJailedE2fsck(ctx, path, FsVerifyTimeout, "-f", "-n")
+		})
+}
+
+func prepareRestoreFilesystem(
+	ctx context.Context,
+	devicePath string,
+	recover func(context.Context, string) (RecoverOutcome, RecoverReason, error),
+	check func(context.Context, string) ([]byte, error),
+) error {
+	if err := ctx.Err(); err != nil {
+		return errors.Join(ErrRestoreFilesystemUnverified, err)
+	}
+
+	outcome, reason, err := recover(ctx, devicePath)
+	if err != nil || outcome != RecoverOutcomeReplayed {
+		return errors.Join(ErrRestoreFilesystemUnverified,
+			fmt.Errorf("journal recovery not verified: %s (%s)", outcome, reason), err)
+	}
+	if err := ctx.Err(); err != nil {
+		return errors.Join(ErrRestoreFilesystemUnverified, err)
+	}
+
+	checkCtx, cancel := context.WithTimeout(ctx, FsVerifyTimeout)
+	defer cancel()
+	result, runErr := check(checkCtx, devicePath)
+	if err := errors.Join(runErr, checkCtx.Err()); err != nil {
+		return errors.Join(ErrRestoreFilesystemUnverified, err)
+	}
+	code, present := e2fsckRC(result)
+	// The scan is read-only. Even "corrected errors" is not an acceptable result:
+	// it would mean the checker ran in a different mode than the one we requested.
+	if !present || code != 0 {
+		return fmt.Errorf("%w: full scan exit code %d (result present: %t)", ErrRestoreFilesystemUnverified, code, present)
+	}
+
+	return nil
+}
