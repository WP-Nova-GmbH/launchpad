+//go:build linux && integration
+
+package rootfs
+
+import (
+	"context"
+	"crypto/sha256"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox/block"
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox/nbd"
+	"github.com/e2b-dev/infra/packages/shared/pkg/featureflags"
+	"github.com/e2b-dev/infra/packages/shared/pkg/logger"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+// Run only on a dedicated Linux host with NBD, systemd and e2fsprogs. No guest
+// filesystem is mounted and no Firecracker process or guest networking is started.
+func TestPrepareRestoreFilesystemOffline(t *testing.T) {
+	if os.Getenv("E2B_OFFLINE_RESTORE_TEST") != "1" {
+		t.Skip("set E2B_OFFLINE_RESTORE_TEST=1 on the dedicated compute test host")
+	}
+
+	dir := t.TempDir()
+	original := filepath.Join(dir, "source.ext4")
+	file, err := os.Create(original)
+	require.NoError(t, err)
+	require.NoError(t, file.Truncate(64<<20))
+	require.NoError(t, file.Close())
+	output, err := exec.CommandContext(t.Context(), "mkfs.ext4", "-F", "-q", original).CombinedOutput()
+	require.NoError(t, err, "%s", output)
+	before, err := os.ReadFile(original)
+	require.NoError(t, err)
+	checksum := sha256.Sum256(before)
+
+	base, err := block.NewLocal(original, header.RootfsBlockSize, uuid.New())
+	require.NoError(t, err)
+	defer base.Close()
+	cache, err := block.NewCache(64<<20, header.RootfsBlockSize, filepath.Join(dir, "private.cow"), false)
+	require.NoError(t, err)
+	overlay := block.NewOverlay(base, cache)
+	defer overlay.Close()
+
+	flags, err := featureflags.NewClient()
+	require.NoError(t, err)
+	pool, err := nbd.NewDevicePool(1)
+	require.NoError(t, err)
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	go pool.Populate(ctx)
+	defer pool.Close(context.WithoutCancel(ctx))
+	mount := nbd.NewDirectPathMount(overlay, pool, flags, logger.NewNopLogger())
+	index, err := mount.Open(ctx)
+	require.NoError(t, err)
+	defer func() { require.NoError(t, mount.Close(context.WithoutCancel(ctx))) }()
+	devicePath := nbd.GetDevicePath(index)
+
+	require.NoError(t, PrepareRestoreFilesystem(ctx, devicePath))
+	// Corrupt only the private copy. A broken destination must fail without
+	// damaging the recovery source, which remains usable for another attempt.
+	// Break the root directory link count while keeping its inode checksum
+	// valid. Journal replay does not walk directory references; a full scan does.
+	output, err = exec.CommandContext(ctx, "debugfs", "-w", "-R",
+		"set_inode_field / links_count 42", devicePath).CombinedOutput()
+	require.NoError(t, err, "%s", output)
+	output, err = exec.CommandContext(ctx, "debugfs", "-R", "stat /", devicePath).CombinedOutput()
+	require.NoError(t, err)
+	require.Contains(t, string(output), "Links: 42", "fixture corruption was not applied")
+	outcome, _, err := RecoverFilesystem(ctx, devicePath)
+	require.NoError(t, err)
+	require.Equal(t, RecoverOutcomeReplayed, outcome)
+	require.ErrorIs(t, PrepareRestoreFilesystem(ctx, devicePath), ErrRestoreFilesystemUnverified)
+	after, err := os.ReadFile(original)
+	require.NoError(t, err)
+	require.Equal(t, checksum, sha256.Sum256(after), "verification or failed preparation changed the source")
+}
