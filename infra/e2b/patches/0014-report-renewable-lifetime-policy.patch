@@ -0,0 +1,52 @@
+package handlers
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+
+	"github.com/e2b-dev/infra/packages/api/internal/api"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+)
+
+func TestLaunchpadCapabilitiesFollowAuthenticatedTeamPolicy(t *testing.T) {
+	team, other := uuid.New(), uuid.New()
+	for _, tc := range []struct {
+		name           string
+		restoreTeams   []string
+		renewableTeams []string
+		node           string
+		capacity       int64
+		status         int
+		renewable      bool
+	}{
+		{"enabled", []string{team.String()}, []string{team.String()}, "node", 1024, http.StatusOK, true},
+		{"lifetime disabled", []string{team.String()}, nil, "node", 1024, http.StatusOK, false},
+		{"another team's lifetime", []string{team.String()}, []string{other.String()}, "node", 1024, http.StatusOK, false},
+		{"another team's restore", []string{other.String()}, []string{team.String()}, "node", 1024, http.StatusForbidden, false},
+		{"no restore node", []string{team.String()}, []string{team.String()}, "", 1024, http.StatusForbidden, false},
+		{"no restore capacity", []string{team.String()}, []string{team.String()}, "node", 0, http.StatusForbidden, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			// No compute or persistence services: reporting capabilities must not start or wake a VM.
+			server := &APIStore{}
+			server.config.LaunchpadRestoreTeams = tc.restoreTeams
+			server.config.LaunchpadRenewableLifetimeTeams = tc.renewableTeams
+			server.config.LaunchpadRestoreNodeID = tc.node
+			server.config.LaunchpadRestoreCapacityBytes = tc.capacity
+			c, response := restoreHTTPContext(t, team, nil)
+			c.Request.Method = http.MethodGet
+			server.GetLaunchpadCapabilities(c)
+			require.Equal(t, tc.status, response.Code)
+			if tc.status != http.StatusOK {
+				return
+			}
+			var capabilities api.LaunchpadRuntimeCapabilities
+			require.NoError(t, json.Unmarshal(response.Body.Bytes(), &capabilities))
+			require.Equal(t, tc.renewable, capabilities.RenewableLifetime)
+			require.True(t, capabilities.DiskRestore)
+			require.True(t, capabilities.QuiescedSnapshots)
+		})
+	}
+}
