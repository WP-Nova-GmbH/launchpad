+func TestCheckpointManagedRecoveryRejectsMemoryAndUnfencedCapture(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		name                   string
+		filesystemOnly, fenced bool
+		version                string
+	}{
+		{"memory", false, true, utils.MinEnvdVersionForFsFreeze},
+		{"unfenced", true, false, utils.MinEnvdVersionForFsFreeze},
+		{"old-envd", true, true, "0.5.5"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			server := admissionTestServer(t, nil)
+			server.config.LaunchpadRequireExecutionFence = tc.fenced
+			sbx := admissionTestSandbox(t, "managed-proof", 27, utils.NewSetOnce[*header.Header]())
+			sbx.Config.Envd.Version = tc.version
+			sbx.APIStoredConfig = &orchestrator.SandboxConfig{Metadata: map[string]string{"launchpad.managed": "thread-vm-v1"}}
+			server.sandboxFactory.Sandboxes.MarkRunning(t.Context(), sbx)
+			_, err := server.Checkpoint(t.Context(), &orchestrator.SandboxCheckpointRequest{SandboxId: "managed-proof", FilesystemOnly: tc.filesystemOnly})
+			require.Equal(t, codes.FailedPrecondition, status.Code(err))
+			_, live := server.sandboxFactory.Sandboxes.Get("managed-proof")
+			require.True(t, live, "rejection must preserve the source VM")
+		})
+	}
+}
