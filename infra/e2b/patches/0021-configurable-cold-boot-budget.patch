new file mode 100644
--- /dev/null
+++ b/packages/orchestrator/pkg/cfg/cold_boot_test.go
@@ -0,0 +1,41 @@
+//go:build linux
+
+package cfg
+
+import (
+	"github.com/stretchr/testify/require"
+	"testing"
+	"time"
+)
+
+func TestColdBootConfiguration(t *testing.T) {
+	for _, value := range []string{"60s", "180s", "5m"} {
+		t.Run(value, func(t *testing.T) {
+			t.Setenv("LAUNCHPAD_COLD_BOOT_TIMEOUT", value)
+			expected, err := time.ParseDuration(value)
+			require.NoError(t, err)
+			full, err := Parse()
+			require.NoError(t, err)
+			build, err := ParseBuilder()
+			require.NoError(t, err)
+			require.Equal(t, expected, full.ColdBootBudget())
+			require.Equal(t, expected, build.ColdBootBudget())
+		})
+	}
+	for _, value := range []string{"0s", "-1s", "59s", "301s", "invalid"} {
+		t.Run("reject "+value, func(t *testing.T) {
+			t.Setenv("LAUNCHPAD_COLD_BOOT_TIMEOUT", value)
+			_, err := Parse()
+			require.Error(t, err)
+			_, err = ParseBuilder()
+			require.Error(t, err)
+		})
+	}
+	t.Run("default", func(t *testing.T) {
+		t.Setenv("LAUNCHPAD_COLD_BOOT_TIMEOUT", "")
+		config, err := Parse()
+		require.NoError(t, err)
+		require.Equal(t, time.Minute, config.ColdBootBudget())
+		require.Equal(t, time.Minute, (BuilderConfig{}).ColdBootBudget())
+	})
+}
