+// Explicit cold restores and managed VMs also need time for offline recovery,
+// template loading and post-boot authentication. Earlier caller deadlines still win.
+func sandboxCreateBudget(config cfg.BuilderConfig, req *orchestrator.SandboxCreateRequest) time.Duration {
+	if req.GetFilesystemBoot() || req.GetSandbox().GetMetadata()["launchpad.managed"] == "thread-vm-v1" {
+		return config.ColdBootBudget() + requestTimeout
+	}
+	return requestTimeout
+}
