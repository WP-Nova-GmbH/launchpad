new file mode 100644
--- /dev/null
+++ b/packages/orchestrator/pkg/server/cold_boot_test.go
@@ -0,0 +1,37 @@
+//go:build linux
+
+package server
+
+import (
+	"context"
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/cfg"
+	"github.com/e2b-dev/infra/packages/shared/pkg/grpc/orchestrator"
+	"github.com/stretchr/testify/require"
+	"testing"
+	"time"
+)
+
+func TestColdBootCreateDeadline(t *testing.T) {
+	config := cfg.BuilderConfig{LaunchpadColdBootTimeout: 3 * time.Minute}
+	for _, tc := range []struct {
+		name     string
+		req      *orchestrator.SandboxCreateRequest
+		expected time.Duration
+	}{
+		{"ordinary memory resume", &orchestrator.SandboxCreateRequest{}, time.Minute},
+		{"explicit disk restore", &orchestrator.SandboxCreateRequest{FilesystemBoot: new(true)}, 4 * time.Minute},
+		{"managed filesystem resume", &orchestrator.SandboxCreateRequest{Sandbox: &orchestrator.SandboxConfig{Metadata: map[string]string{"launchpad.managed": "thread-vm-v1"}}}, 4 * time.Minute},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			budget := sandboxCreateBudget(config, tc.req)
+			require.Equal(t, tc.expected, budget)
+			parent, stop := context.WithTimeout(t.Context(), time.Second)
+			defer stop()
+			child, cancel := context.WithTimeout(parent, budget)
+			defer cancel()
+			parentDeadline, _ := parent.Deadline()
+			childDeadline, _ := child.Deadline()
+			require.Equal(t, parentDeadline, childDeadline)
+		})
+	}
+}
