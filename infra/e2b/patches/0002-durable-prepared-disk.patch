+func TestPreparedDiskOfflineSurvivesSourceDeletion(t *testing.T) {
+	if os.Getenv("E2B_OFFLINE_RESTORE_TEST") != "1" {
+		t.Skip("set E2B_OFFLINE_RESTORE_TEST=1 on the dedicated compute test host")
+	}
+	dir := t.TempDir()
+	original := filepath.Join(dir, "source.ext4")
+	file, err := os.Create(original)
+	require.NoError(t, err)
+	require.NoError(t, file.Truncate(64<<20))
+	require.NoError(t, file.Close())
+	output, err := exec.CommandContext(t.Context(), "mkfs.ext4", "-F", "-q", original).CombinedOutput()
+	require.NoError(t, err, "%s", output)
+	marker := filepath.Join(dir, "marker")
+	require.NoError(t, os.WriteFile(marker, []byte("saved without booting"), 0o600))
+	output, err = exec.CommandContext(t.Context(), "debugfs", "-w", "-R", "write "+marker+" /source-canary", original).CombinedOutput()
+	require.NoError(t, err, "%s", output)
+	oldBootstrap := filepath.Join(dir, "old-bootstrap.json")
+	require.NoError(t, os.WriteFile(oldBootstrap, []byte(`{"version":1,"generation":"source","enrollmentTicket":"old-ticket"}`), 0o600))
+	output, err = exec.CommandContext(t.Context(), "debugfs", "-w", "-R", "write "+oldBootstrap+" "+RestoreBootstrapPath, original).CombinedOutput()
+	require.NoError(t, err, "%s", output)
+	before, err := os.ReadFile(original)
+	require.NoError(t, err)
+	sourceID, destinationID := uuid.New(), uuid.New()
+	base, err := block.NewLocal(original, header.RootfsBlockSize, sourceID)
+	require.NoError(t, err)
+	defer base.Close()
+	flags, err := featureflags.NewClient()
+	require.NoError(t, err)
+	defer flags.Close(context.WithoutCancel(t.Context()))
+	pool, err := nbd.NewDevicePool(1)
+	require.NoError(t, err)
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	go pool.Populate(ctx)
+	defer pool.Close(context.WithoutCancel(ctx))
+	directory := filepath.Join(dir, "prepared")
+	saved, err := PrepareDisk(ctx, directory, destinationID, sourceID, base,
+		metadata.Template{Version: metadata.CurrentVersion, Template: metadata.TemplateMetadata{BuildID: sourceID.String()}}, 64<<20, []byte(`{"version":1,"generation":"destination-1","enrollmentTicket":"single-use-test-ticket"}`),
+		func(ctx context.Context, disk block.Device) (err error) {
+			mount := nbd.NewDirectPathMount(disk, pool, flags, logger.NewNopLogger())
+			index, err := mount.Open(ctx)
+			if err != nil {
+				return err
+			}
+			defer func() { err = errors.Join(err, mount.Close(context.WithoutCancel(ctx))) }()
+			if err := PrepareRestoreFilesystem(ctx, nbd.GetDevicePath(index)); err != nil {
+				return err
+			}
+			if err := WriteRestoreBootstrap(ctx, nbd.GetDevicePath(index), directory, []byte(`{"version":1,"generation":"destination-1","enrollmentTicket":"single-use-test-ticket"}`)); err != nil {
+				return err
+			}
+			if err := PrepareRestoreFilesystem(ctx, nbd.GetDevicePath(index)); err != nil {
+				return err
+			}
+			return mount.Flush(ctx)
+		})
+	require.NoError(t, err)
+	after, err := os.ReadFile(original)
+	require.NoError(t, err)
+	require.Equal(t, sha256.Sum256(before), sha256.Sum256(after))
+	require.NoError(t, os.Remove(original))
+	reopened, disk, err := OpenPreparedDisk(ctx, directory, destinationID)
+	require.NoError(t, err)
+	defer disk.Close()
+	require.Equal(t, saved, reopened)
+	output, err = exec.CommandContext(ctx, "debugfs", "-R", "cat /source-canary", disk.Path()).CombinedOutput()
+	require.NoError(t, err)
+	require.Contains(t, string(output), "saved without booting")
+	output, err = exec.CommandContext(ctx, "debugfs", "-R", "cat "+RestoreBootstrapPath, disk.Path()).CombinedOutput()
+	require.NoError(t, err)
+	require.Contains(t, string(output), `"generation":"destination-1"`)
+	require.NotContains(t, string(output), "old-ticket")
+
+}
