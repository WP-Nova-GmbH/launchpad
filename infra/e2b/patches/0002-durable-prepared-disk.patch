+//go:build linux
+
+package filesystemtools
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+const absentUnit = "LoadState=not-found\nActiveState=inactive\nMainPID=0\nControlPID=0\nControlGroup=\nJob=\n"
+
+func testGuard(t *testing.T, state string) Guard {
+	t.Helper()
+	return newGuard(t.TempDir(), t.TempDir(), func(_ context.Context, _ string, args ...string) ([]byte, error) {
+		switch args[0] {
+		case "show":
+			return []byte(state), nil
+		case "list-units":
+			return nil, nil
+		default:
+			return nil, errors.New("unit not loaded")
+		}
+	})
+}
+
+func TestSuccessfulToolReleasesOnlyAfterConfirmedStop(t *testing.T) {
+	t.Parallel()
+	g := testGuard(t, absentUnit)
+	lease, err := g.Begin("/dev/nbd2")
+	require.NoError(t, err)
+	_, err = g.Begin("/dev/nbd2")
+	require.Error(t, err, "a second tool must not overlap the first")
+	require.NoError(t, lease.Finish(t.Context(), true))
+	reserved, err := Reserved(g.directory, "nbd2")
+	require.NoError(t, err)
+	require.False(t, reserved)
+}
+
+func TestUncertainLauncherKeepsDeviceUntilRestartReconciliation(t *testing.T) {
+	t.Parallel()
+	g := testGuard(t, absentUnit)
+	lease, err := g.Begin("/dev/nbd2")
+	require.NoError(t, err)
+	require.ErrorIs(t, lease.Finish(t.Context(), false), ErrQuarantined)
+	reserved, err := Reserved(g.directory, "nbd2")
+	require.NoError(t, err)
+	require.True(t, reserved, "an absent unit alone cannot exclude a delayed start")
+	require.NoError(t, g.Reconcile(t.Context()))
+	reserved, err = Reserved(g.directory, "nbd2")
+	require.NoError(t, err)
+	require.False(t, reserved)
+}
+
+func TestUnconfirmedStopsRetainReservation(t *testing.T) {
+	t.Parallel()
+	for _, state := range []string{
+		"", strings.Replace(absentUnit, "MainPID=0", "MainPID=42", 1),
+		strings.Replace(absentUnit, "ControlPID=0", "ControlPID=42", 1),
+		strings.Replace(absentUnit, "Job=", "Job=17", 1),
+		strings.Replace(absentUnit, "ActiveState=inactive", "ActiveState=deactivating", 1),
+		strings.Replace(absentUnit, "ControlGroup=\n", "", 1),
+	} {
+		t.Run(state, func(t *testing.T) {
+			g := testGuard(t, state)
+			lease, err := g.Begin("/dev/nbd2")
+			require.NoError(t, err)
+			require.ErrorIs(t, lease.Finish(t.Context(), true), ErrQuarantined)
+			require.Error(t, g.Reconcile(t.Context()))
+			reserved, err := Reserved(g.directory, "nbd2")
+			require.NoError(t, err)
+			require.True(t, reserved)
+		})
+	}
+}
+
+func TestPopulatedCgroupPreventsReuseEvenWithZeroMainPID(t *testing.T) {
+	t.Parallel()
+	g := testGuard(t, strings.Replace(absentUnit, "ControlGroup=", "ControlGroup=/system.slice/test.service", 1))
+	group := filepath.Join(g.cgroupRoot, "system.slice/test.service")
+	require.NoError(t, os.MkdirAll(group, 0o700))
+	events := filepath.Join(group, "cgroup.events")
+	require.NoError(t, os.WriteFile(events, []byte("populated 1\nfrozen 0\n"), 0o600))
+	lease, err := g.Begin("/dev/nbd2")
+	require.NoError(t, err)
+	require.ErrorIs(t, lease.Finish(t.Context(), true), ErrQuarantined)
+	require.Error(t, g.Reconcile(t.Context()))
+	require.NoError(t, os.WriteFile(events, []byte("populated 0\nfrozen 0\n"), 0o600))
+	require.NoError(t, g.Reconcile(t.Context()))
+}
+
+func TestStartupEnumerationFailureDoesNotClearMarkers(t *testing.T) {
+	t.Parallel()
+	g := testGuard(t, absentUnit)
+	_, err := g.Begin("/dev/nbd2")
+	require.NoError(t, err)
+	g.command = func(context.Context, string, ...string) ([]byte, error) {
+		return nil, errors.New("systemd unavailable")
+	}
+	require.Error(t, g.Reconcile(t.Context()))
+	reserved, err := Reserved(g.directory, "nbd2")
+	require.NoError(t, err)
+	require.True(t, reserved)
+}
+
+func TestRestartStopsUnmarkedLegacyUnitsBeforeDeviceRelease(t *testing.T) {
+	t.Parallel()
+	g := testGuard(t, absentUnit)
+	unit := "envd-swap-bootstrap-write-nbd2.service"
+	stopped := false
+	g.command = func(_ context.Context, _ string, args ...string) ([]byte, error) {
