+//go:build linux
+
+package rootfs
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+
+	"github.com/google/uuid"
+	"golang.org/x/sys/unix"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox/block"
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/template/metadata"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+var (
+	ErrPreparedDiskCancelled = errors.New("prepared disk was cancelled")
+	ErrPreparedDiskBusy      = errors.New("prepared disk is being written")
+	ErrPreparedDiskConflict  = errors.New("prepared disk belongs to a different preparation")
+	ErrPreparedDiskCorrupt   = errors.New("prepared disk integrity check failed")
+)
+
+// PreparedDisk is a self-contained, verified filesystem; it holds no saved RAM
+// and no reference to source blocks. Its owner must retain it while a running
+// sandbox or snapshot still references BuildID. Publication is not permission to boot.
+type PreparedDisk struct {
+	Version         int               `json:"version"`
+	BuildID         uuid.UUID         `json:"build_id"`
+	SourceBuildID   uuid.UUID         `json:"source_build_id"`
+	RequestSHA256   string            `json:"request_sha256"`
+	BootstrapSHA256 string            `json:"bootstrap_sha256,omitempty"`
+	RootfsSHA256    string            `json:"rootfs_sha256"`
+	Size            int64             `json:"size"`
+	Metadata        metadata.Template `json:"metadata"`
+}
+
+// PrepareDisk verifies a private COW copy, then flattens it into a durable disk.
+// The caller pins the immutable source and reserves up to twice its disk size
+// before calling. verify must release its NBD handle and all writers before it
+// returns. No guest execution, identity revocation or source writes happen here.
+// The API operation owns buildID and must serialize activation/cancellation with
+// publication. Reusing it with a different source/metadata is rejected.
+func PrepareDisk(ctx context.Context, directory string, buildID, sourceBuildID uuid.UUID,
+	source block.ReadonlyDevice, meta metadata.Template, maxDiskBytes int64, bootstrap []byte,
+	verify func(context.Context, block.Device) error,
+) (result PreparedDisk, err error) {
+	if buildID == uuid.Nil || sourceBuildID == uuid.Nil || buildID == sourceBuildID || verify == nil {
+		return result, errors.New("invalid prepared disk identity or verifier")
+	}
+	if err := ctx.Err(); err != nil {
+		return result, err
+	}
+	bootstrapHash := ""
+	if len(bootstrap) > 0 {
+		if err := validateRestoreBootstrap(bootstrap); err != nil {
+			return result, err
+		}
+		digest := sha256.Sum256(bootstrap)
+		bootstrapHash = hex.EncodeToString(digest[:])
+	}
+	size, err := source.Size(ctx)
+	if err != nil {
+		return result, err
+	}
+	if source.BlockSize() != header.RootfsBlockSize || size <= 0 || size%header.RootfsBlockSize != 0 || size > maxDiskBytes {
+		return result, errors.New("prepared disk exceeds its reservation or has invalid geometry")
+	}
+	request, err := json.Marshal(struct {
+		BootstrapSHA256 string
+		Source          uuid.UUID
+		Size            int64
+		Metadata        metadata.Template
+	}{bootstrapHash, sourceBuildID, size, meta})
+	if err != nil {
+		return result, err
+	}
+	digest := sha256.Sum256(request)
+	requestHash := hex.EncodeToString(digest[:])
+	if err := os.MkdirAll(directory, 0o700); err != nil {
+		return result, err
+	}
+	lock, err := os.OpenFile(filepath.Join(directory, buildID.String()+".lock"), os.O_CREATE|os.O_RDWR, 0o600)
+	if err != nil {
+		return result, err
+	}
+	defer lock.Close()
+	if err := unix.Flock(int(lock.Fd()), unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		if errors.Is(err, unix.EWOULDBLOCK) {
+			return result, ErrPreparedDiskBusy
+		}
+		return result, err
+	}
+	defer unix.Flock(int(lock.Fd()), unix.LOCK_UN)
+	if err := checkPreparedCancellation(directory, buildID); err != nil {
+		return result, err
+	}
+	destination := filepath.Join(directory, buildID.String())
+	if _, err := os.Lstat(destination); err == nil {
+		existing, disk, err := OpenPreparedDisk(ctx, directory, buildID)
+		if err != nil {
+			return result, err
+		}
+		defer disk.Close()
+		if existing.RequestSHA256 != requestHash {
+			return result, ErrPreparedDiskConflict
+		}
+		return existing, nil
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return result, err
+	}
+
+	// An interrupted attempt is disposable until its directory is published.
+	staging := destination + ".preparing"
+	if err := os.RemoveAll(staging); err != nil {
+		return result, err
+	}
+	if err := os.Mkdir(staging, 0o700); err != nil {
+		return result, err
+	}
+	defer func() { err = errors.Join(err, os.RemoveAll(staging)) }()
+	cache, err := block.NewCache(size, source.BlockSize(), filepath.Join(staging, "private.cow"), false)
+	if err != nil {
+		return result, err
+	}
+	overlay := block.NewOverlay(source, cache)
+	defer func() {
+		if overlay != nil {
+			err = errors.Join(err, overlay.Close())
+		}
+	}()
+	if err := verify(ctx, overlay); err != nil {
+		return result, err
+	}
+	if err := ctx.Err(); err != nil {
+		return result, err
+	}
+
+	diskPath := filepath.Join(staging, storage.RootfsName)
+	diskHash, err := copyPreparedDisk(ctx, diskPath, overlay, size)
+	if err != nil {
+		return result, err
+	}
+	// Close the private cache before publishing; its path belongs to staging.
+	if err := overlay.Close(); err != nil {
+		return result, err
+	}
+	overlay = nil
+	meta = meta.MarkFilesystemOnly(true).MarkFsQuiesced(true)
+	meta.Template.BuildID = buildID.String()
+	meta.Prefetch = nil
+	result = PreparedDisk{Version: 1, BuildID: buildID, SourceBuildID: sourceBuildID,
+		RequestSHA256: requestHash, BootstrapSHA256: bootstrapHash, RootfsSHA256: diskHash, Size: size, Metadata: meta}
+	manifest, err := json.Marshal(result)
+	if err != nil {
+		return PreparedDisk{}, err
+	}
+	if err := writePreparedFile(filepath.Join(staging, "prepared.json"), manifest); err != nil {
+		return PreparedDisk{}, err
+	}
+	if err := syncPreparedDirectory(staging); err != nil {
+		return PreparedDisk{}, err
+	}
+	if err := ctx.Err(); err != nil {
+		return PreparedDisk{}, err
+	}
+	if err := os.Rename(staging, destination); err != nil {
+		return PreparedDisk{}, err
+	}
+	// If this fails, publication is uncertain: retain the destination and let a
+	// retry inspect it. Never remove a possibly committed prepared disk.
+	if err := syncPreparedDirectory(directory); err != nil {
+		return PreparedDisk{}, err
+	}
+	return result, nil
+}
+
+func copyPreparedDisk(ctx context.Context, path string, source block.ReadonlyDevice, size int64) (sum string, err error) {
+	out, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return "", err
+	}
+	defer func() { err = errors.Join(err, out.Close()) }()
+	hash := sha256.New()
+	buf := make([]byte, 1<<20)
+	for offset := int64(0); offset < size; {
+		if err := ctx.Err(); err != nil {
+			return "", err
+		}
+		chunk := buf[:min(int64(len(buf)), size-offset)]
+		n, err := source.ReadAt(ctx, chunk, offset)
+		if err != nil {
+			return "", err
+		}
+		if n != len(chunk) {
+			return "", io.ErrUnexpectedEOF
+		}
+		if _, err := out.Write(chunk); err != nil {
+			return "", err
+		}
+		_, _ = hash.Write(chunk)
+		offset += int64(n)
+	}
+	if err := out.Sync(); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(hash.Sum(nil)), nil
+}
+
+// OpenPreparedDisk rechecks all bytes before handing a disk to the activation
+// path. The returned device is read-only; normal sandbox COW owns future writes.
+func OpenPreparedDisk(ctx context.Context, directory string, buildID uuid.UUID) (PreparedDisk, *block.Local, error) {
+	var result PreparedDisk
+	if buildID == uuid.Nil {
+		return result, nil, ErrPreparedDiskCorrupt
+	}
+	if err := checkPreparedCancellation(directory, buildID); err != nil {
+		return result, nil, err
+	}
+	path := filepath.Join(directory, buildID.String())
+	file, err := os.Open(filepath.Join(path, "prepared.json"))
+	if err != nil {
+		return result, nil, err
+	}
+	decoder := json.NewDecoder(io.LimitReader(file, 1<<20))
+	decoder.DisallowUnknownFields()
+	decodeErr := decoder.Decode(&result)
+	if decodeErr == nil {
+		var extra any
+		if err := decoder.Decode(&extra); !errors.Is(err, io.EOF) {
+			decodeErr = ErrPreparedDiskCorrupt
+		}
+	}
+	closeErr := file.Close()
+	if err := errors.Join(decodeErr, closeErr); err != nil {
+		return PreparedDisk{}, nil, errors.Join(ErrPreparedDiskCorrupt, err)
+	}
+	if result.Version != 1 || result.BuildID != buildID || result.SourceBuildID == uuid.Nil ||
+		result.Metadata.Template.BuildID != buildID.String() || !result.Metadata.IsFilesystemOnly() ||
+		!result.Metadata.IsFsQuiesced() || result.Size <= 0 || result.Size%header.RootfsBlockSize != 0 {
+		return PreparedDisk{}, nil, ErrPreparedDiskCorrupt
+	}
+	disk, err := block.NewLocal(filepath.Join(path, storage.RootfsName), header.RootfsBlockSize, buildID)
+	if err != nil {
+		return PreparedDisk{}, nil, err
+	}
+	fail := func(err error) (PreparedDisk, *block.Local, error) {
+		return PreparedDisk{}, nil, errors.Join(err, disk.Close())
+	}
+	size, err := disk.Size(ctx)
+	if err != nil {
+		return fail(err)
+	}
+	if size != result.Size {
+		return fail(ErrPreparedDiskCorrupt)
+	}
+	hash := sha256.New()
+	buf := make([]byte, 1<<20)
+	for offset := int64(0); offset < size; {
+		if err := ctx.Err(); err != nil {
+			return fail(err)
+		}
+		chunk := buf[:min(int64(len(buf)), size-offset)]
+		n, err := disk.ReadAt(ctx, chunk, offset)
+		if err != nil {
+			return fail(errors.Join(ErrPreparedDiskCorrupt, err))
+		}
+		if n != len(chunk) {
+			return fail(ErrPreparedDiskCorrupt)
+		}
+		_, _ = hash.Write(chunk)
+		offset += int64(n)
+	}
+	if hex.EncodeToString(hash.Sum(nil)) != result.RootfsSHA256 {
+		return fail(ErrPreparedDiskCorrupt)
+	}
+	return result, disk, nil
+}
+
+func writePreparedFile(path string, contents []byte) (err error) {
+	file, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return err
+	}
+	defer func() { err = errors.Join(err, file.Close()) }()
+	if _, err := file.Write(contents); err != nil {
+		return err
+	}
+	return file.Sync()
+}
+
+func syncPreparedDirectory(path string) error {
+	dir, err := os.Open(path)
+	if err != nil {
+		return fmt.Errorf("open prepared disk directory: %w", err)
+	}
+	return errors.Join(dir.Sync(), dir.Close())
+}
+
+// CancelPreparedDisk records a durable tombstone before removing private files.
+// The caller must first win cancellation in the durable operation store. A
+// delayed PrepareDisk RPC then cannot recreate a cancelled allocation, even
+// after the orchestrator restarts. Live verifier handles prevent cleanup.
+func CancelPreparedDisk(ctx context.Context, directory string, buildID uuid.UUID) error {
+	if buildID == uuid.Nil {
+		return ErrPreparedDiskCorrupt
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if err := os.MkdirAll(directory, 0o700); err != nil {
+		return err
+	}
+	lock, err := os.OpenFile(filepath.Join(directory, buildID.String()+".lock"), os.O_CREATE|os.O_RDWR, 0o600)
+	if err != nil {
+		return err
+	}
+	defer lock.Close()
+	if err := unix.Flock(int(lock.Fd()), unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		if errors.Is(err, unix.EWOULDBLOCK) {
+			return ErrPreparedDiskBusy
+		}
+		return err
+	}
+	defer unix.Flock(int(lock.Fd()), unix.LOCK_UN)
+	if _, err := readRestoreActivation(directory, buildID); err == nil {
+		return ErrRestoreActivationStarted
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	// The marker's presence alone is authoritative. It is never removed. Sync
+	// even an existing marker: the previous caller may have lost power after
+	// creating it and before confirming durability.
+	marker, err := os.OpenFile(filepath.Join(directory, buildID.String()+".cancelled"), os.O_CREATE|os.O_RDWR, 0o600)
+	if err != nil {
+		return err
+	}
+	if err := errors.Join(marker.Sync(), marker.Close()); err != nil {
+		return err
+	}
+	if err := syncPreparedDirectory(directory); err != nil {
+		return err
+	}
+	if err := os.RemoveAll(filepath.Join(directory, buildID.String())); err != nil {
+		return err
+	}
+	if err := os.RemoveAll(filepath.Join(directory, buildID.String()+".preparing")); err != nil {
+		return err
+	}
+	return syncPreparedDirectory(directory)
+}
+
+func checkPreparedCancellation(directory string, buildID uuid.UUID) error {
+	_, err := os.Lstat(filepath.Join(directory, buildID.String()+".cancelled"))
+	if err == nil {
+		return ErrPreparedDiskCancelled
+	}
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	return err
+}
