+//go:build linux
+
+// Package filesystemtools reserves NBD devices across the lifetime of detached
+// systemd filesystem tools, including a crash of their orchestrator client.
+package filesystemtools
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+)
+
+const Directory = "/run/e2b-filesystem-tools"
+
+var ErrQuarantined = errors.New("filesystem tool device remains quarantined until host reconciliation")
+
+var deviceName = regexp.MustCompile(`^nbd[0-9]+$`)
+var unitName = regexp.MustCompile(`^e2b-fs-tool-[0-9a-f-]{36}\.service$`)
+var legacyUnitName = regexp.MustCompile(`^(fs-check-[0-9a-f-]{36}|envd-swap-[a-z0-9-]+-nbd[0-9]+)\.service$`)
+
+type command func(context.Context, string, ...string) ([]byte, error)
+
+type Guard struct {
+	directory  string
+	cgroupRoot string
+	command    command
+}
+
+func Host() Guard { return newGuard(Directory, "/sys/fs/cgroup", runCommand) }
+
+func newGuard(directory, cgroupRoot string, command command) Guard {
+	return Guard{directory: directory, cgroupRoot: cgroupRoot, command: command}
+}
+
+func runCommand(ctx context.Context, name string, args ...string) ([]byte, error) {
+	cmd := exec.CommandContext(ctx, name, args...)
+	cmd.WaitDelay = 5 * time.Second
+	return cmd.Output()
+}
+
+type Lease struct {
+	Unit  string
+	guard Guard
+	path  string
+}
+
+// Begin is called before systemd-run. An empty directory is also a reservation:
+// death between mkdir and creation of the unit marker must not expose the slot.
+func (g Guard) Begin(device string) (*Lease, error) {
+	name := strings.TrimPrefix(device, "/dev/")
+	if device != "/dev/"+name || !deviceName.MatchString(name) {
+		return nil, errors.New("invalid filesystem tool device")
+	}
+	if err := os.MkdirAll(g.directory, 0o700); err != nil {
+		return nil, err
+	}
+	path := filepath.Join(g.directory, name)
+	if err := os.Mkdir(path, 0o700); err != nil {
+		return nil, errors.Join(ErrQuarantined, fmt.Errorf("reserve filesystem tool device: %w", err))
+	}
+	unit := "e2b-fs-tool-" + uuid.NewString() + ".service"
+	if err := os.WriteFile(filepath.Join(path, unit), nil, 0o600); err != nil {
+		// Keep the reservation if local storage itself is uncertain.
+		return nil, err
+	}
+	return &Lease{Unit: unit, guard: g, path: path}, nil
+}
+
+// Reserved is deliberately only a filesystem lookup on the allocation path.
+// The marker outlives the controller, but a host reboot kills all tools and
+// clears /run together. Never clear markers merely because their creator died.
+func Reserved(directory, device string) (bool, error) {
+	if directory == "" {
+		directory = Directory
+	}
+	if !deviceName.MatchString(device) {
+		return false, errors.New("invalid filesystem tool device")
+	}
+	_, err := os.Lstat(filepath.Join(directory, device))
+	if errors.Is(err, os.ErrNotExist) {
+		return false, nil
+	}
+	return err == nil, err
+}
+
+// Finish only releases a successful, fully waited launcher. A failed launcher
+// may have submitted a delayed start; even a momentary absent unit is not proof
+// that that request cannot still run. Such slots remain unavailable until the
+// next exclusive host startup. Callers must propagate this error before boot.
+func (l *Lease) Finish(ctx context.Context, completed bool) error {
+	stopCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 30*time.Second)
+	defer cancel()
+	err := errors.Join(l.revoke(), l.guard.stop(stopCtx, l.Unit))
+	if !completed || err != nil {
+		return errors.Join(ErrQuarantined, err)
+	}
+	return l.remove()
+}
+
+// StartCondition prevents a delayed systemd start from opening a recycled device
+// after reconciliation has revoked this exact invocation. systemd evaluates the
+// host path before starting the jailed process; it is never mounted into the jail.
+func (l *Lease) StartCondition() string {
+	return "--property=ConditionPathExists=" + filepath.Join(l.path, l.Unit)
+}
+
+func (l *Lease) revoke() error {
+	path := filepath.Join(l.path, l.Unit)
+	if err := os.Rename(path, path+".revoked"); err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			if _, statErr := os.Stat(path + ".revoked"); statErr == nil {
+				return nil
+			}
+		}
+		return err
+	}
+	return nil
+}
+
+func (l *Lease) remove() error {
+	if err := os.Remove(filepath.Join(l.path, l.Unit+".revoked")); err != nil {
+		return err
+	}
+	return os.Remove(l.path)
+}
+
+// Reconcile runs before any startup NBD reclaim/allocation, with the previous
+// controller stopped (the node already requires a single orchestrator). Also
+// stop pre-upgrade tools which did not leave a marker. Uncertain cleanup prevents
+// startup; continuing with a fresh pool would lose the in-memory reservations.
+func (g Guard) Reconcile(ctx context.Context) error {
+	out, err := g.command(ctx, "systemctl", "list-units", "--all", "--no-legend", "--plain", "--no-pager", "--type=service", "e2b-fs-tool-*.service", "fs-check-*.service", "envd-swap-*.service")
+	if err != nil {
+		return errors.New("cannot enumerate filesystem tool units")
+	}
+	for line := range strings.SplitSeq(string(out), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 0 {
+			continue
+		}
+		unit := fields[0]
+		if !unitName.MatchString(unit) && !legacyUnitName.MatchString(unit) {
+			return errors.New("unexpected filesystem tool unit")
+		}
+		if err := g.stop(ctx, unit); err != nil {
+			return err
+		}
+	}
+	entries, err := os.ReadDir(g.directory)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	for _, entry := range entries {
+		if !entry.IsDir() || !deviceName.MatchString(entry.Name()) {
+			return errors.New("invalid filesystem tool reservation")
+		}
+		path := filepath.Join(g.directory, entry.Name())
+		markers, err := os.ReadDir(path)
+		if err != nil {
+			return err
+		}
+		for _, marker := range markers {
+			unit := strings.TrimSuffix(marker.Name(), ".revoked")
+			if !marker.Type().IsRegular() || !unitName.MatchString(unit) {
+				return errors.New("invalid filesystem tool marker")
+			}
+			lease := &Lease{Unit: unit, guard: g, path: path}
+			if err := lease.revoke(); err != nil {
+				return err
+			}
+			if err := g.stop(ctx, unit); err != nil {
+				return err
+			}
+			if err := os.Remove(filepath.Join(path, unit+".revoked")); err != nil {
+				return err
+			}
+		}
+		if err := os.Remove(path); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (g Guard) stop(ctx context.Context, unit string) error {
+	// The stop request may report 'not loaded' for a collected unit. Only the
+	// structured state below can turn that into a confirmed absence.
+	_, _ = g.command(ctx, "systemctl", "stop", "--quiet", unit)
+	out, showErr := g.command(ctx, "systemctl", "show", "--property=LoadState,ActiveState,MainPID,ControlPID,ControlGroup,Job", unit)
+	fields := map[string]string{}
+	for line := range strings.SplitSeq(string(out), "\n") {
+		k, v, ok := strings.Cut(line, "=")
+		if ok {
+			fields[k] = v
+		}
+	}
+	if fields["LoadState"] != "not-found" && (showErr != nil || fields["LoadState"] != "loaded") {
+		return errors.New("cannot confirm filesystem tool unit state")
+	}
+	if (fields["ActiveState"] != "inactive" && fields["ActiveState"] != "failed") || fields["MainPID"] != "0" || fields["ControlPID"] != "0" {
+		return errors.New("filesystem tool is still running")
+	}
+	if job, ok := fields["Job"]; !ok || job != "" {
+		return errors.New("filesystem tool job remains pending")
+	}
+	cgroup, ok := fields["ControlGroup"]
+	if !ok {
+		return errors.New("filesystem tool cgroup is unknown")
+	}
+	if cgroup == "" {
+		return nil
+	}
+	if !strings.HasPrefix(cgroup, "/") || filepath.Clean(cgroup) != cgroup || cgroup == "/" {
+		return errors.New("invalid filesystem tool cgroup")
+	}
+	events, err := os.ReadFile(filepath.Join(g.cgroupRoot, strings.TrimPrefix(cgroup, "/"), "cgroup.events"))
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return errors.New("cannot confirm filesystem tool cgroup is empty")
+	}
+	for line := range strings.SplitSeq(string(events), "\n") {
+		if line == "populated 0" {
+			return nil
+		}
+	}
+	return errors.New("filesystem tool cgroup remains populated")
+}
