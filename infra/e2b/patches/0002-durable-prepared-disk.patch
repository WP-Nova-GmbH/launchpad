+//go:build linux
+
+package rootfs
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+
+	"github.com/google/uuid"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+func PreparedManifest(disk PreparedDisk) ([]byte, string, error) {
+	data, err := json.Marshal(disk)
+	if err != nil {
+		return nil, "", err
+	}
+	digest := sha256.Sum256(data)
+	return data, hex.EncodeToString(digest[:]), nil
+}
+
+// PublishPreparedDisk transfers the independent rootfs into the runtime's normal
+// immutable build storage. It never boots anything. Call only after a durable
+// activation intent has won; no public template assignment may expose this
+// build before that commit. Metadata is the last object published.
+func PublishPreparedDisk(ctx context.Context, directory string, buildID uuid.UUID, expectedManifest string,
+	store storage.StorageProvider, provenance storage.ObjectMetadata,
+) (result PreparedDisk, err error) {
+	result, disk, err := OpenPreparedDisk(ctx, directory, buildID)
+	if err != nil {
+		return result, err
+	}
+	defer func() { err = errors.Join(err, disk.Close()) }()
+	_, digest, err := PreparedManifest(result)
+	if err != nil {
+		return PreparedDisk{}, err
+	}
+	if digest != expectedManifest {
+		return PreparedDisk{}, ErrPreparedDiskConflict
+	}
+	paths := storage.Paths{BuildID: buildID.String()}
+	object, err := store.OpenSeekable(ctx, paths.Rootfs())
+	if err != nil {
+		return PreparedDisk{}, err
+	}
+	_, _, err = object.StoreFile(ctx, disk.Path(), storage.WithMetadata(provenance))
+	if err != nil {
+		return PreparedDisk{}, err
+	}
+	if _, _, _, err = header.StoreHeader(ctx, store, paths.RootfsHeader(), disk.Header(), storage.WithMetadata(provenance)); err != nil {
+		return PreparedDisk{}, err
+	}
+	meta, err := json.Marshal(result.Metadata)
+	if err != nil {
+		return PreparedDisk{}, err
+	}
+	blob, err := store.OpenBlob(ctx, paths.Metadata())
+	if err != nil {
+		return PreparedDisk{}, err
+	}
+	if err = blob.Put(ctx, meta, storage.WithMetadata(provenance)); err != nil {
+		return PreparedDisk{}, err
+	}
+	return result, nil
+}
