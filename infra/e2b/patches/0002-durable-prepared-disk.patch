+//go:build linux
+
+package nbd
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox/filesystemtools"
+	"github.com/stretchr/testify/require"
+)
+
+func TestFilesystemToolReservationPreventsRecycledDevice(t *testing.T) {
+	t.Parallel()
+	pool := retryingPool()
+	pool.sysBlockDir = t.TempDir()
+	pool.filesystemToolsDir = t.TempDir()
+	for _, name := range []string{"nbd0", "nbd1"} {
+		require.NoError(t, os.Mkdir(filepath.Join(pool.sysBlockDir, name), 0o700))
+		require.NoError(t, os.WriteFile(filepath.Join(pool.sysBlockDir, name, "size"), []byte("0\n"), 0o600))
+	}
+	marker := filepath.Join(pool.filesystemToolsDir, "nbd0")
+	require.NoError(t, os.Mkdir(marker, 0o700))
+	pool.usedSlots.Set(0)
+	require.ErrorIs(t, pool.ReleaseDevice(t.Context(), 0, WithInfiniteRetry()), filesystemtools.ErrQuarantined)
+	require.True(t, pool.usedSlots.Test(0))
+	// A fresh controller has lost that bitset. The durable reservation still wins.
+	pool.usedSlots.Clear(0)
+	slot, err := pool.getFreeDeviceSlot()
+	require.NoError(t, err)
+	require.Equal(t, DeviceSlot(1), *slot)
+	require.NoError(t, os.Remove(marker))
+	slot, err = pool.getFreeDeviceSlot()
+	require.NoError(t, err)
+	require.Equal(t, DeviceSlot(0), *slot)
+}
