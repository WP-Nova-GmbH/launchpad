+//go:build linux
+
+package rootfs
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"os/user"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const (
+	RestoreBootstrapPath     = "/launchpad-restore.json"
+	MaxRestoreBootstrapBytes = 16 << 10
+)
+
+var ErrRestoreBootstrap = errors.New("restore bootstrap could not be installed safely")
+var bootstrapOwner = regexp.MustCompile(`(?m)^User:\s*0\s+Group:\s*0\s`)
+var bootstrapLinks = regexp.MustCompile(`(?m)^Links:\s*([0-9]+)\s`)
+var bootstrapStagePath = regexp.MustCompile(`^/[a-zA-Z0-9_./-]+$`)
+
+// WriteRestoreBootstrap installs bounded JSON in the destination's root
+// directory using trusted jailed debugfs, never guest tools or a host kernel
+// mount. Call only on a private offline disk; failure discards that copy. The
+// caller supplies a one-use enrollment ticket, never a reusable management key.
+// Its contents and debugfs output must not be logged or returned in errors.
+func WriteRestoreBootstrap(ctx context.Context, devicePath, stageRoot string, document []byte) error {
+	if err := validateRestoreBootstrap(document); err != nil {
+		return err
+	}
+	if !nbdDevicePath.MatchString(devicePath) || !bootstrapStagePath.MatchString(stageRoot) {
+		return ErrRestoreBootstrap
+	}
+	group, err := user.LookupGroup("disk")
+	if err != nil {
+		return errors.Join(ErrRestoreBootstrap, err)
+	}
+	gid, err := strconv.Atoi(group.Gid)
+	if err != nil {
+		return ErrRestoreBootstrap
+	}
+	stage, err := os.MkdirTemp(stageRoot, ".restore-bootstrap-")
+	if err != nil {
+		return errors.Join(ErrRestoreBootstrap, err)
+	}
+	defer os.RemoveAll(stage)
+	// The jail already runs with SupplementaryGroups=disk. Keep enrollment
+	// material unreadable to other host users, unlike the public envd binary.
+	if err = os.Chown(stage, -1, gid); err != nil {
+		return errors.Join(ErrRestoreBootstrap, err)
+	}
+	if err = os.Chmod(stage, 0o750); err != nil {
+		return errors.Join(ErrRestoreBootstrap, err)
+	}
+	input := filepath.Join(stage, "bootstrap.json")
+	if err = os.WriteFile(input, document, 0o640); err != nil {
+		return errors.Join(ErrRestoreBootstrap, err)
+	}
+	if err = os.Chown(input, -1, gid); err != nil {
+		return errors.Join(ErrRestoreBootstrap, err)
+	}
+	if err = os.Chmod(input, 0o640); err != nil {
+		return errors.Join(ErrRestoreBootstrap, err)
+	}
+	run := func(phase, script string, writable bool) ([]byte, error) {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		// Let the bounded systemd unit finish a mutation even if the caller
+		// disconnects. PrepareDisk checks cancellation before publishing.
+		toolCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), EnvdSwapTimeout+30*time.Second)
+		defer cancel()
+		return runDebugfs(toolCtx, devicePath, stage, phase, script, writable)
+	}
+	stat, err := run("bootstrap-stat", "stat "+RestoreBootstrapPath+"\n", false)
+	if err != nil {
+		return errors.Join(ErrRestoreBootstrap, err)
+	}
+	exists := !envdAbsent(string(stat))
+	if exists && !bootstrapRegularFile(stat) {
+		return ErrRestoreBootstrap
+	}
+	script := ""
+	if exists {
+		script = "rm " + RestoreBootstrapPath + "\n"
+	}
+	script += "write " + input + " " + RestoreBootstrapPath + "\nset_inode_field " + RestoreBootstrapPath + " mode 0100600\nset_inode_field " + RestoreBootstrapPath + " uid 0\nset_inode_field " + RestoreBootstrapPath + " gid 0\n"
+	if _, err = run("bootstrap-write", script, true); err != nil {
+		return errors.Join(ErrRestoreBootstrap, err)
+	}
+	stat, err = run("bootstrap-check", "stat "+RestoreBootstrapPath+"\n", false)
+	if err != nil {
+		return errors.Join(ErrRestoreBootstrap, err)
+	}
+	size, sizeErr := parseEnvdSize(string(stat))
+	if !bootstrapRegularFile(stat) || sizeErr != nil || size != int64(len(document)) || !bootstrapPrivateRootFile(stat) {
+		return ErrRestoreBootstrap
+	}
+	output := filepath.Join(stage, "readback.json")
+	if err = os.WriteFile(output, nil, 0o660); err != nil {
+		return errors.Join(ErrRestoreBootstrap, err)
+	}
+	if err = os.Chown(output, -1, gid); err != nil {
+		return errors.Join(ErrRestoreBootstrap, err)
+	}
+	if err = os.Chmod(output, 0o660); err != nil {
+		return errors.Join(ErrRestoreBootstrap, err)
+	}
+	if _, err = run("bootstrap-readback", "dump "+RestoreBootstrapPath+" "+output+"\n", false); err != nil {
+		return errors.Join(ErrRestoreBootstrap, err)
+	}
+	actual, err := os.ReadFile(output)
+	if err != nil {
+		return errors.Join(ErrRestoreBootstrap, err)
+	}
+	if !bytes.Equal(actual, document) {
+		return ErrRestoreBootstrap
+	}
+	return nil
+}
+
+func validateRestoreBootstrap(document []byte) error {
+	if len(document) == 0 || len(document) > MaxRestoreBootstrapBytes {
+		return ErrRestoreBootstrap
+	}
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(document, &object); err != nil || object == nil {
+		return ErrRestoreBootstrap
+	}
+	var version int
+	if err := json.Unmarshal(object["version"], &version); err != nil || version != 1 {
+		return fmt.Errorf("%w: unsupported format", ErrRestoreBootstrap)
+	}
+	return nil
+}
+
+func bootstrapRegularFile(stat []byte) bool {
+	if !strings.Contains(string(stat), "Type: regular") {
+		return false
+	}
+	links := bootstrapLinks.FindSubmatch(stat)
+	return len(links) == 2 && string(links[1]) == "1"
+}
+
+func bootstrapPrivateRootFile(stat []byte) bool {
+	mode := debugfsModeRe.FindSubmatch(stat)
+	if len(mode) != 2 || !bootstrapOwner.Match(stat) {
+		return false
+	}
+	parsed, err := strconv.ParseUint(string(mode[1]), 8, 32)
+	return err == nil && parsed == 0o600
+}
