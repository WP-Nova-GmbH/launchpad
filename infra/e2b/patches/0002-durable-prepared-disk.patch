+func TestRestoreBootstrapRejectsSymlinkOffline(t *testing.T) {
+	if os.Getenv("E2B_OFFLINE_RESTORE_TEST") != "1" {
+		t.Skip("requires dedicated Linux test host")
+	}
+	dir := t.TempDir()
+	image := filepath.Join(dir, "source.ext4")
+	file, err := os.Create(image)
+	require.NoError(t, err)
+	require.NoError(t, file.Truncate(64<<20))
+	require.NoError(t, file.Close())
+	output, err := exec.CommandContext(t.Context(), "mkfs.ext4", "-F", "-q", image).CombinedOutput()
+	require.NoError(t, err, "%s", output)
+	output, err = exec.CommandContext(t.Context(), "debugfs", "-w", "-R", "symlink "+RestoreBootstrapPath+" /lost+found", image).CombinedOutput()
+	require.NoError(t, err, "%s", output)
+	before, err := os.ReadFile(image)
+	require.NoError(t, err)
+	sourceID := uuid.New()
+	source, err := block.NewLocal(image, header.RootfsBlockSize, sourceID)
+	require.NoError(t, err)
+	defer source.Close()
+	flags, err := featureflags.NewClient()
+	require.NoError(t, err)
+	defer flags.Close(context.WithoutCancel(t.Context()))
+	pool, err := nbd.NewDevicePool(1)
+	require.NoError(t, err)
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	go pool.Populate(ctx)
+	defer pool.Close(context.WithoutCancel(ctx))
+	_, err = PrepareDisk(ctx, filepath.Join(dir, "prepared"), uuid.New(), sourceID, source,
+		metadata.Template{Version: metadata.CurrentVersion, Template: metadata.TemplateMetadata{BuildID: sourceID.String()}}, 64<<20, []byte(`{"version":1,"generation":"new"}`),
+		func(ctx context.Context, disk block.Device) (err error) {
+			mount := nbd.NewDirectPathMount(disk, pool, flags, logger.NewNopLogger())
+			index, err := mount.Open(ctx)
+			if err != nil {
+				return err
+			}
+			defer func() { err = errors.Join(err, mount.Close(context.WithoutCancel(ctx))) }()
+			device := nbd.GetDevicePath(index)
+			output, err := exec.CommandContext(ctx, "debugfs", "-R", "stat "+RestoreBootstrapPath, device).CombinedOutput()
+			require.NoError(t, err)
+			require.Contains(t, string(output), "Type: symlink", "symlink fixture must exist")
+			return WriteRestoreBootstrap(ctx, device, dir, []byte(`{"version":1,"generation":"new"}`))
+		})
+	require.ErrorIs(t, err, ErrRestoreBootstrap)
+	after, err := os.ReadFile(image)
+	require.NoError(t, err)
+	require.Equal(t, sha256.Sum256(before), sha256.Sum256(after))
