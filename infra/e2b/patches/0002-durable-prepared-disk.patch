+	"github.com/stretchr/testify/require"
+)
+
+func activationFixture(t *testing.T, bootstrap []byte) (string, uuid.UUID, string) {
+	t.Helper()
+	directory, source, sourceID, meta, original := preparedDiskFixture(t)
+	id := uuid.New()
+	disk, err := PrepareDisk(t.Context(), directory, id, sourceID, source, meta, int64(len(original)), bootstrap,
+		func(context.Context, block.Device) error { return nil })
+	require.NoError(t, err)
+	_, digest, err := PreparedManifest(disk)
+	require.NoError(t, err)
+	return directory, id, digest
+}
+
+func TestRestoreActivationRecoversLostReplyWithoutSecondBoot(t *testing.T) {
+	t.Parallel()
+	directory, id, digest := activationFixture(t, []byte(`{"version":1,"ticket":"single-use"}`))
+	require.ErrorIs(t, RequireActivatedBuild(directory, id), ErrRestoreActivationStarted)
+	first, err := LockRestoreActivation(t.Context(), directory, id, digest, []byte("immutable boot config"))
+	require.NoError(t, err)
+	require.Equal(t, "accepted", first.Record().State)
+	require.NoError(t, first.BeginBoot())
+	require.ErrorIs(t, first.BeginBoot(), ErrRestoreActivationStarted)
+	require.NoError(t, first.Close()) // Simulate losing process/reply immediately after boot intent.
+	retry, err := LockRestoreActivation(t.Context(), directory, id, digest, []byte("immutable boot config"))
+	require.NoError(t, err)
+	require.Equal(t, "booting", retry.Record().State)
+	require.ErrorIs(t, retry.BeginBoot(), ErrRestoreActivationStarted)
+	require.NoError(t, retry.Complete(json.RawMessage(`{"ready":true}`)))
+	require.NoError(t, retry.Close())
+	require.NoError(t, RequireActivatedBuild(directory, id))
+	require.NoError(t, ReleaseActivatedDisk(t.Context(), directory, id)) // Storage ownership transferred.
+	require.NoError(t, ReleaseActivatedDisk(t.Context(), directory, id))
+	afterCleanup, err := LockRestoreActivation(t.Context(), directory, id, digest, []byte("immutable boot config"))
+	require.NoError(t, err)
+	require.Equal(t, "active", afterCleanup.Record().State)
+	require.JSONEq(t, `{"ready":true}`, string(afterCleanup.Record().Response))
+	require.ErrorIs(t, afterCleanup.BeginBoot(), ErrRestoreActivationStarted)
+	require.NoError(t, afterCleanup.Close())
+	require.NoError(t, RequireActivatedBuild(directory, id))
+}
+
+func TestRestoreActivationBindsRequestAndSerializesCancellation(t *testing.T) {
+	t.Parallel()
+	directory, id, digest := activationFixture(t, []byte(`{"version":1}`))
+	first, err := LockRestoreActivation(t.Context(), directory, id, digest, []byte("original config"))
+	require.NoError(t, err)
+	_, err = LockRestoreActivation(t.Context(), directory, id, digest, []byte("original config"))
+	require.ErrorIs(t, err, ErrPreparedDiskBusy)
+	require.ErrorIs(t, CancelPreparedDisk(t.Context(), directory, id), ErrPreparedDiskBusy)
+	require.NoError(t, first.Close())
+	_, err = LockRestoreActivation(t.Context(), directory, id, digest, []byte("changed config"))
+	require.ErrorIs(t, err, ErrPreparedDiskConflict)
+	require.ErrorIs(t, CancelPreparedDisk(t.Context(), directory, id), ErrRestoreActivationStarted)
+	retry, err := LockRestoreActivation(t.Context(), directory, id, digest, []byte("original config"))
+	require.NoError(t, err)
+	require.Equal(t, "accepted", retry.Record().State, "preflight failure permits another attempt before boot intent")
+	require.NoError(t, retry.Close())
+}
+
+func TestRestoreActivationRejectsCancelledAndVerificationOnlyDisks(t *testing.T) {
+	t.Parallel()
+	for _, cancelled := range []bool{false, true} {
+		directory, id, digest := activationFixture(t, nil)
+		if cancelled {
+			require.NoError(t, CancelPreparedDisk(t.Context(), directory, id))
+		}
+		_, err := LockRestoreActivation(t.Context(), directory, id, digest, []byte("config"))
+		require.Error(t, err)
+		if cancelled {
+			require.ErrorIs(t, err, ErrPreparedDiskCancelled)
+		}
+		_, err = os.Stat(activationPath(directory, id))
+		require.ErrorIs(t, err, os.ErrNotExist)
+	}
+}
+
+func TestRestoreOrdinaryBuildGate(t *testing.T) {
+	t.Parallel()
+	directory := t.TempDir()
+	require.NoError(t, RequireActivatedBuild(directory, uuid.New()))
+	id := uuid.New()
+	require.NoError(t, CancelPreparedDisk(t.Context(), directory, id))
+	require.ErrorIs(t, RequireActivatedBuild(directory, id), ErrPreparedDiskCancelled)
+}
