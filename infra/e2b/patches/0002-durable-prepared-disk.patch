+//go:build linux
+
+package rootfs
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+
+	"github.com/google/uuid"
+	"golang.org/x/sys/unix"
+)
+
+var ErrRestoreActivationStarted = errors.New("restore activation has started")
+
+// RestoreActivation survives lost replies and process restarts independently of
+// the temporary disk. Booting is an irreversible intent: absence from the live
+// registry is not permission to repeat it. Only an explicit, confirmed stop may
+// reconcile a failed activation; it never reuses this execution identity.
+type RestoreActivation struct {
+	Version       int             `json:"version"`
+	RequestSHA256 string          `json:"request_sha256"`
+	State         string          `json:"state"`
+	Response      json.RawMessage `json:"response,omitempty"`
+}
+
+type RestoreActivationLock struct {
+	directory string
+	buildID   uuid.UUID
+	lock      *os.File
+	record    RestoreActivation
+}
+
+func activationPath(directory string, buildID uuid.UUID) string {
+	return filepath.Join(directory, buildID.String()+".activation.json")
+}
+
+func readRestoreActivation(directory string, buildID uuid.UUID) (RestoreActivation, error) {
+	var result RestoreActivation
+	raw, err := os.ReadFile(activationPath(directory, buildID))
+	if err != nil {
+		return result, err
+	}
+	if len(raw) > 1<<20 {
+		return result, ErrPreparedDiskCorrupt
+	}
+	if err := json.Unmarshal(raw, &result); err != nil {
+		return result, ErrPreparedDiskCorrupt
+	}
+	if result.Version != 1 || len(result.RequestSHA256) != 64 {
+		return result, ErrPreparedDiskCorrupt
+	}
+	switch result.State {
+	case "accepted", "booting":
+		if len(result.Response) != 0 {
+			return result, ErrPreparedDiskCorrupt
+		}
+	case "active":
+		if len(result.Response) == 0 {
+			return result, ErrPreparedDiskCorrupt
+		}
+	default:
+		return result, ErrPreparedDiskCorrupt
+	}
+	return result, nil
+}
+
+// LockRestoreActivation checks the exact verified disk before accepting a new
+// immutable boot request. The request is hashed, never stored (it may contain
+// an envd credential). Callers must already own the durable activation intent.
+func LockRestoreActivation(ctx context.Context, directory string, buildID uuid.UUID,
+	manifestSHA string, request []byte,
+) (_ *RestoreActivationLock, err error) {
+	if buildID == uuid.Nil || len(manifestSHA) != 64 || len(request) == 0 {
+		return nil, ErrPreparedDiskConflict
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if err := os.MkdirAll(directory, 0o700); err != nil {
+		return nil, err
+	}
+	file, err := os.OpenFile(filepath.Join(directory, buildID.String()+".lock"), os.O_CREATE|os.O_RDWR, 0o600)
+	if err != nil {
+		return nil, err
+	}
+	h := &RestoreActivationLock{directory: directory, buildID: buildID, lock: file}
+	defer func() {
+		if err != nil {
+			h.Close()
+		}
+	}()
+	if err := unix.Flock(int(file.Fd()), unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		if errors.Is(err, unix.EWOULDBLOCK) {
+			return nil, ErrPreparedDiskBusy
+		}
+		return nil, err
+	}
+	if err := checkPreparedCancellation(directory, buildID); err != nil {
+		return nil, err
+	}
+	digest := sha256.New()
+	digest.Write([]byte(manifestSHA))
+	digest.Write(request)
+	requestSHA := hex.EncodeToString(digest.Sum(nil))
+	record, err := readRestoreActivation(directory, buildID)
+	if err == nil {
+		if record.RequestSHA256 != requestSHA {
+			return nil, ErrPreparedDiskConflict
+		}
+		h.record = record
+		return h, nil
+	}
+	if !errors.Is(err, os.ErrNotExist) {
+		return nil, err
+	}
+	manifest, disk, err := OpenPreparedDisk(ctx, directory, buildID)
+	if err != nil {
+		return nil, err
+	}
+	if err := disk.Close(); err != nil {
+		return nil, err
+	}
+	_, actualSHA, err := PreparedManifest(manifest)
+	if err != nil {
+		return nil, err
+	}
+	if actualSHA != manifestSHA {
+		return nil, ErrPreparedDiskConflict
+	}
+	if manifest.BootstrapSHA256 == "" {
+		return nil, errors.New("verification-only disk cannot be activated")
+	}
+	h.record = RestoreActivation{Version: 1, RequestSHA256: requestSHA, State: "accepted"}
+	if err := h.persist(); err != nil {
+		return nil, err
+	}
+	return h, nil
+}
+
+func (h *RestoreActivationLock) Record() RestoreActivation { return h.record }
+
+func (h *RestoreActivationLock) Close() error {
+	if h.lock == nil {
+		return nil
+	}
+	err := errors.Join(unix.Flock(int(h.lock.Fd()), unix.LOCK_UN), h.lock.Close())
+	h.lock = nil
+	return err
+}
+
+func (h *RestoreActivationLock) persist() error {
+	if h.lock == nil {
+		return ErrPreparedDiskBusy
+	}
+	data, err := json.Marshal(h.record)
+	if err != nil {
+		return err
+	}
+	path := activationPath(h.directory, h.buildID)
+	temporary := path + ".tmp"
+	if err := os.Remove(temporary); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	if err := writePreparedFile(temporary, data); err != nil {
+		return err
+	}
+	if err := os.Rename(temporary, path); err != nil {
+		return err
+	}
+	return syncPreparedDirectory(h.directory)
+}
+
+// BeginBoot must run immediately before the only guest-start attempt, after
+// preflight/capacity failures. A crash after this fsync requires inspection, not
+// another invocation of the boot callback.
+func (h *RestoreActivationLock) BeginBoot() error {
+	if h.lock == nil || h.record.State != "accepted" {
+		return ErrRestoreActivationStarted
+	}
+	h.record.State = "booting"
+	return h.persist()
+}
+
+func (h *RestoreActivationLock) Complete(response json.RawMessage) error {
+	if h.lock == nil || h.record.State != "booting" || !json.Valid(response) {
+		return ErrPreparedDiskConflict
+	}
+	h.record.State = "active"
+	h.record.Response = response
+	return h.persist()
+}
+
+// RequireActivatedBuild prevents ordinary Create/resume routes from bypassing
+// prepared activation. Small receipts remain after private disks are released.
+func RequireActivatedBuild(directory string, buildID uuid.UUID) error {
+	if err := checkPreparedCancellation(directory, buildID); err != nil {
+		return err
+	}
+	record, err := readRestoreActivation(directory, buildID)
+	if err == nil {
+		if record.State == "active" {
+			return nil
+		}
+		return ErrRestoreActivationStarted
+	}
+	if !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	for _, suffix := range []string{"", ".preparing"} {
+		_, err := os.Stat(filepath.Join(directory, buildID.String()+suffix))
+		if err == nil {
+			return ErrRestoreActivationStarted
+		}
+		if !errors.Is(err, os.ErrNotExist) {
+			return err
+		}
+	}
+	return nil
+}
+
+// ReleaseActivatedDisk drops the redundant verified copy only after its boot
+// receipt is durable. The immutable published build and small activation record
+// remain; their lifetime now belongs to normal sandbox/snapshot storage.
+func ReleaseActivatedDisk(ctx context.Context, directory string, buildID uuid.UUID) error {
+	if buildID == uuid.Nil {
+		return ErrPreparedDiskCorrupt
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	lock, err := os.OpenFile(filepath.Join(directory, buildID.String()+".lock"), os.O_CREATE|os.O_RDWR, 0o600)
+	if err != nil {
+		return err
+	}
+	defer lock.Close()
+	if err := unix.Flock(int(lock.Fd()), unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		if errors.Is(err, unix.EWOULDBLOCK) {
+			return ErrPreparedDiskBusy
+		}
+		return err
+	}
+	defer unix.Flock(int(lock.Fd()), unix.LOCK_UN)
+	record, err := readRestoreActivation(directory, buildID)
+	if err != nil {
+		return err
+	}
+	if record.State != "active" {
+		return ErrRestoreActivationStarted
+	}
+	if err := os.RemoveAll(filepath.Join(directory, buildID.String())); err != nil {
+		return err
+	}
+	return syncPreparedDirectory(directory)
+}
