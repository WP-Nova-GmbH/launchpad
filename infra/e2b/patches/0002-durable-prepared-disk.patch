+func TestPublishPreparedDiskTransfersIndependentStorage(t *testing.T) {
+	t.Parallel()
+	directory, source, sourceID, meta, original := preparedDiskFixture(t)
+	id := uuid.New()
+	manifest, err := PrepareDisk(t.Context(), directory, id, sourceID, source, meta, int64(len(original)), nil, func(context.Context, block.Device) error { return nil })
+	require.NoError(t, err)
+	_, digest, err := PreparedManifest(manifest)
+	require.NoError(t, err)
+	store, err := storage.NewProvider(t.Context(), storage.Spec{Provider: storage.LocalStorageProvider, BasePath: t.TempDir()})
+	require.NoError(t, err)
+	paths := storage.Paths{BuildID: id.String()}
+	_, err = PublishPreparedDisk(t.Context(), directory, id, strings.Repeat("0", 64), store, nil)
+	require.ErrorIs(t, err, ErrPreparedDiskConflict)
+	blob, err := store.OpenBlob(t.Context(), paths.Metadata())
+	require.NoError(t, err)
+	exists, err := blob.Exists(t.Context())
+	require.NoError(t, err)
+	require.False(t, exists, "mismatched manifest cannot publish a bootable build")
+	for range 2 {
+		published, err := PublishPreparedDisk(t.Context(), directory, id, digest, store, nil)
+		require.NoError(t, err)
+		require.Equal(t, manifest, published)
+	}
+	require.NoError(t, CancelPreparedDisk(t.Context(), directory, id))
+	require.NoError(t, os.Remove(source.Path()))
+	h, _, err := header.LoadHeader(t.Context(), store, paths.RootfsHeader())
+	require.NoError(t, err)
+	require.Equal(t, id, h.Metadata.BuildId)
+	require.Equal(t, id, h.Metadata.BaseBuildId, "live storage has no dependency on the source allocation")
+	object, err := store.OpenBlob(t.Context(), paths.Rootfs())
+	require.NoError(t, err)
+	var data bytes.Buffer
+	_, err = object.WriteTo(t.Context(), &data)
+	require.NoError(t, err)
+	require.Equal(t, original, data.Bytes())
+	data.Reset()
+	_, err = blob.WriteTo(t.Context(), &data)
+	require.NoError(t, err)
+	var boot metadata.Template
+	require.NoError(t, json.Unmarshal(data.Bytes(), &boot))
+	require.True(t, boot.IsFilesystemOnly())
+	require.True(t, boot.IsFsQuiesced())
+	require.Equal(t, id.String(), boot.Template.BuildID)
+	memory, err := store.OpenBlob(t.Context(), paths.Memfile())
+	require.NoError(t, err)
+	exists, err = memory.Exists(t.Context())
+	require.NoError(t, err)
+	require.False(t, exists, "prepared publication must not retain saved RAM")
+}
