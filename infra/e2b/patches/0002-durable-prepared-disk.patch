+
+// PrepareRestoreDisk publishes a verified, independent rootfs without allocating
+// guest RAM, networking or a Firecracker process. The operation coordinator owns
+// source pins, the destination build ID and the temporary storage reservation.
+func (f *Factory) PrepareRestoreDisk(ctx context.Context, directory string, buildID uuid.UUID,
+	source template.Template, reservedDiskBytes int64, bootstrap []byte,
+) (rootfs.PreparedDisk, error) {
+	sourceBuildID, err := uuid.Parse(source.Files().BuildID)
+	if err != nil {
+		return rootfs.PreparedDisk{}, err
+	}
+	meta, err := source.Metadata()
+	if err != nil {
+		return rootfs.PreparedDisk{}, err
+	}
+	disk, err := source.Rootfs()
+	if err != nil {
+		return rootfs.PreparedDisk{}, err
+	}
+	return rootfs.PrepareDisk(ctx, directory, buildID, sourceBuildID, disk, meta, reservedDiskBytes, bootstrap,
+		func(ctx context.Context, copy block.Device) (err error) {
+			mount := f.NewDirectPathMount(copy, logger.L())
+			index, err := mount.Open(ctx)
+			if err != nil {
+				return err
+			}
+			defer func() { err = errors.Join(err, mount.Close(context.WithoutCancel(ctx))) }()
+			if err := rootfs.PrepareRestoreFilesystem(ctx, nbd.GetDevicePath(index)); err != nil {
+				return err
+			}
+			if len(bootstrap) > 0 {
+				if err := rootfs.WriteRestoreBootstrap(ctx, nbd.GetDevicePath(index), directory, bootstrap); err != nil {
+					return err
+				}
+				if err := rootfs.PrepareRestoreFilesystem(ctx, nbd.GetDevicePath(index)); err != nil {
+					return err
+				}
+			}
+			// Flush kernel/device writeback before flattening the replayed copy.
+			return mount.Flush(ctx)
+		})
+}
