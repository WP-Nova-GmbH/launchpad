+// ValidatePausedDisk is read-only. Routing absence and an older ready snapshot
+// cannot certify a pause whose latest disk build or physical stop failed.
+func (s Store) ValidatePausedDisk(ctx context.Context, team uuid.UUID, sandbox string, build uuid.UUID) error {
+	if team == uuid.Nil || sandbox == "" || build == uuid.Nil {
+		return ErrPausedDisk
+	}
+	_, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	var confirmed bool
+	err = tx.QueryRow(ctx, `SELECT EXISTS (
+        SELECT 1 FROM public.sandbox_execution_fences f
+        JOIN public.snapshots s ON s.team_id=f.team_id AND s.sandbox_id=f.sandbox_id
+        JOIN public.env_build_assignments a ON a.env_id=s.env_id AND a.tag='default'
+        JOIN public.env_builds b ON b.id=a.build_id
+        WHERE f.team_id=$1 AND f.sandbox_id=$2 AND f.state='paused'
+          AND f.current_execution_id IS NOT NULL AND f.paused_build_id=$3 AND b.id=$3
+          AND b.status_group='ready' AND s.config->>'filesystemOnly'='true'
+          AND s.metadata->>'launchpad.managed'='thread-vm-v1'
+          AND a.created_at=(SELECT max(tip.created_at) FROM public.env_build_assignments tip
+            WHERE tip.env_id=s.env_id AND tip.tag='default')
+          AND EXISTS(SELECT 1 FROM public.sandbox_execution_build_roots r
+            WHERE r.team_id=f.team_id AND r.sandbox_id=f.sandbox_id AND r.execution_id=f.current_execution_id)
+    )`, team, sandbox, build).Scan(&confirmed)
+	if err != nil {
+		return err
+	}
+	if !confirmed {
+		return ErrPausedDisk
+	}
+	return nil
+}
