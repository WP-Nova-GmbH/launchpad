+
+func TestPreparedDiskSparseCopyPreservesAllBytesAndTrailingGeometry(t *testing.T) {
+	t.Parallel()
+	for _, nonzero := range []bool{false, true} {
+		t.Run(fmt.Sprint(nonzero), func(t *testing.T) {
+			dir := t.TempDir()
+			size := int64(5<<20) + header.RootfsBlockSize
+			original := make([]byte, size)
+			if nonzero {
+				copy(original[2<<20:], bytes.Repeat([]byte{0x6a}, int(header.RootfsBlockSize)))
+			}
+			sourcePath := filepath.Join(dir, "source")
+			file, err := os.OpenFile(sourcePath, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)
+			require.NoError(t, err)
+			require.NoError(t, file.Truncate(size))
+			if nonzero {
+				_, err = file.WriteAt(original[2<<20:2<<20+header.RootfsBlockSize], 2<<20)
+				require.NoError(t, err)
+			}
+			require.NoError(t, file.Close())
+			source, err := block.NewLocal(sourcePath, header.RootfsBlockSize, uuid.New())
+			require.NoError(t, err)
+			defer source.Close()
+			destination := filepath.Join(dir, "disk")
+			sum, err := copyPreparedDisk(t.Context(), destination, source, size)
+			require.NoError(t, err)
+			actual, err := os.ReadFile(destination)
+			require.NoError(t, err)
+			require.Equal(t, original, actual)
+			digest := sha256.Sum256(original)
+			require.Equal(t, hex.EncodeToString(digest[:]), sum)
+			var stat unix.Stat_t
+			require.NoError(t, unix.Stat(destination, &stat))
+			require.Equal(t, size, stat.Size, "trailing zero blocks define the filesystem geometry")
+			require.Less(t, stat.Blocks*512, size/2, "free disk blocks must not allocate a second whole VM disk")
+		})
+	}
