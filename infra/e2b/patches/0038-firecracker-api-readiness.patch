+//go:build linux
+
+package fc
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"time"
+)
+
+var errFCAPIProcessExited = errors.New("firecracker exited before its API socket became ready")
+
+func waitForFCAPISocket(ctx context.Context, path string, exited <-chan struct{}) error {
+	var dialer net.Dialer
+	return waitForFCAPISocketWithDial(ctx, path, exited, dialer.DialContext)
+}
+
+// A Unix socket file appears at bind, before listen. Probe the FC listener without
+// sending a request; UFFD's separate, single-accept socket keeps its existing wait.
+func waitForFCAPISocketWithDial(
+	ctx context.Context,
+	path string,
+	exited <-chan struct{},
+	dial func(context.Context, string, string) (net.Conn, error),
+) error {
+	waitCtx, cancel := context.WithCancelCause(ctx)
+	defer cancel(nil)
+	go func() {
+		select {
+		case <-exited:
+			cancel(errFCAPIProcessExited)
+		case <-waitCtx.Done():
+		}
+	}()
+	cause := func() error {
+		select {
+		case <-exited:
+			return errFCAPIProcessExited
+		default:
+			return context.Cause(waitCtx)
+		}
+	}
+	failure := func(err error) error {
+		return fmt.Errorf("waiting for firecracker API socket %q: %w", path, err)
+	}
+	ticker := time.NewTicker(10 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		if err := cause(); err != nil {
+			return failure(err)
+		}
+		connection, err := dial(waitCtx, "unix", path)
+		if connection != nil {
+			_ = connection.Close()
+		}
+		if stopped := cause(); stopped != nil {
+			return failure(stopped)
+		}
+		if err == nil {
+			return nil
+		}
+		select {
+		case <-waitCtx.Done():
+			return failure(cause())
+		case <-ticker.C:
+		}
+	}
+}
