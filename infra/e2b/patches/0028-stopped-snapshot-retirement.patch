@@ -149,3 +149,24 @@
 	}
 	return tx.Commit(ctx)
 }
+
+// CleanupStoppedSnapshot removes the resume record only after the permanent
+// physical-stop receipt. Replays repair cleanup missed before an API restart.
+func (s Store) CleanupStoppedSnapshot(ctx context.Context, team uuid.UUID, sandboxID string) error {
+	db, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	state, err := db.LockExecutionFence(ctx, queries.LockExecutionFenceParams{TeamID: team, SandboxID: sandboxID})
+	if err != nil {
+		return err
+	}
+	if state != "stopped" {
+		return ErrFenced
+	}
+	if _, err := tx.Exec(ctx, "DELETE FROM public.snapshots WHERE team_id=$1 AND sandbox_id=$2", team, sandboxID); err != nil {
+		return err
+	}
+	return tx.Commit(ctx)
+}
