+// Routing credentials authorize the edge, never an application running in the guest.
+func stripApplicationIngressCredentials(r *http.Request, applicationTraffic bool) {
+	if !applicationTraffic {
+		return
+	}
+	for _, name := range []string{trafficAccessTokenHeader, "E2b-Sandbox-Id", "E2b-Sandbox-Port"} {
+		r.Header.Del(name)
+	}
+}
--- /dev/null
+++ b/packages/orchestrator/pkg/proxy/launchpad_ingress_credentials_test.go
@@ -0,0 +1,35 @@
+//go:build linux
+
+package proxy
+
+import (
+	"net/http"
+	"testing"
+)
+
+func TestApplicationIngressStripsEdgeCredentials(t *testing.T) {
+	for _, app := range []bool{true, false} {
+		r, err := http.NewRequest(http.MethodGet, "http://guest.test/", nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, name := range []string{trafficAccessTokenHeader, "E2b-Sandbox-Id", "E2b-Sandbox-Port"} {
+			r.Header.Set(name, "edge-secret")
+		}
+		r.Header.Set("Authorization", "app-auth")
+		r.Header.Set("Cookie", "app_session=app-cookie")
+		stripApplicationIngressCredentials(r, app)
+		for _, name := range []string{trafficAccessTokenHeader, "E2b-Sandbox-Id", "E2b-Sandbox-Port"} {
+			want := "edge-secret"
+			if app {
+				want = ""
+			}
+			if got := r.Header.Get(name); got != want {
+				t.Fatalf("edge header %s survived application boundary", name)
+			}
+		}
+		if r.Header.Get("Authorization") != "app-auth" || r.Header.Get("Cookie") != "app_session=app-cookie" {
+			t.Fatal("application credentials were changed")
+		}
+	}
+}
