+func TestExecutionRegistrationSerializesDifferentInitialIdentities(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	team := testutils.CreateTestTeam(t, db)
+	store := executions.Store{DB: db.SqlcClient}
+	first := queries.InsertExecutionAttemptParams{TeamID: team, SandboxID: uuid.NewString(), ExecutionID: uuid.New(), ClusterID: uuid.Nil, NodeID: "host"}
+	second := first
+	second.ExecutionID = uuid.New()
+	identities := []queries.InsertExecutionAttemptParams{first, second}
+	results := make([]error, len(identities))
+	ready := make(chan struct{})
+	var work sync.WaitGroup
+	for index := range identities {
+		work.Go(func() {
+			<-ready
+			results[index] = store.Register(t.Context(), identities[index], uuid.New(), true)
+		})
+	}
+	close(ready)
+	work.Wait()
+	winner := -1
+	for index, result := range results {
+		if result == nil {
+			require.Equal(t, -1, winner, "only one physical identity may win initial admission")
+			winner = index
+		} else {
+			require.ErrorIs(t, result, executions.ErrFenced)
+		}
+	}
+	require.NotEqual(t, -1, winner)
+	attempts, err := db.SqlcClient.ListExecutionAttempts(t.Context(), queries.ListExecutionAttemptsParams{TeamID: team, SandboxID: first.SandboxID})
+	require.NoError(t, err)
+	require.Len(t, attempts, 1)
+	require.Equal(t, identities[winner].ExecutionID, attempts[0].ExecutionID)
+}
+
+func TestExecutionRegistrationDoesNotInventOwnerForLegacyAttempts(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	team := testutils.CreateTestTeam(t, db)
+	store := executions.Store{DB: db.SqlcClient}
+	legacy := queries.InsertExecutionAttemptParams{TeamID: team, SandboxID: uuid.NewString(), ExecutionID: uuid.New(), ClusterID: uuid.Nil, NodeID: "legacy-host"}
+	require.NoError(t, db.SqlcClient.EnsureExecutionFence(t.Context(), queries.EnsureExecutionFenceParams{TeamID: team, SandboxID: legacy.SandboxID}))
+	require.NoError(t, db.SqlcClient.InsertExecutionAttempt(t.Context(), legacy))
+	for _, sameExecution := range []bool{false, true} {
+		next := legacy
+		next.NodeID = "new-host"
+		if !sameExecution {
+			next.ExecutionID = uuid.New()
+		}
+		require.ErrorIs(t, store.Register(t.Context(), next, uuid.New(), true), executions.ErrFenced, "an unknown legacy owner must not be backfilled on another host")
+	}
+	attempts, err := db.SqlcClient.ListExecutionAttempts(t.Context(), queries.ListExecutionAttemptsParams{TeamID: team, SandboxID: legacy.SandboxID})
+	require.NoError(t, err)
+	require.Len(t, attempts, 1)
+	require.Equal(t, legacy.ExecutionID, attempts[0].ExecutionID)
+}
