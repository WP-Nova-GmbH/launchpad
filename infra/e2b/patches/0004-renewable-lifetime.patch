+
+func TestRenewableLifetimeKeepsFiniteLeaseBeyondAbsoluteAge(t *testing.T) {
+	t.Parallel()
+	now := time.Unix(1800000000, 0)
+	sbx := sandbox.Sandbox{StartTime: now.Add(-48 * time.Hour), EndTime: now.Add(time.Minute), MaxInstanceLength: time.Hour, RenewableLifetime: true}
+	end, err := renewalEndTime(now, sbx, 10*time.Minute)
+	require.NoError(t, err)
+	require.Equal(t, now.Add(10*time.Minute), end)
+	end, err = renewalEndTime(now, sbx, 48*time.Hour)
+	require.NoError(t, err)
+	require.Equal(t, now.Add(time.Hour), end, "a renewable grant is still capped")
+	for _, duration := range []time.Duration{0, -time.Second} {
+		_, err = renewalEndTime(now, sbx, duration)
+		require.Error(t, err)
+	}
+	sbx.EndTime = now
+	_, err = renewalEndTime(now, sbx, time.Minute)
+	require.Error(t, err, "an elapsed finite lease cannot be revived")
+	sbx.EndTime = now.Add(time.Minute)
+	sbx.RenewableLifetime = false
+	_, err = renewalEndTime(now, sbx, time.Minute)
+	require.ErrorIs(t, err, errMaxInstanceLengthExceeded, "ordinary teams keep their absolute cap")
+}
+
+func TestRenewableLifetimeAdmissionAndPausePersistence(t *testing.T) {
+	for _, tc := range []struct {
+		name                             string
+		allow, resume, saved, fork, want bool
+	}{
+		{name: "ordinary metadata cannot opt in"},
+		{name: "operator grants new allocation", allow: true, want: true},
+		{name: "resume retains admission after allowlist removal", resume: true, saved: true, want: true},
+		{name: "fork cannot inherit exception", resume: true, saved: true, fork: true},
+		{name: "old snapshot stays bounded", resume: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			o := newCreateSandboxTestOrchestrator(t)
+			team := testTeam()
+			if tc.allow {
+				o.renewableLifetimeTeams = []string{team.ID.String()}
+			}
+			id := "lease-" + uuid.NewString()
