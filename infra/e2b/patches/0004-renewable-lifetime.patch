+package sandbox_catalog
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/redis/go-redis/v9"
+)
+
+var ErrRouteLeaseExpired = errors.New("sandbox route lease has expired")
+var ErrRouteLeaseStopped = errors.New("sandbox route execution has stopped")
+var ErrRouteLeaseSuperseded = errors.New("sandbox route lease revision was superseded")
+
+// A route may expire before an older, longer renewal reaches Redis. Keep its
+// execution/revision fence until the latest deadline ever issued by the owner,
+// independently of the current route TTL. A stopped execution can never publish
+// again; another execution cannot overwrite a still-owned route.
+var publishLease = redis.NewScript(`
+local clock = redis.call('TIME')
+local now = tonumber(clock[1]) * 1000 + math.floor(tonumber(clock[2]) / 1000)
+local ends = tonumber(ARGV[4])
+if ends <= now then return -2 end
+local fence = redis.call('HMGET', KEYS[2], 'revision', 'stopped', 'until', 'request')
+if fence[2] == '1' then return -1 end
+local revision = tonumber(ARGV[3])
+local previous = tonumber(fence[1] or '0')
+if previous > revision then return -3 end
+local request = ARGV[2] .. ':' .. ARGV[4] .. ':' .. ARGV[5]
+if previous == revision and fence[4] and fence[4] ~= request then
+ return redis.error_reply('route lease revision conflicts with its request')
+end
+local route = redis.call('GET', KEYS[1])
+if route then
+ local ok, info = pcall(cjson.decode, route)
+ if not (ok and type(info) == 'table' and type(info.execution_id) == 'string') then
+  return redis.error_reply('invalid sandbox route')
+ end
+ if (info.execution_id ~= ARGV[1] or info.lifecycle_id ~= ARGV[6]) then return 0 end
+end
+local untilAt = math.max(tonumber(ARGV[5]), tonumber(fence[3] or '0'))
+redis.call('HSET', KEYS[2], 'revision', ARGV[3], 'until', untilAt, 'request', request)
+redis.call('PEXPIREAT', KEYS[2], untilAt)
+redis.call('SET', KEYS[1], ARGV[2], 'PXAT', ends)
+return 1
+`)
+
+var stopLease = redis.NewScript(`
+local untilAt = math.max(tonumber(ARGV[2]), tonumber(redis.call('HGET', KEYS[2], 'until') or '0'))
+redis.call('HSET', KEYS[2], 'stopped', '1', 'until', untilAt)
+redis.call('PEXPIREAT', KEYS[2], untilAt)
+local route = redis.call('GET', KEYS[1])
+if route then
+ local ok, info = pcall(cjson.decode, route)
+ if not (ok and type(info) == 'table' and type(info.execution_id) == 'string') then
+  return redis.error_reply('invalid sandbox route')
+ end
+ if info.execution_id == ARGV[1] and info.lifecycle_id == ARGV[3] then redis.call('DEL', KEYS[1]) end
+end
+return 1
+`)
+
+func (c *RedisSandboxCatalog) leaseKeys(sandboxID, executionID, lifecycleID string) ([]string, error) {
+	if sandboxID == "" || executionID == "" || lifecycleID == "" || strings.ContainsAny(sandboxID+executionID+lifecycleID, "{}") {
+		return nil, errors.New("invalid sandbox route identity")
+	}
+	route := c.getCatalogKey(sandboxID)
+	// The untagged route key hashes as a whole. Using that same string inside
+	// braces makes both keys belong to the same slot on Redis Cluster.
+	return []string{route, c.keyPrefix + "lease:{" + route + "}:" + executionID + ":" + lifecycleID}, nil
+}
+
+// PublishLease is used only by a live execution's serialized routing owner.
+// revision increases for every changed deadline, and fenceUntil is the greatest
+// expiry it has ever issued (including requests whose response was lost).
+func (c *RedisSandboxCatalog) PublishLease(ctx context.Context, sandboxID string, info *SandboxInfo, revision int64, endAt, fenceUntil time.Time) error {
+	if info == nil || revision <= 0 || revision > 1<<53-1 || !endAt.After(time.UnixMilli(0)) || fenceUntil.Before(endAt) {
+		return errors.New("invalid sandbox route lease")
+	}
+	keys, err := c.leaseKeys(sandboxID, info.ExecutionID, info.LifecycleID)
+	if err != nil {
+		return err
+	}
+	data, err := json.Marshal(info)
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(ctx, catalogRedisTimeout)
+	defer cancel()
+	result, err := publishLease.Run(ctx, c.redisClient, keys, info.ExecutionID, data, revision, endAt.UnixMilli(), fenceUntil.UnixMilli(), info.LifecycleID).Int()
+	if err != nil {
+		return fmt.Errorf("publish sandbox route lease: %w", err)
+	}
+	switch result {
+	case 1:
+		return nil
+	case 0:
+		return ErrSandboxExecutionMismatch
+	case -1:
+		return ErrRouteLeaseStopped
+	case -2:
+		return ErrRouteLeaseExpired
+	case -3:
+		return ErrRouteLeaseSuperseded
+	default:
+		return errors.New("unexpected sandbox route lease result")
+	}
+}
+
+// StopLease revokes even an absent route, since a publish request with an unknown
+// outcome may still arrive. The fence expires only after every issued lease has.
+func (c *RedisSandboxCatalog) StopLease(ctx context.Context, sandboxID, executionID, lifecycleID string, fenceUntil time.Time) error {
+	keys, err := c.leaseKeys(sandboxID, executionID, lifecycleID)
+	if err != nil {
+		return err
+	}
+	if !fenceUntil.After(time.UnixMilli(0)) {
+		return errors.New("invalid route revocation deadline")
+	}
+	ctx, cancel := context.WithTimeout(ctx, catalogRedisTimeout)
+	defer cancel()
+	return stopLease.Run(ctx, c.redisClient, keys, executionID, fenceUntil.UnixMilli(), lifecycleID).Err()
+}
