+// Renewable lifetime removes only the absolute age clamp. Every grant remains
+// finite and bounded by the captured team limit; an elapsed lease cannot be revived.
+func renewalEndTime(now time.Time, sbx sandbox.Sandbox, duration time.Duration) (time.Time, error) {
+	if duration <= 0 || sbx.MaxInstanceLength <= 0 {
+		return time.Time{}, errMaxInstanceLengthExceeded
+	}
+	if sbx.RenewableLifetime {
+		if !now.Before(sbx.EndTime) {
+			return time.Time{}, errMaxInstanceLengthExceeded
+		}
+		return now.Add(min(duration, sbx.MaxInstanceLength)), nil
+	}
+	if now.Sub(sbx.StartTime) > sbx.MaxInstanceLength {
+		return time.Time{}, errMaxInstanceLengthExceeded
+	}
+	return now.Add(getMaxAllowedTTL(now, sbx.StartTime, duration, sbx.MaxInstanceLength)), nil
+}
