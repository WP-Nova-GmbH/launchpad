+// Run reconciles routes with one bounded host loop, not one goroutine per VM.
+func (p *Publisher) Run(ctx context.Context) error {
+	ticker := time.NewTicker(5 * time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return nil
+		case <-ticker.C:
+			p.refresh(ctx, p.now())
+		}
+	}
