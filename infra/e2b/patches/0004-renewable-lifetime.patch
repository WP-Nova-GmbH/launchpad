+package sandbox_catalog
+
+import (
+	"testing"
+	"time"
+
+	redis_utils "github.com/e2b-dev/infra/packages/shared/pkg/redis"
+	"github.com/stretchr/testify/require"
+)
+
+func TestRouteLeaseOrderingAndRevocation(t *testing.T) {
+	client := redis_utils.SetupInstance(t)
+	catalog := NewRedisSandboxRoutingCatalog(client)
+	ctx := t.Context()
+	now, err := client.Time(ctx).Result()
+	require.NoError(t, err)
+	later := now.Add(time.Hour)
+	shorter := now.Add(time.Minute)
+	old := leaseSandboxInfo("old", "node-1")
+	next := leaseSandboxInfo("next", "node-1")
+	const id = "renewable-routing"
+	require.NoError(t, catalog.PublishLease(ctx, id, old, 1, later, later))
+	require.NoError(t, catalog.PublishLease(ctx, id, old, 2, shorter, later))
+	require.ErrorIs(t, catalog.PublishLease(ctx, id, old, 1, later, later), ErrRouteLeaseSuperseded)
+	require.Error(t, catalog.PublishLease(ctx, id, old, 2, later, later), "same revision cannot change its deadline")
+	ttl, err := client.PTTL(ctx, catalog.getCatalogKey(id)).Result()
+	require.NoError(t, err)
+	require.LessOrEqual(t, ttl, time.Minute)
+	keys, err := catalog.leaseKeys(id, old.ExecutionID, old.LifecycleID)
+	require.NoError(t, err)
+	fenceTTL, err := client.PTTL(ctx, keys[1]).Result()
+	require.NoError(t, err)
+	require.Greater(t, fenceTTL, ttl, "the ordering fence outlives a shortened route")
+	// Simulate expiry of the shorter route. A delayed older grant still cannot
+	// recreate it, even though its own requested deadline is still in the future.
+	require.NoError(t, client.Del(ctx, catalog.getCatalogKey(id)).Err())
+	require.ErrorIs(t, catalog.PublishLease(ctx, id, old, 1, later, later), ErrRouteLeaseSuperseded)
+	require.NoError(t, catalog.PublishLease(ctx, id, old, 3, later, later), "a live owner can recover a lost route")
+	require.ErrorIs(t, catalog.PublishLease(ctx, id, next, 1, later, later), ErrSandboxExecutionMismatch)
+	require.NoError(t, catalog.StopLease(ctx, id, old.ExecutionID, old.LifecycleID, later))
+	require.ErrorIs(t, catalog.PublishLease(ctx, id, old, 4, later, later), ErrRouteLeaseStopped)
+	require.NoError(t, catalog.PublishLease(ctx, id, next, 1, later, later))
+	require.NoError(t, catalog.StopLease(ctx, id, old.ExecutionID, old.LifecycleID, later))
+	got, err := catalog.GetSandbox(ctx, id)
+	require.NoError(t, err)
+	require.Equal(t, next.ExecutionID, got.ExecutionID)
+	require.NoError(t, catalog.StopLease(ctx, id, next.ExecutionID, next.LifecycleID, later))
+	require.ErrorIs(t, catalog.PublishLease(ctx, id, old, 5, later, later), ErrRouteLeaseStopped)
+	require.ErrorIs(t, catalog.PublishLease(ctx, id, next, 2, later, later), ErrRouteLeaseStopped)
+}
+
+func TestRouteLeaseLostInitialPublishAndStop(t *testing.T) {
+	client := redis_utils.SetupInstance(t)
+	catalog := NewRedisSandboxRoutingCatalog(client)
+	ctx := t.Context()
+	now, err := client.Time(ctx).Result()
+	require.NoError(t, err)
+	end := now.Add(time.Minute)
+	info := leaseSandboxInfo("execution", "node-1")
+	require.NoError(t, catalog.StopLease(ctx, "never-published", info.ExecutionID, info.LifecycleID, end))
+	require.ErrorIs(t, catalog.PublishLease(ctx, "never-published", info, 1, end, end), ErrRouteLeaseStopped)
+	require.ErrorIs(t, catalog.PublishLease(ctx, "expired", info, 1, now.Add(-time.Second), end), ErrRouteLeaseExpired)
+	require.NoError(t, catalog.PublishLease(ctx, "retry", info, 1, end, end))
+	require.NoError(t, catalog.PublishLease(ctx, "retry", info, 1, end, end), "identical retry after a lost reply succeeds")
+	require.Error(t, catalog.PublishLease(ctx, "bad-revision", info, 0, end, end))
+	require.Error(t, catalog.PublishLease(ctx, "bad-fence", info, 1, end, now))
+}
+
+func leaseSandboxInfo(executionID, node string) *SandboxInfo {
+	info := testSandboxInfo(executionID, node)
+	info.LifecycleID = "lifecycle-" + executionID
+	return info
+}
+
+func TestRouteLeaseCheckpointKeepsExecutionWithNewLifecycle(t *testing.T) {
+	client := redis_utils.SetupInstance(t)
+	catalog := NewRedisSandboxRoutingCatalog(client)
+	ctx := t.Context()
+	now, err := client.Time(ctx).Result()
+	require.NoError(t, err)
+	end := now.Add(time.Hour)
+	old := leaseSandboxInfo("same-execution", "node-1")
+	replacement := leaseSandboxInfo("same-execution", "node-1")
+	replacement.LifecycleID = "checkpoint-replacement"
+	require.NoError(t, catalog.PublishLease(ctx, "checkpoint", old, 1, end, end))
+	require.NoError(t, catalog.StopLease(ctx, "checkpoint", old.ExecutionID, old.LifecycleID, end))
+	require.NoError(t, catalog.PublishLease(ctx, "checkpoint", replacement, 1, end, end))
+	require.NoError(t, catalog.StopLease(ctx, "checkpoint", old.ExecutionID, old.LifecycleID, end))
+	require.ErrorIs(t, catalog.PublishLease(ctx, "checkpoint", old, 2, end, end), ErrRouteLeaseStopped)
+	got, err := catalog.GetSandbox(ctx, "checkpoint")
+	require.NoError(t, err)
+	require.Equal(t, replacement.LifecycleID, got.LifecycleID)
+}
