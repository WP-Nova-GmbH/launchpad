+func TestLaunchpadRestoreWorkerReleasesOnlyConfirmedExpiredDestination(t *testing.T) {
+	t.Parallel()
+	for _, confirmed := range []bool{false, true} {
+		t.Run(fmt.Sprint(confirmed), func(t *testing.T) {
+			db := testutils.SetupDatabase(t)
+			p := restorePinFixture(t, db)
+			p.ClusterID = uuid.Nil
+			store := restorestore.Store{DB: db.SqlcClient}
+			_, err := store.Create(t.Context(), p, p.ReservedBytes)
+			require.NoError(t, err)
+			runtime := &restoreWorkerRuntime{}
+			server := &APIStore{sqlcDB: db.SqlcClient, restoreRuntimeOverride: runtime}
+			require.NoError(t, server.processRestoreOperation(t.Context(), claimRestoreWork(t, db)))
+			_, err = store.Activate(t.Context(), p.TeamID, p.OperationID)
+			require.NoError(t, err)
+			claimed := claimRestoreWork(t, db)
+			_, err = store.SaveActivationRequest(t.Context(), claimed, []byte(`{"sandbox":{}}`))
+			require.NoError(t, err)
+			runtime.activationError = status.Error(codes.FailedPrecondition, "restore boot outcome requires reconciliation")
+			if confirmed {
+				runtime.activationError = restoreresult.Expired(p.PreparedBuildID.String())
+			}
+			err = server.processRestoreOperation(t.Context(), claimed)
+			if confirmed {
+				require.NoError(t, err)
+			} else {
+				require.Error(t, err)
+			}
+			finished, err := db.SqlcClient.GetRestoreOperation(t.Context(), queries.GetRestoreOperationParams{TeamID: p.TeamID, OperationID: p.OperationID})
+			require.NoError(t, err)
+			pinned, err := db.SqlcClient.HasRestoreBuildPins(t.Context(), p.SourceBuildID)
+			require.NoError(t, err)
+			require.Zero(t, runtime.boots)
+			if !confirmed {
+				require.Equal(t, "activating", finished.State)
+				require.Positive(t, finished.ReservedBytes)
+				require.True(t, pinned)
+				return
+			}
+			require.Equal(t, "failed", finished.State)
+			require.Zero(t, finished.ReservedBytes)
+			require.False(t, pinned)
+			require.NotNil(t, finished.LastError)
+			require.Contains(t, *finished.LastError, "expired before guest start")
+			_, err = store.Activate(t.Context(), p.TeamID, p.OperationID)
+			require.ErrorIs(t, err, restorestore.ErrConflict)
+			// New admission is possible after cleanup; the original operation remains a
+			// terminal idempotency record and cannot be resurrected by a retry.
+			retried, err := store.Create(t.Context(), p, p.ReservedBytes)
+			require.NoError(t, err)
+			require.Equal(t, "failed", retried.State)
+		})
+	}
+}
