+func TestRestoreLeaseExpiryDoesNotRetireAnUncertainOrActiveGuest(t *testing.T) {
+	t.Parallel()
+	for _, active := range []bool{false, true} {
+		directory, id, digest := activationFixture(t, []byte(`{"version":1}`))
+		lock, err := LockRestoreActivation(t.Context(), directory, id, digest, []byte("fixed request"))
+		require.NoError(t, err)
+		require.NoError(t, lock.BeginBoot())
+		if active {
+			require.NoError(t, lock.Complete(json.RawMessage(`{"ready":true}`)))
+		}
+		require.NoError(t, lock.CheckDeadline(time.Now().Add(-time.Hour), time.Now()))
+		require.ErrorIs(t, lock.DiscardExpired(t.Context(), nil), ErrRestoreActivationStarted)
+		require.ErrorIs(t, lock.BeginBoot(), ErrRestoreActivationStarted)
+		require.NoError(t, lock.Close())
+	}
+}
