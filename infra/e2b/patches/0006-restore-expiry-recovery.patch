+// CheckDeadline may reject only an attempt whose durable boot intent has never
+// landed. A retry of booting/active must reconcile even after its original lease
+// ends; expiry alone does not prove that the earlier guest stopped.
+func (h *RestoreActivationLock) CheckDeadline(endAt, now time.Time) error {
+	if h.lock == nil {
+		return ErrPreparedDiskBusy
+	}
+	if h.record.State == "expired" {
+		return ErrRestoreActivationExpired
+	}
+	if h.record.State != "accepted" || endAt.After(now) {
+		return nil
+	}
+	h.record.State = "expired"
+	if err := h.persist(); err != nil {
+		return err
+	}
+	return ErrRestoreActivationExpired
+}
+
+// DiscardExpired removes only this never-started destination. The small receipt
+// remains as a permanent fence against delayed activation and ordinary Create.
+// Cleanup failures are retryable and must retain the control-plane reservation.
+func (h *RestoreActivationLock) DiscardExpired(ctx context.Context, store storage.StorageProvider) error {
+	if h.lock == nil || h.record.State != "expired" {
+		return ErrRestoreActivationStarted
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if err := store.DeleteObjectsWithPrefix(ctx, h.buildID.String()+"/"); err != nil {
+		return err
+	}
+	if err := os.RemoveAll(filepath.Join(h.directory, h.buildID.String())); err != nil {
+		return err
+	}
+	return syncPreparedDirectory(h.directory)
+}
