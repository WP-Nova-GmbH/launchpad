diff --git a/packages/shared/pkg/restoreresult/expired.go b/packages/shared/pkg/restoreresult/expired.go
new file mode 100644
--- /dev/null
+++ b/packages/shared/pkg/restoreresult/expired.go
@@ -0,0 +1,37 @@
+// Package restoreresult carries authoritative restore outcomes across gRPC.
+package restoreresult
+
+import (
+	"google.golang.org/genproto/googleapis/rpc/errdetails"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+const domain = "launchpad.e2b.restore"
+const expired = "ACTIVATION_EXPIRED_BEFORE_START"
+
+// Expired is emitted only after the host has persisted a never-started fence
+// and removed that destination's temporary and published disk objects.
+func Expired(buildID string) error {
+	s, err := status.New(codes.FailedPrecondition, "restore activation expired before guest start; destination cleaned").WithDetails(
+		&errdetails.ErrorInfo{Domain: domain, Reason: expired, Metadata: map[string]string{"prepared_build_id": buildID}},
+	)
+	if err != nil {
+		return err
+	}
+	return s.Err()
+}
+
+func IsExpired(err error, buildID string) bool {
+	s, ok := status.FromError(err)
+	if !ok || s.Code() != codes.FailedPrecondition {
+		return false
+	}
+	for _, detail := range s.Details() {
+		info, ok := detail.(*errdetails.ErrorInfo)
+		if ok && info.Domain == domain && info.Reason == expired && info.Metadata["prepared_build_id"] == buildID {
+			return true
+		}
+	}
+	return false
+}
diff --git a/packages/shared/pkg/restoreresult/expired_test.go b/packages/shared/pkg/restoreresult/expired_test.go
new file mode 100644
--- /dev/null
+++ b/packages/shared/pkg/restoreresult/expired_test.go
@@ -0,0 +1,22 @@
+package restoreresult
+
+import (
+	"fmt"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"testing"
+)
+
+func TestExpiredResultRequiresStructuredMatchingIdentity(t *testing.T) {
+	t.Parallel()
+	original := Expired("assigned-build")
+	// Exercise the protobuf transport representation, not error string matching.
+	transported := status.ErrorProto(status.Convert(original).Proto())
+	require.True(t, IsExpired(transported, "assigned-build"))
+	require.True(t, IsExpired(fmt.Errorf("activate: %w", transported), "assigned-build"))
+	require.False(t, IsExpired(transported, "other-build"))
+	require.False(t, IsExpired(status.Error(codes.FailedPrecondition, status.Convert(original).Message()), "assigned-build"))
+	require.False(t, IsExpired(status.Error(codes.DeadlineExceeded, "reply lost"), "assigned-build"))
+	require.False(t, IsExpired(nil, "assigned-build"))
+}
