+func TestRestoreExpiryFencesDelayedBootAndRetriesCleanup(t *testing.T) {
+	t.Parallel()
+	directory, id, digest := activationFixture(t, []byte(`{"version":1}`))
+	store, err := storage.NewProvider(t.Context(), storage.Spec{Provider: storage.LocalStorageProvider, BasePath: t.TempDir()})
+	require.NoError(t, err)
+	// Preserve an unrelated recovery build while removing all published objects
+	// of this failed destination, including a partially completed publication.
+	sourcePath := storage.Paths{BuildID: uuid.NewString()}.Rootfs()
+	source, err := store.OpenBlob(t.Context(), sourcePath)
+	require.NoError(t, err)
+	require.NoError(t, source.Put(t.Context(), []byte("recovery disk")))
+	destination, err := store.OpenBlob(t.Context(), storage.Paths{BuildID: id.String()}.Rootfs())
+	require.NoError(t, err)
+	require.NoError(t, destination.Put(t.Context(), []byte("partial destination")))
+	lock, err := LockRestoreActivation(t.Context(), directory, id, digest, []byte("fixed request"))
+	require.NoError(t, err)
+	now := time.Now()
+	require.NoError(t, lock.CheckDeadline(now.Add(time.Second), now))
+	require.Equal(t, "accepted", lock.Record().State)
+	require.ErrorIs(t, lock.DiscardExpired(t.Context(), store), ErrRestoreActivationStarted)
+	require.ErrorIs(t, lock.CheckDeadline(now, now), ErrRestoreActivationExpired)
+	require.ErrorIs(t, lock.BeginBoot(), ErrRestoreActivationStarted)
+	require.ErrorIs(t, lock.Complete(json.RawMessage(`{"ready":true}`)), ErrPreparedDiskConflict)
+	require.NoError(t, lock.Close())
+	// Losing the reply, restarting the process, or moving the wall clock back
+	// cannot turn a persisted expiry into permission to boot.
+	retry, err := LockRestoreActivation(t.Context(), directory, id, digest, []byte("fixed request"))
+	require.NoError(t, err)
+	require.ErrorIs(t, retry.CheckDeadline(now.Add(time.Hour), now), ErrRestoreActivationExpired)
+	broken := &expiryDeleteFailure{StorageProvider: store}
+	require.Error(t, retry.DiscardExpired(t.Context(), broken))
+	_, err = os.Stat(filepath.Join(directory, id.String()))
+	require.NoError(t, err)
+	for range 2 {
+		require.NoError(t, retry.DiscardExpired(t.Context(), store))
+	}
+	require.NoError(t, retry.Close())
+	_, err = os.Stat(filepath.Join(directory, id.String()))
+	require.ErrorIs(t, err, os.ErrNotExist)
+	exists, err := destination.Exists(t.Context())
+	require.NoError(t, err)
+	require.False(t, exists)
+	exists, err = source.Exists(t.Context())
+	require.NoError(t, err)
+	require.True(t, exists)
+	require.ErrorIs(t, RequireActivatedBuild(directory, id), ErrRestoreActivationStarted)
+	require.ErrorIs(t, ReleaseActivatedDisk(t.Context(), directory, id), ErrRestoreActivationStarted)
+	final, err := LockRestoreActivation(t.Context(), directory, id, digest, []byte("fixed request"))
+	require.NoError(t, err)
+	defer final.Close()
+	require.Equal(t, "expired", final.Record().State)
+	require.ErrorIs(t, final.BeginBoot(), ErrRestoreActivationStarted)
+}
+
+type expiryDeleteFailure struct{ storage.StorageProvider }
+
+func (*expiryDeleteFailure) DeleteObjectsWithPrefix(context.Context, string) error {
+	return errors.New("storage unavailable")
+}
