+package restoreresult
+
+import (
+	"google.golang.org/genproto/googleapis/rpc/errdetails"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+const stopped = "ACTIVATION_EXECUTION_PHYSICALLY_STOPPED"
+
+// Stopped is emitted only after the exact host execution has a permanent stop
+// fence and the immutable activation receipt has retained that outcome.
+func Stopped(buildID string) error {
+	s, err := status.New(codes.FailedPrecondition, "restore execution physically stopped; destination cleaned").WithDetails(
+		&errdetails.ErrorInfo{Domain: domain, Reason: stopped, Metadata: map[string]string{"prepared_build_id": buildID}},
+	)
+	if err != nil {
+		return err
+	}
+	return s.Err()
+}
+
+func IsStopped(err error, buildID string) bool {
+	s, ok := status.FromError(err)
+	if !ok || s.Code() != codes.FailedPrecondition {
+		return false
+	}
+	for _, detail := range s.Details() {
+		info, ok := detail.(*errdetails.ErrorInfo)
+		if ok && info.Domain == domain && info.Reason == stopped && info.Metadata["prepared_build_id"] == buildID {
+			return true
+		}
+	}
+	return false
+}
