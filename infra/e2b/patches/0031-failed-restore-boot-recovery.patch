+func (s *Server) retireUnregisteredRestore(ctx context.Context, activation *rootfs.RestoreActivationLock, id uuid.UUID, config *orchestrator.SandboxConfig) error {
+	if activation.Record().State != "booting" {
+		return rootfs.ErrRestoreActivationStarted
+	}
+	receipt, err := s.StopExecution(ctx, &orchestrator.StopExecutionRequest{
+		TeamId: config.GetTeamId(), SandboxId: config.GetSandboxId(), ExecutionId: config.GetExecutionId(), RegisteredBeforeStart: true,
+	})
+	if err != nil {
+		return err
+	}
+	if !receipt.GetPhysicallyStopped() || receipt.GetTeamId() != config.GetTeamId() || receipt.GetSandboxId() != config.GetSandboxId() || receipt.GetExecutionId() != config.GetExecutionId() {
+		return status.Error(codes.FailedPrecondition, "restore execution stop is unconfirmed")
+	}
+	if err := activation.DiscardStopped(ctx); err != nil {
+		return restoreDiskError(err)
+	}
+	return restoreresult.Stopped(id.String())
+}
+
 func (s *Server) restoreActivationFailure(ctx context.Context, activation *rootfs.RestoreActivationLock, id uuid.UUID, err error) error {
+	if errors.Is(err, rootfs.ErrRestoreActivationStopped) {
+		return restoreresult.Stopped(id.String())
+	}
 	if !errors.Is(err, rootfs.ErrRestoreActivationExpired) {
 		return err
 	}
