+func TestRestoreUnregisteredBootRetiresExactExecutionAndKeepsSource(t *testing.T) {
+	server := &Server{info: &service.ServiceInfo{}}
+	server.config.RestorePreparationEnabled = true
+	server.config.LaunchpadRequireExecutionFence = true
+	server.config.OrchestratorBaseDir = t.TempDir()
+	id := uuid.New()
+	config := &orchestrator.SandboxConfig{BuildId: id.String(), TeamId: uuid.NewString(), SandboxId: "failed-start", ExecutionId: uuid.NewString()}
+	directory, err := server.restoreDiskDirectory()
+	require.NoError(t, err)
+	require.NoError(t, os.MkdirAll(directory, 0o700))
+	source := filepath.Join(directory, "saved-source")
+	require.NoError(t, os.WriteFile(source, []byte("keep this saved disk"), 0o600))
+	disk := filepath.Join(directory, id.String())
+	require.NoError(t, os.Mkdir(disk, 0o700))
+	digest := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
+	request := []byte("bound immutable request")
+	sum := sha256.Sum256(append([]byte(digest), request...))
+	raw, err := json.Marshal(rootfs.RestoreActivation{Version: 1, RequestSHA256: hex.EncodeToString(sum[:]), State: "booting"})
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(filepath.Join(directory, id.String()+".activation.json"), raw, 0o600))
+	activation, err := rootfs.LockRestoreActivation(t.Context(), directory, id, digest, request)
+	require.NoError(t, err)
+	server.config.LaunchpadRequireExecutionFence = false
+	err = server.retireUnregisteredRestore(t.Context(), activation, id, config)
+	require.False(t, restoreresult.IsStopped(err, id.String()))
+	require.Equal(t, "booting", activation.Record().State)
+	_, statErr := os.Stat(disk)
+	require.NoError(t, statErr)
+	server.config.LaunchpadRequireExecutionFence = true
+	err = server.retireUnregisteredRestore(t.Context(), activation, id, config)
+	require.True(t, restoreresult.IsStopped(err, id.String()))
+	require.Equal(t, "stopped", activation.Record().State)
+	require.NoError(t, activation.Close())
+	_, err = os.Stat(disk)
+	require.ErrorIs(t, err, os.ErrNotExist)
+	retained, err := os.ReadFile(source)
+	require.NoError(t, err)
+	require.Equal(t, "keep this saved disk", string(retained))
+	activation, err = rootfs.LockRestoreActivation(t.Context(), directory, id, digest, request)
+	require.NoError(t, err)
+	defer activation.Close()
+	require.ErrorIs(t, activation.BeginBoot(), rootfs.ErrRestoreActivationStarted)
+	require.True(t, restoreresult.IsStopped(server.restoreActivationFailure(t.Context(), activation, id, activation.CheckDeadline(time.Now(), time.Now())), id.String()))
+}
