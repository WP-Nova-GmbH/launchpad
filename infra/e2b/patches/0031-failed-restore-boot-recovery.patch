+func TestRestoreUnregisteredRecoveryCannotRetireActiveOrAcceptedReceipt(t *testing.T) {
+	for _, state := range []string{"accepted", "active"} {
+		t.Run(state, func(t *testing.T) {
+			server := &Server{info: &service.ServiceInfo{}}
+			server.config.RestorePreparationEnabled = true
+			server.config.OrchestratorBaseDir = t.TempDir()
+			directory, err := server.restoreDiskDirectory()
+			require.NoError(t, err)
+			require.NoError(t, os.MkdirAll(directory, 0o700))
+			id := uuid.New()
+			digest := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
+			request := []byte("bound request")
+			sum := sha256.Sum256(append([]byte(digest), request...))
+			record := rootfs.RestoreActivation{Version: 1, RequestSHA256: hex.EncodeToString(sum[:]), State: state}
+			if state == "active" {
+				record.Response = json.RawMessage(`{}`)
+			}
+			raw, err := json.Marshal(record)
+			require.NoError(t, err)
+			require.NoError(t, os.WriteFile(filepath.Join(directory, id.String()+".activation.json"), raw, 0o600))
+			activation, err := rootfs.LockRestoreActivation(t.Context(), directory, id, digest, request)
+			require.NoError(t, err)
+			defer activation.Close()
+			require.ErrorIs(t, server.retireUnregisteredRestore(t.Context(), activation, id, &orchestrator.SandboxConfig{}), rootfs.ErrRestoreActivationStarted)
+			require.Equal(t, state, activation.Record().State)
+		})
+	}
+}
