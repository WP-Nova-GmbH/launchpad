+func TestStoppedResultRequiresStructuredMatchingIdentity(t *testing.T) {
+	t.Parallel()
+	original := Stopped("assigned-build")
+	transported := status.ErrorProto(status.Convert(original).Proto())
+	require.True(t, IsStopped(transported, "assigned-build"))
+	require.True(t, IsStopped(fmt.Errorf("activate: %w", transported), "assigned-build"))
+	require.False(t, IsStopped(transported, "other-build"))
+	require.False(t, IsStopped(status.Error(codes.FailedPrecondition, status.Convert(original).Message()), "assigned-build"))
+	require.False(t, IsStopped(status.Error(codes.DeadlineExceeded, "reply lost"), "assigned-build"))
+	require.False(t, IsStopped(Expired("assigned-build"), "assigned-build"))
+	require.False(t, IsStopped(nil, "assigned-build"))
+}
