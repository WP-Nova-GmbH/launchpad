+func TestLaunchpadRestoreWorkerAcceptsOnlyBoundStoppedOutcome(t *testing.T) {
+	for _, kind := range []string{"matching", "foreign-build", "unstructured", "lost-reply"} {
+		t.Run(kind, func(t *testing.T) {
+			t.Parallel()
+			db := testutils.SetupDatabase(t)
+			p := restorePinFixture(t, db)
+			p.ClusterID = uuid.Nil
+			store := restorestore.Store{DB: db.SqlcClient}
+			_, err := store.Create(t.Context(), p, p.ReservedBytes)
+			require.NoError(t, err)
+			runtime := &restoreWorkerRuntime{}
+			runtime.activationOutcome = func(ctx context.Context, op queries.SandboxRestoreOperation) error {
+				switch kind {
+				case "matching":
+					// This mock host outcome represents an already saved exact stop receipt.
+					require.NoError(t, db.SqlcClient.TestsRawSQL(ctx, "INSERT INTO sandbox_execution_fences(team_id,sandbox_id,state) VALUES($1,$2,'stopped')", op.TeamID, op.SandboxID))
+					return restoreresult.Stopped(op.PreparedBuildID.String())
+				case "foreign-build":
+					return restoreresult.Stopped(uuid.NewString())
+				case "unstructured":
+					return status.Error(codes.FailedPrecondition, "restore execution physically stopped; destination cleaned")
+				default:
+					return status.Error(codes.DeadlineExceeded, "activation response lost")
+				}
+			}
+			server := &APIStore{sqlcDB: db.SqlcClient, restoreRuntimeOverride: runtime, authService: fakeAPIKeyAuthService{team: &authtypes.Team{Limits: &authtypes.TeamLimits{SandboxConcurrency: 3}}}}
+			require.NoError(t, server.processRestoreOperation(t.Context(), claimRestoreWork(t, db)))
+			_, err = store.Activate(t.Context(), p.TeamID, p.OperationID)
+			require.NoError(t, err)
+			activation := claimRestoreWork(t, db)
+			_, err = store.SaveActivationRequest(t.Context(), activation, []byte(`{"sandbox":{}}`))
+			require.NoError(t, err)
+			err = server.processRestoreOperation(t.Context(), activation)
+			row, getErr := db.SqlcClient.GetRestoreOperation(t.Context(), queries.GetRestoreOperationParams{TeamID: p.TeamID, OperationID: p.OperationID})
+			require.NoError(t, getErr)
+			if kind == "matching" {
+				require.NoError(t, err)
+				require.Equal(t, "failed", row.State)
+				require.Zero(t, row.ReservedBytes)
+				require.True(t, runtime.discardedStopped)
