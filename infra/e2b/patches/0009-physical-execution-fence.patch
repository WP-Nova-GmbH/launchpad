+//go:build linux
+
+package sandbox
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/cfg"
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox/cgroup"
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox/execution"
+	"github.com/e2b-dev/infra/packages/shared/pkg/sandboxtypes"
+)
+
+// ExecutionStore is shared by startup and the stop RPC. Its directory must be
+// persistent and must not live in the disposable template/build cache.
+func ExecutionStore(config cfg.BuilderConfig) (*execution.Store, error) {
+	if !config.LaunchpadRequireExecutionFence {
+		return nil, errors.New("physical execution fencing is disabled")
+	}
+	bootID, err := os.ReadFile("/proc/sys/kernel/random/boot_id")
+	if err != nil {
+		return nil, err
+	}
+	return execution.New(filepath.Join(config.OrchestratorBaseDir, "executions"), strings.TrimSpace(string(bootID)), cgroup.KillExisting)
+}
+
+func (f *Factory) reserveExecution(runtime sandboxtypes.RuntimeMetadata, group string) (*execution.Reservation, error) {
+	if !f.config.LaunchpadRequireExecutionFence {
+		return nil, nil
+	}
+	store, err := ExecutionStore(f.config)
+	if err != nil {
+		return nil, err
+	}
+	return store.Reserve(execution.Identity{TeamID: runtime.TeamID, SandboxID: runtime.SandboxID, ExecutionID: runtime.ExecutionID}, group)
+}
+
+// Startup cleanup must run even if the request was canceled. Abort keeps the
+// record uncertain when physical cleanup cannot be established.
+func abortExecution(ctx context.Context, reservation *execution.Reservation) error {
+	if reservation == nil {
+		return nil
+	}
+	cleanupCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 10*time.Second)
+	defer cancel()
+	return reservation.Abort(cleanupCtx)
+}
