+// Package executions records every possible host before a managed VM can boot.
+// Routing/Redis expiry never erases the identities needed to stop that VM.
+package executions
+
+import (
+	"context"
+	"errors"
+	"github.com/e2b-dev/infra/packages/db/client"
+	"github.com/e2b-dev/infra/packages/db/queries"
+	"github.com/google/uuid"
+)
+
+var ErrFenced = errors.New("sandbox execution is permanently fenced")
+
+type Store struct{ DB *client.Client }
+
+func (s Store) Register(ctx context.Context, p queries.InsertExecutionAttemptParams) error {
+	if p.TeamID == uuid.Nil || p.ExecutionID == uuid.Nil || p.SandboxID == "" || p.NodeID == "" {
+		return errors.New("invalid execution identity")
+	}
+	db, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	if err := db.EnsureExecutionFence(ctx, queries.EnsureExecutionFenceParams{TeamID: p.TeamID, SandboxID: p.SandboxID}); err != nil {
+		return err
+	}
+	state, err := db.LockExecutionFence(ctx, queries.LockExecutionFenceParams{TeamID: p.TeamID, SandboxID: p.SandboxID})
+	if err != nil {
+		return err
+	}
+	if state != "active" {
+		return ErrFenced
+	}
+	if err := db.InsertExecutionAttempt(ctx, p); err != nil {
+		return err
+	}
+	return tx.Commit(ctx)
+}
+
+func (s Store) BeginStop(ctx context.Context, team uuid.UUID, sandboxID string) ([]queries.SandboxExecutionAttempt, error) {
+	db, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	// Unknown/legacy executions never become a false successful stop. Only
+	// registrations made before fenced-runtime RPCs are eligible here.
+	if _, err := db.LockExecutionFence(ctx, queries.LockExecutionFenceParams{TeamID: team, SandboxID: sandboxID}); err != nil {
+		return nil, err
+	}
+	if err := db.FenceSandboxExecution(ctx, queries.FenceSandboxExecutionParams{TeamID: team, SandboxID: sandboxID}); err != nil {
+		return nil, err
+	}
+	attempts, err := db.ListExecutionAttempts(ctx, queries.ListExecutionAttemptsParams{TeamID: team, SandboxID: sandboxID})
+	if err != nil {
+		return nil, err
+	}
+	if len(attempts) == 0 {
+		return nil, errors.New("execution registry contains no physical identities")
+	}
+	if err := tx.Commit(ctx); err != nil {
+		return nil, err
+	}
+	return attempts, nil
+}
+
+// Publish holds the same admission lock until the routing record is installed.
+// Stop therefore either rejects a late publication or observes and removes it.
+func (s Store) Publish(ctx context.Context, team uuid.UUID, sandboxID string, publish func() error) error {
+	db, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	state, err := db.LockExecutionFence(ctx, queries.LockExecutionFenceParams{TeamID: team, SandboxID: sandboxID})
+	if err != nil {
+		return err
+	}
+	if state != "active" {
+		return ErrFenced
+	}
+	if err := publish(); err != nil {
+		return err
+	}
+	return tx.Commit(ctx)
+}
