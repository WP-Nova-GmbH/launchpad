+// Package execution records the physical identity needed to stop a VM after
+// its orchestrator restarts. A missing API route is never a stop receipt.
+package execution
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+var ErrAlreadyReserved = errors.New("execution identity has already been reserved")
+var identifier = regexp.MustCompile(`^[a-zA-Z0-9-]{1,128}$`)
+
+type Identity struct {
+	TeamID      string `json:"teamId"`
+	SandboxID   string `json:"sandboxId"`
+	ExecutionID string `json:"executionId"`
+}
+
+type Record struct {
+	Version int `json:"version"`
+	Identity
+	Groups []Group `json:"groups"`
+	State  string  `json:"state"`
+}
+
+type Group struct {
+	CgroupName string `json:"cgroupName"`
+	BootID     string `json:"bootId"`
+}
+
+type Store struct {
+	directory string
+	bootID    string
+	killGroup func(context.Context, string) error
+}
+
+// New requires a real kernel boot identity and a cgroup killer that waits for
+// populated=0. It must not be supplied with the optional accounting noop.
+func New(directory, bootID string, killGroup func(context.Context, string) error) (*Store, error) {
+	if !identifier.MatchString(bootID) || killGroup == nil {
+		return nil, errors.New("physical execution tracking requires boot identity and cgroup enforcement")
+	}
+	if err := os.MkdirAll(directory, 0700); err != nil {
+		return nil, err
+	}
+	return &Store{directory: directory, bootID: bootID, killGroup: killGroup}, nil
+}
+
+func (s *Store) lock(id Identity) (*os.File, error) {
+	if !identifier.MatchString(id.TeamID) || !identifier.MatchString(id.SandboxID) || !identifier.MatchString(id.ExecutionID) {
+		return nil, errors.New("invalid physical execution identity")
+	}
+	file, err := os.OpenFile(filepath.Join(s.directory, id.ExecutionID+".lock"), os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		return nil, err
+	}
+	if err := unix.Flock(int(file.Fd()), unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		file.Close()
+		return nil, err
+	}
+	return file, nil
+}
+func unlock(file *os.File) { _ = unix.Flock(int(file.Fd()), unix.LOCK_UN); _ = file.Close() }
+func (s *Store) read(id Identity) (Record, error) {
+	var record Record
+	data, err := os.ReadFile(filepath.Join(s.directory, id.ExecutionID+".json"))
+	if err != nil {
+		return record, err
+	}
+	if err := json.Unmarshal(data, &record); err != nil {
+		return record, err
+	}
+	if record.Version != 1 || record.Identity != id || (len(record.Groups) == 0 && record.State != "stopped") ||
+		(record.State != "reserved" && record.State != "running" && record.State != "stopping" && record.State != "stopped") {
+		return record, errors.New("physical execution record is invalid or belongs to another owner")
+	}
+	seen := make(map[string]bool)
+	for _, group := range record.Groups {
+		if !identifier.MatchString(group.BootID) || !strings.HasPrefix(group.CgroupName, "sbx-"+id.SandboxID+"-") || !identifier.MatchString(group.CgroupName) || seen[group.CgroupName] {
+			return record, errors.New("invalid or duplicated physical execution cgroup")
+		}
+		seen[group.CgroupName] = true
+	}
+	return record, nil
+}
+func (s *Store) save(record Record) error {
+	data, err := json.Marshal(record)
+	if err != nil {
+		return err
+	}
+	file, err := os.CreateTemp(s.directory, record.ExecutionID+".pending-")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(file.Name())
+	defer file.Close()
+	if _, err := file.Write(data); err != nil {
+		return err
+	}
+	if err := file.Sync(); err != nil {
+		return err
+	}
+	if err := file.Close(); err != nil {
+		return err
+	}
+	if err := os.Rename(file.Name(), filepath.Join(s.directory, record.ExecutionID+".json")); err != nil {
+		return err
+	}
+	directory, err := os.Open(s.directory)
+	if err != nil {
+		return err
+	}
+	defer directory.Close()
+	return directory.Sync()
+}
+
+type Reservation struct {
+	store  *Store
+	record Record
+	lock   *os.File
+}
+
+// Reserve persists intent and holds the cross-process lock before cgroup
+// creation/clone. Call Commit after startup, or Abort on every failure. All
+// Firecracker processes must enter this recorded cgroup atomically at clone.
+func (s *Store) Reserve(id Identity, cgroupName string) (*Reservation, error) {
+	if !strings.HasPrefix(cgroupName, "sbx-"+id.SandboxID+"-") || !identifier.MatchString(cgroupName) {
+		return nil, errors.New("invalid execution cgroup")
+	}
+	lock, err := s.lock(id)
+	if err != nil {
+		return nil, err
+	}
+	record, err := s.read(id)
+	if err != nil && !os.IsNotExist(err) {
+		unlock(lock)
+		return nil, err
+	}
+	if os.IsNotExist(err) {
+		record = Record{Version: 1, Identity: id, State: "running"}
+	}
+	if record.State != "running" {
+		unlock(lock)
+		return nil, ErrAlreadyReserved
+	}
+	for _, group := range record.Groups {
+		if group.CgroupName == cgroupName {
+			unlock(lock)
+			return nil, ErrAlreadyReserved
+		}
+	}
+	record.Groups = append(record.Groups, Group{CgroupName: cgroupName, BootID: s.bootID})
+	record.State = "reserved"
+	if err := s.save(record); err != nil {
+		unlock(lock)
+		return nil, err
+	}
+	return &Reservation{store: s, record: record, lock: lock}, nil
+}
+func (r *Reservation) Commit() error {
+	if r.lock == nil {
+		return errors.New("execution reservation already released")
+	}
+	record := r.record
+	record.State = "running"
+	if err := r.store.save(record); err != nil {
+		return err
+	}
+	r.record = record
+	unlock(r.lock)
+	r.lock = nil
+	return nil
+}
+
+// Abort never publishes a stop receipt until the cgroup is empty. On failure
+// the durable reservation survives for reconciliation by this exact identity.
+func (r *Reservation) Abort(ctx context.Context) error {
+	if r.lock == nil {
+		return nil
+	}
+	defer func() { unlock(r.lock); r.lock = nil }()
+	group := r.record.Groups[len(r.record.Groups)-1]
+	if err := r.store.killGroup(ctx, group.CgroupName); err != nil {
+		return err
+	}
+	// Startup cleanup only stops this attempted lifecycle. A checkpoint may
+	// have another live lifecycle under the same execution identity.
+	record := r.record
+	record.State = "running"
+	return r.store.save(record)
+}
+func (s *Store) stop(ctx context.Context, record Record) (Record, error) {
+	if record.State == "stopped" {
+		return record, nil
+	}
+	// Fence future checkpoint/recovery clones before touching processes. A failed
+	// kill must never reopen admission while a caller retries termination.
+	if record.State != "stopping" {
+		record.State = "stopping"
+		if err := s.save(record); err != nil {
+			return record, err
+		}
+	}
+	// A different kernel boot proves the original execution cannot still run.
+	// Never kill a possibly reused cgroup on the new boot.
+	for _, group := range record.Groups {
+		if group.BootID == s.bootID {
+			if err := s.killGroup(ctx, group.CgroupName); err != nil {
+				return record, fmt.Errorf("physical execution is not confirmed stopped: %w", err)
+			}
+		}
+	}
+	record.State = "stopped"
+	if err := s.save(record); err != nil {
+		return record, err
+	}
+	return record, nil
+}
+func (s *Store) Stop(ctx context.Context, id Identity) (Record, error) {
+	return s.stopIdentity(ctx, id, false)
+}
+
+// StopRegistered is only for API registry entries durably inserted before a
+// fenced-runtime create RPC. Missing here means that clone has not passed its
+// reservation yet; publishing the tombstone under the same lock prevents a
+// delayed RPC from starting. Never use this for legacy/unregistered VMs.
+func (s *Store) StopRegistered(ctx context.Context, id Identity) (Record, error) {
+	return s.stopIdentity(ctx, id, true)
+}
+func (s *Store) stopIdentity(ctx context.Context, id Identity, registered bool) (Record, error) {
+	lock, err := s.lock(id)
+	if err != nil {
+		return Record{}, err
+	}
+	defer unlock(lock)
+	record, err := s.read(id)
+	if registered && os.IsNotExist(err) {
+		record = Record{Version: 1, Identity: id, State: "stopped"}
+		return record, s.save(record)
+	}
+	if err != nil {
+		return Record{}, err
+	}
+	return s.stop(ctx, record)
+}
