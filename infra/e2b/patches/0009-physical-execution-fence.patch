+	"google.golang.org/grpc"
+)
+
+type executionStopClient struct {
+	rpc.SandboxServiceClient
+	stop func(*rpc.StopExecutionRequest) (*rpc.StopExecutionResponse, error)
+}
+
+func (c executionStopClient) StopExecution(_ context.Context, request *rpc.StopExecutionRequest, _ ...grpc.CallOption) (*rpc.StopExecutionResponse, error) {
+	return c.stop(request)
+}
+
+func TestExecutionStopRejectsMissingMismatchedAndFailedHostReceipts(t *testing.T) {
+	attempt := queries.SandboxExecutionAttempt{TeamID: uuid.New(), SandboxID: "sandbox-test", ExecutionID: uuid.New(), ClusterID: uuid.Nil, NodeID: "host-a"}
+	cases := []struct {
+		name   string
+		result *rpc.StopExecutionResponse
+		err    error
+	}{
+		{name: "missing"},
+		{name: "not stopped", result: &rpc.StopExecutionResponse{TeamId: attempt.TeamID.String(), SandboxId: attempt.SandboxID, ExecutionId: attempt.ExecutionID.String()}},
+		{name: "wrong team", result: &rpc.StopExecutionResponse{TeamId: uuid.NewString(), SandboxId: attempt.SandboxID, ExecutionId: attempt.ExecutionID.String(), PhysicallyStopped: true}},
+		{name: "wrong execution", result: &rpc.StopExecutionResponse{TeamId: attempt.TeamID.String(), SandboxId: attempt.SandboxID, ExecutionId: uuid.NewString(), PhysicallyStopped: true}},
+		{name: "wrong sandbox", result: &rpc.StopExecutionResponse{TeamId: attempt.TeamID.String(), SandboxId: "other", ExecutionId: attempt.ExecutionID.String(), PhysicallyStopped: true}},
+		{name: "lost reply", err: errors.New("reply lost")},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			connect := func(ctx context.Context, cluster uuid.UUID, node string) (rpc.SandboxServiceClient, context.Context, error) {
+				require.Equal(t, attempt.ClusterID, cluster)
+				require.Equal(t, attempt.NodeID, node)
+				return executionStopClient{stop: func(in *rpc.StopExecutionRequest) (*rpc.StopExecutionResponse, error) {
+					require.True(t, in.GetRegisteredBeforeStart())
+					require.Equal(t, attempt.ExecutionID.String(), in.GetExecutionId())
+					return tc.result, tc.err
+				}}, ctx, nil
+			}
+			require.Error(t, confirmExecutionStops(t.Context(), []queries.SandboxExecutionAttempt{attempt}, connect))
+		})
+	}
+}
+
+func TestExecutionStopConfirmsEveryRegisteredHostOnRetry(t *testing.T) {
+	first := queries.SandboxExecutionAttempt{TeamID: uuid.New(), SandboxID: "sandbox-test", ExecutionID: uuid.New(), ClusterID: uuid.Nil, NodeID: "host-a"}
+	second := first
+	second.NodeID = "host-b"
+	var called []string
+	connect := func(ctx context.Context, _ uuid.UUID, node string) (rpc.SandboxServiceClient, context.Context, error) {
+		called = append(called, node)
+		return executionStopClient{stop: func(in *rpc.StopExecutionRequest) (*rpc.StopExecutionResponse, error) {
+			return &rpc.StopExecutionResponse{TeamId: in.GetTeamId(), SandboxId: in.GetSandboxId(), ExecutionId: in.GetExecutionId(), PhysicallyStopped: true}, nil
+		}}, ctx, nil
+	}
+	attempts := []queries.SandboxExecutionAttempt{first, second}
+	require.NoError(t, confirmExecutionStops(t.Context(), attempts, connect))
+	require.NoError(t, confirmExecutionStops(t.Context(), attempts, connect))
+	require.Equal(t, []string{"host-a", "host-b", "host-a", "host-b"}, called)
+	require.Error(t, confirmExecutionStops(t.Context(), nil, connect))
+}
+
+func TestExecutionReceiptReplaysWithoutHostAndRemainsTeamScoped(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	team := testutils.CreateTestTeam(t, db)
+	other := testutils.CreateTestTeam(t, db)
+	store := executions.Store{DB: db.SqlcClient}
+	p := queries.InsertExecutionAttemptParams{TeamID: team, SandboxID: uuid.NewString(), ExecutionID: uuid.New(), ClusterID: uuid.Nil, NodeID: "offline-host"}
+	require.NoError(t, store.Register(t.Context(), p))
+	_, err := store.BeginStop(t.Context(), team, p.SandboxID)
+	require.NoError(t, err)
+	n, err := db.SqlcClient.ConfirmExecutionStopped(t.Context(), queries.ConfirmExecutionStoppedParams{TeamID: team, SandboxID: p.SandboxID})
+	require.NoError(t, err)
+	require.EqualValues(t, 1, n)
+	// No orchestrator exists in this API instance: a lost reply must be recoverable
+	// from the durable final receipt even while its former host is offline.
+	server := &APIStore{sqlcDB: db.SqlcClient}
+	ctx, response := restoreHTTPContext(t, team, nil)
+	server.StopLaunchpadExecution(ctx, p.SandboxID)
+	require.Equal(t, 200, response.Code)
+	require.JSONEq(t, `{"sandboxID":"`+p.SandboxID+`","physicallyStopped":true}`, response.Body.String())
+	ctx, response = restoreHTTPContext(t, other, nil)
+	server.StopLaunchpadExecution(ctx, p.SandboxID)
+	require.Equal(t, 404, response.Code)
+	ctx, response = restoreHTTPContext(t, team, nil)
+	server.StopLaunchpadExecution(ctx, "never-registered")
+	require.Equal(t, 404, response.Code)
+}
