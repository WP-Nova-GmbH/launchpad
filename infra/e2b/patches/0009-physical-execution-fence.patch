+// KillExisting is only for exact cgroup identities from the durable execution
+// journal, after the journal has fenced future clones. Absence then proves that
+// this group cannot contain processes; an accounting noop is never accepted.
+func KillExisting(ctx context.Context, name string) error {
+	if !regexp.MustCompile(`^sbx-[a-zA-Z0-9-]{1,124}$`).MatchString(name) {
+		return errors.New("invalid sandbox cgroup identity")
+	}
+	handle := &CgroupHandle{path: filepath.Join(RootCgroupPath, name)}
+	return handle.kill(ctx)
+}
