+//go:build linux
+
+package server
+
+import (
+	"context"
+	"errors"
+	"os"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox"
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox/execution"
+	rpc "github.com/e2b-dev/infra/packages/shared/pkg/grpc/orchestrator"
+)
+
+// StopExecution is addressed by the API's durable node/execution tuple, never
+// by a routing lookup alone. The journal fences checkpoint/recovery starts and
+// confirms every recorded lifecycle's cgroup is empty before acknowledging.
+func (s *Server) StopExecution(ctx context.Context, in *rpc.StopExecutionRequest) (*rpc.StopExecutionResponse, error) {
+	release := s.info.TrackWork()
+	defer release()
+	if !s.config.LaunchpadRequireExecutionFence {
+		return nil, status.Error(codes.Unimplemented, "physical execution fencing is disabled")
+	}
+	store, err := sandbox.ExecutionStore(s.config.BuilderConfig)
+	if err != nil {
+		return nil, status.Error(codes.Unavailable, "execution journal unavailable")
+	}
+	stop := store.Stop
+	if in.GetRegisteredBeforeStart() {
+		stop = store.StopRegistered
+	}
+	record, err := stop(ctx, execution.Identity{TeamID: in.GetTeamId(), SandboxID: in.GetSandboxId(), ExecutionID: in.GetExecutionId()})
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return nil, status.Error(codes.FailedPrecondition, "physical execution identity is unknown; stop is not confirmed")
+		}
+		return nil, status.Error(codes.Unavailable, "physical execution stop is not confirmed")
+	}
+	// Kernel termination wakes the normal FC exit waiter. Leave cleanup to its
+	// existing lifecycle guard; a later lifecycle cannot pass the journal fence.
+	return &rpc.StopExecutionResponse{TeamId: record.TeamID, SandboxId: record.SandboxID, ExecutionId: record.ExecutionID, PhysicallyStopped: record.State == "stopped"}, nil
+}
