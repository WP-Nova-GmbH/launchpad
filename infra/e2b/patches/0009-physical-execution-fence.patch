+package execution
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func testIdentity() Identity {
+	return Identity{TeamID: "team-1", SandboxID: "sandbox-1", ExecutionID: "execution-1"}
+}
+
+func TestPhysicalStopSurvivesLostReplyAndRestart(t *testing.T) {
+	directory := t.TempDir()
+	calls := 0
+	kill := func(context.Context, string) error { calls++; return nil }
+	source, err := New(directory, "boot-1", kill)
+	require.NoError(t, err)
+	reservation, err := source.Reserve(testIdentity(), "sbx-sandbox-1-random")
+	require.NoError(t, err)
+	require.NoError(t, reservation.Commit())
+	record, err := source.Stop(t.Context(), testIdentity())
+	require.NoError(t, err)
+	require.Equal(t, "stopped", record.State)
+	restarted, err := New(directory, "boot-1", kill)
+	require.NoError(t, err)
+	record, err = restarted.Stop(t.Context(), testIdentity())
+	require.NoError(t, err)
+	require.Equal(t, "stopped", record.State)
+	require.Equal(t, 1, calls, "lost replies must reuse the durable receipt")
+	_, err = restarted.Reserve(testIdentity(), "sbx-sandbox-1-new")
+	require.ErrorIs(t, err, ErrAlreadyReserved)
+}
+
+func TestInterruptedStartupRequiresStopEvidence(t *testing.T) {
+	directory := t.TempDir()
+	failed := true
+	calls := 0
+	store, err := New(directory, "boot-1", func(context.Context, string) error {
+		calls++
+		if failed {
+			return errors.New("cgroup still populated")
+		}
+		return nil
+	})
+	require.NoError(t, err)
+	reservation, err := store.Reserve(testIdentity(), "sbx-sandbox-1-random")
+	require.NoError(t, err)
+	// Simulate process death after clone but before Commit: the kernel releases
+	// the lock, while the spawned VM remains in its pre-recorded cgroup.
+	unlock(reservation.lock)
+	reservation.lock = nil
+	_, err = store.Stop(t.Context(), testIdentity())
+	require.ErrorContains(t, err, "not confirmed stopped")
+	record, err := store.read(testIdentity())
+	require.NoError(t, err)
+	require.Equal(t, "stopping", record.State)
+	_, err = store.Reserve(testIdentity(), "sbx-sandbox-1-again")
+	require.ErrorIs(t, err, ErrAlreadyReserved)
+	failed = false
+	record, err = store.Stop(t.Context(), testIdentity())
+	require.NoError(t, err)
+	require.Equal(t, "stopped", record.State)
+	require.Equal(t, 2, calls)
+}
+
+func TestKernelRestartCannotKillNewBootProcesses(t *testing.T) {
+	directory := t.TempDir()
+	source, err := New(directory, "boot-before", func(context.Context, string) error { return nil })
+	require.NoError(t, err)
+	r, err := source.Reserve(testIdentity(), "sbx-sandbox-1-random")
+	require.NoError(t, err)
+	require.NoError(t, r.Commit())
+	restarted, err := New(directory, "boot-after", func(context.Context, string) error {
+		t.Fatal("old identity must not kill a new boot's processes")
+		return nil
+	})
+	require.NoError(t, err)
+	receipt, err := restarted.Stop(t.Context(), testIdentity())
+	require.NoError(t, err)
+	require.Equal(t, "stopped", receipt.State)
+}
+
+func TestUnknownWrongOwnerAndCorruptRecordsDoNotProveStop(t *testing.T) {
+	directory := t.TempDir()
+	calls := 0
+	store, err := New(directory, "boot-1", func(context.Context, string) error { calls++; return nil })
+	require.NoError(t, err)
+	_, err = store.Stop(t.Context(), testIdentity())
+	require.ErrorIs(t, err, os.ErrNotExist)
+	r, err := store.Reserve(testIdentity(), "sbx-sandbox-1-random")
+	require.NoError(t, err)
+	require.NoError(t, r.Commit())
+	wrong := testIdentity()
+	wrong.TeamID = "other-team"
+	_, err = store.Stop(t.Context(), wrong)
+	require.ErrorContains(t, err, "another owner")
+	require.NoError(t, os.WriteFile(filepath.Join(directory, "execution-1.json"), []byte("partial"), 0600))
+	_, err = store.Stop(t.Context(), testIdentity())
+	require.Error(t, err)
+	require.Zero(t, calls)
+}
+
+func TestAbortKeepsUncertainReservationForReconciliation(t *testing.T) {
+	store, err := New(t.TempDir(), "boot-1", func(context.Context, string) error { return errors.New("cannot inspect cgroup") })
+	require.NoError(t, err)
+	r, err := store.Reserve(testIdentity(), "sbx-sandbox-1-random")
+	require.NoError(t, err)
+	require.Error(t, r.Abort(t.Context()))
+	record, err := store.read(testIdentity())
+	require.NoError(t, err)
+	require.Equal(t, "reserved", record.State)
+	_, err = store.Reserve(testIdentity(), "sbx-sandbox-1-another")
+	require.ErrorIs(t, err, ErrAlreadyReserved)
+}
+
+func TestCheckpointLifecyclesAreAllStoppedBeforeExecutionIsFenced(t *testing.T) {
+	var killed []string
+	store, err := New(t.TempDir(), "boot-1", func(_ context.Context, name string) error { killed = append(killed, name); return nil })
+	require.NoError(t, err)
+	for _, name := range []string{"sbx-sandbox-1-before", "sbx-sandbox-1-after"} {
+		r, err := store.Reserve(testIdentity(), name)
+		require.NoError(t, err)
+		require.NoError(t, r.Commit())
+	}
+	_, err = store.Stop(t.Context(), testIdentity())
+	require.NoError(t, err)
+	require.Equal(t, []string{"sbx-sandbox-1-before", "sbx-sandbox-1-after"}, killed)
+	_, err = store.Reserve(testIdentity(), "sbx-sandbox-1-late")
+	require.ErrorIs(t, err, ErrAlreadyReserved)
+}
+
+func TestFailedCheckpointStartupDoesNotKillPriorLifecycle(t *testing.T) {
+	var killed []string
+	store, err := New(t.TempDir(), "boot-1", func(_ context.Context, name string) error { killed = append(killed, name); return nil })
+	require.NoError(t, err)
+	old, err := store.Reserve(testIdentity(), "sbx-sandbox-1-before")
+	require.NoError(t, err)
+	require.NoError(t, old.Commit())
+	failed, err := store.Reserve(testIdentity(), "sbx-sandbox-1-failed")
+	require.NoError(t, err)
+	require.NoError(t, failed.Abort(t.Context()))
+	require.Equal(t, []string{"sbx-sandbox-1-failed"}, killed)
+	retry, err := store.Reserve(testIdentity(), "sbx-sandbox-1-retry")
+	require.NoError(t, err)
+	require.NoError(t, retry.Commit())
