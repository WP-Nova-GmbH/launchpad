+package handlers
+
+import (
+	"context"
+	"errors"
+	"net/http"
+
+	"github.com/google/uuid"
+
+	"github.com/gin-gonic/gin"
+	"github.com/jackc/pgx/v5"
+
+	"github.com/e2b-dev/infra/packages/api/internal/db"
+	"github.com/e2b-dev/infra/packages/api/internal/orchestrator"
+	"github.com/e2b-dev/infra/packages/api/internal/sandbox"
+	"github.com/e2b-dev/infra/packages/auth/pkg/auth"
+	"github.com/e2b-dev/infra/packages/db/pkg/executions"
+	"github.com/e2b-dev/infra/packages/db/queries"
+	rpc "github.com/e2b-dev/infra/packages/shared/pkg/grpc/orchestrator"
+)
+
+// StopLaunchpadExecution does not infer shutdown from an expired routing entry.
+// Its permanent admission fence and host list survive both API and host restart.
+func (a *APIStore) StopLaunchpadExecution(c *gin.Context, sandboxID string) {
+	team := auth.MustGetTeamID(c)
+	ctx := c.Request.Context()
+	// A saved receipt remains valid after the host goes offline. Its permanent
+	// registry tombstone already prevents all later managed starts/resumes.
+	state, err := a.sqlcDB.LockExecutionFence(ctx, queries.LockExecutionFenceParams{TeamID: team, SandboxID: sandboxID})
+	if err == nil && state == "stopped" {
+		c.JSON(http.StatusOK, gin.H{"sandboxID": sandboxID, "physicallyStopped": true})
+		return
+	}
+	attempts, err := (executions.Store{DB: a.sqlcDB}).BeginStop(ctx, team, sandboxID)
+	if err != nil {
+		if errors.Is(err, pgx.ErrNoRows) {
+			a.sendAPIStoreError(c, http.StatusNotFound, "Registered execution not found")
+			return
+		}
+		a.sendAPIStoreError(c, http.StatusServiceUnavailable, "Execution fence is unavailable")
+		return
+	}
+	if err := confirmExecutionStops(ctx, attempts, a.orchestrator.RestoreClient); err != nil {
+		a.sendAPIStoreError(c, http.StatusServiceUnavailable, "Physical execution stop is unconfirmed")
+		return
+	}
+
+	// The database fence prevents a new resume while the routing/snapshot records
+	// are cleaned. Cleanup failure stays retryable; no false success is returned.
+	err = a.orchestrator.RemoveSandbox(ctx, team, sandboxID, sandbox.RemoveOpts{Action: sandbox.StateActionKill, Reason: sandbox.KillReasonRequest})
+	if err != nil && !errors.Is(err, orchestrator.ErrSandboxNotFound) {
+		a.sendAPIStoreError(c, 503, "Stopped execution cleanup is incomplete")
+		return
+	}
+	err = a.deleteSnapshot(ctx, sandboxID, team)
+	if err != nil && !errors.Is(err, db.ErrSnapshotNotFound) {
+		a.sendAPIStoreError(c, 503, "Stopped snapshot cleanup is incomplete")
+		return
+	}
+	count, err := a.sqlcDB.ConfirmExecutionStopped(ctx, queries.ConfirmExecutionStoppedParams{TeamID: team, SandboxID: sandboxID})
+	if err != nil || count != 1 {
+		a.sendAPIStoreError(c, 503, "Physical stop receipt could not be saved")
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"sandboxID": sandboxID, "physicallyStopped": true})
+}
+
+func confirmExecutionStops(ctx context.Context, attempts []queries.SandboxExecutionAttempt, connect func(context.Context, uuid.UUID, string) (rpc.SandboxServiceClient, context.Context, error)) error {
+	if len(attempts) == 0 {
+		return errors.New("no registered execution")
+	}
+	for _, attempt := range attempts {
+		client, child, err := connect(ctx, attempt.ClusterID, attempt.NodeID)
+		if err != nil {
+			return err
+		}
+		receipt, err := client.StopExecution(child, &rpc.StopExecutionRequest{TeamId: attempt.TeamID.String(), SandboxId: attempt.SandboxID, ExecutionId: attempt.ExecutionID.String(), RegisteredBeforeStart: true})
+		if err != nil {
+			return err
+		}
+		if !receipt.GetPhysicallyStopped() || receipt.GetTeamId() != attempt.TeamID.String() || receipt.GetSandboxId() != attempt.SandboxID || receipt.GetExecutionId() != attempt.ExecutionID.String() {
+			return errors.New("physical execution receipt does not match the registered attempt")
+		}
+	}
+	return nil
+}
