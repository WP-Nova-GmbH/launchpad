+package executions_test
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+	"github.com/stretchr/testify/require"
+
+	"github.com/e2b-dev/infra/packages/db/pkg/executions"
+	"github.com/e2b-dev/infra/packages/db/pkg/testutils"
+	"github.com/e2b-dev/infra/packages/db/queries"
+)
+
+func TestExecutionRegistryPersistsEveryAttemptAndPermanentlyFencesAdmission(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	team := testutils.CreateTestTeam(t, db)
+	other := testutils.CreateTestTeam(t, db)
+	store := executions.Store{DB: db.SqlcClient}
+	first := queries.InsertExecutionAttemptParams{TeamID: team, SandboxID: uuid.NewString(), ExecutionID: uuid.New(), ClusterID: uuid.Nil, NodeID: "node-a"}
+	require.NoError(t, store.Register(t.Context(), first))
+	require.NoError(t, store.Register(t.Context(), first))
+	second := first
+	second.NodeID = "node-b"
+	require.NoError(t, store.Register(t.Context(), second))
+	_, err := store.BeginStop(t.Context(), other, first.SandboxID)
+	require.ErrorIs(t, err, pgx.ErrNoRows)
+	_, err = store.BeginStop(t.Context(), team, "unknown")
+	require.ErrorIs(t, err, pgx.ErrNoRows)
+	attempts, err := store.BeginStop(t.Context(), team, first.SandboxID)
+	require.NoError(t, err)
+	require.Len(t, attempts, 2)
+	reopened := executions.Store{DB: db.SqlcClient}
+	require.ErrorIs(t, reopened.Register(t.Context(), first), executions.ErrFenced)
+	published := false
+	require.ErrorIs(t, reopened.Publish(t.Context(), team, first.SandboxID, func() error { published = true; return nil }), executions.ErrFenced)
+	require.False(t, published, "a late create reply must not republish a stopped VM")
+
+	n, err := db.SqlcClient.ConfirmExecutionStopped(t.Context(), queries.ConfirmExecutionStoppedParams{TeamID: team, SandboxID: first.SandboxID})
+	require.NoError(t, err)
+	require.EqualValues(t, 1, n)
+	replay, err := reopened.BeginStop(t.Context(), team, first.SandboxID)
+	require.NoError(t, err)
+	require.Equal(t, attempts, replay)
+	second.ExecutionID = uuid.New()
+	require.ErrorIs(t, reopened.Register(t.Context(), second), executions.ErrFenced)
+
+	// Stop races admission. Every registration that wins must be in the stop
+	// host list; a registration that loses must fail before the create RPC.
+	raced := first
+	raced.SandboxID = uuid.NewString()
+	raced.ExecutionID = uuid.New()
+	require.NoError(t, store.Register(t.Context(), raced))
+	next := raced
+	next.NodeID = "node-race"
+	ready := make(chan struct{})
+	var group sync.WaitGroup
+	var registerErr, stopErr error
+	var captured []queries.SandboxExecutionAttempt
+	group.Go(func() { <-ready; registerErr = store.Register(context.Background(), next) })
+	group.Go(func() { <-ready; captured, stopErr = store.BeginStop(context.Background(), team, raced.SandboxID) })
+	close(ready)
+	group.Wait()
+	require.NoError(t, stopErr)
+	if registerErr == nil {
+		require.Len(t, captured, 2)
+	} else {
+		require.True(t, errors.Is(registerErr, executions.ErrFenced))
+		require.Len(t, captured, 1)
+	}
+	// A publication already holding the lock must finish before stop returns.
+	publication := first
+	publication.SandboxID = uuid.NewString()
+	publication.ExecutionID = uuid.New()
+	require.NoError(t, store.Register(t.Context(), publication))
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	done := make(chan error, 1)
+	go func() {
+		done <- store.Publish(t.Context(), team, publication.SandboxID, func() error { close(entered); <-release; return nil })
+	}()
+	<-entered
+	stopped := make(chan error, 1)
+	go func() { _, err := store.BeginStop(t.Context(), team, publication.SandboxID); stopped <- err }()
+	close(release)
+	require.NoError(t, <-done)
+	require.NoError(t, <-stopped)
+	require.ErrorIs(t, store.Publish(t.Context(), team, publication.SandboxID, func() error { t.Fatal("fenced publication executed"); return nil }), executions.ErrFenced)
+
+}
