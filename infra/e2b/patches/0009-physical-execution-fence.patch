+//go:build integration && linux
+
+package execution_test
+
+import (
+	"bufio"
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox/cgroup"
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox/execution"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+)
+
+// Run on the dedicated compute host. This creates and kills only its own
+// cgroup and the shell/child launched atomically into it by this test.
+func TestPhysicalExecutionStopKillsRealProcessTreeAfterJournalRestart(t *testing.T) {
+	require.Equal(t, 0, os.Geteuid(), "physical stop proof requires the dedicated Linux host")
+	boot, err := os.ReadFile("/proc/sys/kernel/random/boot_id")
+	require.NoError(t, err)
+	directory := t.TempDir()
+	id := execution.Identity{TeamID: uuid.NewString(), SandboxID: "stop-proof-" + uuid.NewString(), ExecutionID: uuid.NewString()}
+	group := "sbx-" + id.SandboxID + "-" + uuid.NewString()
+	source, err := execution.New(directory, strings.TrimSpace(string(boot)), cgroup.KillExisting)
+	require.NoError(t, err)
+	reservation, err := source.Reserve(id, group)
+	require.NoError(t, err)
+	defer reservation.Abort(context.Background())
+	groupPath := filepath.Join(cgroup.RootCgroupPath, group)
+	require.NoError(t, os.Mkdir(groupPath, 0700))
+	defer os.Remove(groupPath)
+	defer cgroup.KillExisting(context.Background(), group)
+	fd, err := os.Open(groupPath)
+	require.NoError(t, err)
+	defer fd.Close()
+	command := exec.Command("/bin/sh", "-c", "sleep 600 & echo ready; wait")
+	command.SysProcAttr = &syscall.SysProcAttr{UseCgroupFD: true, CgroupFD: int(fd.Fd())}
+	output, err := command.StdoutPipe()
+	require.NoError(t, err)
+	require.NoError(t, command.Start())
+	defer command.Process.Kill()
+	scanner := bufio.NewScanner(output)
+	require.True(t, scanner.Scan())
+	require.Equal(t, "ready", scanner.Text())
+	require.NoError(t, reservation.Commit())
+	// Neither the restart nor the loss of an HTTP reply carries a PID. Recover
+	// solely from the persisted pre-clone cgroup identity.
+	restarted, err := execution.New(directory, strings.TrimSpace(string(boot)), cgroup.KillExisting)
+	require.NoError(t, err)
+	receipt, err := restarted.Stop(t.Context(), id)
+	require.NoError(t, err)
+	require.Equal(t, "stopped", receipt.State)
+	require.Error(t, command.Wait(), "the original shell must have been killed")
+	events, err := os.ReadFile(filepath.Join(groupPath, "cgroup.events"))
+	require.NoError(t, err)
+	require.Contains(t, string(events), "populated 0")
+	third, err := execution.New(directory, strings.TrimSpace(string(boot)), func(context.Context, string) error { t.Fatal("receipt retry must not kill again"); return nil })
+	require.NoError(t, err)
+	_, err = third.Stop(t.Context(), id)
+	require.NoError(t, err)
+	_, err = third.Reserve(id, group+"-late")
+	require.ErrorIs(t, err, execution.ErrAlreadyReserved)
+}
