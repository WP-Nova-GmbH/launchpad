@@ -0,0 +1,57 @@
+package handlers
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/e2b-dev/infra/packages/api/internal/api"
+	"github.com/e2b-dev/infra/packages/api/internal/sandbox"
+	dbtypes "github.com/e2b-dev/infra/packages/db/pkg/types"
+	"github.com/stretchr/testify/require"
+)
+
+func TestLaunchpadPrivateTrafficTokenOnlyForRunningRestrictedVM(t *testing.T) {
+	token, no := "private-test-token", false
+	vm := sandbox.Sandbox{State: sandbox.StateRunning, Metadata: map[string]string{"launchpad.managed": "thread-vm-v1"},
+		TrafficAccessToken: &token, Network: &dbtypes.SandboxNetworkConfig{Ingress: &dbtypes.SandboxNetworkIngressConfig{AllowPublicAccess: &no}}}
+	require.Equal(t, &token, launchpadPrivateTrafficToken(true, vm))
+	cases := []struct {
+		name   string
+		change func(*sandbox.Sandbox)
+	}{
+		{"unmanaged", func(s *sandbox.Sandbox) { s.Metadata = nil }},
+		{"pausing", func(s *sandbox.Sandbox) { s.State = sandbox.StatePausing }},
+		{"stopping", func(s *sandbox.Sandbox) { s.State = sandbox.StateKilling }},
+		{"snapshotting", func(s *sandbox.Sandbox) { s.State = sandbox.StateSnapshotting }},
+		{"auto resume", func(s *sandbox.Sandbox) {
+			s.AutoResume = &dbtypes.SandboxAutoResumeConfig{Policy: dbtypes.SandboxAutoResumeAny}
+		}},
+		{"unknown policy", func(s *sandbox.Sandbox) { s.AutoResume = &dbtypes.SandboxAutoResumeConfig{Policy: "unknown"} }},
+		{"no network", func(s *sandbox.Sandbox) { s.Network = nil }},
+		{"no ingress", func(s *sandbox.Sandbox) { s.Network = &dbtypes.SandboxNetworkConfig{} }},
+		{"implicit public", func(s *sandbox.Sandbox) {
+			s.Network = &dbtypes.SandboxNetworkConfig{Ingress: &dbtypes.SandboxNetworkIngressConfig{}}
+		}},
+		{"public", func(s *sandbox.Sandbox) {
+			yes := true
+			s.Network = &dbtypes.SandboxNetworkConfig{Ingress: &dbtypes.SandboxNetworkIngressConfig{AllowPublicAccess: &yes}}
+		}},
+		{"missing token", func(s *sandbox.Sandbox) { s.TrafficAccessToken = nil }},
+		{"empty token", func(s *sandbox.Sandbox) { empty := ""; s.TrafficAccessToken = &empty }},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			copy := vm
+			c.change(&copy)
+			require.Nil(t, launchpadPrivateTrafficToken(true, copy))
+		})
+	}
+	require.Nil(t, launchpadPrivateTrafficToken(false, vm))
+	// Encoding an omitted token must not introduce a null/empty credential field.
+	encoded, err := json.Marshal(api.SandboxDetail{})
+	require.NoError(t, err)
+	require.NotContains(t, string(encoded), "trafficAccessToken")
+	encoded, err = json.Marshal(api.SandboxDetail{TrafficAccessToken: launchpadPrivateTrafficToken(true, vm)})
+	require.NoError(t, err)
+	require.Contains(t, string(encoded), `"trafficAccessToken":"private-test-token"`)
+}
