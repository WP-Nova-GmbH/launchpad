+
+// The management API already authenticated the owning team. Reuse only a running
+// VM's stored token; inspection cannot create, connect to, or resume a sandbox.
+func launchpadPrivateTrafficToken(enabled bool, sbx sandbox.Sandbox) *string {
+	if !enabled || sbx.State != sandbox.StateRunning || sbx.Metadata["launchpad.managed"] != "thread-vm-v1" ||
+		sbx.TrafficAccessToken == nil || *sbx.TrafficAccessToken == "" ||
+		(sbx.AutoResume != nil && sbx.AutoResume.Policy != dbtypes.SandboxAutoResumeOff) ||
+		sbx.Network == nil || sbx.Network.Ingress == nil || sbx.Network.Ingress.AllowPublicAccess == nil || *sbx.Network.Ingress.AllowPublicAccess {
+		return nil
+	}
+	return sbx.TrafficAccessToken
+}
