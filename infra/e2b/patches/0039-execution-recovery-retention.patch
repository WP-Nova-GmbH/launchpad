+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), `DELETE FROM sandbox_creation_operations WHERE team_id=$1 AND sandbox_id=$2`, team, sandbox))
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), `INSERT INTO sandbox_restore_operations(team_id,operation_id,request_sha256,request_payload,source_template_id,source_build_id,prepared_build_id,sandbox_id,execution_id,cluster_id,node_id,generation,state,reserved_bytes,manifest)
+        VALUES($1,$2,repeat('a',64),$3,'source',$4,$5,$6,$7,$8,'host','3','active',0,'{}')`, team, uuid.New(), raw, *candidate.BuildID, uuid.New(), sandbox, candidate.ExecutionID, uuid.Nil))
+	got, err := store.RetentionCandidate(t.Context(), team, sandbox)
+	require.NoError(t, err)
+	require.Equal(t, candidate, got)
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), `UPDATE sandbox_restore_operations SET state='activating',next_attempt_at=$2 WHERE sandbox_id=$1`, sandbox, time.Now()))
+	_, err = store.RetentionCandidate(t.Context(), team, sandbox)
+	require.ErrorIs(t, err, executions.ErrRetention)
+}
+
+func TestExecutionRetentionSharesFenceFirstOrderWithPausedAlias(t *testing.T) {
+	db, store, team, sandbox, candidate := retentionFixture(t)
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), `UPDATE snapshots SET config='{"filesystemOnly":true}' WHERE sandbox_id=$1`, sandbox))
+	require.NoError(t, store.MarkPaused(t.Context(), team, sandbox, candidate.ExecutionID, *candidate.BuildID, func([]queries.SandboxExecutionAttempt) error { return nil }))
+	namespace := testutils.GetTeamSlug(t, t.Context(), db, team)
+	ready := make(chan struct{})
+	var wg sync.WaitGroup
+	failures := make(chan error, 17)
+	// Alias creation takes this same fence before catalog writes. Neither path
+	// may hold the catalog while waiting for the other path's fence.
+	for range 16 {
+		wg.Go(func() {
+			<-ready
+			_, err := store.RetainPausedDisk(t.Context(), team, sandbox, namespace, "launchpad-backup-"+uuid.NewString())
+			if err != nil && !errors.Is(err, executions.ErrPausedDisk) {
+				failures <- err
+			}
+		})
+	}
+	wg.Go(func() {
+		<-ready
+		_, err := store.RetainForStop(t.Context(), team, sandbox, uuid.New(), candidate.RetentionRequest, func(_ context.Context, roots []uuid.UUID) ([]uuid.UUID, error) { return roots, nil })
+		if err != nil {
+			failures <- err
+		}
+	})
+	close(ready)
+	wg.Wait()
+	close(failures)
+	for err := range failures {
+		require.NoError(t, err)
+	}
+	require.Equal(t, "stopping", retentionFence(t, db, team, sandbox))
+}
+
+func TestExecutionRetentionRejectsCaptureDelayedBeforeItsDurableAdmission(t *testing.T) {
+	db, store, team, sandbox, candidate := retentionFixture(t)
+	base := testutils.CreateTestTemplate(t, db, team)
+	in := queries.UpsertSnapshotParams{TemplateID: "late-" + uuid.NewString(), TeamID: team, SandboxID: sandbox, BaseTemplateID: base, Metadata: types.JSONBStringMap(candidate.Metadata), Vcpu: 2, RamMb: 2048, KernelVersion: "6.1.0", FirecrackerVersion: "1.4.0", OriginNodeID: "host", StartedAt: pgtype.Timestamptz{Time: time.Now(), Valid: true}, Status: types.BuildStatusSnapshotting, SourceBuildID: *candidate.BuildID}
+	started := make(chan struct{})
+	finished := make(chan error, 1)
+	receipt, err := store.RetainForStop(t.Context(), team, sandbox, uuid.New(), candidate.RetentionRequest, func(_ context.Context, roots []uuid.UUID) ([]uuid.UUID, error) {
+		go func() {
+			close(started)
+			_, err := store.UpsertSnapshotForExecution(t.Context(), candidate.ExecutionID, in)
+			finished <- err
+		}()
+		<-started
+		return roots, nil
+	})
+	require.NoError(t, err)
+	require.NotNil(t, receipt.RetainedTemplateID)
+	require.ErrorIs(t, <-finished, executions.ErrFenced, "a capture already read from routing before retention must not publish later")
+	require.Equal(t, "stopping", retentionFence(t, db, team, sandbox))
+	_, tx, err := db.SqlcClient.WithTx(t.Context())
+	require.NoError(t, err)
+	defer tx.Rollback(t.Context())
+	var count int
+	require.NoError(t, tx.QueryRow(t.Context(), `SELECT count(*) FROM env_build_assignments a JOIN snapshots s ON s.env_id=a.env_id WHERE s.sandbox_id=$1`, sandbox).Scan(&count))
+	require.Equal(t, 1, count, "no late pending capture was inserted after sealing")
+}
+
+func TestExecutionRetentionDefersToCaptureWhoseAdmissionAlreadyCommitted(t *testing.T) {
+	db, store, team, sandbox, candidate := retentionFixture(t)
+	base := testutils.CreateTestTemplate(t, db, team)
+	in := queries.UpsertSnapshotParams{TemplateID: "early-" + uuid.NewString(), TeamID: team, SandboxID: sandbox, BaseTemplateID: base, Metadata: types.JSONBStringMap(candidate.Metadata), Vcpu: 2, RamMb: 2048, KernelVersion: "6.1.0", FirecrackerVersion: "1.4.0", OriginNodeID: "host", StartedAt: pgtype.Timestamptz{Time: time.Now(), Valid: true}, Status: types.BuildStatusSnapshotting, SourceBuildID: *candidate.BuildID}
+	_, err := store.UpsertSnapshotForExecution(t.Context(), candidate.ExecutionID, in)
+	require.NoError(t, err)
+	_, err = store.RetainForStop(t.Context(), team, sandbox, uuid.New(), candidate.RetentionRequest, func(context.Context, []uuid.UUID) ([]uuid.UUID, error) {
+		t.Fatal("pending capture must block before header validation or stop")
+		return nil, nil
+	})
+	require.ErrorIs(t, err, executions.ErrRetentionCandidateChanged)
+	require.Equal(t, "active", retentionFence(t, db, team, sandbox))
+}
+
+func TestExecutionRetentionUsesExistingStoppedCertificateWithoutRevivingIt(t *testing.T) {
+	for _, cleanup := range []bool{false, true} {
+		t.Run(map[bool]string{false: "remaining ready tip", true: "no current tip"}[cleanup], func(t *testing.T) {
+			db, store, team, sandbox, before := retentionFixture(t)
+			_, err := store.BeginStop(t.Context(), team, sandbox)
+			require.NoError(t, err)
+			count, err := db.SqlcClient.ConfirmExecutionStopped(t.Context(), queries.ConfirmExecutionStoppedParams{TeamID: team, SandboxID: sandbox})
+			require.NoError(t, err)
+			require.EqualValues(t, 1, count)
+			if cleanup {
+				require.NoError(t, store.CleanupStoppedSnapshot(t.Context(), team, sandbox))
+			}
+			candidate, err := store.RetentionCandidate(t.Context(), team, sandbox)
+			require.NoError(t, err)
+			require.Equal(t, before.ExecutionID, candidate.ExecutionID)
+			require.Equal(t, cleanup, candidate.BuildID == nil)
+			receipt, err := store.RetainForStop(t.Context(), team, sandbox, uuid.New(), candidate.RetentionRequest, func(_ context.Context, roots []uuid.UUID) ([]uuid.UUID, error) { return roots, nil })
+			require.NoError(t, err)
+			require.Equal(t, "stopped", retentionFence(t, db, team, sandbox))
+			require.Equal(t, cleanup, receipt.RetainedTemplateID == nil)
+			require.ErrorIs(t, store.Register(t.Context(), queries.InsertExecutionAttemptParams{TeamID: team, SandboxID: sandbox, ExecutionID: uuid.New(), ClusterID: uuid.Nil, NodeID: "host"}, uuid.New(), true), executions.ErrFenced)
+			replay, err := store.RetainForStop(t.Context(), team, sandbox, receipt.RecoveryOperationID, candidate.RetentionRequest, func(context.Context, []uuid.UUID) ([]uuid.UUID, error) {
+				t.Fatal("saved immutable receipt must replay")
+				return nil, nil
+			})
+			require.NoError(t, err)
+			require.Equal(t, receipt, replay)
+		})
+	}
+}
