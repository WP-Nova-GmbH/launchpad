+func TestExecutionRetentionNamedPublicationCommitsBeforeStopAndRollsBackOnFailure(t *testing.T) {
+	db, store, team, sandbox, candidate := retentionFixture(t)
+	alias := "published-" + uuid.NewString()
+	entered, release := make(chan struct{}), make(chan struct{})
+	published := make(chan error, 1)
+	go func() {
+		_, err := store.PublishSnapshotTemplateForExecution(t.Context(), team, sandbox, candidate.ExecutionID, func(tx *client.Client) (string, error) {
+			id, err := publishRetentionTestAlias(t.Context(), tx, team, sandbox, *candidate.BuildID, alias)
+			close(entered)
+			<-release
+			return id, err
+		})
+		published <- err
+	}()
+	<-entered
+	require.Zero(t, retentionAliasCount(t, db, alias), "publication stays uncommitted while the fence is held")
+	stopStarted, stopped := make(chan struct{}), make(chan error, 1)
+	go func() { close(stopStarted); _, err := store.BeginStop(t.Context(), team, sandbox); stopped <- err }()
+	<-stopStarted
+	close(release)
