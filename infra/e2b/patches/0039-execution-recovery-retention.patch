+//go:build linux
+
+package server
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/template/metadata"
+	"github.com/e2b-dev/infra/packages/shared/pkg/grpc/orchestrator"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+func TestRetentionValidationReadsStoredDiskAndIndependentMemoryAncestors(t *testing.T) {
+	server := &Server{}
+	server.config.LaunchpadRequireExecutionFence = true
+	var err error
+	server.persistence, err = storage.NewProvider(t.Context(), storage.Spec{Provider: storage.LocalStorageProvider, BasePath: t.TempDir()})
+	require.NoError(t, err)
+	self, disk, memory := uuid.New(), uuid.New(), uuid.New()
+	paths := storage.Paths{BuildID: self.String()}
+	request := &orchestrator.RetainedBuildRootsRequest{BuildIds: []string{self.String()}}
+	_, err = server.ValidateRetainedBuildRoots(t.Context(), request)
+	require.Equal(t, codes.FailedPrecondition, status.Code(err))
+	raw, err := json.Marshal(metadata.Template{Version: metadata.CurrentVersion, Template: metadata.TemplateMetadata{BuildID: self.String()}})
+	require.NoError(t, err)
+	blob, err := server.persistence.OpenBlob(t.Context(), paths.Metadata())
+	require.NoError(t, err)
+	require.NoError(t, blob.Put(t.Context(), raw))
+	write := func(path string, ancestor uuid.UUID) {
+		h, err := header.NewHeader(&header.Metadata{Version: 3, BuildId: self, BlockSize: 4096, Size: 4096}, []header.BuildMap{{Length: 4096, BuildId: ancestor}})
+		require.NoError(t, err)
+		_, _, _, err = header.StoreHeader(t.Context(), server.persistence, path, h)
+		require.NoError(t, err)
+	}
+	write(paths.RootfsHeader(), disk)
+	_, err = server.ValidateRetainedBuildRoots(t.Context(), request)
+	require.Equal(t, codes.FailedPrecondition, status.Code(err), "missing memory header must not become a filesystem-only snapshot")
+	write(paths.MemfileHeader(), memory)
+	result, err := server.ValidateRetainedBuildRoots(t.Context(), request)
+	require.NoError(t, err)
+	require.ElementsMatch(t, []string{self.String(), disk.String(), memory.String()}, result.BuildIds)
+	cancelled, cancel := context.WithCancel(t.Context())
+	cancel()
+	_, err = server.ValidateRetainedBuildRoots(cancelled, request)
+	require.Error(t, err)
+	// No sandboxFactory, SQL client or guest connection exists in this fixture.
+	server.config.LaunchpadRequireExecutionFence = false
+	_, err = server.ValidateRetainedBuildRoots(t.Context(), request)
+	require.Equal(t, codes.Unimplemented, status.Code(err))
+}
