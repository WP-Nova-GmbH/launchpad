new file mode 100644
--- /dev/null
+++ b/packages/orchestrator/pkg/server/retained_build_roots.go
@@ -0,0 +1,42 @@
+//go:build linux
+
+package server
+
+import (
+	"context"
+	"slices"
+	"time"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/template/template"
+	"github.com/e2b-dev/infra/packages/shared/pkg/grpc/orchestrator"
+	"github.com/google/uuid"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// ValidateRetainedBuildRoots reads persisted metadata and both disk and memory
+// mappings without touching execution, a guest, a lease or any database lock.
+func (s *Server) ValidateRetainedBuildRoots(ctx context.Context, in *orchestrator.RetainedBuildRootsRequest) (*orchestrator.RetainedBuildRootsResponse, error) {
+	if !s.config.LaunchpadRequireExecutionFence {
+		return nil, status.Error(codes.Unimplemented, "execution retention is disabled")
+	}
+	if len(in.GetBuildIds()) != 1 {
+		return nil, status.Error(codes.InvalidArgument, "one exact retained root is required")
+	}
+	root, err := uuid.Parse(in.GetBuildIds()[0])
+	if err != nil || root == uuid.Nil {
+		return nil, status.Error(codes.InvalidArgument, "invalid retained root")
+	}
+	child, cancel := context.WithTimeout(ctx, 15*time.Second)
+	defer cancel()
+	refs, err := template.RetainedBuilds(child, s.persistence, []uuid.UUID{root})
+	if err != nil {
+		return nil, status.Error(codes.FailedPrecondition, "retained immutable build headers are unavailable")
+	}
+	out := &orchestrator.RetainedBuildRootsResponse{BuildIds: make([]string, 0, len(refs))}
+	for id := range refs {
+		out.BuildIds = append(out.BuildIds, id.String())
+	}
+	slices.Sort(out.BuildIds)
+	return out, nil
+}
