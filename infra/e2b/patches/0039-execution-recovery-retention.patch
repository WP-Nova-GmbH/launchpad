+	_, err = store2.PublishSnapshotTemplateForExecution(t.Context(), team2, sandbox2, candidate2.ExecutionID, func(tx *client.Client) (string, error) {
+		id, e := publishRetentionTestAlias(t.Context(), tx, team2, sandbox2, *candidate2.BuildID, alias)
