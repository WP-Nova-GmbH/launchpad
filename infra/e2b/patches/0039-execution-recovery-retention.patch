+func TestExecutionRetentionRejectsNamedPublicationDelayedAfterCaptureAdmission(t *testing.T) {
+	db, store, team, sandbox, candidate := retentionFixture(t)
+	base := testutils.CreateTestTemplate(t, db, team)
+	in := queries.UpsertSnapshotParams{TemplateID: "admitted-" + uuid.NewString(), TeamID: team, SandboxID: sandbox, BaseTemplateID: base, Metadata: types.JSONBStringMap(candidate.Metadata), Vcpu: 2, RamMb: 2048, KernelVersion: "6.1.0", FirecrackerVersion: "1.4.0", OriginNodeID: "host", StartedAt: pgtype.Timestamptz{Time: time.Now(), Valid: true}, Status: types.BuildStatusSnapshotting, SourceBuildID: *candidate.BuildID}
+	admitted, err := store.UpsertSnapshotForExecution(t.Context(), candidate.ExecutionID, in)
+	require.NoError(t, err)
+	alias := "late-" + uuid.NewString()
+	ready, release := make(chan struct{}), make(chan struct{})
+	result := make(chan error, 1)
+	go func() {
+		close(ready)
+		<-release
+		_, e := store.PublishSnapshotTemplateForExecution(t.Context(), team, sandbox, candidate.ExecutionID, func(tx *client.Client) (string, error) {
+			return publishRetentionTestAlias(t.Context(), tx, team, sandbox, admitted.BuildID, alias)
+		})
+		result <- e
+	}()
+	<-ready
+	_, err = store.BeginStop(t.Context(), team, sandbox)
+	require.NoError(t, err)
+	close(release)
+	require.ErrorIs(t, <-result, executions.ErrFenced)
+	require.Zero(t, retentionAliasCount(t, db, alias), "a stopped capture cannot publish its previously missing alias")
+}
