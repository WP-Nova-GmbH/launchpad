+package handlers
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	templatecache "github.com/e2b-dev/infra/packages/api/internal/cache/templates"
+	"github.com/e2b-dev/infra/packages/auth/pkg/auth"
+	authtypes "github.com/e2b-dev/infra/packages/auth/pkg/types"
+	authqueries "github.com/e2b-dev/infra/packages/db/pkg/auth/queries"
+	"github.com/e2b-dev/infra/packages/db/pkg/testutils"
+	redisutils "github.com/e2b-dev/infra/packages/shared/pkg/redis"
+	"github.com/gin-gonic/gin"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+)
+
+func TestLaunchpadSnapshotAliasReadDoesNotTrustCachedAbsence(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	team := testutils.CreateTestTeam(t, db)
+	slug := testutils.GetTeamSlug(t, t.Context(), db, team)
+	redis := redisutils.SetupInstance(t)
+	cache := templatecache.NewTemplateCache(db.SqlcClient, redis)
+	t.Cleanup(func() { _ = cache.Close(t.Context()) })
+	a := &APIStore{sqlcDB: db.SqlcClient, templateCache: cache}
+	a.config.LaunchpadRestoreNodeID = "dedicated-host"
+	a.config.LaunchpadRestoreCapacityBytes = 1
+	a.config.LaunchpadRestoreTeams = []string{team.String()}
+	request := func(identifier string) *httptest.ResponseRecorder {
+		response := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(response)
+		c.Request = httptest.NewRequest("GET", "/templates/aliases/"+identifier, nil)
+		auth.SetTeamInfoForTest(t, c, &authtypes.Team{Team: &authqueries.Team{ID: team, Slug: slug}})
+		a.GetTemplatesAliasesAlias(c, identifier)
+		return response
+	}
+	for _, prefix := range []string{"launchpad-backup-", "launchpad-final-", "ordinary-", "launchpad-backup-not-a-uuid-"} {
+		alias := prefix + uuid.NewString()
+		_, err := cache.ResolveAlias(t.Context(), alias, slug)
+		require.ErrorIs(t, err, templatecache.ErrTemplateNotFound)
+		template := testutils.CreateTestTemplate(t, db, team)
+		testutils.CreateTestTemplateAliasWithName(t, db, template, alias, &slug)
+		_, err = cache.ResolveAlias(t.Context(), alias, slug)
+		require.ErrorIs(t, err, templatecache.ErrTemplateNotFound, "the real Redis negative entry remains stale after publication")
+		response := request(alias)
+		if launchpadPausedSnapshotAlias(alias) {
+			require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+			require.Contains(t, response.Body.String(), template)
+			require.Equal(t, http.StatusBadRequest, request("another-team/"+alias).Code)
+			require.Equal(t, http.StatusNotFound, request(alias+":missing-tag").Code)
+			a.config.LaunchpadRestoreNodeID = ""
+			require.Equal(t, http.StatusNotFound, request(alias).Code, "ordinary hosts retain their cache behavior")
+			a.config.LaunchpadRestoreNodeID = "dedicated-host"
+		} else {
+			require.Equal(t, http.StatusNotFound, response.Code, "ordinary and malformed aliases retain caching")
+		}
+	}
+	missing := "launchpad-backup-" + uuid.NewString()
+	require.Equal(t, http.StatusNotFound, request(missing).Code)
+	foreign := testutils.CreateTestTeam(t, db)
+	foreignTemplate := testutils.CreateTestTemplate(t, db, foreign)
+	testutils.CreateTestTemplateAliasWithName(t, db, foreignTemplate, missing, &slug)
+	require.Equal(t, http.StatusForbidden, request(missing).Code, "uncached reads preserve exact team ownership")
+}
