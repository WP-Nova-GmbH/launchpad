+	require.NoError(t, <-stopped)
+	require.Equal(t, 1, retentionAliasCount(t, db, alias), "Stop observes a completely committed named root")
+	_, err := store.PublishSnapshotTemplateForExecution(t.Context(), team, sandbox, uuid.New(), func(*client.Client) (string, error) { t.Error("wrong execution reached publication"); return "", nil })
+	require.ErrorIs(t, err, executions.ErrFenced)
+
+	db2, store2, team2, sandbox2, candidate2 := retentionFixture(t)
+	_, err = store2.PublishSnapshotTemplateForExecution(t.Context(), team2, sandbox2, uuid.New(), func(*client.Client) (string, error) {
+		t.Error("wrong active execution reached publication")
+		return "", nil
+	})
+	require.ErrorIs(t, err, executions.ErrFenced)
