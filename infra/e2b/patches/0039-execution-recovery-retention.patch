diff --git a/packages/api/internal/handlers/launchpad_retention.go b/packages/api/internal/handlers/launchpad_retention.go
new file mode 100644
--- /dev/null
+++ b/packages/api/internal/handlers/launchpad_retention.go
@@ -0,0 +1,92 @@
+package handlers
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/e2b-dev/infra/packages/auth/pkg/auth"
+	"github.com/e2b-dev/infra/packages/db/pkg/executions"
+	"github.com/e2b-dev/infra/packages/shared/pkg/grpc/orchestrator"
+	"github.com/gin-gonic/gin"
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+)
+
+func (a *APIStore) retentionError(c *gin.Context, err error) {
+	switch {
+	case errors.Is(err, executions.ErrRetentionCandidateChanged):
+		c.JSON(http.StatusConflict, gin.H{"code": "retention_candidate_changed", "message": "No retention was committed for this operation; inspect the current candidate"})
+	case errors.Is(err, pgx.ErrNoRows):
+		a.sendAPIStoreError(c, 404, "Managed execution was not found")
+	case errors.Is(err, executions.ErrRetention):
+		a.sendAPIStoreError(c, 409, "Execution ownership or retained snapshot changed; keep the sandbox")
+	default:
+		a.sendAPIStoreError(c, 503, "Execution retention is incomplete; keep the sandbox")
+	}
+}
+
+func (a *APIStore) GetLaunchpadRetentionCandidate(c *gin.Context, sandboxID string) {
+	team := auth.MustGetTeamID(c)
+	if !a.restoreAdmissionEnabled(team) {
+		a.sendAPIStoreError(c, 403, "Execution retention is not enabled for this team")
+		return
+	}
+	candidate, err := (executions.Store{DB: a.sqlcDB}).RetentionCandidate(c.Request.Context(), team, sandboxID)
+	if err != nil {
+		a.retentionError(c, err)
+		return
+	}
+	c.JSON(http.StatusOK, candidate)
+}
+
+func (a *APIStore) PutLaunchpadExecutionRetention(c *gin.Context, sandboxID string, recoveryOperationID uuid.UUID) {
+	team := auth.MustGetTeamID(c)
+	if !a.restoreAdmissionEnabled(team) {
+		a.sendAPIStoreError(c, 403, "Execution retention is not enabled for this team")
+		return
+	}
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 8*1024)
+	decoder := json.NewDecoder(c.Request.Body)
+	decoder.DisallowUnknownFields()
+	var body executions.RetentionRequest
+	var extra any
+	if decoder.Decode(&body) != nil || !errors.Is(decoder.Decode(&extra), io.EOF) {
+		a.sendAPIStoreError(c, 400, "Invalid execution retention request")
+		return
+	}
+	validate := func(ctx context.Context, roots []uuid.UUID) ([]uuid.UUID, error) {
+		bounded, cancel := context.WithTimeout(ctx, 15*time.Second)
+		defer cancel()
+		client, child, err := a.restoreRuntime().RestoreClient(bounded, uuid.Nil, a.config.LaunchpadRestoreNodeID)
+		if err != nil {
+			return nil, err
+		}
+		raw := make([]string, 0, len(roots))
+		for _, id := range roots {
+			raw = append(raw, id.String())
+		}
+		result, err := client.ValidateRetainedBuildRoots(child, &orchestrator.RetainedBuildRootsRequest{BuildIds: raw})
+		if err != nil {
+			return nil, err
+		}
+		refs := make([]uuid.UUID, 0, len(result.GetBuildIds()))
+		for _, value := range result.GetBuildIds() {
+			id, err := uuid.Parse(value)
+			if err != nil || id == uuid.Nil {
+				return nil, executions.ErrRetention
+			}
+			refs = append(refs, id)
+		}
+		return refs, nil
+	}
+	receipt, err := (executions.Store{DB: a.sqlcDB}).RetainForStop(c.Request.Context(), team, sandboxID, recoveryOperationID, body, validate)
+	if err != nil {
+		a.retentionError(c, err)
+		return
+	}
+	c.JSON(http.StatusOK, receipt)
+}
diff --git a/packages/api/internal/handlers/launchpad_retention_test.go b/packages/api/internal/handlers/launchpad_retention_test.go
new file mode 100644
--- /dev/null
+++ b/packages/api/internal/handlers/launchpad_retention_test.go
@@ -0,0 +1,109 @@
+package handlers
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"github.com/e2b-dev/infra/packages/db/pkg/buildretention"
+	"github.com/e2b-dev/infra/packages/db/pkg/executions"
+	"github.com/e2b-dev/infra/packages/db/pkg/testutils"
+	"github.com/e2b-dev/infra/packages/db/queries"
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/template/metadata"
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/template/template"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+)
+
+func TestRetentionRootsAndAncestorsSurviveStoppedSnapshotCleanupAndCollection(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	team := testutils.CreateTestTeam(t, db)
+	base := testutils.CreateTestTemplate(t, db, team)
+	sbx := "recover-" + uuid.NewString()
+	store := executions.Store{DB: db.SqlcClient}
+	owner := map[string]string{"launchpad.managed": "thread-vm-v1", "launchpad.allocation_id": "allocation-from-import", "launchpad.operation_id": uuid.NewString(), "launchpad.thread_id": uuid.NewString(), "launchpad.generation": "2"}
+	require.NoError(t, store.CaptureCreation(t.Context(), team, sbx, owner))
+	attempt := queries.InsertExecutionAttemptParams{TeamID: team, SandboxID: sbx, ExecutionID: uuid.New(), ClusterID: uuid.Nil, NodeID: "offline-host"}
+	require.NoError(t, store.Register(t.Context(), attempt, uuid.New(), true))
+	snapshot := testutils.UpsertTestSnapshot(t, t.Context(), db, "damaged-"+uuid.NewString(), sbx, team, base)
+	raw, err := json.Marshal(owner)
+	require.NoError(t, err)
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), `UPDATE snapshots SET metadata=$2 WHERE sandbox_id=$1`, sbx, string(raw)))
+	files, err := storage.NewProvider(t.Context(), storage.Spec{Provider: storage.LocalStorageProvider, BasePath: t.TempDir()})
+	require.NoError(t, err)
+	self, disk, memory, garbage := snapshot.BuildID, uuid.New(), uuid.New(), uuid.New()
+	paths := storage.Paths{BuildID: self.String()}
+	put := func(path string, value []byte) {
+		b, err := files.OpenBlob(t.Context(), path)
+		require.NoError(t, err)
+		require.NoError(t, b.Put(t.Context(), value))
+	}
+	raw, err = json.Marshal(metadata.Template{Version: metadata.CurrentVersion, Template: metadata.TemplateMetadata{BuildID: self.String()}})
+	require.NoError(t, err)
+	put(paths.Metadata(), raw)
+	writeHeader := func(path string, ancestor uuid.UUID) {
+		h, err := header.NewHeader(&header.Metadata{Version: 3, BuildId: self, BlockSize: 4096, Size: 4096}, []header.BuildMap{{Length: 4096, BuildId: ancestor}})
+		require.NoError(t, err)
+		_, _, _, err = header.StoreHeader(t.Context(), files, path, h)
+		require.NoError(t, err)
+	}
+	writeHeader(paths.RootfsHeader(), disk)
+	writeHeader(paths.MemfileHeader(), memory)
+	for _, id := range []uuid.UUID{self, disk, memory, garbage} {
+		put((storage.Paths{BuildID: id.String()}).Snapfile(), []byte(id.String()))
+	}
+	candidate, err := store.RetentionCandidate(t.Context(), team, sbx)
+	require.NoError(t, err)
+	receipt, err := store.RetainForStop(t.Context(), team, sbx, uuid.New(), candidate.RetentionRequest, func(ctx context.Context, roots []uuid.UUID) ([]uuid.UUID, error) {
+		refs, err := template.RetainedBuilds(ctx, files, roots)
+		out := []uuid.UUID{}
+		for id := range refs {
+			out = append(out, id)
+		}
+		return out, err
+	})
+	require.NoError(t, err)
+	require.ElementsMatch(t, []uuid.UUID{self, disk, memory}, receipt.RetainedBuildIDs)
+	// Simulate the existing host certificate admission; then exercise actual
+	// API stopped replay, whose source-snapshot cleanup used to drop this root.
+	count, err := db.SqlcClient.ConfirmExecutionStopped(t.Context(), queries.ConfirmExecutionStoppedParams{TeamID: team, SandboxID: sbx})
+	require.NoError(t, err)
+	require.EqualValues(t, 1, count)
+	api := &APIStore{sqlcDB: db.SqlcClient}
+	ctx, response := restoreHTTPContext(t, team, nil)
+	api.StopLaunchpadExecution(ctx, sbx)
+	require.Equal(t, 200, response.Code, response.Body.String())
+	// Only our independent retained template remains live. The ordinary stopped
+	// snapshot environment is soft-deleted by the normal stop cleanup path.
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), `UPDATE envs SET deleted_at=now() WHERE id=$1`, snapshot.TemplateID))
+	require.NoError(t, buildretention.WithIdleCatalog(t.Context(), db.SqlcClient, func(c buildretention.Catalog) error {
+		require.Contains(t, c.Roots, self)
+		_, err := template.CollectBuildObjects(t.Context(), files, []uuid.UUID{self}, []uuid.UUID{self, disk, memory, garbage})
+		return err
+	}))
+	for _, id := range []uuid.UUID{self, disk, memory, garbage} {
+		blob, err := files.OpenBlob(t.Context(), (storage.Paths{BuildID: id.String()}).Snapfile())
+		if id == garbage {
+			require.ErrorIs(t, err, storage.ErrBuildRetired)
+			continue
+		}
+		require.NoError(t, err)
+		exists, err := blob.Exists(t.Context())
+		require.NoError(t, err)
+		require.Equal(t, id != garbage, exists)
+	}
+}
+
+func TestRetentionCandidateChangedErrorIsExplicitAndNotGeneric(t *testing.T) {
+	api := &APIStore{}
+	ctx, response := restoreHTTPContext(t, uuid.New(), nil)
+	api.retentionError(ctx, executions.ErrRetentionCandidateChanged)
+	require.Equal(t, 409, response.Code)
+	require.Contains(t, response.Body.String(), `"code":"retention_candidate_changed"`)
+	ctx, response = restoreHTTPContext(t, uuid.New(), nil)
+	api.retentionError(ctx, executions.ErrRetention)
+	require.Equal(t, 409, response.Code)
+	require.NotContains(t, response.Body.String(), "retention_candidate_changed")
+}
