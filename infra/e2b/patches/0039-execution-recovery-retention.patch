diff --git a/packages/db/pkg/executions/retention.go b/packages/db/pkg/executions/retention.go
new file mode 100644
--- /dev/null
+++ b/packages/db/pkg/executions/retention.go
@@ -0,0 +1,396 @@
+package executions
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"maps"
+	"slices"
+	"strconv"
+	"strings"
+
+	"github.com/e2b-dev/infra/packages/db/client"
+	"github.com/e2b-dev/infra/packages/db/queries"
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+)
+
+var ErrRetention = errors.New("execution retention identity or roots changed")
+var ErrRetentionCandidateChanged = errors.New("retention candidate changed without a saved receipt")
+
+type RetentionRequest struct {
+	ExecutionID uuid.UUID         `json:"executionID"`
+	BuildID     *uuid.UUID        `json:"buildID"`
+	Metadata    map[string]string `json:"metadata"`
+}
+
+type RetentionCandidate struct {
+	RetentionRequest
+	SandboxID   string `json:"sandboxID"`
+	Disposition string `json:"disposition"`
+}
+
+type RetentionReceipt struct {
+	RetentionCandidate
+	Version             int         `json:"version"`
+	Kind                string      `json:"kind"`
+	RecoveryOperationID uuid.UUID   `json:"recoveryOperationID"`
+	RetainedTemplateID  *string     `json:"retainedTemplateID"`
+	RetainedBuildIDs    []uuid.UUID `json:"retainedBuildIDs"`
+	RequestSHA256       string      `json:"requestSHA256"`
+}
+
+func validRetentionRequest(in RetentionRequest) bool {
+	if in.ExecutionID == uuid.Nil || (in.BuildID != nil && *in.BuildID == uuid.Nil) || in.Metadata["launchpad.managed"] != "thread-vm-v1" {
+		return false
+	}
+	for _, key := range []string{"launchpad.operation_id"} {
+		id, err := uuid.Parse(in.Metadata[key])
+		if err != nil || id == uuid.Nil || id.String() != in.Metadata[key] {
+			return false
+		}
+	}
+	allocation := in.Metadata["launchpad.allocation_id"]
+	if allocation == "" || strings.TrimSpace(allocation) != allocation || len(allocation) > 64 {
+		return false
+	}
+	thread := in.Metadata["launchpad.thread_id"]
+	if thread == "" || strings.TrimSpace(thread) != thread || len(thread) > 191 {
+		return false
+	}
+	generation, err := strconv.ParseUint(in.Metadata["launchpad.generation"], 10, 64)
+	if err != nil || generation == 0 || strconv.FormatUint(generation, 10) != in.Metadata["launchpad.generation"] {
+		return false
+	}
+	if in.Metadata["launchpad.restore"] == "" {
+		return len(in.Metadata) == 5
+	}
+	if in.Metadata["launchpad.restore"] != "v1" {
+		return false
+	}
+	parent, attempt := in.Metadata["launchpad.restore_parent_operation_id"], in.Metadata["launchpad.restore_boot_attempt"]
+	if parent == "" && attempt == "" {
+		return len(in.Metadata) == 6
+	}
+	id, err := uuid.Parse(parent)
+	if err != nil || id == uuid.Nil || id.String() != parent {
+		return false
+	}
+	number, err := strconv.ParseUint(attempt, 10, 32)
+	return len(in.Metadata) == 8 && err == nil && number > 0 && len(attempt) <= 9 && strconv.FormatUint(number, 10) == attempt
+}
+
+// Candidate reads only durable ownership and catalog state. It never consults a
+// routing cache, renews a lease, contacts a guest, or interprets missing files as absence.
+func (s Store) RetentionCandidate(ctx context.Context, team uuid.UUID, sandbox string) (RetentionCandidate, error) {
+	_, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return RetentionCandidate{}, err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	return retentionCandidate(ctx, tx, team, sandbox)
+}
+
+func retentionCandidate(ctx context.Context, tx pgx.Tx, team uuid.UUID, sandbox string) (RetentionCandidate, error) {
+	result := RetentionCandidate{SandboxID: sandbox, Disposition: "no_current_tip"}
+	var state string
+	err := tx.QueryRow(ctx, `SELECT state,current_execution_id FROM public.sandbox_execution_fences WHERE team_id=$1 AND sandbox_id=$2`, team, sandbox).Scan(&state, &result.ExecutionID)
+	if err != nil {
+		return result, err
+	}
+	if state != "active" && state != "paused" && state != "stopped" {
+		return result, ErrRetention
+	}
+	var registered bool
+	if err = tx.QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM public.sandbox_execution_attempts WHERE team_id=$1 AND sandbox_id=$2 AND execution_id=$3)`, team, sandbox, result.ExecutionID).Scan(&registered); err != nil {
+		return result, err
+	}
+	if !registered {
+		return result, ErrRetention
+	}
+	rows, err := tx.Query(ctx, `SELECT metadata FROM public.sandbox_creation_operations WHERE team_id=$1 AND sandbox_id=$2 AND NOT cancelled
+        UNION ALL SELECT convert_from(request_payload,'UTF8')::jsonb->'metadata' FROM public.sandbox_restore_operations
+        WHERE team_id=$1 AND sandbox_id=$2 AND execution_id=$3 AND state='active'`, team, sandbox, result.ExecutionID)
+	if err != nil {
+		return result, err
+	}
+	count := 0
+	for rows.Next() {
+		var raw []byte
+		if err = rows.Scan(&raw); err != nil {
+			break
+		}
+		count++
+		var owner map[string]string
+		if err = json.Unmarshal(raw, &owner); err != nil {
+			break
+		}
+		result.Metadata = make(map[string]string, 5)
+		for _, key := range []string{"launchpad.managed", "launchpad.allocation_id", "launchpad.operation_id", "launchpad.thread_id", "launchpad.generation", "launchpad.restore", "launchpad.restore_parent_operation_id", "launchpad.restore_boot_attempt"} {
+			if value, ok := owner[key]; ok {
+				result.Metadata[key] = value
+			}
+		}
+	}
+	rows.Close()
+	if err != nil {
+		return result, err
+	}
+	if err = rows.Err(); err != nil {
+		return result, err
+	}
+	if count != 1 || !validRetentionRequest(result.RetentionRequest) {
+		return result, ErrRetention
+	}
+	// Freeze publication in RetainForStop before this same query is repeated.
+	// A failed build is not a ready tip; an unfinished writer is not proven absent.
+	var busy bool
+	err = tx.QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM public.snapshots s
+        JOIN public.env_build_assignments a ON a.env_id=s.env_id
+        JOIN public.env_builds b ON b.id=a.build_id
+        WHERE s.team_id=$1 AND s.sandbox_id=$2 AND b.status_group IN ('pending','in_progress'))`, team, sandbox).Scan(&busy)
+	if err != nil {
+		return result, err
+	}
+	if busy {
+		return result, ErrRetention
+	}
+	rows, err = tx.Query(ctx, `SELECT s.metadata,b.id FROM public.snapshots s
+        JOIN public.envs e ON e.id=s.env_id AND e.team_id=s.team_id
+        LEFT JOIN LATERAL (SELECT a.build_id,a.created_at FROM public.env_build_assignments a
+            JOIN public.env_builds ready ON ready.id=a.build_id AND ready.status_group='ready'
+            WHERE a.env_id=s.env_id AND a.tag='default') tip ON true
+        LEFT JOIN public.env_builds b ON b.id=tip.build_id
+        WHERE s.team_id=$1 AND s.sandbox_id=$2 AND (tip.build_id IS NULL OR tip.created_at=(
+            SELECT max(a.created_at) FROM public.env_build_assignments a JOIN public.env_builds ready ON ready.id=a.build_id AND ready.status_group='ready'
+            WHERE a.env_id=s.env_id AND a.tag='default'))`, team, sandbox)
+	if err != nil {
+		return result, err
+	}
+	count = 0
+	for rows.Next() {
+		var raw []byte
+		if err = rows.Scan(&raw, &result.BuildID); err != nil {
+			break
+		}
+		count++
+		var owner map[string]string
+		if err = json.Unmarshal(raw, &owner); err != nil {
+			break
+		}
+		for key, value := range result.Metadata {
+			if owner[key] != value {
+				err = ErrRetention
+				break
+			}
+		}
+		if err != nil {
+			break
+		}
+	}
+	rows.Close()
+	if err != nil {
+		return result, err
+	}
+	if err = rows.Err(); err != nil {
+		return result, err
+	}
+	if count > 1 {
+		return result, ErrRetention
+	}
+	if result.BuildID != nil {
+		result.Disposition = "ready_tip"
+	}
+	return result, nil
+}
+
+// RetainForStop publishes independent snapshot-template roots and seals the
+// existing execution fence in one transaction. Validation only reads immutable
+// object headers on the host; it must never acquire database locks or boot a VM.
+// ponytail: rare owner recovery holds global catalog writes for this bounded RPC.
+func (s Store) RetainForStop(ctx context.Context, team uuid.UUID, sandbox string, operation uuid.UUID, in RetentionRequest, validate func(context.Context, []uuid.UUID) ([]uuid.UUID, error)) (RetentionReceipt, error) {
+	var empty RetentionReceipt
+	if team == uuid.Nil || sandbox == "" || operation == uuid.Nil || !validRetentionRequest(in) || validate == nil {
+		return empty, ErrRetention
+	}
+	raw, err := json.Marshal(in)
+	if err != nil {
+		return empty, err
+	}
+	db, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return empty, err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	// Same admission lock/order as physical collection. The shared table locks
+	// also exclude internal snapshot workers until the roots and fence commit.
+	if _, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock_shared($1)`, int64(0x4c5041444743)); err != nil {
+		return empty, err
+	}
+	state, err := db.LockExecutionFence(ctx, queries.LockExecutionFenceParams{TeamID: team, SandboxID: sandbox})
+	if err != nil {
+		return empty, err
+	}
+	if _, err = tx.Exec(ctx, `LOCK TABLE public.envs,public.env_builds,public.env_build_assignments,public.snapshots,public.snapshot_templates IN SHARE ROW EXCLUSIVE MODE`); err != nil {
+		return empty, err
+	}
+	var storedRequest, storedReceipt []byte
+	var storedSandbox string
+	var storedExecution uuid.UUID
+	err = tx.QueryRow(ctx, `SELECT sandbox_id,execution_id,request_payload,receipt FROM public.sandbox_execution_retentions WHERE team_id=$1 AND operation_id=$2`, team, operation).Scan(&storedSandbox, &storedExecution, &storedRequest, &storedReceipt)
+	if err == nil {
+		if storedSandbox != sandbox || storedExecution != in.ExecutionID || !bytes.Equal(raw, storedRequest) || (state != "stopping" && state != "stopped") {
+			return empty, ErrRetention
+		}
+		var out RetentionReceipt
+		if err = json.Unmarshal(storedReceipt, &out); err != nil {
+			return empty, err
+		}
+		return out, tx.Commit(ctx)
+	}
+	if !errors.Is(err, pgx.ErrNoRows) {
+		return empty, err
+	}
+	candidate, err := retentionCandidate(ctx, tx, team, sandbox)
+	if err != nil {
+		if errors.Is(err, ErrRetention) {
+			return empty, ErrRetentionCandidateChanged
+		}
+		return empty, err
+	}
+	if candidate.ExecutionID != in.ExecutionID || !maps.Equal(candidate.Metadata, in.Metadata) || (candidate.BuildID == nil) != (in.BuildID == nil) || (in.BuildID != nil && *candidate.BuildID != *in.BuildID) {
+		return empty, ErrRetentionCandidateChanged
+	}
+	digest := sha256.Sum256(raw)
+	out := RetentionReceipt{RetentionCandidate: candidate, Version: 1, Kind: "retained_for_stop", RecoveryOperationID: operation, RetainedBuildIDs: []uuid.UUID{}, RequestSHA256: hex.EncodeToString(digest[:])}
+	if in.BuildID != nil {
+		refs, err := validate(ctx, []uuid.UUID{*in.BuildID})
+		if err != nil {
+			return empty, err
+		}
+		if !slices.Contains(refs, *in.BuildID) {
+			return empty, ErrRetention
+		}
+		slices.SortFunc(refs, func(a, b uuid.UUID) int { return bytes.Compare(a[:], b[:]) })
+		refs = slices.Compact(refs)
+		for _, id := range refs {
+			if id == uuid.Nil {
+				return empty, ErrRetention
+			}
+		}
+		out.RetainedBuildIDs = refs
+		identity := sha256.Sum256(append(append([]byte{}, team[:]...), operation[:]...))
+		template := "lr" + hex.EncodeToString(identity[:])[:18]
+		var node string
+		var cluster *uuid.UUID
+		err = tx.QueryRow(ctx, `SELECT a.node_id,a.cluster_id FROM public.sandbox_execution_attempts a WHERE team_id=$1 AND sandbox_id=$2 AND execution_id=$3 ORDER BY node_id LIMIT 1`, team, sandbox, in.ExecutionID).Scan(&node, &cluster)
+		if err != nil {
+			return empty, err
+		}
+		if cluster != nil && *cluster == uuid.Nil {
+			cluster = nil
+		}
+		created, err := db.CreateSnapshotTemplateEnv(ctx, queries.CreateSnapshotTemplateEnvParams{SnapshotID: template, TeamID: team, ClusterID: cluster, SandboxID: sandbox, OriginNodeID: &node, BuildID: in.BuildID, Tag: "default"})
+		if err != nil {
+			return empty, err
+		}
+		var same bool
+		err = tx.QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM public.snapshot_templates s JOIN public.active_envs e ON e.id=s.env_id AND e.team_id=$2 WHERE s.env_id=$1 AND s.sandbox_id=$3 AND s.build_id=$4)`, created, team, sandbox, *in.BuildID).Scan(&same)
+		if err != nil {
+			return empty, err
+		}
+		if !same {
+			return empty, ErrRetention
+		}
+		out.RetainedTemplateID = &created
+	}
+	// A pre-existing stopped receipt is already permanent admission proof.
+	// Never revive it merely to record retention of any remaining ready tip.
+	if state != "stopped" {
+		if err = db.FenceSandboxExecution(ctx, queries.FenceSandboxExecutionParams{TeamID: team, SandboxID: sandbox}); err != nil {
+			return empty, err
+		}
+	}
+	encoded, err := json.Marshal(out)
+	if err != nil {
+		return empty, err
+	}
+	_, err = tx.Exec(ctx, `INSERT INTO public.sandbox_execution_retentions(team_id,operation_id,sandbox_id,execution_id,request_payload,receipt) VALUES($1,$2,$3,$4,$5,$6)`, team, operation, sandbox, in.ExecutionID, raw, string(encoded))
+	if err != nil {
+		return empty, err
+	}
+	return out, tx.Commit(ctx)
+}
+
+// UpsertSnapshotForExecution publishes durable capture work while holding the
+// same fence used by recovery. A request delayed before its upsert cannot create
+// a late snapshot after retention has sealed admission, even if it read Redis first.
+func (s Store) UpsertSnapshotForExecution(ctx context.Context, execution uuid.UUID, in queries.UpsertSnapshotParams) (queries.UpsertSnapshotRow, error) {
+	var empty queries.UpsertSnapshotRow
+	if execution == uuid.Nil {
+		return empty, ErrFenced
+	}
+	db, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return empty, err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	if _, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock_shared($1)`, int64(0x4c5041444743)); err != nil {
+		return empty, err
+	}
+	state, err := db.LockExecutionFence(ctx, queries.LockExecutionFenceParams{TeamID: in.TeamID, SandboxID: in.SandboxID})
+	if err != nil {
+		return empty, err
+	}
+	if state != "active" {
+		return empty, ErrFenced
+	}
+	var current uuid.UUID
+	if err = tx.QueryRow(ctx, `SELECT current_execution_id FROM sandbox_execution_fences WHERE team_id=$1 AND sandbox_id=$2`, in.TeamID, in.SandboxID).Scan(&current); err != nil {
+		return empty, err
+	}
+	if current != execution {
+		return empty, ErrFenced
+	}
+	result, err := db.UpsertSnapshot(ctx, in)
+	if err != nil {
+		return empty, err
+	}
+	return result, tx.Commit(ctx)
+}
+
+// PublishSnapshotTemplateForExecution keeps the named root and its alias in the
+// same fence transaction. A capture admitted before Stop may be delayed before
+// publication; once Stop seals the fence, it cannot make a missing alias appear.
+func (s Store) PublishSnapshotTemplateForExecution(ctx context.Context, team uuid.UUID, sandbox string, execution uuid.UUID, publish func(*client.Client) (string, error)) (string, error) {
+	if execution == uuid.Nil {
+		return "", ErrFenced
+	}
+	db, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return "", err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	if _, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock_shared($1)`, int64(0x4c5041444743)); err != nil {
+		return "", err
+	}
+	state, err := db.LockExecutionFence(ctx, queries.LockExecutionFenceParams{TeamID: team, SandboxID: sandbox})
+	if err != nil {
+		return "", err
+	}
+	var current uuid.UUID
+	if err = tx.QueryRow(ctx, `SELECT current_execution_id FROM sandbox_execution_fences WHERE team_id=$1 AND sandbox_id=$2`, team, sandbox).Scan(&current); err != nil {
+		return "", err
+	}
+	if state != "active" || current != execution {
+		return "", ErrFenced
+	}
+	result, err := publish(db)
+	if err != nil {
+		return "", err
+	}
+	return result, tx.Commit(ctx)
+}
