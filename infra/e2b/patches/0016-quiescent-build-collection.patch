+
+func capabilityServer(t *testing.T, enabled bool) *httptest.Server {
+	t.Helper()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		require.Equal(t, "/extensions/launchpad/v1/capabilities", r.URL.Path)
+		require.Equal(t, "proof-key", r.Header.Get("X-API-Key"))
+		require.NoError(t, json.NewEncoder(w).Encode(map[string]any{"version": 1, "buildCollectionAdmission": enabled}))
+	}))
+	t.Cleanup(server.Close)
+	return server
+}
+func TestCollectorDryRunAndDeletionKeepRetainedLayers(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	team := testutils.CreateTestTeam(t, db)
+	liveEnv := testutils.CreateTestTemplate(t, db, team)
+	live := testutils.CreateTestBuild(t, t.Context(), db, liveEnv, "uploaded")
+	testutils.CreateTestBuildAssignment(t, t.Context(), db, liveEnv, live, "default")
+	oldEnv := testutils.CreateTestTemplate(t, db, team)
+	ancestor := testutils.CreateTestBuild(t, t.Context(), db, oldEnv, "uploaded")
+	dead := testutils.CreateTestBuild(t, t.Context(), db, oldEnv, "uploaded")
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), "UPDATE public.envs SET deleted_at=now() WHERE id=$1", oldEnv))
+	source := t.TempDir()
+	store, err := storage.NewProvider(t.Context(), storage.Spec{Provider: storage.LocalStorageProvider, BasePath: source})
+	require.NoError(t, err)
+	paths := storage.Paths{BuildID: live.String()}
+	data, err := json.Marshal(metadata.Template{Version: metadata.CurrentVersion, Template: metadata.TemplateMetadata{BuildID: live.String()}, FilesystemOnly: true})
+	require.NoError(t, err)
+	blob, err := store.OpenBlob(t.Context(), paths.Metadata())
+	require.NoError(t, err)
+	require.NoError(t, blob.Put(t.Context(), data))
+	h, err := header.NewHeader(&header.Metadata{Version: 3, BuildId: live, BlockSize: 4096, Size: 4096}, []header.BuildMap{{Length: 4096, BuildId: ancestor}})
+	require.NoError(t, err)
+	_, _, _, err = header.StoreHeader(t.Context(), store, paths.RootfsHeader(), h)
+	require.NoError(t, err)
+	for _, id := range []uuid.UUID{ancestor, dead} {
+		blob, err = store.OpenBlob(t.Context(), id.String()+"/rootfs")
+		require.NoError(t, err)
+		require.NoError(t, blob.Put(t.Context(), []byte("payload")))
+	}
+	input := settings{DatabaseURL: db.ConnStr(), StoragePath: source, APIURL: capabilityServer(t, true).URL, APIKey: "proof-key"}
+	out, err := collect(t.Context(), input, false)
+	require.NoError(t, err)
+	require.True(t, out.DryRun)
+	require.Equal(t, 2, out.RetainedBuilds)
+	require.Equal(t, []uuid.UUID{dead}, out.UnreferencedBuilds)
+	require.Empty(t, out.DeletedBuilds)
+	blob, err = store.OpenBlob(t.Context(), dead.String()+"/rootfs")
+	require.NoError(t, err)
+	exists, err := blob.Exists(t.Context())
+	require.NoError(t, err)
+	require.True(t, exists)
+	out, err = collect(t.Context(), input, true)
+	require.NoError(t, err)
+	require.False(t, out.DryRun)
+	require.Equal(t, []uuid.UUID{dead}, out.DeletedBuilds)
+	exists, err = blob.Exists(t.Context())
+	require.NoError(t, err)
+	require.False(t, exists)
+	blob, err = store.OpenBlob(t.Context(), ancestor.String()+"/rootfs")
+	require.NoError(t, err)
+	bytes, err := storage.GetBlob(t.Context(), blob)
+	require.NoError(t, err)
+	require.Equal(t, "payload", string(bytes))
+}
+func TestCollectorRequiresVerifiedLocalAPIAdmission(t *testing.T) {
+	// No valid database or storage is needed: admission must fail first.
+	input := settings{APIURL: capabilityServer(t, false).URL, APIKey: "proof-key"}
+	_, err := collect(t.Context(), input, true)
+	require.ErrorContains(t, err, "does not admit")
+	input.APIURL = "https://example.invalid"
+	err = verifyAdmission(t.Context(), input)
+	require.ErrorContains(t, err, "loopback API")
+}
