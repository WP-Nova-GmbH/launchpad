+func TestApprovedCollectionCannotWidenAfterNewRetirement(t *testing.T) {
+	for _, live := range []bool{false, true} {
+		name := "idle"
+		if live {
+			name = "live"
+		}
+		t.Run(name, func(t *testing.T) {
+			db := testutils.SetupDatabase(t)
+			team := testutils.CreateTestTeam(t, db)
+			rootEnv := testutils.CreateTestTemplate(t, db, team)
+			root := testutils.CreateTestBuild(t, t.Context(), db, rootEnv, "uploaded")
+			testutils.CreateTestBuildAssignment(t, t.Context(), db, rootEnv, root, "default")
+			retiredEnv := testutils.CreateTestTemplate(t, db, team)
+			ancestor := testutils.CreateTestBuild(t, t.Context(), db, retiredEnv, "uploaded")
+			approvedDead := testutils.CreateTestBuild(t, t.Context(), db, retiredEnv, "uploaded")
+			require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), "UPDATE public.envs SET deleted_at=now() WHERE id=$1", retiredEnv))
+			laterEnv := testutils.CreateTestTemplate(t, db, team)
+			laterDead := testutils.CreateTestBuild(t, t.Context(), db, laterEnv, "uploaded")
+			testutils.CreateTestBuildAssignment(t, t.Context(), db, laterEnv, laterDead, "default")
+			if live {
+				p := queries.InsertExecutionAttemptParams{TeamID: team, SandboxID: uuid.NewString(), ExecutionID: uuid.New(), ClusterID: uuid.Nil, NodeID: "live-host"}
+				require.NoError(t, (executions.Store{DB: db.SqlcClient}).Register(t.Context(), p, root, true))
+			}
+			source := t.TempDir()
+			store, err := storage.NewProvider(t.Context(), storage.Spec{Provider: storage.LocalStorageProvider, BasePath: source})
+			require.NoError(t, err)
+			putRoot := func(id, parent uuid.UUID) {
+				paths := storage.Paths{BuildID: id.String()}
+				data, err := json.Marshal(metadata.Template{Version: metadata.CurrentVersion, Template: metadata.TemplateMetadata{BuildID: id.String()}, FilesystemOnly: true})
+				require.NoError(t, err)
+				blob, err := store.OpenBlob(t.Context(), paths.Metadata())
+				require.NoError(t, err)
+				require.NoError(t, blob.Put(t.Context(), data))
+				h, err := header.NewHeader(&header.Metadata{Version: 3, BuildId: id, BlockSize: 4096, Size: 4096}, []header.BuildMap{{Length: 4096, BuildId: parent}})
+				require.NoError(t, err)
+				_, _, _, err = header.StoreHeader(t.Context(), store, paths.RootfsHeader(), h)
+				require.NoError(t, err)
+			}
+			putRoot(root, ancestor)
+			putRoot(laterDead, laterDead)
+			for _, id := range []uuid.UUID{ancestor, approvedDead, laterDead} {
+				blob, err := store.OpenBlob(t.Context(), id.String()+"/rootfs")
+				require.NoError(t, err)
+				require.NoError(t, blob.Put(t.Context(), []byte("kept bytes")))
+			}
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				require.Equal(t, "proof-key", r.Header.Get("X-API-Key"))
+				require.NoError(t, json.NewEncoder(w).Encode(map[string]any{"version": 1, "buildCollectionAdmission": true, "executionBuildRoots": true, "liveBuildCollection": true}))
+			}))
+			t.Cleanup(server.Close)
+			input := settings{DatabaseURL: db.ConnStr(), StoragePath: source, APIURL: server.URL, APIKey: "proof-key", ApprovedBuilds: []uuid.UUID{root, ancestor, approvedDead, approvedDead}}
+			out, err := collect(t.Context(), input, false, live)
+			require.NoError(t, err)
+			require.Equal(t, 3, out.RetainedBuilds)
+			require.ElementsMatch(t, []uuid.UUID{root, ancestor, approvedDead}, out.ApprovedBuilds)
+			require.Equal(t, []uuid.UUID{approvedDead}, out.UnreferencedBuilds)
+
+			// A build that becomes collectable between review and apply must
+			// remain untouched unless the operator approved that build too.
+			require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), "UPDATE public.envs SET deleted_at=now() WHERE id=$1", laterEnv))
+			emptyScope := input
+			emptyScope.ApprovedBuilds = []uuid.UUID{}
+			out, err = collect(t.Context(), emptyScope, true, live)
+			require.NoError(t, err)
+			require.Empty(t, out.UnreferencedBuilds)
+			require.Empty(t, out.DeletedBuilds)
+			out, err = collect(t.Context(), input, true, live)
+			require.NoError(t, err)
+			require.Equal(t, 2, out.RetainedBuilds)
+			require.Equal(t, []uuid.UUID{approvedDead}, out.UnreferencedBuilds)
+			require.Equal(t, []uuid.UUID{approvedDead}, out.DeletedBuilds)
+			for _, id := range []uuid.UUID{ancestor, laterDead} {
+				blob, err := store.OpenBlob(t.Context(), id.String()+"/rootfs")
+				require.NoError(t, err)
+				data, err := storage.GetBlob(t.Context(), blob)
+				require.NoError(t, err)
+				require.Equal(t, "kept bytes", string(data))
+			}
+			// Omitting approval retains the existing automatic collector policy.
+			blob, err := store.OpenBlob(t.Context(), laterDead.String()+"/rootfs")
+			require.NoError(t, err)
+			input.ApprovedBuilds = nil
+			out, err = collect(t.Context(), input, true, live)
+			require.NoError(t, err)
+			require.Contains(t, out.DeletedBuilds, laterDead)
+			require.NotContains(t, out.DeletedBuilds, ancestor)
+			require.NotContains(t, out.DeletedBuilds, root)
+			exists, err := blob.Exists(t.Context())
+			require.NoError(t, err)
+			require.False(t, exists)
+		})
+	}
+}
