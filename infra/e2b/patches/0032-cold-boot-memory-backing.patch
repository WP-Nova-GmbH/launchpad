+
+func TestPreparedRestoreUsesSupportedHugePages(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		name      string
+		version   string
+		hugePages bool
+		invalid   bool
+	}{
+		{name: "pinned runtime", version: "v1.14-0.2.0", hugePages: true},
+		{name: "upstream supported", version: "v1.7.0", hugePages: true},
+		{name: "older runtime", version: "v1.6.0"},
+		{name: "unknown runtime", version: "fc", invalid: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			build := queries.EnvBuild{FirecrackerVersion: tc.version, EnvdVersion: new("envd"), TotalDiskSizeMb: new(int64(64)), RamMb: 4096, Vcpu: 2}
+			team := &teamtypes.Team{Limits: &teamtypes.TeamLimits{MaxLengthHours: 1}}
+			request, err := BuildRestoreRequest(queries.SandboxRestoreOperation{}, build, team, api.LaunchpadRestoreRequest{LeaseSeconds: new(600)}, time.Now())
+			if tc.invalid {
+				require.Error(t, err)
+				require.Nil(t, request)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tc.hugePages, request.GetSandbox().GetHugePages())
+			require.True(t, request.GetFilesystemBoot(), "memory backing must not restore saved processes")
+			require.Equal(t, int64(4096), request.GetSandbox().GetRamMb(), "memory backing must retain the admitted VM size")
+		})
+	}
+}
