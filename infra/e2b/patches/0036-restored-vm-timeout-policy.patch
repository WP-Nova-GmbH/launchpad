+func TestPreparedRestoreTimeoutPolicySurvivesDurableRequest(t *testing.T) {
+	t.Parallel()
+	now := time.Date(2026, 10, 1, 12, 0, 0, 0, time.UTC)
+	build := queries.EnvBuild{FirecrackerVersion: "v1.14-0.2.0", EnvdVersion: new("envd"), TotalDiskSizeMb: new(int64(64)), RamMb: 1024, Vcpu: 1}
+	team := &teamtypes.Team{Limits: &teamtypes.TeamLimits{MaxLengthHours: 1}}
+	request, err := BuildRestoreRequest(queries.SandboxRestoreOperation{}, build, team, api.LaunchpadRestoreRequest{LeaseSeconds: new(600)}, now)
+	require.NoError(t, err)
+	raw, err := protojson.Marshal(request)
+	require.NoError(t, err)
+	restored := &rpc.SandboxCreateRequest{}
+	require.NoError(t, protojson.Unmarshal(raw, restored))
+	require.True(t, restored.GetSandbox().GetAutoPause(), "a finite restore lease must preserve the disk on timeout")
+	require.True(t, restored.GetSandbox().GetAutoPauseFilesystemOnly(), "timeout must enter the certified filesystem pause path")
+	require.Nil(t, restored.GetSandbox().GetAutoResume(), "inbound traffic must not wake the restored VM")
+	require.True(t, restored.GetFilesystemBoot(), "policy persistence must not restore process memory")
+	require.Equal(t, now.Add(10*time.Minute), restored.GetEndTime().AsTime())
+}
