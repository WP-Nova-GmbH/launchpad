+// Use the production snapshot SQL: it appends assignments and keeps one internal
+// snapshot env across captures, the behavior simplified build fixtures can miss.
+func appendSnapshot(t *testing.T, db *testutils.Database, team uuid.UUID, base, sandbox string, source uuid.UUID) queries.UpsertSnapshotRow {
+	t.Helper()
+	row, err := db.SqlcClient.UpsertSnapshot(t.Context(), queries.UpsertSnapshotParams{
+		TemplateID: "snapshot-" + uuid.NewString(), TeamID: team, SandboxID: sandbox,
+		BaseTemplateID: base, StartedAt: pgtype.Timestamptz{Time: time.Now(), Valid: true},
+		OriginNodeID: "test-node", Vcpu: 2, RamMb: 2048, FreeDiskSizeMb: 512,
+		KernelVersion: "6.1.0", FirecrackerVersion: "1.4.0", Status: "building", SourceBuildID: source,
+	})
+	require.NoError(t, err)
+	return row
+}
+
+func TestPinnedCatalogSnapshotHistoryReleasesOnlySupersededUnpinnedBuilds(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	team := testutils.CreateTestTeam(t, db)
+	base := testutils.CreateTestTemplate(t, db, team)
+	boot := testutils.CreateTestBuild(t, t.Context(), db, base, "uploaded")
+	sandbox := uuid.NewString()
+	first := appendSnapshot(t, db, team, base, sandbox, boot)
+	require.NoError(t, db.SqlcClient.UpdateEnvBuildStatus(t.Context(), queries.UpdateEnvBuildStatusParams{BuildID: first.BuildID, Status: "uploaded"}))
+	saved, err := db.SqlcClient.CreateSnapshotTemplateEnv(t.Context(), queries.CreateSnapshotTemplateEnvParams{
+		SnapshotID: "saved-" + uuid.NewString(), TeamID: team, SandboxID: sandbox, BuildID: &first.BuildID, Tag: "default",
+	})
+	require.NoError(t, err)
+	second := appendSnapshot(t, db, team, base, sandbox, boot)
+	require.Equal(t, first.TemplateID, second.TemplateID)
+	called := false
+	require.ErrorIs(t, WithPinnedCatalog(t.Context(), db.SqlcClient, func(Catalog) error { called = true; return nil }), ErrBusy)
+	require.False(t, called, "an incomplete newer snapshot must block deletion")
+	require.NoError(t, db.SqlcClient.UpdateEnvBuildStatus(t.Context(), queries.UpdateEnvBuildStatusParams{BuildID: second.BuildID, Status: "uploaded"}))
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), "UPDATE public.env_build_assignments SET created_at='2026-10-01T00:00:00Z' WHERE build_id=$1", first.BuildID))
+	require.NoError(t, WithPinnedCatalog(t.Context(), db.SqlcClient, func(c Catalog) error {
+		require.ElementsMatch(t, []uuid.UUID{boot, first.BuildID, second.BuildID}, c.Roots)
+		return nil
+	}))
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), "UPDATE public.envs SET deleted_at=now() WHERE id=$1", saved))
+	require.NoError(t, WithPinnedCatalog(t.Context(), db.SqlcClient, func(c Catalog) error {
+		require.ElementsMatch(t, []uuid.UUID{boot, second.BuildID}, c.Roots)
+		require.Contains(t, c.Candidates, first.BuildID, "historical snapshot bytes should now be eligible")
+		return nil
+	}))
+	// The resumed VM may still boot from the older disk; registration protects it
+	// independently of the current snapshot tip and the retired backup's env.
+	registry := executions.Store{DB: db.SqlcClient}
+	require.NoError(t, registry.Register(t.Context(), queries.InsertExecutionAttemptParams{TeamID: team, SandboxID: sandbox, ExecutionID: uuid.New(), NodeID: "test-node"}, first.BuildID, true))
+	require.NoError(t, WithPinnedCatalog(t.Context(), db.SqlcClient, func(c Catalog) error {
+		require.ElementsMatch(t, []uuid.UUID{boot, first.BuildID, second.BuildID}, c.Roots)
+		return nil
+	}))
+}
