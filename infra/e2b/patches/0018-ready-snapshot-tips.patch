+func TestPinnedCatalogFailedLatestSnapshotKeepsPreviousResumeDisk(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	team := testutils.CreateTestTeam(t, db)
+	base := testutils.CreateTestTemplate(t, db, team)
+	boot := testutils.CreateTestBuild(t, t.Context(), db, base, "uploaded")
+	sandbox := uuid.NewString()
+	first := appendSnapshot(t, db, team, base, sandbox, boot)
+	require.NoError(t, db.SqlcClient.UpdateEnvBuildStatus(t.Context(), queries.UpdateEnvBuildStatusParams{BuildID: first.BuildID, Status: "uploaded"}))
+	failed := appendSnapshot(t, db, team, base, sandbox, boot)
+	require.NoError(t, db.SqlcClient.UpdateEnvBuildStatus(t.Context(), queries.UpdateEnvBuildStatusParams{BuildID: failed.BuildID, Status: "failed"}))
+	latest, err := db.SqlcClient.GetLastSnapshot(t.Context(), sandbox)
+	require.NoError(t, err)
+	require.Equal(t, first.BuildID, latest.EnvBuild.ID)
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), "UPDATE public.envs SET deleted_at=now() WHERE id=$1", first.TemplateID))
+	require.NoError(t, WithPinnedCatalog(t.Context(), db.SqlcClient, func(c Catalog) error {
+		require.ElementsMatch(t, []uuid.UUID{boot, first.BuildID}, c.Roots)
+		require.Contains(t, c.Candidates, failed.BuildID)
+		return nil
+	}))
+	// Positive stop cleanup deletes the snapshot record; soft deletion alone did not.
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), "DELETE FROM public.snapshots WHERE sandbox_id=$1", sandbox))
+	require.NoError(t, WithPinnedCatalog(t.Context(), db.SqlcClient, func(c Catalog) error {
+		require.ElementsMatch(t, []uuid.UUID{boot}, c.Roots)
+		return nil
+	}))
+}
