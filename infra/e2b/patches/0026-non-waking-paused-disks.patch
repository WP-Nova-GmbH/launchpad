+func TestPausedDiskRejectsMemorySnapshotsChangedTipsAndAliasCollisions(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	team := testutils.CreateTestTeam(t, db)
+	namespace := testutils.GetTeamSlug(t, t.Context(), db, team)
+	base := testutils.CreateTestTemplate(t, db, team)
+	sbx := "paused-" + uuid.NewString()
+	snap := testutils.UpsertTestSnapshot(t, t.Context(), db, "disk-"+uuid.NewString(), sbx, team, base)
+	store := executions.Store{DB: db.SqlcClient}
+	attempt := queries.InsertExecutionAttemptParams{TeamID: team, SandboxID: sbx, ExecutionID: uuid.New(), ClusterID: uuid.Nil, NodeID: "host"}
+	require.NoError(t, store.Register(t.Context(), attempt, uuid.New(), true))
+	require.ErrorIs(t, store.MarkPaused(t.Context(), team, sbx, attempt.ExecutionID, snap.BuildID, func(attempts []queries.SandboxExecutionAttempt) error { require.Len(t, attempts, 1); return nil }), executions.ErrPausedDisk)
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), `UPDATE snapshots SET config='{"filesystemOnly":true}',metadata='{"launchpad.managed":"thread-vm-v1"}' WHERE sandbox_id=$1`, sbx))
+	require.NoError(t, store.MarkPaused(t.Context(), team, sbx, attempt.ExecutionID, snap.BuildID, func(attempts []queries.SandboxExecutionAttempt) error { require.Len(t, attempts, 1); return nil }))
+	alias := "launchpad-backup-" + uuid.NewString()
+	testutils.CreateTestTemplateAliasWithName(t, db, base, alias, &namespace)
+	_, err := store.RetainPausedDisk(t.Context(), team, sbx, namespace, alias)
+	require.Error(t, err, "existing ordinary template must not be overwritten")
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), `UPDATE env_builds SET status='failed' WHERE id=$1`, snap.BuildID))
+	_, err = store.RetainPausedDisk(t.Context(), team, sbx, namespace, "launchpad-backup-"+uuid.NewString())
+	require.ErrorIs(t, err, executions.ErrPausedDisk)
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), `UPDATE env_builds SET status='success' WHERE id=$1`, snap.BuildID))
+	// A different published tip cannot inherit the prior pause acknowledgement.
+	newer := testutils.UpsertTestSnapshot(t, t.Context(), db, snap.TemplateID, sbx, team, base)
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), `UPDATE env_build_assignments SET created_at=created_at+interval '1 second' WHERE build_id=$1`, newer.BuildID))
+	_, err = store.RetainPausedDisk(t.Context(), team, sbx, namespace, "launchpad-backup-"+uuid.NewString())
+	require.ErrorIs(t, err, executions.ErrPausedDisk)
+	_, err = store.BeginStop(t.Context(), team, sbx)
+	require.NoError(t, err)
+	require.ErrorIs(t, store.Register(t.Context(), attempt, uuid.New(), true), executions.ErrFenced)
+}
