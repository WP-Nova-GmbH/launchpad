+func TestPausedDiskRequiresEveryPhysicalStopBeforePublishingItsReceipt(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	team := testutils.CreateTestTeam(t, db)
+	namespace := testutils.GetTeamSlug(t, t.Context(), db, team)
+	base := testutils.CreateTestTemplate(t, db, team)
+	sbx := "paused-" + uuid.NewString()
+	snap := testutils.UpsertTestSnapshot(t, t.Context(), db, "disk-"+uuid.NewString(), sbx, team, base)
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), `UPDATE snapshots SET config='{"filesystemOnly":true}',metadata='{"launchpad.managed":"thread-vm-v1"}' WHERE sandbox_id=$1`, sbx))
+	store := executions.Store{DB: db.SqlcClient}
+	attempt := queries.InsertExecutionAttemptParams{TeamID: team, SandboxID: sbx, ExecutionID: uuid.New(), ClusterID: uuid.Nil, NodeID: "host-a"}
+	build := uuid.New()
+	require.NoError(t, store.Register(t.Context(), attempt, build, true))
+	second := attempt
+	second.NodeID = "host-b"
+	require.NoError(t, store.Register(t.Context(), second, build, true))
+	require.ErrorIs(t, store.MarkPaused(t.Context(), team, sbx, attempt.ExecutionID, snap.BuildID, nil), executions.ErrPausedDisk)
+	uncertain := errors.New("second host is unavailable")
+	err := store.MarkPaused(t.Context(), team, sbx, attempt.ExecutionID, snap.BuildID, func(attempts []queries.SandboxExecutionAttempt) error {
+		require.Len(t, attempts, 2)
+		return uncertain
+	})
+	require.ErrorIs(t, err, uncertain)
+	_, err = store.RetainPausedDisk(t.Context(), team, sbx, namespace, "launchpad-backup-"+uuid.NewString())
+	require.ErrorIs(t, err, executions.ErrPausedDisk)
+	require.NoError(t, store.MarkPaused(t.Context(), team, sbx, attempt.ExecutionID, snap.BuildID, func(attempts []queries.SandboxExecutionAttempt) error {
+		require.Len(t, attempts, 2)
+		return nil
+	}))
+	_, err = store.RetainPausedDisk(t.Context(), team, sbx, namespace, "launchpad-backup-"+uuid.NewString())
+	require.NoError(t, err)
+}
+
+func TestPausedDiskRetainsOneIndependentBuildWithoutBooting(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	team := testutils.CreateTestTeam(t, db)
+	other := testutils.CreateTestTeam(t, db)
+	namespace := testutils.GetTeamSlug(t, t.Context(), db, team)
+	base := testutils.CreateTestTemplate(t, db, team)
+	sbx := "paused-" + uuid.NewString()
+	snap := testutils.UpsertTestSnapshot(t, t.Context(), db, "disk-"+uuid.NewString(), sbx, team, base)
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), `UPDATE snapshots SET config='{"filesystemOnly":true}',metadata='{"launchpad.managed":"thread-vm-v1"}' WHERE sandbox_id=$1`, sbx))
+	store := executions.Store{DB: db.SqlcClient}
+	attempt := queries.InsertExecutionAttemptParams{TeamID: team, SandboxID: sbx, ExecutionID: uuid.New(), ClusterID: uuid.Nil, NodeID: "host"}
+	require.NoError(t, store.Register(t.Context(), attempt, uuid.New(), true))
+	alias := "launchpad-backup-" + uuid.NewString()
+	_, err := store.RetainPausedDisk(t.Context(), team, sbx, namespace, alias)
+	require.ErrorIs(t, err, executions.ErrPausedDisk, "routing absence or a snapshot alone is insufficient")
+	require.Error(t, store.MarkPaused(t.Context(), other, sbx, attempt.ExecutionID, snap.BuildID, func(attempts []queries.SandboxExecutionAttempt) error { require.Len(t, attempts, 1); return nil }))
+	require.ErrorIs(t, store.MarkPaused(t.Context(), team, sbx, uuid.New(), snap.BuildID, func(attempts []queries.SandboxExecutionAttempt) error { require.Len(t, attempts, 1); return nil }), executions.ErrPausedDisk)
+	require.ErrorIs(t, store.MarkPaused(t.Context(), team, sbx, attempt.ExecutionID, uuid.New(), func(attempts []queries.SandboxExecutionAttempt) error { require.Len(t, attempts, 1); return nil }), executions.ErrPausedDisk)
+	require.NoError(t, store.MarkPaused(t.Context(), team, sbx, attempt.ExecutionID, snap.BuildID, func(attempts []queries.SandboxExecutionAttempt) error { require.Len(t, attempts, 1); return nil }))
+	require.NoError(t, store.MarkPaused(t.Context(), team, sbx, attempt.ExecutionID, snap.BuildID, func(attempts []queries.SandboxExecutionAttempt) error { require.Len(t, attempts, 1); return nil }))
+	require.ErrorIs(t, store.Register(t.Context(), attempt, uuid.New(), true), executions.ErrFenced, "old execution cannot reactivate itself")
+	var group sync.WaitGroup
+	results := make([]string, 4)
+	errors := make([]error, 4)
+	for i := range results {
+		group.Go(func() { results[i], errors[i] = store.RetainPausedDisk(t.Context(), team, sbx, namespace, alias) })
+	}
+	group.Wait()
+	for i := range results {
+		require.NoError(t, errors[i])
+		require.Equal(t, results[0], results[i])
+	}
+	_, err = store.RetainPausedDisk(t.Context(), other, sbx, namespace, alias)
+	require.Error(t, err)
+	// A new explicit resume clears the receipt before any boot RPC.
+	resumed := attempt
+	resumed.ExecutionID = uuid.New()
+	require.NoError(t, store.Register(t.Context(), resumed, snap.BuildID, true))
+	_, err = store.RetainPausedDisk(t.Context(), team, sbx, namespace, "launchpad-backup-"+uuid.NewString())
+	require.ErrorIs(t, err, executions.ErrPausedDisk)
+	require.ErrorIs(t, store.MarkPaused(t.Context(), team, sbx, attempt.ExecutionID, snap.BuildID, func(attempts []queries.SandboxExecutionAttempt) error { require.Len(t, attempts, 1); return nil }), executions.ErrPausedDisk, "late pause response cannot freeze the resumed guest")
+	// Delete the source pause record; its independent template still points at
+	// the same immutable build, retaining it in the storage catalog.
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), `DELETE FROM snapshots WHERE sandbox_id=$1`, sbx))
+	templates, err := db.SqlcClient.ListTeamSnapshotTemplates(t.Context(), queries.ListTeamSnapshotTemplatesParams{TeamID: team, CursorID: "zzzzzzzzzzzzzzzzzzzzzzzz", CursorTime: time.Now().Add(time.Hour), PageLimit: 100})
+	require.NoError(t, err)
+	require.Len(t, templates, 1)
+	require.Equal(t, results[0], templates[0].SnapshotID)
+	require.Equal(t, snap.BuildID, templates[0].BuildID)
+}
