+package executions
+
+import (
+	"context"
+	"errors"
+
+	"github.com/e2b-dev/infra/packages/db/queries"
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+)
+
+var ErrPausedDisk = errors.New("no confirmed paused disk matches this request")
+
+// MarkPaused is called after a successful filesystem-only pause RPC and durable
+// build publication. A late pause reply cannot overwrite a newer execution.
+func (s Store) MarkPaused(ctx context.Context, team uuid.UUID, sandbox string, execution, build uuid.UUID, confirm func([]queries.SandboxExecutionAttempt) error) error {
+	if confirm == nil {
+		return ErrPausedDisk
+	}
+	db, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	state, err := db.LockExecutionFence(ctx, queries.LockExecutionFenceParams{TeamID: team, SandboxID: sandbox})
+	if err != nil {
+		return err
+	}
+	if state != "active" && state != "paused" {
+		return ErrFenced
+	}
+	result, err := tx.Exec(ctx, `UPDATE public.sandbox_execution_fences f
+        SET state='paused', paused_build_id=$4
+        WHERE team_id=$1 AND sandbox_id=$2 AND current_execution_id=$3
+        AND (paused_build_id IS NULL OR paused_build_id=$4)
+        AND EXISTS(SELECT 1 FROM public.sandbox_execution_build_roots r
+            WHERE r.team_id=f.team_id AND r.sandbox_id=f.sandbox_id AND r.execution_id=$3)
+        AND EXISTS(SELECT 1 FROM public.snapshots s
+            JOIN public.env_build_assignments a ON a.env_id=s.env_id AND a.tag='default'
+            JOIN public.env_builds b ON b.id=a.build_id
+            WHERE s.team_id=f.team_id AND s.sandbox_id=f.sandbox_id AND b.id=$4
+              AND b.status_group='ready' AND s.config->>'filesystemOnly'='true'
+              AND s.metadata->>'launchpad.managed'='thread-vm-v1')`, team, sandbox, execution, build)
+	if err != nil {
+		return err
+	}
+	if result.RowsAffected() != 1 {
+		return ErrPausedDisk
+	}
+	attempts, err := db.ListExecutionAttempts(ctx, queries.ListExecutionAttemptsParams{TeamID: team, SandboxID: sandbox})
+	if err != nil {
+		return err
+	}
+	if len(attempts) == 0 {
+		return ErrPausedDisk
+	}
+	if err := confirm(attempts); err != nil {
+		return err
+	}
+	return tx.Commit(ctx)
+}
+
+// RetainPausedDisk atomically names the immutable disk already saved by pause.
+// It has no host RPC or boot path. Admission and physical collection share this
+// fence/catalog locking protocol; resuming clears the receipt before booting.
+func (s Store) RetainPausedDisk(ctx context.Context, team uuid.UUID, sandbox, namespace, alias string) (string, error) {
+	if team == uuid.Nil || sandbox == "" || namespace == "" || alias == "" {
+		return "", ErrPausedDisk
+	}
+	db, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return "", err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	state, err := db.LockExecutionFence(ctx, queries.LockExecutionFenceParams{TeamID: team, SandboxID: sandbox})
+	if err != nil {
+		return "", err
+	}
+	if state != "paused" {
+		return "", ErrPausedDisk
+	}
+	// Same alias cannot refer to two source sandboxes under concurrent requests.
+	if _, err := tx.Exec(ctx, `SELECT pg_advisory_xact_lock(hashtextextended($1, 83))`, namespace+"/"+alias); err != nil {
+		return "", err
+	}
+	var build uuid.UUID
+	var node string
+	var cluster *uuid.UUID
+	err = tx.QueryRow(ctx, `SELECT b.id,s.origin_node_id,e.cluster_id
+        FROM public.sandbox_execution_fences f
+        JOIN public.snapshots s ON s.team_id=f.team_id AND s.sandbox_id=f.sandbox_id
+        JOIN public.active_envs e ON e.id=s.env_id AND e.team_id=f.team_id
+        JOIN LATERAL (SELECT a.build_id FROM public.env_build_assignments a
+            JOIN public.env_builds b ON b.id=a.build_id AND b.status_group='ready'
+            WHERE a.env_id=s.env_id AND a.tag='default' ORDER BY a.created_at DESC LIMIT 1) tip ON true
+        JOIN public.env_builds b ON b.id=tip.build_id AND b.id=f.paused_build_id
+        WHERE f.team_id=$1 AND f.sandbox_id=$2 AND f.current_execution_id IS NOT NULL
+          AND s.config->>'filesystemOnly'='true' AND s.metadata->>'launchpad.managed'='thread-vm-v1'`, team, sandbox).Scan(&build, &node, &cluster)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return "", ErrPausedDisk
+	}
+	if err != nil {
+		return "", err
+	}
+	var existing, source string
+	var recorded uuid.UUID
+	err = tx.QueryRow(ctx, `SELECT e.id,st.sandbox_id,st.build_id FROM public.env_aliases a
+        JOIN public.active_envs e ON e.id=a.env_id AND e.team_id=$3 AND e.source='snapshot_template'
+        JOIN public.snapshot_templates st ON st.env_id=e.id
+        WHERE a.namespace=$1 AND a.alias=$2`, namespace, alias, team).Scan(&existing, &source, &recorded)
+	if err == nil {
+		if source != sandbox || recorded != build {
+			return "", ErrPausedDisk
+		}
+		return existing, tx.Commit(ctx)
+	}
+	if !errors.Is(err, pgx.ErrNoRows) {
+		return "", err
+	}
+	// Generate inside this transaction; retry sees the committed alias, never
+	// overwrites it or adds a second mutable build assignment.
+	template := "lp" + uuid.NewString()[0:8] + uuid.NewString()[0:8]
+	env, err := db.CreateSnapshotTemplateEnv(ctx, queries.CreateSnapshotTemplateEnvParams{
+		SnapshotID: template, TeamID: team, ClusterID: cluster, SandboxID: sandbox,
+		OriginNodeID: &node, BuildID: &build, Tag: "default",
+	})
+	if err != nil {
+		return "", err
+	}
+	if err := db.CreateTemplateAlias(ctx, queries.CreateTemplateAliasParams{Alias: alias, TemplateID: env, Namespace: &namespace}); err != nil {
+		return "", err
+	}
+	return env, tx.Commit(ctx)
+}
