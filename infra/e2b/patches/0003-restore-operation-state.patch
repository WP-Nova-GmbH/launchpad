+	n, err = db.SqlcClient.FinishRestoreOperation(t.Context(), queries.FinishRestoreOperationParams{TeamID: p.TeamID, OperationID: p.OperationID, ClaimID: &id, TerminalState: "cancelled"})
+	require.NoError(t, err)
