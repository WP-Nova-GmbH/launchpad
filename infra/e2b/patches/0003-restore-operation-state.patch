+	p := createOperation(t, db)
+	old := uuid.New()
+	rows, err := db.SqlcClient.ClaimRestoreOperations(t.Context(), queries.ClaimRestoreOperationsParams{ClaimID: &old, ClaimUntil: time.Now().Add(-time.Minute), BatchSize: 1})
+	require.NoError(t, err)
