+package orchestrator
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/google/uuid"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/timestamppb"
+
+	"github.com/e2b-dev/infra/packages/api/internal/api"
+	"github.com/e2b-dev/infra/packages/api/internal/sandbox"
+	teamtypes "github.com/e2b-dev/infra/packages/auth/pkg/types"
+	dbtypes "github.com/e2b-dev/infra/packages/db/pkg/types"
+	"github.com/e2b-dev/infra/packages/db/queries"
+	rpc "github.com/e2b-dev/infra/packages/shared/pkg/grpc/orchestrator"
+)
+
+// RestoreClient deliberately uses the recorded node. Normal placement may
+// retry another node; a prepared disk and uncertain boot may never do that.
+func (o *Orchestrator) RestoreClient(ctx context.Context, cluster uuid.UUID, nodeID string) (rpc.SandboxServiceClient, context.Context, error) {
+	node := o.getOrConnectNode(ctx, cluster, nodeID)
+	if node == nil {
+		return nil, ctx, errors.New("restore node is unavailable")
+	}
+	client, child := node.GetClient(ctx)
+	return client.Sandbox, child, nil
+}
+
+func BuildRestoreRequest(op queries.SandboxRestoreOperation, build queries.EnvBuild, team *teamtypes.Team, input api.LaunchpadRestoreRequest, now time.Time) (*rpc.SandboxCreateRequest, error) {
+	if team == nil || team.Limits == nil || team.Limits.MaxLengthHours <= 0 || build.EnvdVersion == nil || build.TotalDiskSizeMb == nil || input.LeaseSeconds == nil {
+		return nil, errors.New("restore build or team policy is incomplete")
+	}
+	if int64(*input.LeaseSeconds) > team.Limits.MaxLengthHours*3600 {
+		return nil, errors.New("restore lease exceeds team policy")
+	}
+	metadata := map[string]string{}
+	if input.Metadata != nil {
+		for key, value := range *input.Metadata {
+			metadata[key] = value
+		}
+	}
+	metadata["launchpad.managed"] = "thread-vm-v1"
+	metadata["launchpad.operation_id"] = op.OperationID.String()
+	metadata["launchpad.generation"] = op.Generation
+	return &rpc.SandboxCreateRequest{
+		Sandbox: &rpc.SandboxConfig{
+			BuildId: op.PreparedBuildID.String(), TemplateId: op.SandboxID, BaseTemplateId: op.SourceTemplateID,
+			SandboxId: op.SandboxID, ExecutionId: op.ExecutionID.String(), TeamId: op.TeamID.String(),
+			Snapshot: true, Metadata: metadata, KernelVersion: build.KernelVersion,
+			FirecrackerVersion: build.FirecrackerVersion, EnvdVersion: *build.EnvdVersion,
+			Vcpu: build.Vcpu, RamMb: build.RamMb, TotalDiskSizeMb: *build.TotalDiskSizeMb,
+			MaxSandboxLength: team.Limits.MaxLengthHours, EventsTtlDays: team.Limits.EventsTTLDays,
+			AllowInternetAccess: new(true), Network: &rpc.SandboxNetworkConfig{Ingress: &rpc.SandboxNetworkIngressConfig{}},
+		},
+		FilesystemBoot: new(true), StartTime: timestamppb.New(now), EndTime: timestamppb.New(now.Add(time.Duration(*input.LeaseSeconds) * time.Second)),
+	}, nil
+}
+
+func (o *Orchestrator) ActivatePreparedRestore(ctx context.Context, op queries.SandboxRestoreOperation, request *rpc.SandboxCreateRequest, digest string) error {
+	request = proto.CloneOf(request)
+	config := request.GetSandbox()
+	token, err := o.accessTokenGenerator.GenerateEnvdAccessToken(op.SandboxID)
+	if err != nil {
+		return err
+	}
+	traffic, err := o.accessTokenGenerator.GenerateTrafficAccessToken(op.SandboxID)
+	if err != nil {
+		return err
+	}
+	config.EnvdAccessToken = &token
+	config.Network = &rpc.SandboxNetworkConfig{Ingress: &rpc.SandboxNetworkIngressConfig{TrafficAccessToken: &traffic}}
+	client, child, err := o.RestoreClient(ctx, op.ClusterID, op.NodeID)
+	if err != nil {
+		return err
+	}
+	response, err := client.ActivateRestoreDisk(child, &rpc.RestoreDiskActivateRequest{Create: request, ManifestSha256: digest})
+	if err != nil {
+		return err
+	}
+	if !response.GetFilesystemBootApplied() {
+		return errors.New("runtime did not confirm cold boot")
+	}
+	existing, err := o.sandboxStore.Get(ctx, op.TeamID, op.SandboxID)
+	if err == nil {
+		if existing.ExecutionID != op.ExecutionID.String() {
+			return errors.New("restore execution conflicts with registered sandbox")
+		}
+		return nil // Do not overwrite an accepted renewal or lifecycle transition.
+	}
+	if !errors.Is(err, sandbox.ErrNotFound) {
+		return err
+	}
+	node := o.GetNode(op.ClusterID, op.NodeID)
+	if node == nil {
+		return errors.New("restore node disappeared before registration")
+	}
+	sbx := sandbox.Sandbox{
+		SandboxID: op.SandboxID, TemplateID: op.SandboxID, BaseTemplateID: op.SourceTemplateID,
+		ClientID: response.GetClientId(), ExecutionID: op.ExecutionID.String(), TeamID: op.TeamID, BuildID: op.PreparedBuildID,
+		Metadata: config.GetMetadata(), MaxInstanceLength: time.Duration(config.GetMaxSandboxLength()) * time.Hour,
+		StartTime: request.GetStartTime().AsTime(), EndTime: request.GetEndTime().AsTime(),
+		VCpu: config.GetVcpu(), RamMB: config.GetRamMb(), TotalDiskSizeMB: config.GetTotalDiskSizeMb(),
+		KernelVersion: config.GetKernelVersion(), FirecrackerVersion: response.GetResolvedFirecrackerVersion(), FirecrackerVersionResolved: true,
+		EnvdVersion: config.GetEnvdVersion(), EnvdAccessToken: &token, TrafficAccessToken: &traffic,
+		AllowInternetAccess: new(true), NodeID: op.NodeID, ClusterID: op.ClusterID, Domain: node.SandboxDomain, State: sandbox.StateRunning,
+		Network: &dbtypes.SandboxNetworkConfig{Ingress: &dbtypes.SandboxNetworkIngressConfig{AllowPublicAccess: new(false)}},
+	}
+	// A failed registration keeps the durable activation pending. Never launch an
+	// asynchronous kill here: a late kill could destroy a successfully retried VM.
+	return o.sandboxStore.Add(ctx, sbx, nil)
+}
