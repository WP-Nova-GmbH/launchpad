+	db := testutils.SetupDatabase(t)
+	store := restorestore.Store{DB: db.SqlcClient}
+	a := newOperation(t, db)
+	b := newOperation(t, db)
+	b.ClusterID = a.ClusterID
+	b.NodeID = a.NodeID
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	failures := make([]error, 2)
+	for i, p := range []queries.CreateRestoreOperationParams{a, b} {
+		wg.Go(func() { <-start; _, failures[i] = store.Create(t.Context(), p, a.ReservedBytes) })
+	}
+	close(start)
+	wg.Wait()
+	winners := 0
+	for _, err := range failures {
+		if err == nil {
+			winners++
+		} else {
+			require.ErrorIs(t, err, restorestore.ErrCapacity)
+		}
