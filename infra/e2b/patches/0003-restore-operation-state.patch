+package handlers
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc"
+	"google.golang.org/protobuf/types/known/emptypb"
+
+	restorestore "github.com/e2b-dev/infra/packages/db/pkg/restores"
+	"github.com/e2b-dev/infra/packages/db/pkg/testutils"
+	"github.com/e2b-dev/infra/packages/db/queries"
+	rpc "github.com/e2b-dev/infra/packages/shared/pkg/grpc/orchestrator"
+)
+
+type restoreWorkerRuntime struct {
+	rpc.SandboxServiceClient
+	lostReply bool
+	boots     int
+	released  bool
+	cancelled bool
+}
+
+func (r *restoreWorkerRuntime) RestoreClient(ctx context.Context, _ uuid.UUID, _ string) (rpc.SandboxServiceClient, context.Context, error) {
+	return r, ctx, nil
+}
+func (r *restoreWorkerRuntime) PrepareRestoreDisk(_ context.Context, p *rpc.RestoreDiskPrepareRequest, _ ...grpc.CallOption) (*rpc.RestoreDiskResponse, error) {
+	raw, _ := json.Marshal(map[string]string{"build_id": p.GetPreparedBuildId(), "source_build_id": p.GetSourceBuildId()})
+	sum := sha256.Sum256(raw)
+	return &rpc.RestoreDiskResponse{Manifest: raw, ManifestSha256: hex.EncodeToString(sum[:])}, nil
+}
+func (r *restoreWorkerRuntime) CancelRestoreDisk(context.Context, *rpc.RestoreDiskRequest, ...grpc.CallOption) (*emptypb.Empty, error) {
+	r.cancelled = true
+	return &emptypb.Empty{}, nil
+}
+func (r *restoreWorkerRuntime) ReleaseRestoreDisk(context.Context, *rpc.RestoreDiskRequest, ...grpc.CallOption) (*emptypb.Empty, error) {
+	r.released = true
+	return &emptypb.Empty{}, nil
+}
+func (r *restoreWorkerRuntime) ActivatePreparedRestore(context.Context, queries.SandboxRestoreOperation, *rpc.SandboxCreateRequest, string) error {
+	if r.boots == 0 {
+		r.boots++
+	}
+	if r.lostReply {
+		r.lostReply = false
+		return errors.New("reply lost after boot")
+	}
+	return nil
+}
+
+func claimRestoreWork(t *testing.T, db *testutils.Database) queries.SandboxRestoreOperation {
+	t.Helper()
+	claim := uuid.New()
+	ops, err := db.SqlcClient.ClaimRestoreOperations(t.Context(), queries.ClaimRestoreOperationsParams{BatchSize: 1, ClaimID: &claim, ClaimUntil: time.Now().Add(time.Minute)})
+	require.NoError(t, err)
+	require.Len(t, ops, 1)
+	return ops[0]
+}
+
+func TestLaunchpadRestoreWorkerReconcilesLostActivationReply(t *testing.T) {
+	t.Parallel()
+	db := testutils.SetupDatabase(t)
+	p := restorePinFixture(t, db)
+	p.ClusterID = uuid.Nil
+	store := restorestore.Store{DB: db.SqlcClient}
+	_, err := store.Create(t.Context(), p, p.ReservedBytes)
+	require.NoError(t, err)
+	runtime := &restoreWorkerRuntime{lostReply: true}
+	server := &APIStore{sqlcDB: db.SqlcClient, restoreRuntimeOverride: runtime}
+	prepared := claimRestoreWork(t, db)
+	require.NoError(t, server.processRestoreOperation(t.Context(), prepared))
+	_, err = store.Activate(t.Context(), p.TeamID, p.OperationID)
+	require.NoError(t, err)
+	activation := claimRestoreWork(t, db)
+	_, err = store.SaveActivationRequest(t.Context(), activation, []byte(`{"sandbox":{}}`))
+	require.NoError(t, err)
+	require.Error(t, server.processRestoreOperation(t.Context(), activation))
+	retained, err := db.SqlcClient.GetRestoreOperation(t.Context(), queries.GetRestoreOperationParams{TeamID: p.TeamID, OperationID: p.OperationID})
+	require.NoError(t, err)
+	require.Equal(t, "activating", retained.State)
+	require.Positive(t, retained.ReservedBytes)
+	require.False(t, runtime.released)
+	// A crashed worker loses its lease. Recovery retries the same assigned boot.
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), "UPDATE public.sandbox_restore_operations SET claim_until=now()-interval '1 second' WHERE operation_id=$1", p.OperationID))
+	recovery := claimRestoreWork(t, db)
+	require.NotEqual(t, *activation.ClaimID, *recovery.ClaimID)
+	require.NoError(t, server.processRestoreOperation(t.Context(), recovery))
+	require.Equal(t, 1, runtime.boots)
+	require.True(t, runtime.released)
+	finished, err := db.SqlcClient.GetRestoreOperation(t.Context(), queries.GetRestoreOperationParams{TeamID: p.TeamID, OperationID: p.OperationID})
+	require.NoError(t, err)
+	require.Equal(t, "active", finished.State)
+	require.Zero(t, finished.ReservedBytes)
+	pinned, err := db.SqlcClient.HasRestoreBuildPins(t.Context(), p.SourceBuildID)
+	require.NoError(t, err)
+	require.False(t, pinned)
+}
+
+func TestLaunchpadRestoreWorkerHonorsCancellationBeforeSideEffects(t *testing.T) {
+	t.Parallel()
+	db := testutils.SetupDatabase(t)
+	p := restorePinFixture(t, db)
+	p.ClusterID = uuid.Nil
+	store := restorestore.Store{DB: db.SqlcClient}
+	_, err := store.Create(t.Context(), p, p.ReservedBytes)
+	require.NoError(t, err)
+	claimed := claimRestoreWork(t, db)
+	_, err = store.Cancel(t.Context(), p.TeamID, p.OperationID)
+	require.NoError(t, err)
+	runtime := &restoreWorkerRuntime{}
+	server := &APIStore{sqlcDB: db.SqlcClient, restoreRuntimeOverride: runtime}
+	require.NoError(t, server.processRestoreOperation(t.Context(), claimed))
+	require.True(t, runtime.cancelled)
+	require.Zero(t, runtime.boots)
+	finished, err := db.SqlcClient.GetRestoreOperation(t.Context(), queries.GetRestoreOperationParams{TeamID: p.TeamID, OperationID: p.OperationID})
+	require.NoError(t, err)
+	require.Equal(t, "cancelled", finished.State)
+	require.Zero(t, finished.ReservedBytes)
+}
