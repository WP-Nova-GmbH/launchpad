+func restoreHTTPContext(t *testing.T, team uuid.UUID, body []byte) (*gin.Context, *httptest.ResponseRecorder) {
+	t.Helper()
+	response := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(response)
+	c.Request = httptest.NewRequest("PUT", "/extensions/launchpad/v1/restores/test", bytes.NewReader(body))
+	auth.SetTeamInfoForTest(t, c, &authtypes.Team{Team: &authqueries.Team{ID: team}})
+	return c, response
+}
+
+func TestLaunchpadRestoreRequestCanonicalAndBounded(t *testing.T) {
+	t.Parallel()
+	input := api.LaunchpadRestoreRequest{SourceTemplateID: "source", SourceBuildID: uuid.New(), Generation: "generation-1"}
+	original, err := canonicalRestoreRequest(input)
+	require.NoError(t, err)
+	input.LeaseSeconds = new(600)
+	explicit, err := canonicalRestoreRequest(input)
+	require.NoError(t, err)
+	require.Equal(t, original, explicit)
+	input.Bootstrap = &map[string]interface{}{"version": 1, "ticket": strings.Repeat("x", 17*1024)}
+	_, err = canonicalRestoreRequest(input)
+	require.Error(t, err)
+	input.Bootstrap = &map[string]interface{}{"version": 2}
+	_, err = canonicalRestoreRequest(input)
+	require.Error(t, err)
+	input.Bootstrap = nil
+	input.Metadata = &map[string]string{"arbitrary": "label"}
+	_, err = canonicalRestoreRequest(input)
+	require.Error(t, err)
+}
+
+func TestLaunchpadRestoreAdmissionIdentityIsolationAndCancellation(t *testing.T) {
+	t.Parallel()
+	db := testutils.SetupDatabase(t)
+	p := restorePinFixture(t, db)
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), "UPDATE public.env_builds SET total_disk_size_mb=64 WHERE id=$1", p.SourceBuildID))
+	server := &APIStore{sqlcDB: db.SqlcClient}
+	server.config.LaunchpadRestoreTeams = []string{p.TeamID.String()}
+	server.config.LaunchpadRestoreNodeID = "test-node"
+	server.config.LaunchpadRestoreCapacityBytes = 130 * 1024 * 1024
+	input := api.LaunchpadRestoreRequest{SourceTemplateID: p.SourceTemplateID, SourceBuildID: p.SourceBuildID, Generation: "generation-1"}
+	raw, err := json.Marshal(input)
+	require.NoError(t, err)
+	c, response := restoreHTTPContext(t, p.TeamID, raw)
+	server.PutLaunchpadRestore(c, p.OperationID)
+	require.Equal(t, 202, response.Code, response.Body.String())
+	var first api.LaunchpadRestoreStatus
+	require.NoError(t, json.Unmarshal(response.Body.Bytes(), &first))
+	c, response = restoreHTTPContext(t, p.TeamID, raw)
+	server.PutLaunchpadRestore(c, p.OperationID)
+	require.Equal(t, 202, response.Code, response.Body.String())
+	var retry api.LaunchpadRestoreStatus
+	require.NoError(t, json.Unmarshal(response.Body.Bytes(), &retry))
+	require.Equal(t, first.SandboxID, retry.SandboxID)
+	require.Equal(t, first.PreparedBuildID, retry.PreparedBuildID)
+	// Another operation cannot take the already reserved final disk slot.
+	c, response = restoreHTTPContext(t, p.TeamID, raw)
+	server.PutLaunchpadRestore(c, uuid.New())
+	require.Equal(t, 429, response.Code, response.Body.String())
+	// A caller with another authenticated team cannot inspect or cancel it.
+	other := testutils.CreateTestTeam(t, db)
+	c, response = restoreHTTPContext(t, other, nil)
+	server.GetLaunchpadRestore(c, p.OperationID)
+	require.Equal(t, 404, response.Code)
+	c, response = restoreHTTPContext(t, other, nil)
+	server.DeleteLaunchpadRestore(c, p.OperationID)
+	require.Equal(t, 404, response.Code)
+	c, response = restoreHTTPContext(t, p.TeamID, nil)
+	server.PostLaunchpadRestoreActivate(c, p.OperationID)
+	require.Equal(t, 409, response.Code, "verification-only disks cannot activate")
+	c, response = restoreHTTPContext(t, p.TeamID, nil)
+	server.DeleteLaunchpadRestore(c, p.OperationID)
+	require.Equal(t, 202, response.Code)
+	op, err := db.SqlcClient.GetRestoreOperation(t.Context(), queries.GetRestoreOperationParams{TeamID: p.TeamID, OperationID: p.OperationID})
+	require.NoError(t, err)
+	require.Equal(t, "cancelling", op.State)
+	require.Positive(t, op.ReservedBytes, "HTTP cancellation cannot release capacity before host cleanup")
+	input.Generation = "different"
+	raw, err = json.Marshal(input)
+	require.NoError(t, err)
+	c, response = restoreHTTPContext(t, p.TeamID, raw)
+	server.PutLaunchpadRestore(c, p.OperationID)
+	require.Equal(t, 409, response.Code)
+}
+
+func TestLaunchpadRestoreDisabledCapabilities(t *testing.T) {
+	t.Parallel()
+	c, response := restoreHTTPContext(t, uuid.New(), nil)
+	(&APIStore{}).GetLaunchpadCapabilities(c)
+	require.Equal(t, 403, response.Code)
+}
+
+func TestLaunchpadRestoreReservationIncludesFractionalMiB(t *testing.T) {
+	t.Parallel()
+	// Geometry observed on an actual snapshot: DB stores 2726 MiB, but
+	// the immutable rootfs contains another 860160 bytes.
+	reserved, err := restoreDiskReservation(new(int64(2726)))
+	require.NoError(t, err)
+	require.GreaterOrEqual(t, reserved/2, int64(2859278336))
+	require.Equal(t, int64(2727*2*1024*1024), reserved)
+	for _, invalid := range []*int64{nil, new(int64(0)), new(int64(-1)), new(int64(math.MaxInt64)), new(int64(math.MaxInt64 / (2 * 1024 * 1024)))} {
+		_, err = restoreDiskReservation(invalid)
+		require.Error(t, err)
+	}
+}
