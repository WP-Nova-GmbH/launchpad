+// Package restores owns the durable ordering between restore admission,
+// activation and cancellation. Runtime side effects happen after these commits.
+package restores
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+
+	"github.com/e2b-dev/infra/packages/db/client"
+	"github.com/e2b-dev/infra/packages/db/queries"
+)
+
+var (
+	ErrConflict = errors.New("restore operation conflicts with its existing request or state")
+	ErrCapacity = errors.New("restore preparation capacity is exhausted")
+	ErrInvalid  = errors.New("invalid restore request")
+)
+
+type Store struct{ DB *client.Client }
+
+// Create reserves capacity and pins an owned immutable source atomically. The
+// The zero cluster UUID is the upstream local cluster and is valid. The
+// caller supplies generated destination IDs; only the winning insertion uses
+// them. Every retry returns the original IDs, including cancellation tombstones.
+// RequestPayload must be bounded canonical data with no reusable credentials.
+func (s Store) Create(ctx context.Context, p queries.CreateRestoreOperationParams, hostCapacity int64) (queries.SandboxRestoreOperation, error) {
+	var empty queries.SandboxRestoreOperation
+	if p.TeamID == uuid.Nil || p.OperationID == uuid.Nil || p.SourceBuildID == uuid.Nil ||
+		p.PreparedBuildID == uuid.Nil || p.ExecutionID == uuid.Nil ||
+		p.SourceTemplateID == "" || p.NodeID == "" || p.SandboxID == "" || p.Generation == "" ||
+		len(p.Generation) > 256 || len(p.RequestPayload) > 64*1024 || !json.Valid(p.RequestPayload) ||
+		p.ReservedBytes <= 0 || hostCapacity <= 0 {
+		return empty, ErrInvalid
+	}
+	// Bind both caller intent and derived immutable source/placement parameters.
+	// Generated destination identities are deliberately excluded from the hash.
+	bound, err := json.Marshal(struct {
+		Payload          json.RawMessage
+		SourceTemplate   string
+		SourceBuild      uuid.UUID
+		Cluster          uuid.UUID
+		Node, Generation string
+		ReservedBytes    int64
+	}{p.RequestPayload, p.SourceTemplateID, p.SourceBuildID, p.ClusterID, p.NodeID, p.Generation, p.ReservedBytes})
+	if err != nil {
+		return empty, err
+	}
+	digest := sha256.Sum256(bound)
+	p.RequestSha256 = hex.EncodeToString(digest[:])
+	txDB, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return empty, err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	// Serialize retries even when two requests choose different compute nodes.
+	if err = txDB.LockRestoreCapacity(ctx, "restore-operation:"+p.TeamID.String()+":"+p.OperationID.String()); err != nil {
+		return empty, err
+	}
+	existing, err := txDB.GetRestoreOperation(ctx, queries.GetRestoreOperationParams{TeamID: p.TeamID, OperationID: p.OperationID})
+	if err == nil {
+		if existing.RequestSha256 != p.RequestSha256 {
+			return empty, ErrConflict
+		}
+		return existing, tx.Commit(ctx)
+	}
+	if !errors.Is(err, pgx.ErrNoRows) {
+		return empty, err
+	}
+	if err = txDB.LockRestoreCapacity(ctx, "restore-capacity:"+p.ClusterID.String()+":"+p.NodeID); err != nil {
+		return empty, err
+	}
+	reserved, err := txDB.RestoreReservedBytes(ctx, queries.RestoreReservedBytesParams{ClusterID: p.ClusterID, NodeID: p.NodeID})
+	if err != nil {
+		return empty, err
+	}
+	if p.ReservedBytes > hostCapacity || reserved > hostCapacity-p.ReservedBytes {
+		return empty, ErrCapacity
+	}
+	if _, err = txDB.LockRestoreSourceTemplate(ctx, queries.LockRestoreSourceTemplateParams{TeamID: p.TeamID, TemplateID: p.SourceTemplateID}); err != nil {
+		return empty, err
+	}
+	if _, err = txDB.GetRestoreSourceBuild(ctx, queries.GetRestoreSourceBuildParams{TeamID: p.TeamID, TemplateID: p.SourceTemplateID, BuildID: p.SourceBuildID}); err != nil {
+		return empty, err
+	}
+	n, err := txDB.CreateRestoreOperation(ctx, p)
+	if err != nil {
+		return empty, err
+	}
+	if n != 1 {
+		return empty, ErrConflict
+	}
+	if err = txDB.PinRestoreBuild(ctx, queries.PinRestoreBuildParams{TeamID: p.TeamID, OperationID: p.OperationID, BuildID: p.SourceBuildID}); err != nil {
+		return empty, err
+	}
+	result, err := txDB.GetRestoreOperation(ctx, queries.GetRestoreOperationParams{TeamID: p.TeamID, OperationID: p.OperationID})
+	if err != nil {
+		return empty, err
+	}
+	return result, tx.Commit(ctx)
+}
+
+// Activate records permission to boot. An HTTP/RPC retry can acknowledge the
+// same permission but can never transition a cancelled operation back to life.
+func (s Store) Activate(ctx context.Context, team, operation uuid.UUID) (queries.SandboxRestoreOperation, error) {
+	_, err := s.DB.RequestRestoreActivation(ctx, queries.RequestRestoreActivationParams{TeamID: team, OperationID: operation})
+	if err != nil {
+		return queries.SandboxRestoreOperation{}, err
+	}
+	result, err := s.DB.GetRestoreOperation(ctx, queries.GetRestoreOperationParams{TeamID: team, OperationID: operation})
+	if err != nil {
+		return result, err
+	}
+	if result.State != "activating" && result.State != "active" {
+		return result, ErrConflict
+	}
+	return result, nil
+}
+
+func (s Store) Cancel(ctx context.Context, team, operation uuid.UUID) (queries.SandboxRestoreOperation, error) {
+	_, err := s.DB.RequestRestoreCancellation(ctx, queries.RequestRestoreCancellationParams{TeamID: team, OperationID: operation})
+	if err != nil {
+		return queries.SandboxRestoreOperation{}, err
+	}
+	result, err := s.DB.GetRestoreOperation(ctx, queries.GetRestoreOperationParams{TeamID: team, OperationID: operation})
+	if err != nil {
+		return result, err
+	}
+	if result.State != "cancelling" && result.State != "cancelled" {
+		return result, ErrConflict
+	}
+	return result, nil
+}
+
+// Complete releases temporary capacity and source pins only after the caller
+// confirms cleanup, or durable transfer to the active sandbox's storage lineage.
+func (s Store) Complete(ctx context.Context, team, operation, claim uuid.UUID, state string) error {
+	txDB, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	n, err := txDB.FinishRestoreOperation(ctx, queries.FinishRestoreOperationParams{TeamID: team, OperationID: operation, ClaimID: &claim, TerminalState: state})
+	if err != nil {
+		return err
+	}
+	if n != 1 {
+		return fmt.Errorf("restore completion lost its worker claim or state: %w", ErrConflict)
+	}
+	if err = txDB.ReleaseRestorePins(ctx, queries.ReleaseRestorePinsParams{TeamID: team, OperationID: operation}); err != nil {
+		return err
+	}
+	return tx.Commit(ctx)
+}
+
+// SaveActivationRequest freezes the boot parameters and registers the independent
+// destination build in the same transaction. The payload excludes reusable
+// credentials; the API derives those from its existing token generator.
+func (s Store) SaveActivationRequest(ctx context.Context, op queries.SandboxRestoreOperation, request []byte) (queries.SandboxRestoreOperation, error) {
+	txDB, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return op, err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	_, err = txDB.SaveRestoreActivationRequest(ctx, queries.SaveRestoreActivationRequestParams{
+		TeamID: op.TeamID, OperationID: op.OperationID, ClaimID: op.ClaimID, ActivationRequest: request,
+	})
+	if err != nil {
+		return op, err
+	}
+	saved, err := txDB.GetRestoreOperation(ctx, queries.GetRestoreOperationParams{TeamID: op.TeamID, OperationID: op.OperationID})
+	if err != nil {
+		return op, err
+	}
+	if saved.State != "activating" || len(saved.ActivationRequest) == 0 {
+		return op, ErrConflict
+	}
+	if err := txDB.CreateRestoreBuild(ctx, queries.CreateRestoreBuildParams{TeamID: op.TeamID, OperationID: op.OperationID}); err != nil {
+		return op, err
+	}
+	var cluster *uuid.UUID
+	if op.ClusterID != uuid.Nil {
+		cluster = &op.ClusterID
+	}
+	_, err = txDB.CreateSnapshotTemplateEnv(ctx, queries.CreateSnapshotTemplateEnvParams{
+		SnapshotID: op.SandboxID, TeamID: op.TeamID, ClusterID: cluster, SandboxID: op.SandboxID,
+		OriginNodeID: &op.NodeID, BuildID: &op.PreparedBuildID, Tag: "default",
+	})
+	if err != nil {
+		return op, err
+	}
+	return saved, tx.Commit(ctx)
+}
