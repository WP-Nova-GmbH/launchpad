+-- +goose Up
+CREATE TABLE public.sandbox_restore_operations (
+    team_id uuid NOT NULL REFERENCES public.teams(id),
+    operation_id uuid NOT NULL,
+    request_sha256 text NOT NULL CHECK (request_sha256 ~ '^[0-9a-f]{64}$'),
+    request_payload bytea NOT NULL,
+    source_template_id text NOT NULL,
+    source_build_id uuid NOT NULL,
+    prepared_build_id uuid NOT NULL UNIQUE,
+    sandbox_id text NOT NULL UNIQUE,
+    execution_id uuid NOT NULL UNIQUE,
+    cluster_id uuid NOT NULL,
+    node_id text NOT NULL,
+    generation text NOT NULL,
+    state text NOT NULL DEFAULT 'preparing' CHECK (state IN ('preparing','prepared','activating','active','cancelling','cancelled')),
+    reserved_bytes bigint NOT NULL CHECK (reserved_bytes >= 0),
+    manifest bytea,
+    activation_request bytea,
+    claim_id uuid,
+    claim_until timestamptz,
+    next_attempt_at timestamptz NOT NULL DEFAULT now(),
+    last_error text,
+    created_at timestamptz NOT NULL DEFAULT now(),
+    updated_at timestamptz NOT NULL DEFAULT now(),
+    PRIMARY KEY (team_id, operation_id),
+    CHECK ((claim_id IS NULL) = (claim_until IS NULL)),
+    CHECK (state NOT IN ('prepared','activating','active') OR manifest IS NOT NULL)
+);
+CREATE INDEX sandbox_restore_pending ON public.sandbox_restore_operations(next_attempt_at)
+    WHERE state IN ('preparing','activating','cancelling');
+
+-- These references outlive a worker process. Drop them only after verified
+-- cancellation or transfer to the activated sandbox's normal storage lineage.
+CREATE TABLE public.sandbox_restore_pins (
+    team_id uuid NOT NULL,
+    operation_id uuid NOT NULL,
+    build_id uuid NOT NULL REFERENCES public.env_builds(id),
+    PRIMARY KEY (team_id, operation_id, build_id),
+    FOREIGN KEY (team_id, operation_id) REFERENCES public.sandbox_restore_operations(team_id, operation_id)
+);
+CREATE INDEX sandbox_restore_pins_build ON public.sandbox_restore_pins(build_id);
+
+-- +goose Down
+DROP TABLE public.sandbox_restore_pins;
+DROP TABLE public.sandbox_restore_operations;
--- /dev/null
+++ b/packages/db/queries/restores/operations.sql
@@ -0,0 +1,145 @@
+-- name: LockRestoreSourceTemplate :one
+-- Lock this env before inserting pins or soft-deleting it. After the lock is
+-- acquired, the caller resolves the build in the same transaction.
+SELECT id FROM public.envs
+WHERE id = @template_id AND team_id = @team_id AND deleted_at IS NULL
+FOR UPDATE;
+
+-- name: GetRestoreSourceBuild :one
+SELECT b.* FROM public.env_builds b
+JOIN public.env_build_assignments a ON a.build_id = b.id
+JOIN public.active_envs e ON e.id = a.env_id
+WHERE e.id = @template_id AND e.team_id = @team_id AND b.id = @build_id
+AND b.status_group = 'ready'
+LIMIT 1;
+
+-- name: CreateRestoreOperation :execrows
+INSERT INTO public.sandbox_restore_operations (
+    team_id, operation_id, request_sha256, request_payload, source_template_id,
+    source_build_id, prepared_build_id, sandbox_id, execution_id, cluster_id,
+    node_id, generation, reserved_bytes
+) VALUES (
+    @team_id, @operation_id, @request_sha256, @request_payload, @source_template_id,
+    @source_build_id, @prepared_build_id, @sandbox_id, @execution_id, @cluster_id,
+    @node_id, @generation, @reserved_bytes
+) ON CONFLICT (team_id, operation_id) DO NOTHING;
+
+-- name: GetRestoreOperation :one
+SELECT * FROM public.sandbox_restore_operations WHERE team_id = @team_id AND operation_id = @operation_id;
+
+-- name: PinRestoreBuild :exec
+INSERT INTO public.sandbox_restore_pins (team_id, operation_id, build_id)
+VALUES (@team_id, @operation_id, @build_id)
+ON CONFLICT DO NOTHING;
+
+-- name: HasRestoreBuildPins :one
+SELECT EXISTS (SELECT 1 FROM public.sandbox_restore_pins WHERE build_id = @build_id);
+
+-- name: HasRestoreTemplatePins :one
+-- Tags can change after admission. Keep the original source env protected even
+-- if its current assignments no longer point to the pinned immutable build.
+SELECT EXISTS (
+    SELECT 1 FROM public.sandbox_restore_operations o
+    JOIN public.sandbox_restore_pins p USING (team_id, operation_id)
+    WHERE o.source_template_id = @template_id
+    UNION ALL
+    SELECT 1 FROM public.sandbox_restore_pins p
+    JOIN public.env_build_assignments a ON a.build_id = p.build_id
+    WHERE a.env_id = @template_id
+);
+
+-- name: ClaimRestoreOperations :many
+WITH pending AS (
+    SELECT team_id, operation_id FROM public.sandbox_restore_operations
+    WHERE state IN ('preparing','activating','cancelling')
+        AND next_attempt_at <= now()
+        AND (claim_until IS NULL OR claim_until < now())
+    ORDER BY next_attempt_at, created_at
+    LIMIT sqlc.arg(batch_size)::int
+    FOR UPDATE SKIP LOCKED
+)
+UPDATE public.sandbox_restore_operations o
+SET claim_id = @claim_id, claim_until = sqlc.arg(claim_until)::timestamptz, updated_at = now()
+FROM pending p WHERE o.team_id = p.team_id AND o.operation_id = p.operation_id
