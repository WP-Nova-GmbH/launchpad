+)
+
+func newOperation(t *testing.T, db *testutils.Database) queries.CreateRestoreOperationParams {
+	t.Helper()
+	team := testutils.CreateTestTeam(t, db)
+	template := testutils.CreateTestTemplate(t, db, team)
+	build := testutils.CreateTestBuild(t, t.Context(), db, template, "uploaded")
+	testutils.CreateTestBuildAssignment(t, t.Context(), db, template, build, "default")
+	p := queries.CreateRestoreOperationParams{
+		TeamID: team, OperationID: uuid.New(), RequestSha256: strings.Repeat("a", 64),
+		RequestPayload: []byte(`{"generation":"placement-1"}`), SourceTemplateID: template,
+		SourceBuildID: build, PreparedBuildID: uuid.New(), SandboxID: uuid.NewString(),
+		ExecutionID: uuid.New(), ClusterID: uuid.Nil, NodeID: "test-node", Generation: "placement-1", ReservedBytes: 1024,
+	}
+	return p
+}
+
+func createOperation(t *testing.T, db *testutils.Database) queries.CreateRestoreOperationParams {
+	t.Helper()
+	p := newOperation(t, db)
+	n, err := db.SqlcClient.CreateRestoreOperation(t.Context(), p)
+	require.NoError(t, err)
+	require.EqualValues(t, 1, n)
+	require.NoError(t, db.SqlcClient.PinRestoreBuild(t.Context(), queries.PinRestoreBuildParams{TeamID: p.TeamID, OperationID: p.OperationID, BuildID: p.SourceBuildID}))
+	return p
+}
+
+func claim(t *testing.T, db *testutils.Database) uuid.UUID {
+	t.Helper()
+	id := uuid.New()
+	rows, err := db.SqlcClient.ClaimRestoreOperations(t.Context(), queries.ClaimRestoreOperationsParams{ClaimID: &id, ClaimUntil: time.Now().Add(time.Minute), BatchSize: 1})
+	require.NoError(t, err)
+	require.Len(t, rows, 1)
+	return id
+}
+
+func prepare(t *testing.T, db *testutils.Database, p queries.CreateRestoreOperationParams) {
+	t.Helper()
+	id := claim(t, db)
+	n, err := db.SqlcClient.FinishRestorePreparation(t.Context(), queries.FinishRestorePreparationParams{TeamID: p.TeamID, OperationID: p.OperationID, ClaimID: &id, Manifest: []byte(`{"verified":true}`)})
+	require.NoError(t, err)
+	require.EqualValues(t, 1, n)
+}
+
+func TestRestoreImmutableIdentityAndTeamIsolation(t *testing.T) {
+	t.Parallel()
+	db := testutils.SetupDatabase(t)
+	p := createOperation(t, db)
+	duplicate := p
+	duplicate.PreparedBuildID = uuid.New()
+	duplicate.SandboxID = uuid.NewString()
+	duplicate.ExecutionID = uuid.New()
+	duplicate.RequestSha256 = strings.Repeat("b", 64)
+	n, err := db.SqlcClient.CreateRestoreOperation(t.Context(), duplicate)
+	require.NoError(t, err)
+	require.Zero(t, n)
+	row, err := db.SqlcClient.GetRestoreOperation(t.Context(), queries.GetRestoreOperationParams{TeamID: p.TeamID, OperationID: p.OperationID})
+	require.NoError(t, err)
+	require.Equal(t, p.PreparedBuildID, row.PreparedBuildID)
+	require.Equal(t, p.SandboxID, row.SandboxID)
+	require.Equal(t, p.RequestSha256, row.RequestSha256)
+	other := testutils.CreateTestTeam(t, db)
+	_, err = db.SqlcClient.GetRestoreOperation(t.Context(), queries.GetRestoreOperationParams{TeamID: other, OperationID: p.OperationID})
+	require.ErrorIs(t, err, pgx.ErrNoRows)
+	n, err = db.SqlcClient.RequestRestoreCancellation(t.Context(), queries.RequestRestoreCancellationParams{TeamID: other, OperationID: p.OperationID})
+	require.NoError(t, err)
+	require.Zero(t, n)
+	_, err = db.SqlcClient.GetRestoreSourceBuild(t.Context(), queries.GetRestoreSourceBuildParams{TeamID: other, TemplateID: p.SourceTemplateID, BuildID: p.SourceBuildID})
+	require.ErrorIs(t, err, pgx.ErrNoRows)
+}
+
+func TestRestoreActivationAndCancellationHaveOneWinner(t *testing.T) {
+	t.Parallel()
+	db := testutils.SetupDatabase(t)
+	p := createOperation(t, db)
+	prepare(t, db, p)
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	var activate, cancel int64
+	var activateErr, cancelErr error
+	wg.Go(func() {
+		<-start
+		activate, activateErr = db.SqlcClient.RequestRestoreActivation(t.Context(), queries.RequestRestoreActivationParams{TeamID: p.TeamID, OperationID: p.OperationID})
+	})
+	wg.Go(func() {
+		<-start
+		cancel, cancelErr = db.SqlcClient.RequestRestoreCancellation(t.Context(), queries.RequestRestoreCancellationParams{TeamID: p.TeamID, OperationID: p.OperationID})
+	})
+	close(start)
+	wg.Wait()
+	require.NoError(t, activateErr)
+	require.NoError(t, cancelErr)
+	require.EqualValues(t, 1, activate+cancel)
+	id := claim(t, db)
+	terminal := "active"
+	if cancel == 1 {
+		terminal = "cancelled"
+	}
+	txDB, tx, err := db.SqlcClient.WithTx(t.Context())
+	require.NoError(t, err)
+	defer tx.Rollback(context.WithoutCancel(t.Context()))
+	n, err := txDB.FinishRestoreOperation(t.Context(), queries.FinishRestoreOperationParams{TeamID: p.TeamID, OperationID: p.OperationID, ClaimID: &id, TerminalState: terminal})
+	require.NoError(t, err)
+	require.EqualValues(t, 1, n)
+	require.NoError(t, txDB.ReleaseRestorePins(t.Context(), queries.ReleaseRestorePinsParams{TeamID: p.TeamID, OperationID: p.OperationID}))
+	require.NoError(t, tx.Commit(t.Context()))
+	n, err = db.SqlcClient.RequestRestoreActivation(t.Context(), queries.RequestRestoreActivationParams{TeamID: p.TeamID, OperationID: p.OperationID})
+	require.NoError(t, err)
+	require.Zero(t, n, "delayed activation must not reopen a terminal operation")
+	row, err := db.SqlcClient.GetRestoreOperation(t.Context(), queries.GetRestoreOperationParams{TeamID: p.TeamID, OperationID: p.OperationID})
+	require.NoError(t, err)
+	require.Equal(t, terminal, row.State)
+	require.Zero(t, row.ReservedBytes)
+	pinned, err := db.SqlcClient.HasRestoreBuildPins(t.Context(), p.SourceBuildID)
+	require.NoError(t, err)
+	require.False(t, pinned)
+}
+
+func TestRestoreCancellationKeepsLiveWorkerAndSourcePin(t *testing.T) {
+	t.Parallel()
+	db := testutils.SetupDatabase(t)
+	p := createOperation(t, db)
+	id := claim(t, db)
+	n, err := db.SqlcClient.RequestRestoreCancellation(t.Context(), queries.RequestRestoreCancellationParams{TeamID: p.TeamID, OperationID: p.OperationID})
+	require.NoError(t, err)
+	require.EqualValues(t, 1, n)
+	other := uuid.New()
+	rows, err := db.SqlcClient.ClaimRestoreOperations(t.Context(), queries.ClaimRestoreOperationsParams{ClaimID: &other, ClaimUntil: time.Now().Add(time.Minute), BatchSize: 1})
+	require.NoError(t, err)
+	require.Empty(t, rows, "cleanup must not race a live preparation")
+	n, err = db.SqlcClient.FinishRestorePreparation(t.Context(), queries.FinishRestorePreparationParams{TeamID: p.TeamID, OperationID: p.OperationID, ClaimID: &id, Manifest: []byte("verified")})
+	require.NoError(t, err)
+	require.Zero(t, n, "late prepare result must not undo cancellation")
+	require.NoError(t, db.SqlcClient.ReleaseRestorePins(t.Context(), queries.ReleaseRestorePinsParams{TeamID: p.TeamID, OperationID: p.OperationID}))
+	pinned, err := db.SqlcClient.HasRestoreBuildPins(t.Context(), p.SourceBuildID)
+	require.NoError(t, err)
+	require.True(t, pinned)
+	builds, err := db.SqlcClient.GetExclusiveBuildsForTemplateDeletion(t.Context(), p.SourceTemplateID)
+	require.NoError(t, err)
+	require.Empty(t, builds)
+	bytes, err := db.SqlcClient.RestoreReservedBytes(t.Context(), queries.RestoreReservedBytesParams{ClusterID: p.ClusterID, NodeID: p.NodeID})
+	require.NoError(t, err)
+	require.Equal(t, p.ReservedBytes, bytes)
