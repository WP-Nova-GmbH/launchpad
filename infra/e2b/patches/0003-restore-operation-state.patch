+func restorePinFixture(t *testing.T, db *testutils.Database) queries.CreateRestoreOperationParams {
+	t.Helper()
+	team := testutils.CreateTestTeam(t, db)
+	template := testutils.CreateTestTemplate(t, db, team)
+	build := testutils.CreateTestBuild(t, t.Context(), db, template, "uploaded")
+	testutils.CreateTestBuildAssignment(t, t.Context(), db, template, build, "default")
+	return queries.CreateRestoreOperationParams{
+		TeamID: team, OperationID: uuid.New(), RequestPayload: []byte(`{}`),
+		SourceTemplateID: template, SourceBuildID: build, PreparedBuildID: uuid.New(),
+		SandboxID: uuid.NewString(), ExecutionID: uuid.New(), ClusterID: uuid.New(),
+		NodeID: "test-node", Generation: "placement-1", ReservedBytes: 1024,
+	}
+}
+
+func TestTemplateDeletionPreservesPendingRestore(t *testing.T) {
+	t.Parallel()
+	db := testutils.SetupDatabase(t)
+	p := restorePinFixture(t, db)
+	store := restorestore.Store{DB: db.SqlcClient}
+	_, err := store.Create(t.Context(), p, p.ReservedBytes)
+	require.NoError(t, err)
+	api := &APIStore{sqlcDB: db.SqlcClient}
+	_, err = api.softDeleteTemplate(t.Context(), p.TeamID, p.SourceTemplateID)
+	require.ErrorIs(t, err, errTemplateRestorePinned)
+	_, err = db.SqlcClient.GetRestoreSourceBuild(t.Context(), queries.GetRestoreSourceBuildParams{TeamID: p.TeamID, TemplateID: p.SourceTemplateID, BuildID: p.SourceBuildID})
+	require.NoError(t, err, "refused deletion must roll back the soft delete")
+}
+
+func TestTemplateDeletionRacesRestoreAdmission(t *testing.T) {
+	t.Parallel()
+	db := testutils.SetupDatabase(t)
+	p := restorePinFixture(t, db)
+	store := restorestore.Store{DB: db.SqlcClient}
+	api := &APIStore{sqlcDB: db.SqlcClient}
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	var createErr, deleteErr error
+	wg.Go(func() { <-start; _, createErr = store.Create(t.Context(), p, p.ReservedBytes) })
+	wg.Go(func() { <-start; _, deleteErr = api.softDeleteTemplate(t.Context(), p.TeamID, p.SourceTemplateID) })
+	close(start)
+	wg.Wait()
+	if createErr == nil {
+		require.ErrorIs(t, deleteErr, errTemplateRestorePinned)
+	} else {
+		require.True(t, errors.Is(createErr, pgx.ErrNoRows), "unexpected admission error: %v", createErr)
+		require.NoError(t, deleteErr)
+	}
+}
