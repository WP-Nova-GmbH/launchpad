+func TestRestoreAdmissionIsIdempotentAndBindsRequest(t *testing.T) {
+	t.Parallel()
+	db := testutils.SetupDatabase(t)
+	store := restorestore.Store{DB: db.SqlcClient}
+	p := newOperation(t, db)
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	records := make([]queries.SandboxRestoreOperation, 2)
+	failures := make([]error, 2)
+	for i := range 2 {
+		attempt := p
+		attempt.SandboxID = uuid.NewString()
+		attempt.PreparedBuildID = uuid.New()
+		attempt.ExecutionID = uuid.New()
+		wg.Go(func() { <-start; records[i], failures[i] = store.Create(t.Context(), attempt, p.ReservedBytes) })
+	}
+	close(start)
+	wg.Wait()
+	for _, err := range failures {
+		require.NoError(t, err)
+	}
+	require.Equal(t, records[0].SandboxID, records[1].SandboxID)
+	require.Equal(t, records[0].PreparedBuildID, records[1].PreparedBuildID)
+	require.Equal(t, records[0].ExecutionID, records[1].ExecutionID)
