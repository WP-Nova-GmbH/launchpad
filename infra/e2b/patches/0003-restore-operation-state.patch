+func TestRestoreActivationFreezesBootPlanAndOwnsIndependentBuild(t *testing.T) {
+	t.Parallel()
+	db := testutils.SetupDatabase(t)
+	p := createOperation(t, db)
+	prepare(t, db, p)
+	store := restorestore.Store{DB: db.SqlcClient}
+	_, err := store.Activate(t.Context(), p.TeamID, p.OperationID)
+	require.NoError(t, err)
+	claimID := claim(t, db)
+	op, err := db.SqlcClient.GetRestoreOperation(t.Context(), queries.GetRestoreOperationParams{TeamID: p.TeamID, OperationID: p.OperationID})
+	require.NoError(t, err)
+	require.Equal(t, claimID, *op.ClaimID)
+	first, err := store.SaveActivationRequest(t.Context(), op, []byte(`{"assigned":"first"}`))
+	require.NoError(t, err)
+	require.Equal(t, []byte(`{"assigned":"first"}`), first.ActivationRequest)
+	again, err := store.SaveActivationRequest(t.Context(), op, []byte(`{"assigned":"second"}`))
+	require.NoError(t, err)
+	require.Equal(t, first.ActivationRequest, again.ActivationRequest, "a retry cannot change the assigned boot identity")
+	// Retagging cannot make the immutable pinned source unavailable to a worker.
+	require.NoError(t, db.SqlcClient.DeleteTemplateTags(t.Context(), queries.DeleteTemplateTagsParams{TemplateID: p.SourceTemplateID, Tags: []string{"default"}}))
+	source, err := db.SqlcClient.GetPinnedRestoreSource(t.Context(), queries.GetPinnedRestoreSourceParams{TeamID: p.TeamID, OperationID: p.OperationID})
+	require.NoError(t, err)
+	require.Equal(t, p.SourceBuildID, source.ID)
+	owned, err := db.SqlcClient.GetRestoreSourceBuild(t.Context(), queries.GetRestoreSourceBuildParams{TeamID: p.TeamID, TemplateID: p.SandboxID, BuildID: p.PreparedBuildID})
+	require.NoError(t, err)
+	require.Equal(t, p.PreparedBuildID, owned.ID)
+	require.NoError(t, store.Complete(t.Context(), p.TeamID, p.OperationID, claimID, "active"))
+	pinned, err := db.SqlcClient.HasRestoreBuildPins(t.Context(), p.SourceBuildID)
+	require.NoError(t, err)
+	require.False(t, pinned)
+}
