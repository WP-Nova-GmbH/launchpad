+package handlers
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/google/uuid"
+	"google.golang.org/protobuf/encoding/protojson"
+
+	"github.com/e2b-dev/infra/packages/api/internal/api"
+	"github.com/e2b-dev/infra/packages/api/internal/orchestrator"
+	restorestore "github.com/e2b-dev/infra/packages/db/pkg/restores"
+	"github.com/e2b-dev/infra/packages/db/queries"
+	rpc "github.com/e2b-dev/infra/packages/shared/pkg/grpc/orchestrator"
+)
+
+type restoreRuntime interface {
+	RestoreClient(context.Context, uuid.UUID, string) (rpc.SandboxServiceClient, context.Context, error)
+	ActivatePreparedRestore(context.Context, queries.SandboxRestoreOperation, *rpc.SandboxCreateRequest, string) error
+}
+
+func (a *APIStore) restoreRuntime() restoreRuntime {
+	if a.restoreRuntimeOverride != nil {
+		return a.restoreRuntimeOverride
+	}
+	return a.orchestrator
+}
+
+func (a *APIStore) wakeRestoreWorker() {
+	if a.restoreWake != nil {
+		select {
+		case a.restoreWake <- struct{}{}:
+		default:
+		}
+	}
+}
+
+func (a *APIStore) startRestoreWorker(ctx context.Context) {
+	if a.config.LaunchpadRestoreNodeID == "" {
+		return
+	}
+	workerCtx, cancel := context.WithCancel(ctx)
+	a.restoreCancel = cancel
+	a.restoreDone = make(chan struct{})
+	a.restoreWake = make(chan struct{}, 1)
+	go func() {
+		defer close(a.restoreDone)
+		timer := time.NewTicker(5 * time.Second)
+		defer timer.Stop()
+		a.wakeRestoreWorker()
+		for {
+			select {
+			case <-workerCtx.Done():
+				return
+			case <-timer.C:
+			case <-a.restoreWake:
+			}
+			// The database claim is longer than the bounded disk RPC. Cross-process
+			// duplicates still serialize on the host; lease expiry never proves absence.
+			claim := uuid.New()
+			ops, err := a.sqlcDB.ClaimRestoreOperations(workerCtx, queries.ClaimRestoreOperationsParams{
+				BatchSize: 1, ClaimID: &claim, ClaimUntil: time.Now().Add(20 * time.Minute),
+			})
+			if err != nil || len(ops) == 0 {
+				continue
+			}
+			op := ops[0]
+			runCtx, stop := context.WithTimeout(workerCtx, 17*time.Minute)
+			err = a.processRestoreOperation(runCtx, op)
+			stop()
+			if err != nil {
+				retryCtx, cancel := context.WithTimeout(context.WithoutCancel(workerCtx), 10*time.Second)
+				// Do not persist transport/debugfs errors containing credentials or paths.
+				reason := op.State + " is incomplete; retry or reconciliation pending"
+				_, _ = a.sqlcDB.RetryRestoreOperation(retryCtx, queries.RetryRestoreOperationParams{
+					TeamID: op.TeamID, OperationID: op.OperationID, ClaimID: &claim, LastError: &reason,
+					NextAttemptAt: time.Now().Add(10 * time.Second),
+				})
+				cancel()
+			}
+			a.wakeRestoreWorker()
+		}
+	}()
+}
+
+func (a *APIStore) processRestoreOperation(ctx context.Context, claimed queries.SandboxRestoreOperation) error {
+	op, err := a.sqlcDB.GetRestoreOperation(ctx, queries.GetRestoreOperationParams{TeamID: claimed.TeamID, OperationID: claimed.OperationID})
+	if err != nil {
+		return err
+	}
+	if op.ClaimID == nil || claimed.ClaimID == nil || *op.ClaimID != *claimed.ClaimID {
+		return restorestore.ErrConflict
+	}
+	client, child, err := a.restoreRuntime().RestoreClient(ctx, op.ClusterID, op.NodeID)
+	if err != nil {
+		return err
+	}
+	store := restorestore.Store{DB: a.sqlcDB}
+	switch op.State {
+	case "cancelling":
+		if _, err := client.CancelRestoreDisk(child, &rpc.RestoreDiskRequest{PreparedBuildId: op.PreparedBuildID.String()}); err != nil {
+			return err
+		}
+		return store.Complete(ctx, op.TeamID, op.OperationID, *op.ClaimID, "cancelled")
+	case "preparing":
+		var input api.LaunchpadRestoreRequest
+		if err := json.Unmarshal(op.RequestPayload, &input); err != nil {
+			return err
+		}
+		var bootstrap []byte
+		if input.Bootstrap != nil {
+			bootstrap, err = json.Marshal(input.Bootstrap)
+			if err != nil {
+				return err
+			}
+		}
+		result, err := client.PrepareRestoreDisk(child, &rpc.RestoreDiskPrepareRequest{
+			SourceBuildId: op.SourceBuildID.String(), PreparedBuildId: op.PreparedBuildID.String(), MaxDiskBytes: op.ReservedBytes / 2, Bootstrap: bootstrap,
+		})
+		if err != nil {
+			return err
+		}
+		digest := sha256.Sum256(result.GetManifest())
+		var identity struct {
+			BuildID       uuid.UUID `json:"build_id"`
+			SourceBuildID uuid.UUID `json:"source_build_id"`
+		}
+		if json.Unmarshal(result.GetManifest(), &identity) != nil || identity.BuildID != op.PreparedBuildID || identity.SourceBuildID != op.SourceBuildID ||
+			result.GetManifestSha256() != hex.EncodeToString(digest[:]) {
+			return errors.New("invalid prepared manifest")
+		}
+		n, err := a.sqlcDB.FinishRestorePreparation(ctx, queries.FinishRestorePreparationParams{
+			TeamID: op.TeamID, OperationID: op.OperationID, ClaimID: op.ClaimID, Manifest: result.GetManifest(),
+		})
+		if err != nil {
+			return err
+		}
+		if n != 1 {
+			return restorestore.ErrConflict
+		}
+		return nil
+	case "activating":
+		if len(op.ActivationRequest) == 0 {
+			var input api.LaunchpadRestoreRequest
+			if err := json.Unmarshal(op.RequestPayload, &input); err != nil {
+				return err
+			}
+			build, err := a.sqlcDB.GetPinnedRestoreSource(ctx, queries.GetPinnedRestoreSourceParams{TeamID: op.TeamID, OperationID: op.OperationID})
+			if err != nil {
+				return err
+			}
+			team, err := a.authService.GetTeamByID(ctx, op.TeamID)
+			if err != nil {
+				return err
+			}
+			request, err := orchestrator.BuildRestoreRequest(op, build, team, input, time.Now())
+			if err != nil {
+				return err
+			}
+			raw, err := protojson.Marshal(request)
+			if err != nil {
+				return err
+			}
+			op, err = store.SaveActivationRequest(ctx, op, raw)
+			if err != nil {
+				return err
+			}
+		}
+		request := &rpc.SandboxCreateRequest{}
+		if err := protojson.Unmarshal(op.ActivationRequest, request); err != nil {
+			return err
+		}
+		digest := sha256.Sum256(op.Manifest)
+		if err := a.restoreRuntime().ActivatePreparedRestore(ctx, op, request, hex.EncodeToString(digest[:])); err != nil {
+			return err
+		}
+		if _, err := client.ReleaseRestoreDisk(child, &rpc.RestoreDiskRequest{PreparedBuildId: op.PreparedBuildID.String()}); err != nil {
+			return err
+		}
+		return store.Complete(ctx, op.TeamID, op.OperationID, *op.ClaimID, "active")
+	default:
+		return fmt.Errorf("unexpected restore worker phase %s", op.State)
+	}
+}
