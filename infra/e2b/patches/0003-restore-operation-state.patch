+//go:build linux
+
+package server
+
+import (
+	"github.com/google/uuid"
+	"google.golang.org/protobuf/types/known/timestamppb"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/grpc/orchestrator"
+)
+
+func TestRestoreExtensionDisabledByDefault(t *testing.T) {
+	t.Parallel()
+	server := &Server{}
+	_, err := server.PrepareRestoreDisk(t.Context(), &orchestrator.RestoreDiskPrepareRequest{})
+	require.Equal(t, codes.Unimplemented, status.Code(err))
+	_, err = server.InspectRestoreDisk(t.Context(), &orchestrator.RestoreDiskRequest{})
+	require.Equal(t, codes.Unimplemented, status.Code(err))
+	_, err = server.CancelRestoreDisk(t.Context(), &orchestrator.RestoreDiskRequest{})
+	require.Equal(t, codes.Unimplemented, status.Code(err))
+	_, err = server.ActivateRestoreDisk(t.Context(), &orchestrator.RestoreDiskActivateRequest{})
+	require.Equal(t, codes.Unimplemented, status.Code(err))
+	_, err = server.ReleaseRestoreDisk(t.Context(), &orchestrator.RestoreDiskRequest{})
+	require.Equal(t, codes.Unimplemented, status.Code(err))
+}
+
+func TestRestoreRejectsPathsBeforeDiskAccess(t *testing.T) {
+	t.Parallel()
+	server := &Server{}
+	server.config.RestorePreparationEnabled = true
+	for _, raw := range []string{"", "../outside", "00000000-0000-0000-0000-000000000000"} {
+		_, err := server.CancelRestoreDisk(t.Context(), &orchestrator.RestoreDiskRequest{PreparedBuildId: raw})
+		require.Equal(t, codes.InvalidArgument, status.Code(err))
+	}
+}
+
+func TestRestoreActivationRequiresFreshColdBootIdentity(t *testing.T) {
+	t.Parallel()
+	token := "new-envd-token"
+	request := &orchestrator.RestoreDiskActivateRequest{
+		ManifestSha256: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
+		Create: &orchestrator.SandboxCreateRequest{
+			Sandbox: &orchestrator.SandboxConfig{BuildId: uuid.NewString(), TeamId: uuid.NewString(),
+				SandboxId: "assigned-sandbox", ExecutionId: "assigned-execution", TemplateId: "template", Snapshot: true, EnvdAccessToken: &token},
+			FilesystemBoot: new(true), StartTime: timestamppb.Now(), EndTime: timestamppb.New(time.Now().Add(time.Minute)),
+		},
+	}
+	_, err := validateRestoreActivation(request)
+	require.NoError(t, err)
+	request.Create.FilesystemBoot = new(false)
+	_, err = validateRestoreActivation(request)
+	require.Equal(t, codes.InvalidArgument, status.Code(err))
+	request.Create.FilesystemBoot = new(true)
+	request.Create.Sandbox.EnvdAccessToken = nil
+	_, err = validateRestoreActivation(request)
+	require.Equal(t, codes.InvalidArgument, status.Code(err))
+	_, err = validateRestoreActivation(&orchestrator.RestoreDiskActivateRequest{})
+	require.Equal(t, codes.InvalidArgument, status.Code(err))
+}
