+//go:build linux
+
+package server
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/google/uuid"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/encoding/protojson"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/emptypb"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox/rootfs"
+	"github.com/e2b-dev/infra/packages/shared/pkg/grpc/orchestrator"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage"
+)
+
+func (s *Server) restoreDiskDirectory() (string, error) {
+	if !s.config.RestorePreparationEnabled {
+		return "", status.Error(codes.Unimplemented, "prepared restore extension is disabled")
+	}
+	return filepath.Join(s.config.OrchestratorBaseDir, "prepared-restores"), nil
+}
+
+func restoreBuildID(raw string) (uuid.UUID, error) {
+	id, err := uuid.Parse(raw)
+	if err != nil || id == uuid.Nil {
+		return uuid.Nil, status.Error(codes.InvalidArgument, "invalid restore build ID")
+	}
+	return id, nil
+}
+
+func restoreDiskResponse(disk rootfs.PreparedDisk) (*orchestrator.RestoreDiskResponse, error) {
+	manifest, digest, err := rootfs.PreparedManifest(disk)
+	if err != nil {
+		return nil, err
+	}
+	return &orchestrator.RestoreDiskResponse{Manifest: manifest, ManifestSha256: digest}, nil
+}
+
+func restoreDiskError(err error) error {
+	switch {
+	case errors.Is(err, os.ErrNotExist):
+		return status.Error(codes.NotFound, "prepared restore disk does not exist")
+	case errors.Is(err, rootfs.ErrRestoreActivationStarted):
+		return status.Error(codes.FailedPrecondition, "restore activation requires reconciliation")
+	case errors.Is(err, rootfs.ErrPreparedDiskCancelled):
+		return status.Error(codes.FailedPrecondition, "prepared restore was cancelled")
+	case errors.Is(err, rootfs.ErrPreparedDiskBusy):
+		return status.Error(codes.Aborted, "prepared restore disk is busy")
+	case errors.Is(err, rootfs.ErrPreparedDiskConflict):
+		return status.Error(codes.AlreadyExists, "prepared restore manifest conflicts")
+	case errors.Is(err, rootfs.ErrPreparedDiskCorrupt):
+		return status.Error(codes.DataLoss, "prepared restore integrity check failed")
+	default:
+		return err
+	}
+}
+
+func (s *Server) PrepareRestoreDisk(ctx context.Context, req *orchestrator.RestoreDiskPrepareRequest) (*orchestrator.RestoreDiskResponse, error) {
+	directory, err := s.restoreDiskDirectory()
+	if err != nil {
+		return nil, err
+	}
+	sourceID, err := restoreBuildID(req.GetSourceBuildId())
+	if err != nil {
+		return nil, err
+	}
+	destinationID, err := restoreBuildID(req.GetPreparedBuildId())
+	if err != nil {
+		return nil, err
+	}
+	if sourceID == destinationID || req.GetMaxDiskBytes() <= 0 {
+		return nil, status.Error(codes.InvalidArgument, "invalid restore reservation")
+	}
+	// Bound preparation time and NBD/verifier concurrency with the existing
+	// start semaphore. No guest resources or CPU are allocated by this path.
+	ctx, cancel := context.WithTimeout(ctx, 15*time.Minute)
+	defer cancel()
+	if !s.startingSandboxes.TryAcquire(1) {
+		return nil, status.Error(codes.ResourceExhausted, "restore preparation capacity is busy")
+	}
+	defer s.startingSandboxes.Release(1)
+	source, release, err := s.templateCache.GetTemplatePinned(ctx, sourceID.String(), true, false)
+	defer release()
+	if err != nil {
+		return nil, err
+	}
+	disk, err := s.sandboxFactory.PrepareRestoreDisk(ctx, directory, destinationID, source, req.GetMaxDiskBytes(), req.GetBootstrap())
+	if err != nil {
+		return nil, restoreDiskError(err)
+	}
+	return restoreDiskResponse(disk)
+}
+
+func (s *Server) InspectRestoreDisk(ctx context.Context, req *orchestrator.RestoreDiskRequest) (*orchestrator.RestoreDiskResponse, error) {
+	directory, err := s.restoreDiskDirectory()
+	if err != nil {
+		return nil, err
+	}
+	id, err := restoreBuildID(req.GetPreparedBuildId())
+	if err != nil {
+		return nil, err
+	}
+	manifest, disk, err := rootfs.OpenPreparedDisk(ctx, directory, id)
+	if err != nil {
+		return nil, restoreDiskError(err)
+	}
+	if err = disk.Close(); err != nil {
+		return nil, err
+	}
+	return restoreDiskResponse(manifest)
+}
+
+func (s *Server) CancelRestoreDisk(ctx context.Context, req *orchestrator.RestoreDiskRequest) (*emptypb.Empty, error) {
+	directory, err := s.restoreDiskDirectory()
+	if err != nil {
+		return nil, err
+	}
+	id, err := restoreBuildID(req.GetPreparedBuildId())
+	if err != nil {
+		return nil, err
+	}
+	if err = rootfs.CancelPreparedDisk(ctx, directory, id); err != nil {
+		return nil, restoreDiskError(err)
+	}
+	return &emptypb.Empty{}, nil
+}
+
+func (s *Server) requireRestoreActivated(req *orchestrator.SandboxCreateRequest) error {
+	id, err := uuid.Parse(req.GetSandbox().GetBuildId())
+	if err != nil {
+		return nil
+	} // Existing Create validation owns ordinary inputs.
+	return restoreDiskError(rootfs.RequireActivatedBuild(filepath.Join(s.config.OrchestratorBaseDir, "prepared-restores"), id))
+}
+
+func validateRestoreActivation(req *orchestrator.RestoreDiskActivateRequest) (uuid.UUID, error) {
+	create := req.GetCreate()
+	config := create.GetSandbox()
+	id, err := restoreBuildID(config.GetBuildId())
+	if err != nil {
+		return uuid.Nil, err
+	}
+	manifest, err := hex.DecodeString(req.GetManifestSha256())
+	if err != nil || len(manifest) != sha256.Size || !create.GetFilesystemBoot() || !config.GetSnapshot() ||
+		config.GetSandboxId() == "" || config.GetExecutionId() == "" || config.GetEnvdAccessToken() == "" ||
+		config.GetTemplateId() == "" || config.GetTeamId() == "" ||
+		create.GetStartTime().CheckValid() != nil || create.GetEndTime().CheckValid() != nil ||
+		!create.GetEndTime().AsTime().After(create.GetStartTime().AsTime()) {
+		return uuid.Nil, status.Error(codes.InvalidArgument, "invalid restore activation request")
+	}
+	if _, err := restoreBuildID(config.GetTeamId()); err != nil {
+		return uuid.Nil, err
+	}
+	return id, nil
+}
+
+// ActivateRestoreDisk is called only after the API has durably won activation.
+// The local receipt is a second fence for the external side effect, so an
+// expired API worker lease cannot cause another start after a lost response.
+func (s *Server) ActivateRestoreDisk(ctx context.Context, req *orchestrator.RestoreDiskActivateRequest) (*orchestrator.SandboxCreateResponse, error) {
+	directory, err := s.restoreDiskDirectory()
+	if err != nil {
+		return nil, err
+	}
+	id, err := validateRestoreActivation(req)
+	if err != nil {
+		return nil, err
+	}
+	request, err := (proto.MarshalOptions{Deterministic: true}).Marshal(req.GetCreate())
+	if err != nil {
+		return nil, err
+	}
+	activation, err := rootfs.LockRestoreActivation(ctx, directory, id, req.GetManifestSha256(), request)
+	if err != nil {
+		return nil, restoreDiskError(err)
+	}
+	defer activation.Close()
+	record := activation.Record()
+	if record.State == "active" {
+		result := &orchestrator.SandboxCreateResponse{}
+		if err := protojson.Unmarshal(record.Response, result); err != nil {
+			return nil, status.Error(codes.DataLoss, "invalid restore activation receipt")
+		}
+		return result, nil
+	}
+	config := req.GetCreate().GetSandbox()
+	var response *orchestrator.SandboxCreateResponse
+	if record.State == "booting" {
+		live, found := s.sandboxFactory.Sandboxes.Get(config.GetSandboxId())
+		if !found {
+			return nil, status.Error(codes.FailedPrecondition, "restore boot outcome requires reconciliation")
+		}
+		if live.Runtime.ExecutionID != config.GetExecutionId() || live.Runtime.BuildID != id.String() || live.Runtime.TeamID != config.GetTeamId() {
+			return nil, status.Error(codes.AlreadyExists, "restore execution identity conflicts")
+		}
+		// Registry promotion only happens after envd initialization and before the
+		// Create response. Finding the exact identity proves that milestone landed.
+		response = &orchestrator.SandboxCreateResponse{ClientId: s.info.ClientId, FilesystemBootApplied: true,
+			ResolvedFirecrackerVersion: live.Config.FirecrackerConfig.FirecrackerVersion}
+	} else {
+		_, err = rootfs.PublishPreparedDisk(ctx, directory, id, req.GetManifestSha256(), s.persistence, storage.ObjectMetadata{
+			storage.ObjectMetadataTeamID: config.GetTeamId(), storage.ObjectMetadataTemplateID: config.GetTemplateId(),
+			storage.ObjectMetadataBuildOrigin: string(storage.ObjectOriginSnapshotTemplate),
+		})
+		if err != nil {
+			return nil, restoreDiskError(err)
+		}
+		response, err = s.createSandbox(ctx, req.GetCreate(), activation.BeginBoot)
+		if err != nil {
+			return nil, err
+		}
+	}
+	raw, err := protojson.Marshal(response)
+	if err != nil {
+		return nil, err
+	}
+	if err := activation.Complete(json.RawMessage(raw)); err != nil {
+		return nil, err
+	}
+	return response, nil
+}
+
+func (s *Server) ReleaseRestoreDisk(ctx context.Context, req *orchestrator.RestoreDiskRequest) (*emptypb.Empty, error) {
+	directory, err := s.restoreDiskDirectory()
+	if err != nil {
+		return nil, err
+	}
+	id, err := restoreBuildID(req.GetPreparedBuildId())
+	if err != nil {
+		return nil, err
+	}
+	if err := rootfs.ReleaseActivatedDisk(ctx, directory, id); err != nil {
+		return nil, restoreDiskError(err)
+	}
+	return &emptypb.Empty{}, nil
+}
