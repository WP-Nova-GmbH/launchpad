+package handlers
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"math"
+	"net/http"
+	"slices"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+
+	"github.com/e2b-dev/infra/packages/api/internal/api"
+	"github.com/e2b-dev/infra/packages/auth/pkg/auth"
+	restorestore "github.com/e2b-dev/infra/packages/db/pkg/restores"
+	"github.com/e2b-dev/infra/packages/db/queries"
+	"github.com/e2b-dev/infra/packages/shared/pkg/id"
+)
+
+func (a *APIStore) restoreAdmissionEnabled(team uuid.UUID) bool {
+	return a.config.LaunchpadRestoreNodeID != "" && a.config.LaunchpadRestoreCapacityBytes > 0 &&
+		slices.Contains(a.config.LaunchpadRestoreTeams, team.String())
+}
+
+func (a *APIStore) GetLaunchpadCapabilities(c *gin.Context) {
+	if !a.restoreAdmissionEnabled(auth.MustGetTeamInfo(c).Team.ID) {
+		a.sendAPIStoreError(c, http.StatusForbidden, "Launchpad restore is not enabled for this team")
+		return
+	}
+	c.JSON(http.StatusOK, api.LaunchpadRuntimeCapabilities{Version: 1, DiskRestore: true, RenewableLifetime: false})
+}
+
+func canonicalRestoreRequest(body api.LaunchpadRestoreRequest) ([]byte, error) {
+	if body.SourceBuildID == uuid.Nil || body.SourceTemplateID == "" || len(body.SourceTemplateID) > 128 ||
+		body.Generation == "" || len(body.Generation) > 256 {
+		return nil, restorestore.ErrInvalid
+	}
+	if body.LeaseSeconds == nil {
+		body.LeaseSeconds = new(600)
+	}
+	if *body.LeaseSeconds < 60 || *body.LeaseSeconds > 3600 {
+		return nil, restorestore.ErrInvalid
+	}
+	if body.Bootstrap != nil {
+		raw, err := json.Marshal(body.Bootstrap)
+		if err != nil || len(raw) > 16*1024 {
+			return nil, restorestore.ErrInvalid
+		}
+		var version struct {
+			Version int `json:"version"`
+		}
+		if json.Unmarshal(raw, &version) != nil || version.Version != 1 {
+			return nil, restorestore.ErrInvalid
+		}
+	}
+	if body.Metadata != nil {
+		if len(*body.Metadata) > 16 {
+			return nil, restorestore.ErrInvalid
+		}
+		for key, value := range *body.Metadata {
+			if !strings.HasPrefix(key, "launchpad.") || len(key) > 128 || len(value) > 256 {
+				return nil, restorestore.ErrInvalid
+			}
+		}
+	}
+	raw, err := json.Marshal(body)
+	if err != nil || len(raw) > 32*1024 {
+		return nil, restorestore.ErrInvalid
+	}
+	return raw, nil
+}
+
+func (a *APIStore) restoreError(c *gin.Context, err error) {
+	switch {
+	case errors.Is(err, pgx.ErrNoRows):
+		a.sendAPIStoreError(c, 404, "Restore or source not found")
+	case errors.Is(err, restorestore.ErrConflict):
+		a.sendAPIStoreError(c, 409, "Restore operation conflicts with its request or state")
+	case errors.Is(err, restorestore.ErrCapacity):
+		a.sendAPIStoreError(c, 429, "Restore preparation capacity is exhausted")
+	case errors.Is(err, restorestore.ErrInvalid):
+		a.sendAPIStoreError(c, 400, "Invalid restore request")
+	default:
+		a.sendAPIStoreError(c, 503, "Restore operation is temporarily unavailable")
+	}
+}
+
+func (a *APIStore) restoreStatus(c *gin.Context, code int, op queries.SandboxRestoreOperation) {
+	result := api.LaunchpadRestoreStatus{OperationID: op.OperationID, State: api.LaunchpadRestoreStatusState(op.State),
+		Generation: op.Generation, SandboxID: op.SandboxID, ExecutionID: op.ExecutionID, PreparedBuildID: op.PreparedBuildID,
+		Error: op.LastError}
+	if len(op.Manifest) > 0 {
+		sum := sha256.Sum256(op.Manifest)
+		result.ManifestSHA256 = new(hex.EncodeToString(sum[:]))
+	}
+	if op.State == "active" && a.orchestrator != nil {
+		if sbx, err := a.orchestrator.GetSandbox(c.Request.Context(), op.TeamID, op.SandboxID); err == nil && sbx.ExecutionID == op.ExecutionID.String() {
+			result.Sandbox = sbx.ToAPISandbox()
+		}
+	}
+	c.JSON(code, result)
+}
+
+// Builds record whole MiB rounded down. Reserve the next whole MiB before
+// multiplying for the private COW and flattened disk; the host still enforces
+// this byte bound against the real immutable disk geometry.
+func restoreDiskReservation(sizeMB *int64) (int64, error) {
+	const twoCopiesMiB = int64(2 * 1024 * 1024)
+	if sizeMB == nil || *sizeMB <= 0 || *sizeMB >= math.MaxInt64/twoCopiesMiB {
+		return 0, restorestore.ErrInvalid
+	}
+	return (*sizeMB + 1) * twoCopiesMiB, nil
+}
+
+func (a *APIStore) PutLaunchpadRestore(c *gin.Context, operationID uuid.UUID) {
+	team := auth.MustGetTeamInfo(c)
+	if operationID == uuid.Nil {
+		a.restoreError(c, restorestore.ErrInvalid)
+		return
+	}
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 40*1024)
+	decoder := json.NewDecoder(c.Request.Body)
+	decoder.DisallowUnknownFields()
+	var body api.LaunchpadRestoreRequest
+	if decoder.Decode(&body) != nil {
+		a.restoreError(c, restorestore.ErrInvalid)
+		return
+	}
+	var extra any
+	if err := decoder.Decode(&extra); !errors.Is(err, io.EOF) {
+		a.restoreError(c, restorestore.ErrInvalid)
+		return
+	}
+	raw, err := canonicalRestoreRequest(body)
+	if err != nil {
+		a.restoreError(c, err)
+		return
+	}
+	ctx := c.Request.Context()
+	existing, err := a.sqlcDB.GetRestoreOperation(ctx, queries.GetRestoreOperationParams{TeamID: team.Team.ID, OperationID: operationID})
+	if err == nil {
+		if !bytes.Equal(existing.RequestPayload, raw) {
+			a.restoreError(c, restorestore.ErrConflict)
+			return
+		}
+		a.restoreStatus(c, http.StatusAccepted, existing)
+		return
+	}
+	if !errors.Is(err, pgx.ErrNoRows) {
+		a.restoreError(c, err)
+		return
+	}
+	if !a.restoreAdmissionEnabled(team.Team.ID) || (team.Team.ClusterID != nil && *team.Team.ClusterID != uuid.Nil) {
+		a.sendAPIStoreError(c, 403, "Restore admission requires the configured dedicated local team")
+		return
+	}
+	build, err := a.sqlcDB.GetRestoreSourceBuild(ctx, queries.GetRestoreSourceBuildParams{
+		TeamID: team.Team.ID, TemplateID: body.SourceTemplateID, BuildID: body.SourceBuildID,
+	})
+	if err != nil {
+		a.restoreError(c, err)
+		return
+	}
+	reservedBytes, err := restoreDiskReservation(build.TotalDiskSizeMb)
+	if err != nil {
+		a.restoreError(c, restorestore.ErrInvalid)
+		return
+	}
+	op, err := (restorestore.Store{DB: a.sqlcDB}).Create(ctx, queries.CreateRestoreOperationParams{
+		TeamID: team.Team.ID, OperationID: operationID, RequestPayload: raw,
+		SourceTemplateID: body.SourceTemplateID, SourceBuildID: body.SourceBuildID,
+		PreparedBuildID: uuid.New(), SandboxID: id.Generate(), ExecutionID: uuid.New(),
+		ClusterID: uuid.Nil, NodeID: a.config.LaunchpadRestoreNodeID, Generation: body.Generation,
+		ReservedBytes: reservedBytes,
+	}, a.config.LaunchpadRestoreCapacityBytes)
+	if err != nil {
+		a.restoreError(c, err)
+		return
+	}
+	a.wakeRestoreWorker()
+	a.restoreStatus(c, http.StatusAccepted, op)
+}
+
+func (a *APIStore) GetLaunchpadRestore(c *gin.Context, operationID uuid.UUID) {
+	op, err := a.sqlcDB.GetRestoreOperation(c.Request.Context(), queries.GetRestoreOperationParams{
+		TeamID: auth.MustGetTeamInfo(c).Team.ID, OperationID: operationID,
+	})
+	if err != nil {
+		a.restoreError(c, err)
+		return
+	}
+	a.restoreStatus(c, http.StatusOK, op)
+}
+
+func (a *APIStore) PostLaunchpadRestoreActivate(c *gin.Context, operationID uuid.UUID) {
+	ctx := c.Request.Context()
+	team := auth.MustGetTeamInfo(c).Team.ID
+	op, err := a.sqlcDB.GetRestoreOperation(ctx, queries.GetRestoreOperationParams{TeamID: team, OperationID: operationID})
+	if err != nil {
+		a.restoreError(c, err)
+		return
+	}
+	var input api.LaunchpadRestoreRequest
+	if json.Unmarshal(op.RequestPayload, &input) != nil || input.Bootstrap == nil {
+		a.sendAPIStoreError(c, 409, "Verification-only preparations cannot be activated")
+		return
+	}
+	op, err = (restorestore.Store{DB: a.sqlcDB}).Activate(ctx, team, operationID)
+	if err != nil {
+		a.restoreError(c, err)
+		return
+	}
+	a.wakeRestoreWorker()
+	a.restoreStatus(c, http.StatusAccepted, op)
+}
+
+func (a *APIStore) DeleteLaunchpadRestore(c *gin.Context, operationID uuid.UUID) {
+	op, err := (restorestore.Store{DB: a.sqlcDB}).Cancel(c.Request.Context(), auth.MustGetTeamInfo(c).Team.ID, operationID)
+	if err != nil {
+		a.restoreError(c, err)
+		return
+	}
+	a.wakeRestoreWorker()
+	a.restoreStatus(c, http.StatusAccepted, op)
+}
