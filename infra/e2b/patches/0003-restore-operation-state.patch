+func TestPreparedRestoreBootPlanIsColdBoundedAndCredentialFree(t *testing.T) {
+	t.Parallel()
+	now := time.Date(2026, 10, 1, 12, 0, 0, 0, time.UTC)
+	op := queries.SandboxRestoreOperation{PreparedBuildID: uuid.New(), TeamID: uuid.New(), ExecutionID: uuid.New(), OperationID: uuid.New(), SandboxID: "destination", SourceTemplateID: "source", Generation: "placement-3"}
+	build := queries.EnvBuild{KernelVersion: "kernel", FirecrackerVersion: "fc", EnvdVersion: new("envd"), TotalDiskSizeMb: new(int64(64)), RamMb: 1024, Vcpu: 1}
+	team := &teamtypes.Team{Limits: &teamtypes.TeamLimits{MaxLengthHours: 1}}
+	input := api.LaunchpadRestoreRequest{LeaseSeconds: new(600), Metadata: &map[string]string{"launchpad.thread_id": "thread-1", "launchpad.operation_id": "spoofed"}}
+	req, err := BuildRestoreRequest(op, build, team, input, now)
+	require.NoError(t, err)
+	require.True(t, req.GetFilesystemBoot())
+	require.True(t, req.GetSandbox().GetSnapshot())
+	require.Equal(t, op.PreparedBuildID.String(), req.GetSandbox().GetBuildId())
+	require.Equal(t, op.OperationID.String(), req.GetSandbox().GetMetadata()["launchpad.operation_id"])
+	require.Equal(t, now.Add(10*time.Minute), req.GetEndTime().AsTime())
+	require.Empty(t, req.GetSandbox().GetEnvdAccessToken(), "the durable request must not contain a reusable credential")
+	require.Empty(t, req.GetSandbox().GetNetwork().GetIngress().GetTrafficAccessToken())
+	require.Equal(t, "spoofed", (*input.Metadata)["launchpad.operation_id"], "normalization must not mutate caller input")
+	input.LeaseSeconds = new(3601)
+	_, err = BuildRestoreRequest(op, build, team, input, now)
+	require.Error(t, err)
+}
