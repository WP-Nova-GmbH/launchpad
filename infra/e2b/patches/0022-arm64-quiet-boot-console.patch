+++ b/packages/orchestrator/pkg/sandbox/fc/kernel_args.go
@@ -126,6 +126,12 @@
 	// keeps the architected timer as its clocksource. The serial console is ttyS0 on both:
 	// Firecracker exposes a 16550-compatible UART on arm64 too, and the arm64 guest kernel
 	// is built with the 8250 driver.
+	// Bind the ARM UART even with quiet logging. The pinned ARM image can stall
+	// during systemd cold boot without a console; verbosity stays unchanged.
+	if arch == "arm64" {
+		args["console"] = "ttyS0"
+	}
+
 	if arch == "amd64" {
 		args["i8042.nokbd"] = ""
 		args["i8042.noaux"] = ""
