+func TestFSReadHandleCannotWriteOrCreateObjects(t *testing.T) {
+	t.Parallel()
+	p := newTempProvider(t)
+	ctx := t.Context()
+	obj, err := p.OpenBlob(ctx, "retained-header")
+	require.NoError(t, err)
+	require.NoError(t, obj.Put(ctx, []byte("retained")))
+	file, err := obj.(*fsObject).getHandle()
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, file.Close()) })
+	_, err = file.Write([]byte("changed"))
+	require.Error(t, err)
+	data, err := GetBlob(ctx, obj)
+	require.NoError(t, err)
+	require.Equal(t, "retained", string(data))
+
+	missing, err := p.OpenBlob(ctx, "missing-header")
+	require.NoError(t, err)
+	_, err = GetBlob(ctx, missing)
+	require.ErrorIs(t, err, ErrObjectNotExist)
+	exists, err := missing.Exists(ctx)
+	require.NoError(t, err)
+	require.False(t, exists)
