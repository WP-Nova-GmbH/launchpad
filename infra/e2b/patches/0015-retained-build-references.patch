@@ -0,0 +1,60 @@
+package template
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/google/uuid"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/template/metadata"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+// RetainedBuilds marks the object prefixes needed by retained template, live
+// sandbox and restore roots. The caller must hold admission against new roots
+// for the entire mark/delete transaction. No deletion is safe when this scan
+// fails: a missing header is not evidence that its ancestor layers are unused.
+func RetainedBuilds(ctx context.Context, store storage.StorageProvider, roots []uuid.UUID) (map[uuid.UUID]struct{}, error) {
+	retained := make(map[uuid.UUID]struct{})
+	scanned := make(map[uuid.UUID]struct{})
+	for _, buildID := range roots {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		if buildID == uuid.Nil {
+			return nil, fmt.Errorf("empty retained build identity")
+		}
+		if _, done := scanned[buildID]; done {
+			continue
+		}
+		meta, err := metadata.FromBuildID(ctx, store, buildID.String())
+		if err != nil {
+			return nil, fmt.Errorf("read retained metadata %s: %w", buildID, err)
+		}
+		if meta.Template.BuildID != "" && meta.Template.BuildID != buildID.String() {
+			return nil, fmt.Errorf("mismatched retained metadata for build %s", buildID)
+		}
+		paths := storage.Paths{BuildID: buildID.String()}
+		rootfs, _, err := header.LoadStoredHeader(ctx, store, paths.RootfsHeader())
+		if err != nil {
+			return nil, fmt.Errorf("read retained rootfs %s: %w", buildID, err)
+		}
+		var memfile *header.Header
+		if !meta.IsFilesystemOnly() {
+			memfile, _, err = header.LoadStoredHeader(ctx, store, paths.MemfileHeader())
+			if err != nil {
+				return nil, fmt.Errorf("read retained memory %s: %w", buildID, err)
+			}
+		}
+		references, err := header.ReferencedBuildIDs(buildID, rootfs, memfile, meta.IsFilesystemOnly())
+		if err != nil {
+			return nil, err
+		}
+		for id := range references {
+			retained[id] = struct{}{}
+		}
+		scanned[buildID] = struct{}{}
+	}
+	return retained, nil
+}
diff --git a/packages/orchestrator/pkg/template/template/references_test.go b/packages/orchestrator/pkg/template/template/references_test.go
