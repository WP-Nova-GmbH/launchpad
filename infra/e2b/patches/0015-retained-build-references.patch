@@ -0,0 +1,42 @@
+package header
+
+import (
+	"fmt"
+
+	"github.com/google/uuid"
+)
+
+// ReferencedBuildIDs reports every build whose objects a saved build may read.
+// Both disk and memory mappings are required for RAM snapshots: a child can replace all
+// rootfs blocks while still referring to an ancestor's memory blocks. The
+// snapshot's own build is retained for its snapfile and metadata even if no
+// mapped block happens to use it. An unreadable or mismatched header must stop
+// collection rather than make a build appear unreferenced.
+// filesystemOnly must come from the stored build metadata; a missing memory
+// header alone does not establish that the build is a cold-boot disk.
+func ReferencedBuildIDs(buildID uuid.UUID, rootfs, memfile *Header, filesystemOnly bool) (map[uuid.UUID]struct{}, error) {
+	if buildID == uuid.Nil || rootfs == nil || (!filesystemOnly && memfile == nil) {
+		return nil, fmt.Errorf("missing headers for build %s", buildID)
+	}
+
+	references := map[uuid.UUID]struct{}{buildID: {}}
+	headers := []*Header{rootfs}
+	if memfile != nil {
+		headers = append(headers, memfile)
+	}
+	for _, h := range headers {
+		if h.Metadata == nil || h.Metadata.BuildId != buildID {
+			return nil, fmt.Errorf("mismatched header for build %s", buildID)
+		}
+		if h.Mapping.Len() == 0 {
+			return nil, fmt.Errorf("empty mapping in header for build %s", buildID)
+		}
+		for _, id := range h.Mapping.Builds() {
+			if id == uuid.Nil {
+				return nil, fmt.Errorf("empty mapped build in header for build %s", buildID)
+			}
+			references[id] = struct{}{}
+		}
+	}
+	return references, nil
+}
diff --git a/packages/shared/pkg/storage/header/references_test.go b/packages/shared/pkg/storage/header/references_test.go
