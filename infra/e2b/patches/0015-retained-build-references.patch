@@ -0,0 +1,55 @@
+package header
+
+import (
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+)
+
+func TestReferencedBuildIDsIncludesIndependentDiskAndMemoryAncestors(t *testing.T) {
+	t.Parallel()
+	self, diskParent, memoryParent := uuid.New(), uuid.New(), uuid.New()
+	makeHeader := func(parent uuid.UUID) *Header {
+		h, err := NewHeader(&Metadata{Version: MetadataVersionV4, BuildId: self,
+			BlockSize: 4096, Size: 8192}, []BuildMap{
+			{Offset: 0, Length: 4096, BuildId: self},
+			{Offset: 4096, Length: 4096, BuildId: parent},
+		})
+		require.NoError(t, err)
+		return h
+	}
+
+	refs, err := ReferencedBuildIDs(self, makeHeader(diskParent), makeHeader(memoryParent), false)
+	require.NoError(t, err)
+	require.Equal(t, map[uuid.UUID]struct{}{
+		self: {}, diskParent: {}, memoryParent: {},
+	}, refs)
+}
+
+func TestReferencedBuildIDsFailsClosed(t *testing.T) {
+	t.Parallel()
+	self := uuid.New()
+	h, err := NewHeader(&Metadata{Version: 3, BuildId: self,
+		BlockSize: 4096, Size: 4096}, nil)
+	require.NoError(t, err)
+	_, err = ReferencedBuildIDs(self, h, nil, false)
+	require.Error(t, err)
+
+	wrong, err := NewHeader(&Metadata{Version: 3, BuildId: uuid.New(),
+		BlockSize: 4096, Size: 4096}, nil)
+	require.NoError(t, err)
+	_, err = ReferencedBuildIDs(self, h, wrong, false)
+	require.Error(t, err)
+}
+
+func TestReferencedBuildIDsAcceptsAnExplicitFilesystemOnlyBuild(t *testing.T) {
+	t.Parallel()
+	self := uuid.New()
+	h, err := NewHeader(&Metadata{Version: 3, BuildId: self,
+		BlockSize: 4096, Size: 4096}, nil)
+	require.NoError(t, err)
+	refs, err := ReferencedBuildIDs(self, h, nil, true)
+	require.NoError(t, err)
+	require.Equal(t, map[uuid.UUID]struct{}{self: {}}, refs)
+}
