index 0000000..49f79e6
--- /dev/null
+++ b/packages/orchestrator/pkg/template/template/references_test.go
@@ -0,0 +1,61 @@
+package template
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/template/metadata"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+func TestRetainedBuildsUsesStoredFilesystemOnlyMetadata(t *testing.T) {
+	t.Parallel()
+	for _, filesystemOnly := range []bool{true, false} {
+		t.Run(map[bool]string{true: "cold disk", false: "RAM snapshot"}[filesystemOnly], func(t *testing.T) {
+			t.Parallel()
+			store, err := storage.NewProvider(t.Context(), storage.Spec{
+				Provider: storage.LocalStorageProvider, BasePath: t.TempDir(),
+			})
+			require.NoError(t, err)
+			self, diskAncestor, memoryAncestor := uuid.New(), uuid.New(), uuid.New()
+			paths := storage.Paths{BuildID: self.String()}
+			meta := metadata.Template{Version: metadata.CurrentVersion,
+				Template:       metadata.TemplateMetadata{BuildID: self.String()},
+				FilesystemOnly: filesystemOnly}
+			bytes, err := json.Marshal(meta)
+			require.NoError(t, err)
+			blob, err := store.OpenBlob(t.Context(), paths.Metadata())
+			require.NoError(t, err)
+			require.NoError(t, blob.Put(t.Context(), bytes))
+			writeHeader := func(path string, ancestor uuid.UUID) {
+				h, err := header.NewHeader(&header.Metadata{Version: 3, BuildId: self,
+					BlockSize: 4096, Size: 4096}, []header.BuildMap{{Length: 4096, BuildId: ancestor}})
+				require.NoError(t, err)
+				_, _, _, err = header.StoreHeader(t.Context(), store, path, h)
+				require.NoError(t, err)
+			}
+			writeHeader(paths.RootfsHeader(), diskAncestor)
+			if !filesystemOnly {
+				_, err := RetainedBuilds(t.Context(), store, []uuid.UUID{self})
+				require.ErrorContains(t, err, "read retained memory")
+				writeHeader(paths.MemfileHeader(), memoryAncestor)
+			}
+			refs, err := RetainedBuilds(t.Context(), store, []uuid.UUID{self, self})
+			require.NoError(t, err)
+			want := map[uuid.UUID]struct{}{self: {}, diskAncestor: {}}
+			if !filesystemOnly {
+				want[memoryAncestor] = struct{}{}
+			}
+			require.Equal(t, want, refs)
+			rootfs, err := store.OpenBlob(t.Context(), paths.RootfsHeader())
+			require.NoError(t, err)
+			require.NoError(t, rootfs.Put(t.Context(), []byte("truncated")))
+			_, err = RetainedBuilds(t.Context(), store, []uuid.UUID{self})
+			require.ErrorContains(t, err, "read retained rootfs")
+		})
+	}
+}
