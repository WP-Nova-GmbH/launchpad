+package hostfirewall
+
+import (
+	"context"
+	"github.com/stretchr/testify/require"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestCheckRefusesMissingFailedOrCancelledAttestation(t *testing.T) {
+	for _, result := range []string{"exit 0", "exit 1"} {
+		t.Run(result, func(t *testing.T) {
+			binary := filepath.Join(t.TempDir(), "check")
+			require.NoError(t, os.WriteFile(binary, []byte("#!/bin/sh\ntest \"$1\" = check || exit 9\n"+result+"\n"), 0o700))
+			err := Check(t.Context(), binary)
+			if result == "exit 0" {
+				require.NoError(t, err)
+			} else {
+				require.Error(t, err)
+			}
+		})
+	}
+	require.Error(t, Check(t.Context(), filepath.Join(t.TempDir(), "missing")))
+	dir := t.TempDir()
+	binary := filepath.Join(dir, "check")
+	marker := filepath.Join(dir, "started")
+	require.NoError(t, os.WriteFile(binary, []byte("#!/bin/sh\ntouch '"+marker+"'\n"), 0o700))
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	require.Error(t, Check(ctx, binary))
+	_, err := os.Stat(marker)
+	require.True(t, os.IsNotExist(err), "cancelled admission must not run the check")
+}
