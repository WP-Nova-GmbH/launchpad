+// Package hostfirewall enforces the operator-installed guest boundary before boot.
+package hostfirewall
+
+import (
+	"context"
+	"fmt"
+	"os/exec"
+	"time"
+)
+
+// Check invokes the installed read-only attestation immediately before guest
+// start. Missing installation, changed rules and an uncertain check all refuse
+// new execution; existing workloads are not killed by a readiness failure.
+func Check(ctx context.Context, binary string) error {
+	ctx, cancel := context.WithTimeout(ctx, 3*time.Second)
+	defer cancel()
+	if err := exec.CommandContext(ctx, binary, "check").Run(); err != nil {
+		return fmt.Errorf("host guest-firewall check failed: %w", err)
+	}
+	return nil
+}
