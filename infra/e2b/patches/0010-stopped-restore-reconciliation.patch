+// The durable request excludes secrets. Both activation and stopped cleanup
+// must reconstruct exactly the same host-bound request from the stable seed.
+func (o *Orchestrator) authenticatedRestoreRequest(request *rpc.SandboxCreateRequest) (*rpc.SandboxCreateRequest, error) {
+	request = proto.CloneOf(request)
+	config := request.GetSandbox()
+	token, err := o.accessTokenGenerator.GenerateEnvdAccessToken(config.GetSandboxId())
+	if err != nil {
+		return nil, err
+	}
+	traffic, err := o.accessTokenGenerator.GenerateTrafficAccessToken(config.GetSandboxId())
+	if err != nil {
+		return nil, err
+	}
+	config.EnvdAccessToken = &token
+	config.Network = &rpc.SandboxNetworkConfig{Ingress: &rpc.SandboxNetworkIngressConfig{TrafficAccessToken: &traffic}}
+	return request, nil
+}
+
+func (o *Orchestrator) DiscardStoppedPreparedRestore(ctx context.Context, op queries.SandboxRestoreOperation, request *rpc.SandboxCreateRequest, digest string) error {
+	request, err := o.authenticatedRestoreRequest(request)
+	if err != nil {
+		return err
+	}
+	client, child, err := o.RestoreClient(ctx, op.ClusterID, op.NodeID)
+	if err != nil {
+		return err
+	}
+	if _, err := client.DiscardStoppedRestoreDisk(child, &rpc.RestoreDiskActivateRequest{Create: request, ManifestSha256: digest}); err != nil {
+		return err
+	}
+	return o.sandboxStore.ReleaseRestore(ctx, op.TeamID, op.SandboxID, op.OperationID)
+}
