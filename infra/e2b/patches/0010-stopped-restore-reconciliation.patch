+func TestPreparedRestoreCredentialsReconstructedAfterPersistence(t *testing.T) {
+	t.Parallel()
+	generator, err := sandbox.NewAccessTokenGenerator("test-stable-seed")
+	require.NoError(t, err)
+	o := &Orchestrator{accessTokenGenerator: generator}
+	saved := &rpc.SandboxCreateRequest{Sandbox: &rpc.SandboxConfig{SandboxId: "destination"}}
+	activation, err := o.authenticatedRestoreRequest(saved)
+	require.NoError(t, err)
+	require.NotEmpty(t, activation.GetSandbox().GetEnvdAccessToken())
+	require.NotEmpty(t, activation.GetSandbox().GetNetwork().GetIngress().GetTrafficAccessToken())
+	require.Empty(t, saved.GetSandbox().GetEnvdAccessToken())
+	raw, err := protojson.Marshal(saved)
+	require.NoError(t, err)
+	restored := &rpc.SandboxCreateRequest{}
+	require.NoError(t, protojson.Unmarshal(raw, restored))
+	cleanup, err := o.authenticatedRestoreRequest(restored)
+	require.NoError(t, err)
+	activationBytes, err := (proto.MarshalOptions{Deterministic: true}).Marshal(activation)
+	require.NoError(t, err)
+	cleanupBytes, err := (proto.MarshalOptions{Deterministic: true}).Marshal(cleanup)
+	require.NoError(t, err)
+	require.Equal(t, activationBytes, cleanupBytes, "the host receipt binds the full request, including reconstructed credentials")
