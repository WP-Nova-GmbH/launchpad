+// DiscardStoppedRestoreDisk reconciles a failed boot only after positive host
+// fencing. Neither API absence nor a timeout is accepted as shutdown evidence.
+func (s *Server) DiscardStoppedRestoreDisk(ctx context.Context, req *orchestrator.RestoreDiskActivateRequest) (*emptypb.Empty, error) {
+	directory, err := s.restoreDiskDirectory()
+	if err != nil {
+		return nil, err
+	}
+	id, err := validateRestoreActivation(req)
+	if err != nil {
+		return nil, err
+	}
+	request, err := (proto.MarshalOptions{Deterministic: true}).Marshal(req.GetCreate())
+	if err != nil {
+		return nil, err
+	}
+	activation, err := rootfs.LockRestoreActivation(ctx, directory, id, req.GetManifestSha256(), request)
+	if err != nil {
+		return nil, restoreDiskError(err)
+	}
+	defer activation.Close()
+	create := req.GetCreate().GetSandbox()
+	if _, err := s.StopExecution(ctx, &orchestrator.StopExecutionRequest{
+		TeamId: create.GetTeamId(), SandboxId: create.GetSandboxId(), ExecutionId: create.GetExecutionId(),
+	}); err != nil {
+		return nil, err
+	}
+	if err := activation.DiscardStopped(ctx); err != nil {
+		return nil, restoreDiskError(err)
+	}
+	return &emptypb.Empty{}, nil
+}
