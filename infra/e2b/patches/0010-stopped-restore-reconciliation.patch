+// DiscardStopped is used only after the host has confirmed permanent execution
+// fencing for the exact immutable activation request. Keep the published build
+// for lineage-aware GC; deleting a prepared copy cannot invalidate descendants.
+func (h *RestoreActivationLock) DiscardStopped(ctx context.Context) error {
+	if h.lock == nil {
+		return ErrPreparedDiskBusy
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	h.record.State = "stopped"
+	h.record.Response = nil
+	if err := h.persist(); err != nil {
+		return err
+	}
+	if err := os.RemoveAll(filepath.Join(h.directory, h.buildID.String())); err != nil {
+		return err
+	}
+	return syncPreparedDirectory(h.directory)
+}
