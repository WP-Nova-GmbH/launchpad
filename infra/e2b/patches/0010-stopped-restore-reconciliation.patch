+func TestRestoreConfirmedStopPersistsAcrossCleanupAndRestart(t *testing.T) {
+	for _, state := range []string{"accepted", "booting", "active"} {
+		t.Run(state, func(t *testing.T) {
+			directory, id, digest := activationFixture(t, []byte(`{"version":1}`))
+			request := []byte("exact activation identity")
+			first, err := LockRestoreActivation(t.Context(), directory, id, digest, request)
+			require.NoError(t, err)
+			if state != "accepted" {
+				require.NoError(t, first.BeginBoot())
+			}
+			if state == "active" {
+				require.NoError(t, first.Complete(json.RawMessage(`{"ready":true}`)))
+			}
+			require.NoError(t, first.DiscardStopped(t.Context()))
+			require.NoError(t, first.Close())
+			_, err = os.Stat(filepath.Join(directory, id.String()))
+			require.ErrorIs(t, err, os.ErrNotExist)
+			retry, err := LockRestoreActivation(t.Context(), directory, id, digest, request)
+			require.NoError(t, err)
+			require.Equal(t, "stopped", retry.Record().State)
+			require.NoError(t, retry.DiscardStopped(t.Context()))
+			require.ErrorIs(t, retry.CheckDeadline(time.Now().Add(time.Hour), time.Now()), ErrRestoreActivationStopped)
+			require.Error(t, retry.BeginBoot())
+			require.NoError(t, retry.Close())
+			require.Error(t, RequireActivatedBuild(directory, id))
+			_, err = LockRestoreActivation(t.Context(), directory, id, digest, []byte("different execution"))
+			require.ErrorIs(t, err, ErrPreparedDiskConflict)
+		})
+	}
+}
