+//go:build linux
+
+package rootfs
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"syscall"
+	"time"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage"
+	"github.com/google/uuid"
+	"golang.org/x/sys/unix"
+)
+
+var ErrColdProbeUnverified = errors.New("quarantined cold recovery is unverified")
+
+type ColdProbeReceipt struct {
+	Version               int       `json:"version"`
+	PreparedBuildID       uuid.UUID `json:"preparedBuildID"`
+	RootfsSHA256          string    `json:"rootfsSHA256"`
+	InitSHA256            string    `json:"initSHA256"`
+	PhysicalStopConfirmed bool      `json:"physicalStopConfirmed"`
+	MountOnly             bool      `json:"mountOnly"`
+}
+
+type ColdProbeSettings struct {
+	ScriptPath     string
+	BuildDirectory string
+}
+
+func validProbeReceipt(disk PreparedDisk, receipt *ColdProbeReceipt) bool {
+	if receipt == nil || receipt.Version != 1 || receipt.PreparedBuildID != disk.BuildID ||
+		receipt.RootfsSHA256 != disk.RootfsSHA256 || !receipt.PhysicalStopConfirmed || !receipt.MountOnly {
+		return false
+	}
+	digest, err := hex.DecodeString(receipt.InitSHA256)
+	return err == nil && len(digest) == sha256.Size
+}
+
+// The caller retains the source pin and disk reservation until this completes.
+// The trusted helper reserves its own bounded host cgroup, never a user VM slot.
+func VerifyPreparedDiskCold(ctx context.Context, directory string, buildID uuid.UUID, settings ColdProbeSettings) (PreparedDisk, error) {
+	return verifyPreparedDiskCold(ctx, directory, buildID, func(ctx context.Context, disk PreparedDisk) (*ColdProbeReceipt, error) {
+		if !filepath.IsAbs(settings.ScriptPath) || !filepath.IsAbs(settings.BuildDirectory) {
+			return nil, ErrColdProbeUnverified
+		}
+		script, err := os.Lstat(settings.ScriptPath)
+		if err != nil || !script.Mode().IsRegular() || script.Mode().Perm()&022 != 0 {
+			return nil, ErrColdProbeUnverified
+		}
+		output := filepath.Join(directory, buildID.String()+".cold-probe")
+		// A lost controller reply may leave a process alive. Its durable operation
+		// receipt must prove physical stop before a new attempt can be admitted.
+		if _, err := os.Lstat(output); err == nil {
+			var operation struct {
+				PhysicalStopConfirmed bool   `json:"physicalStopConfirmed"`
+				DiskSHA256            string `json:"diskSha256"`
+				Format                string `json:"format"`
+			}
+			raw, err := os.ReadFile(filepath.Join(output, "operation.json"))
+			if err != nil || len(raw) > 65536 || json.Unmarshal(raw, &operation) != nil || operation.DiskSHA256 != disk.RootfsSHA256 || operation.Format != "launchpad-disk-probe-operation-v1" {
+				return nil, ErrColdProbeUnverified
+			}
+			if !operation.PhysicalStopConfirmed {
+				if err := runColdProbeHelper(ctx, settings.ScriptPath, "reconcile", output); err != nil {
+					return nil, err
+				}
+				raw, err = os.ReadFile(filepath.Join(output, "operation.json"))
+				if err != nil || len(raw) > 65536 || json.Unmarshal(raw, &operation) != nil || !operation.PhysicalStopConfirmed {
+					return nil, ErrColdProbeUnverified
+				}
+			}
+			receipt, err := readHelperProbeReceipt(output, disk)
+			if err == nil {
+				return receipt, nil
+			}
+			// Keep failed evidence; only this confirmed stopped attempt can be retired.
+			if err := os.Rename(output, output+".failed-"+uuid.NewString()); err != nil {
+				return nil, err
+			}
+		} else if !errors.Is(err, os.ErrNotExist) {
+			return nil, err
+		}
+		required := filepath.Join(directory, buildID.String()+".probe-files.json")
+		if err := os.WriteFile(required, []byte("[]"), 0600); err != nil {
+			return nil, err
+		}
+		if err := runColdProbeHelper(ctx, settings.ScriptPath, "--direct", "--mount-only", "--disk", filepath.Join(directory, buildID.String(), storage.RootfsName), "--disk-sha256", disk.RootfsSHA256, "--required-files", required, "--probe-build", settings.BuildDirectory, "--output", output, "--timeout", "300"); err != nil {
+			return nil, err
+		}
+		return readHelperProbeReceipt(output, disk)
+	})
+}
+
+func runColdProbeHelper(ctx context.Context, script string, args ...string) error {
+	cmd := exec.CommandContext(ctx, "python3", append([]string{script}, args...)...)
+	cmd.Cancel = func() error { return cmd.Process.Signal(syscall.SIGTERM) }
+	cmd.WaitDelay = 35 * time.Second
+	cmd.Stdout, cmd.Stderr = io.Discard, io.Discard
+	if err := cmd.Run(); err != nil {
+		return ErrColdProbeUnverified
+	}
+	return nil
+}
+
+func readHelperProbeReceipt(output string, disk PreparedDisk) (*ColdProbeReceipt, error) {
+	raw, err := os.ReadFile(filepath.Join(output, "verified.json"))
+	if err != nil || len(raw) > 65536 {
+		return nil, ErrColdProbeUnverified
+	}
+	var result struct {
+		Format                string `json:"format"`
+		DiskSHA256            string `json:"diskSha256"`
+		InitSHA256            string `json:"initSha256"`
+		PhysicalStopConfirmed bool   `json:"physicalStopConfirmed"`
+		MountOnly             bool   `json:"mountOnly"`
+		Receipt               struct {
+			Verified      bool   `json:"verified"`
+			Phase         string `json:"phase"`
+			UserProcesses []int  `json:"userProcesses"`
+			Files         int    `json:"files"`
+			MountOnly     bool   `json:"mountOnly"`
+		} `json:"receipt"`
+	}
+	if json.Unmarshal(raw, &result) != nil || result.Format != "launchpad-disk-probe-result-v1" || !result.Receipt.Verified || result.Receipt.Phase != "quarantine" || len(result.Receipt.UserProcesses) != 1 || result.Receipt.UserProcesses[0] != 1 || result.Receipt.Files != 0 || !result.Receipt.MountOnly {
+		return nil, ErrColdProbeUnverified
+	}
+	receipt := &ColdProbeReceipt{Version: 1, PreparedBuildID: disk.BuildID, RootfsSHA256: result.DiskSHA256, InitSHA256: result.InitSHA256, PhysicalStopConfirmed: result.PhysicalStopConfirmed, MountOnly: result.MountOnly}
+	if !validProbeReceipt(disk, receipt) {
+		return nil, ErrColdProbeUnverified
+	}
+	return receipt, nil
+}
+
+func verifyPreparedDiskCold(ctx context.Context, directory string, buildID uuid.UUID, probe func(context.Context, PreparedDisk) (*ColdProbeReceipt, error)) (PreparedDisk, error) {
+	if buildID == uuid.Nil {
+		return PreparedDisk{}, ErrColdProbeUnverified
+	}
+	lock, err := os.OpenFile(filepath.Join(directory, buildID.String()+".lock"), os.O_RDWR, 0600)
+	if err != nil {
+		return PreparedDisk{}, err
+	}
+	defer lock.Close()
+	if err := unix.Flock(int(lock.Fd()), unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		return PreparedDisk{}, ErrPreparedDiskBusy
+	}
+	defer unix.Flock(int(lock.Fd()), unix.LOCK_UN)
+	if _, err := readRestoreActivation(directory, buildID); err == nil {
+		return PreparedDisk{}, ErrRestoreActivationStarted
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return PreparedDisk{}, err
+	}
+	disk, opened, err := OpenPreparedDisk(ctx, directory, buildID)
+	if err != nil {
+		return PreparedDisk{}, err
+	}
+	defer opened.Close()
+	if disk.ColdProbe != nil {
+		if !validProbeReceipt(disk, disk.ColdProbe) {
+			return PreparedDisk{}, ErrColdProbeUnverified
+		}
+		manifest, err := os.Open(filepath.Join(directory, buildID.String(), "prepared.json"))
+		if err != nil {
+			return PreparedDisk{}, err
+		}
+		if err := errors.Join(manifest.Sync(), manifest.Close(), syncPreparedDirectory(filepath.Join(directory, buildID.String()))); err != nil {
+			return PreparedDisk{}, err
+		}
+		return disk, nil
+	}
+	receipt, err := probe(ctx, disk)
+	if err != nil {
+		return PreparedDisk{}, err
+	}
+	if ctx.Err() != nil {
+		return PreparedDisk{}, ctx.Err()
+	}
+	if !validProbeReceipt(disk, receipt) {
+		return PreparedDisk{}, ErrColdProbeUnverified
+	}
+	disk.ColdProbe = receipt
+	manifest, err := json.Marshal(disk)
+	if err != nil {
+		return PreparedDisk{}, err
+	}
+	candidate, err := os.CreateTemp(filepath.Join(directory, buildID.String()), ".cold-manifest-")
+	if err != nil {
+		return PreparedDisk{}, err
+	}
+	defer os.Remove(candidate.Name())
+	_, writeErr := candidate.Write(manifest)
+	err = errors.Join(writeErr, candidate.Sync(), candidate.Close())
+	if err != nil {
+		return PreparedDisk{}, err
+	}
+	if err := os.Rename(candidate.Name(), filepath.Join(directory, buildID.String(), "prepared.json")); err != nil {
+		return PreparedDisk{}, err
+	}
+	if err := syncPreparedDirectory(filepath.Join(directory, buildID.String())); err != nil {
+		return PreparedDisk{}, err
+	}
+	return disk, nil
+}
