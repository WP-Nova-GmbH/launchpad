+func TestColdProbeStatusCarriesImmutableManifestReceipt(t *testing.T) {
+	buildID := uuid.New()
+	proof := api.LaunchpadColdProbeReceipt{Version: 1, PreparedBuildID: buildID, RootfsSHA256: strings.Repeat("a", 64), InitSHA256: strings.Repeat("b", 64), PhysicalStopConfirmed: true, MountOnly: true}
+	manifest, err := json.Marshal(struct {
+		ColdProbe api.LaunchpadColdProbeReceipt `json:"coldProbe"`
+	}{proof})
+	require.NoError(t, err)
+	op := queries.SandboxRestoreOperation{OperationID: uuid.New(), PreparedBuildID: buildID, State: "prepared", Manifest: manifest}
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	(&APIStore{}).restoreStatus(c, 200, op)
+	var status api.LaunchpadRestoreStatus
+	require.NoError(t, json.Unmarshal(recorder.Body.Bytes(), &status))
+	require.Equal(t, &proof, status.ColdProbe)
+	digest := sha256.Sum256(manifest)
+	require.Equal(t, hex.EncodeToString(digest[:]), *status.ManifestSHA256)
+	recorder = httptest.NewRecorder()
+	c, _ = gin.CreateTestContext(recorder)
+	op.Manifest = []byte(`{"version":1}`)
+	(&APIStore{}).restoreStatus(c, 200, op)
+	require.NoError(t, json.Unmarshal(recorder.Body.Bytes(), &status))
+	var clean api.LaunchpadRestoreStatus
+	require.NoError(t, json.Unmarshal(recorder.Body.Bytes(), &clean))
+	require.Nil(t, clean.ColdProbe)
+}
