+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func coldProbeFixture(t *testing.T) (string, PreparedDisk) {
+	t.Helper()
+	directory, source, sourceID, meta, original := preparedDiskFixture(t)
+	disk, err := PrepareDisk(t.Context(), directory, uuid.New(), sourceID, source, meta, int64(len(original)), nil, func(context.Context, block.Device) error { return nil })
+	require.NoError(t, err)
+	return directory, disk
+}
+func coldReceipt(disk PreparedDisk) *ColdProbeReceipt {
+	return &ColdProbeReceipt{Version: 1, PreparedBuildID: disk.BuildID, RootfsSHA256: disk.RootfsSHA256, InitSHA256: strings.Repeat("a", 64), PhysicalStopConfirmed: true, MountOnly: true}
+}
+func TestColdProbeBoundPublicationAndRetry(t *testing.T) {
+	directory, disk := coldProbeFixture(t)
+	calls := 0
+	probe := func(context.Context, PreparedDisk) (*ColdProbeReceipt, error) { calls++; return coldReceipt(disk), nil }
+	verified, err := verifyPreparedDiskCold(t.Context(), directory, disk.BuildID, probe)
+	require.NoError(t, err)
+	require.NotNil(t, verified.ColdProbe)
+	reopened, opened, err := OpenPreparedDisk(t.Context(), directory, disk.BuildID)
+	require.NoError(t, err)
+	require.NoError(t, opened.Close())
+	require.Equal(t, verified, reopened)
+	_, err = verifyPreparedDiskCold(t.Context(), directory, disk.BuildID, probe)
+	require.NoError(t, err)
+	require.Equal(t, 1, calls)
+}
+func TestColdProbeFailsClosedAndRetainsDisk(t *testing.T) {
+	for _, name := range []string{"unavailable", "foreign-disk", "foreign-build", "not-stopped", "not-mount-only", "bad-init", "cancelled"} {
+		t.Run(name, func(t *testing.T) {
+			directory, disk := coldProbeFixture(t)
+			ctx, cancel := context.WithCancel(t.Context())
+			defer cancel()
+			_, err := verifyPreparedDiskCold(ctx, directory, disk.BuildID, func(context.Context, PreparedDisk) (*ColdProbeReceipt, error) {
+				receipt := coldReceipt(disk)
+				switch name {
+				case "unavailable":
+					return nil, ErrColdProbeUnverified
+				case "foreign-disk":
+					receipt.RootfsSHA256 = strings.Repeat("b", 64)
+				case "foreign-build":
+					receipt.PreparedBuildID = uuid.New()
+				case "not-stopped":
+					receipt.PhysicalStopConfirmed = false
+				case "not-mount-only":
+					receipt.MountOnly = false
+				case "bad-init":
+					receipt.InitSHA256 = "unknown"
+				case "cancelled":
+					cancel()
+				}
+				return receipt, nil
+			})
+			require.Error(t, err)
+			unchanged, opened, err := OpenPreparedDisk(t.Context(), directory, disk.BuildID)
+			require.NoError(t, err)
+			require.NoError(t, opened.Close())
+			require.Nil(t, unchanged.ColdProbe)
+		})
+	}
+}
+func TestColdProbeExcludesCancelAndActivation(t *testing.T) {
+	directory, disk := coldProbeFixture(t)
+	_, err := verifyPreparedDiskCold(t.Context(), directory, disk.BuildID, func(context.Context, PreparedDisk) (*ColdProbeReceipt, error) {
+		require.ErrorIs(t, CancelPreparedDisk(t.Context(), directory, disk.BuildID), ErrPreparedDiskBusy)
+		return coldReceipt(disk), nil
+	})
+	require.NoError(t, err)
+	require.NoError(t, CancelPreparedDisk(t.Context(), directory, disk.BuildID))
+	_, err = verifyPreparedDiskCold(t.Context(), directory, disk.BuildID, func(context.Context, PreparedDisk) (*ColdProbeReceipt, error) {
+		t.Fatal("cancelled disk booted")
+		return nil, nil
+	})
+	require.ErrorIs(t, err, ErrPreparedDiskCancelled)
+}
+func TestColdProbeRejectsCorruptPersistedReceipt(t *testing.T) {
+	directory, disk := coldProbeFixture(t)
+	disk.ColdProbe = coldReceipt(disk)
+	disk.ColdProbe.PhysicalStopConfirmed = false
+	raw, err := json.Marshal(disk)
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(filepath.Join(directory, disk.BuildID.String(), "prepared.json"), raw, 0600))
+	_, _, err = OpenPreparedDisk(t.Context(), directory, disk.BuildID)
+	require.ErrorIs(t, err, ErrColdProbeUnverified)
+}
+func TestColdProbeUncertainControllerCannotRepeat(t *testing.T) {
+	directory, disk := coldProbeFixture(t)
+	output := filepath.Join(directory, disk.BuildID.String()+".cold-probe")
+	require.NoError(t, os.Mkdir(output, 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(output, "operation.json"), []byte(`{"physicalStopConfirmed":false}`), 0600))
+	script := filepath.Join(t.TempDir(), "unexpected.py")
+	require.NoError(t, os.WriteFile(script, []byte("raise Exception('must not be launched')"), 0600))
+	_, err := VerifyPreparedDiskCold(t.Context(), directory, disk.BuildID, ColdProbeSettings{ScriptPath: script, BuildDirectory: directory})
+	require.True(t, errors.Is(err, ErrColdProbeUnverified))
+}
+
+// Opt-in proof on the dedicated Linux host. The source is an already verified,
+// disposable filesystem-only build; this path never mutates or deletes it.
+func TestColdProbeDedicatedHost(t *testing.T) {
+	sourcePath := os.Getenv("LAUNCHPAD_COLD_PROBE_TEST_SOURCE")
+	if sourcePath == "" {
+		t.Skip("dedicated host fixture not supplied")
+	}
+	output := os.Getenv("LAUNCHPAD_COLD_PROBE_TEST_OUTPUT")
+	require.NotEmpty(t, output)
+	raw, err := os.ReadFile(filepath.Join(filepath.Dir(sourcePath), "metadata.json"))
+	require.NoError(t, err)
+	var meta metadata.Template
+	require.NoError(t, json.Unmarshal(raw, &meta))
+	require.True(t, meta.IsFilesystemOnly())
+	require.True(t, meta.IsFsQuiesced())
+	sourceID, err := uuid.Parse(meta.Template.BuildID)
+	require.NoError(t, err)
+	source, err := block.NewLocal(sourcePath, header.RootfsBlockSize, sourceID)
+	require.NoError(t, err)
+	defer source.Close()
+	size, err := source.Size(t.Context())
+	require.NoError(t, err)
+	buildID := uuid.New()
+	disk, err := PrepareDisk(t.Context(), output, buildID, sourceID, source, meta, size, nil, func(context.Context, block.Device) error { return nil })
+	require.NoError(t, err)
+	settings := ColdProbeSettings{ScriptPath: os.Getenv("LAUNCHPAD_COLD_PROBE_TEST_SCRIPT"), BuildDirectory: os.Getenv("LAUNCHPAD_COLD_PROBE_TEST_BUILD")}
+	verified, err := VerifyPreparedDiskCold(t.Context(), output, buildID, settings)
+	require.NoError(t, err)
+	require.True(t, validProbeReceipt(disk, verified.ColdProbe))
+	again, err := VerifyPreparedDiskCold(t.Context(), output, buildID, settings)
+	require.NoError(t, err)
+	require.Equal(t, verified, again)
+	receipt, err := json.Marshal(verified.ColdProbe)
+	require.NoError(t, err)
+	t.Logf("PASS product cold recovery, persisted exact disk receipt and retry: %s", receipt)
+	_, err = os.Stat(sourcePath)
+	require.NoError(t, err)
+}
+
+func TestColdProbeDedicatedRecovery(t *testing.T) {
+	rawID := os.Getenv("LAUNCHPAD_COLD_PROBE_RECOVERY_BUILD")
+	if rawID == "" {
+		t.Skip("dedicated recovery fixture not supplied")
+	}
+	id, err := uuid.Parse(rawID)
+	require.NoError(t, err)
+	directory := os.Getenv("LAUNCHPAD_COLD_PROBE_TEST_OUTPUT")
+	disk, err := VerifyPreparedDiskCold(t.Context(), directory, id, ColdProbeSettings{ScriptPath: os.Getenv("LAUNCHPAD_COLD_PROBE_TEST_SCRIPT"), BuildDirectory: os.Getenv("LAUNCHPAD_COLD_PROBE_TEST_BUILD")})
+	require.NoError(t, err)
+	require.True(t, validProbeReceipt(disk, disk.ColdProbe))
+	retired, err := filepath.Glob(filepath.Join(directory, id.String()+".cold-probe.failed-*"))
+	require.NoError(t, err)
+	require.Len(t, retired, 1)
+	raw, err := os.ReadFile(filepath.Join(retired[0], "operation.json"))
+	require.NoError(t, err)
+	var old struct {
+		PhysicalStopConfirmed bool `json:"physicalStopConfirmed"`
+		Reconciled            bool `json:"reconciled"`
+	}
+	require.NoError(t, json.Unmarshal(raw, &old))
+	require.True(t, old.PhysicalStopConfirmed)
+	require.True(t, old.Reconciled)
+	t.Log("PASS vanished controller physically reconciled before replacement probe; exact disk certified and source retained")
+}
