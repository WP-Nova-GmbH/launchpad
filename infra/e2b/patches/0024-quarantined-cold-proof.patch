+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"runtime"
+)
+
+func sum(path string) string {
+	b, e := os.ReadFile(path)
+	if e != nil {
+		panic(e)
+	}
+	h := sha256.Sum256(b)
+	return hex.EncodeToString(h[:])
+}
+func main() {
+	var lock struct {
+		BaseImages map[string]string `json:"baseImages"`
+	}
+	raw, e := os.ReadFile("launchpad-probe/runtime.lock.json")
+	if e != nil {
+		panic(e)
+	}
+	if e = json.Unmarshal(raw, &lock); e != nil {
+		panic(e)
+	}
+	r := map[string]any{"format": "launchpad-disk-probe-build-v1", "platform": "linux/" + runtime.GOARCH, "image": lock.BaseImages["golang:${GOLANG_VERSION}-${DEBIAN_VERSION}"], "sourceSha256": sum("launchpad-probe/quarantine/init_linux.go"), "initSha256": sum("bin/probe-init"), "runtimeLockSha256": sum("launchpad-probe/runtime.lock.json")}
+	b, e := json.Marshal(r)
+	if e != nil {
+		panic(e)
+	}
+	if e = os.WriteFile("bin/probe-build.json", append(b, '\n'), 0600); e != nil {
+		panic(e)
+	}
+}
