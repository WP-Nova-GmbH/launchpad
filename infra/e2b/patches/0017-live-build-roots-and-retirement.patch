diff --git a/packages/api/internal/orchestrator/build_retention.go b/packages/api/internal/orchestrator/build_retention.go
new file mode 100644
--- /dev/null
+++ b/packages/api/internal/orchestrator/build_retention.go
@@ -0,0 +1,19 @@
+package orchestrator
+
+import (
+	"github.com/e2b-dev/infra/packages/api/internal/orchestrator/nodemanager"
+	"github.com/google/uuid"
+	"strings"
+)
+
+// Live reclamation requires the same reproducible patch-set build on the API
+// and host. An older/unknown host may ignore retirement tombstones, even if the
+// upgraded API has already registered its boot roots. Such roots stay held but
+// cannot authorize live collection.
+func (o *Orchestrator) canCollectLiveOnNode(node *nodemanager.Node) bool {
+	return node != nil && strings.HasPrefix(o.buildRetentionRuntimeVersion, "launchpad-patched-") &&
+		node.Metadata().Version == o.buildRetentionRuntimeVersion
+}
+func (o *Orchestrator) CanCollectLiveBuilds() bool {
+	return o != nil && o.buildRetentionNodeID != "" && o.canCollectLiveOnNode(o.GetNode(uuid.Nil, o.buildRetentionNodeID))
+}
