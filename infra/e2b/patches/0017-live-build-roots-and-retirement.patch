+//go:build linux
+
+package storage
+
+import (
+	"context"
+	"errors"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestRetiredBuildRejectsCachedBlobSeekableAndLateWrites(t *testing.T) {
+	base := t.TempDir()
+	id := uuid.New()
+	key := id.String() + "/rootfs"
+	store := newFileSystemStorage(base, "", nil)
+	blob, err := store.OpenBlob(t.Context(), key)
+	require.NoError(t, err)
+	require.NoError(t, blob.Put(t.Context(), []byte("disk")))
+	seekable, err := store.OpenSeekable(t.Context(), key)
+	require.NoError(t, err)
+	source := filepath.Join(t.TempDir(), "source")
+	require.NoError(t, os.WriteFile(source, []byte("late upload"), 0600))
+	require.NoError(t, RetireBuildObjects(t.Context(), store, id))
+	require.ErrorIs(t, blob.Put(t.Context(), []byte("late metadata")), ErrBuildRetired)
+	_, _, err = seekable.StoreFile(t.Context(), source)
+	require.ErrorIs(t, err, ErrBuildRetired)
+	_, err = store.OpenBlob(t.Context(), key)
+	require.ErrorIs(t, err, ErrBuildRetired)
+	_, err = store.OpenSeekable(t.Context(), key)
+	require.ErrorIs(t, err, ErrBuildRetired)
+	// A process restart or lost deletion reply never removes the permanent fence.
+	reopened := newFileSystemStorage(base, "", nil)
+	require.NoError(t, RetireBuildObjects(t.Context(), reopened, id))
+	_, err = reopened.OpenBlob(t.Context(), key)
+	require.ErrorIs(t, err, ErrBuildRetired)
+	_, err = os.Stat(filepath.Join(base, id.String()))
+	require.ErrorIs(t, err, os.ErrNotExist)
+}
+func TestRetirementWaitsForWholeWriteAndCancellationCannotDelete(t *testing.T) {
+	base := t.TempDir()
+	id := uuid.New()
+	key := id.String() + "/rootfs"
+	store := newFileSystemStorage(base, "", nil)
+	blob, err := store.OpenBlob(t.Context(), key)
+	require.NoError(t, err)
+	require.NoError(t, blob.Put(t.Context(), []byte("original")))
+	release, err := AcquireLocalBuildWrite(t.Context(), base, key)
+	require.NoError(t, err)
+	// A second process/provider opens the same kernel lock, not a process-local mutex.
+	descriptor, err := unix.Open(filepath.Join(base, buildGuardDirectory, id.String()+".lock"), unix.O_RDWR, 0)
+	require.NoError(t, err)
+	defer unix.Close(descriptor)
+	require.ErrorIs(t, unix.Flock(descriptor, unix.LOCK_EX|unix.LOCK_NB), unix.EWOULDBLOCK)
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	require.ErrorIs(t, RetireBuildObjects(ctx, store, id), context.Canceled)
+	bytes, err := GetBlob(t.Context(), blob)
+	require.NoError(t, err)
+	require.Equal(t, "original", string(bytes))
+	release()
+	require.NoError(t, RetireBuildObjects(t.Context(), store, id))
+}
+func TestRetirementRecordsRejectSymlinksAndInvalidBuilds(t *testing.T) {
+	base := t.TempDir()
+	id := uuid.New()
+	key := id.String() + "/rootfs"
+	store := newFileSystemStorage(base, "", nil)
+	require.Error(t, RetireBuildObjects(t.Context(), store, uuid.Nil))
+	dir := filepath.Join(base, buildGuardDirectory)
+	require.NoError(t, os.Mkdir(dir, 0700))
+	target := filepath.Join(t.TempDir(), "untouched")
+	require.NoError(t, os.WriteFile(target, []byte("host file"), 0600))
+	require.NoError(t, os.Symlink(target, filepath.Join(dir, id.String()+".lock")))
+	_, err := store.OpenBlob(t.Context(), key)
+	require.Error(t, err)
+	require.Error(t, RetireBuildObjects(t.Context(), store, id))
+	bytes, err := os.ReadFile(target)
+	require.NoError(t, err)
+	require.Equal(t, "host file", string(bytes))
+}
+func TestRetirementMarkerPersistsAcrossFailedPrefixRemoval(t *testing.T) {
+	base := t.TempDir()
+	id := uuid.New()
+	store := newFileSystemStorage(base, "", nil)
+	// A persisted marker from an interrupted deletion is sufficient to reject a
+	// retrying uploader, even while the old prefix is still present.
+	dir := filepath.Join(base, buildGuardDirectory)
+	require.NoError(t, os.Mkdir(dir, 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, id.String()+".retired"), nil, 0600))
+	require.NoError(t, os.Mkdir(filepath.Join(base, id.String()), 0700))
+	_, err := AcquireLocalBuildWrite(t.Context(), base, id.String()+"/rootfs")
+	require.ErrorIs(t, err, ErrBuildRetired)
+	require.NoError(t, RetireBuildObjects(t.Context(), store, id))
+	_, err = os.Stat(filepath.Join(base, id.String()))
+	require.True(t, errors.Is(err, os.ErrNotExist))
+}
