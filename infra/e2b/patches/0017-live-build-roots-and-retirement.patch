+
+	"github.com/google/uuid"
+	"golang.org/x/sys/unix"
+)
+
+const buildGuardDirectory = ".launchpad-build-retirement"
+
+// AcquireLocalBuildWrite spans the entire object write, including atomic rename
+// and size sidecars. The returned release is required even on a failed upload.
+// It also guards directory creation by readers and signed local upload handlers.
+func AcquireLocalBuildWrite(ctx context.Context, basePath, key string) (func(), error) {
+	if !filepath.IsLocal(key) || filepath.Clean(key) != strings.TrimSuffix(key, "/") {
+		return nil, fmt.Errorf("invalid local object key")
+	}
+	first, _, _ := strings.Cut(key, "/")
+	id, err := uuid.Parse(first)
+	if err != nil || id.String() != first {
+		return func() {}, nil
+	}
+	lock, err := acquireBuildGuard(ctx, basePath, id, unix.LOCK_SH)
+	if err != nil {
+		return nil, err
+	}
+	marker := filepath.Join(basePath, buildGuardDirectory, id.String()+".retired")
+	info, err := os.Lstat(marker)
+	if err == nil {
+		lock.Close()
+		if !info.Mode().IsRegular() {
+			return nil, fmt.Errorf("invalid retirement record")
+		}
+		return nil, ErrBuildRetired
+	}
+	if !errors.Is(err, os.ErrNotExist) {
+		lock.Close()
+		return nil, err
+	}
+	return func() { lock.Close() }, nil
+}
+
+func acquireBuildGuard(ctx context.Context, basePath string, id uuid.UUID, mode int) (*os.File, error) {
+	dir := filepath.Join(basePath, buildGuardDirectory)
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, err
+	}
+	info, err := os.Lstat(dir)
+	if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return nil, fmt.Errorf("invalid retirement directory")
+	}
+	descriptor, err := unix.Open(filepath.Join(dir, id.String()+".lock"), unix.O_CREAT|unix.O_RDWR|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0600)
+	if err != nil {
+		return nil, err
+	}
+	lock := os.NewFile(uintptr(descriptor), "build guard")
+	info, err = lock.Stat()
+	if err != nil || !info.Mode().IsRegular() {
+		lock.Close()
+		return nil, fmt.Errorf("invalid build guard")
+	}
+	for {
+		if err := ctx.Err(); err != nil {
+			lock.Close()
+			return nil, err
+		}
+		err := unix.Flock(descriptor, mode|unix.LOCK_NB)
+		if err == nil {
+			return lock, nil
+		}
+		if !errors.Is(err, unix.EWOULDBLOCK) && !errors.Is(err, unix.EAGAIN) {
+			lock.Close()
+			return nil, err
+		}
+		timer := time.NewTimer(10 * time.Millisecond)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			lock.Close()
+			return nil, ctx.Err()
+		case <-timer.C:
+		}
+	}
+}
+
+func (s *fsStorage) RetireBuild(ctx context.Context, id uuid.UUID) error {
+	if id == uuid.Nil {
+		return fmt.Errorf("empty immutable build identity")
+	}
+	lock, err := acquireBuildGuard(ctx, s.basePath, id, unix.LOCK_EX)
+	if err != nil {
+		return err
+	}
+	defer lock.Close()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	dir := filepath.Join(s.basePath, buildGuardDirectory)
+	marker := filepath.Join(dir, id.String()+".retired")
+	descriptor, err := unix.Open(marker, unix.O_CREAT|unix.O_EXCL|unix.O_WRONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0600)
+	if err == nil {
+		f := os.NewFile(uintptr(descriptor), "build retirement")
+		syncErr := f.Sync()
+		closeErr := f.Close()
+		if syncErr != nil || closeErr != nil {
+			return errors.Join(syncErr, closeErr)
+		}
+	} else if !errors.Is(err, unix.EEXIST) {
+		return err
+	}
+	info, err := os.Lstat(marker)
+	if err != nil || !info.Mode().IsRegular() {
+		return fmt.Errorf("invalid retirement record")
+	}
+	// Retry must sync again after an earlier uncertain fsync. A durable tombstone
+	// precedes deletion, so a crash can leak bytes but cannot resurrect a build.
+	f, err := os.Open(marker)
+	if err != nil {
+		return err
+	}
+	err = f.Sync()
+	closeErr := f.Close()
+	if err != nil || closeErr != nil {
+		return errors.Join(err, closeErr)
+	}
+	parent, err := os.Open(dir)
+	if err != nil {
+		return err
+	}
+	err = parent.Sync()
+	closeErr = parent.Close()
+	if err != nil || closeErr != nil {
+		return errors.Join(err, closeErr)
+	}
+	if err := os.RemoveAll(s.getPath(id.String() + "/")); err != nil {
+		return err
+	}
+	parent, err = os.Open(s.basePath)
+	if err != nil {
+		return err
+	}
+	defer parent.Close()
+	return parent.Sync()
+}
