+-- +goose Up
+-- A root is registered in the same transaction as its physical boot identity.
+-- Existing attempts intentionally remain unknown; never infer their base from routing.
+CREATE TABLE public.sandbox_execution_build_roots (
+    team_id uuid NOT NULL,
+    sandbox_id text NOT NULL,
