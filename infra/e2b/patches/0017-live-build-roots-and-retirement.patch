@@ -0,0 +1,24 @@
+package orchestrator
+
+import (
+	"github.com/e2b-dev/infra/packages/api/internal/api"
+	"github.com/e2b-dev/infra/packages/api/internal/orchestrator/nodemanager"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestLiveCollectionRefusesUnknownOrMixedRuntimeBuild(t *testing.T) {
+	version := "launchpad-patched-proof-1599d6e79e30"
+	o := &Orchestrator{buildRetentionRuntimeVersion: version}
+	require.False(t, o.canCollectLiveOnNode(nil))
+	for _, old := range []string{"", "0.14.1", "launchpad-patched-old-1599d6e79e30"} {
+		node := nodemanager.NewTestNode("host", api.NodeStatusReady, 0, 8, nodemanager.WithOrchestratorVersion(old))
+		require.False(t, o.canCollectLiveOnNode(node))
+	}
+	node := nodemanager.NewTestNode("host", api.NodeStatusReady, 0, 8, nodemanager.WithOrchestratorVersion(version))
+	require.True(t, o.canCollectLiveOnNode(node))
+	o.buildRetentionRuntimeVersion = ""
+	require.False(t, o.canCollectLiveOnNode(node))
+	var unknown *Orchestrator
+	require.False(t, unknown.CanCollectLiveBuilds())
+}
