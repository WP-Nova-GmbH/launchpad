diff --git a/packages/shared/pkg/storage/build_retirement.go b/packages/shared/pkg/storage/build_retirement.go
new file mode 100644
--- /dev/null
+++ b/packages/shared/pkg/storage/build_retirement.go
@@ -0,0 +1,23 @@
+package storage
+
+import (
+	"context"
+	"errors"
+	"github.com/google/uuid"
+)
+
+var ErrBuildRetired = errors.New("immutable build has been physically retired")
+var ErrBuildRetirementUnsupported = errors.New("storage does not provide immutable build retirement")
+
+// RetireBuildObjects permanently rejects late writes before removing the exact
+// immutable UUID prefix. Only guarded local storage supports this protocol; a
+// plain prefix delete cannot stop an abandoned upload from recreating the data.
+func RetireBuildObjects(ctx context.Context, store StorageProvider, id uuid.UUID) error {
+	guarded, ok := store.(interface {
+		RetireBuild(context.Context, uuid.UUID) error
+	})
+	if !ok {
+		return ErrBuildRetirementUnsupported
+	}
+	return guarded.RetireBuild(ctx, id)
+}
