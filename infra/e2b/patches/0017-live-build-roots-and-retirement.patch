+	data, err := json.Marshal(metadata.Template{Version: metadata.CurrentVersion, Template: metadata.TemplateMetadata{BuildID: boot.String()}, FilesystemOnly: true})
+	require.NoError(t, err)
+	blob, err := store.OpenBlob(t.Context(), paths.Metadata())
+	require.NoError(t, err)
+	require.NoError(t, blob.Put(t.Context(), data))
+	h, err := header.NewHeader(&header.Metadata{Version: 3, BuildId: boot, BlockSize: 4096, Size: 4096}, []header.BuildMap{{Length: 4096, BuildId: ancestor}})
