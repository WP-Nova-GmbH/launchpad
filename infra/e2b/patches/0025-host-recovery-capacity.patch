+//go:build linux
+
+package cgroup
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sync"
+	"syscall"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func budgetFixture(t *testing.T) (string, string, string) {
+	t.Helper()
+	root := t.TempDir()
+	budget := hostCapacityBudget{Format: "launchpad-host-capacity-v1", MaxRunningVMs: 1,
+		ReserveMemoryMiB: 3072, ReserveCPUCount: 1, NormalMemoryMaxBytes: 5 * 1024 * 1024 * 1024,
+		NormalCPUCount: 2, ProbeMemoryMaxBytes: 5 * 1024 * 1024 * 1024, ProbeCPUCount: 2}
+	bytes, err := json.Marshal(budget)
+	require.NoError(t, err)
+	file := filepath.Join(root, "budget.json")
+	require.NoError(t, os.WriteFile(file, bytes, 0o600))
+	for key, value := range map[string]string{"memory.max": "5368709120", "memory.swap.max": "0", "cpu.max": "200000 100000"} {
+		require.NoError(t, os.WriteFile(filepath.Join(root, key), []byte(value), 0o600))
+	}
+	return root, file, filepath.Join(root, "host.lock")
+}
+
+func TestHostBudgetCountsEmptyReservations(t *testing.T) {
+	t.Parallel()
+	root, file, lock := budgetFixture(t)
+	release, err := reserveNormalCapacity(root, file, lock, "sbx-first")
+	require.NoError(t, err)
+	require.NoError(t, os.Mkdir(filepath.Join(root, "sbx-first"), 0o700))
+	release()
+	_, err = reserveNormalCapacity(root, file, lock, "sbx-second")
+	require.ErrorContains(t, err, "waiting")
+	_, err = reserveNormalCapacity(root, file, lock, "sbx-first")
+	require.ErrorContains(t, err, "already reserved")
+	require.NoError(t, os.Remove(filepath.Join(root, "sbx-first")))
+	release, err = reserveNormalCapacity(root, file, lock, "sbx-second")
+	require.NoError(t, err)
+	release()
+}
+
+func TestHostBudgetConcurrentAdmissionsHaveOneWinner(t *testing.T) {
+	t.Parallel()
+	root, file, lock := budgetFixture(t)
+	var wg sync.WaitGroup
+	outcomes := make(chan bool, 2)
+	for _, name := range []string{"sbx-first", "sbx-second"} {
+		wg.Go(func() {
+			release, err := reserveNormalCapacity(root, file, lock, name)
+			if err != nil {
+				outcomes <- false
+				return
+			}
+			defer release()
+			err = os.Mkdir(filepath.Join(root, name), 0o700)
+			outcomes <- err == nil
+		})
+	}
+	wg.Wait()
+	close(outcomes)
+	winners := 0
+	for won := range outcomes {
+		if won {
+			winners++
+		}
+	}
+	require.Equal(t, 1, winners)
+}
+
+func TestHostBudgetMismatchNeverAdmits(t *testing.T) {
+	t.Parallel()
+	for _, key := range []string{"memory.max", "memory.swap.max", "cpu.max"} {
+		t.Run(key, func(t *testing.T) {
+			root, file, lock := budgetFixture(t)
+			require.NoError(t, os.WriteFile(filepath.Join(root, key), []byte("max"), 0o600))
+			_, err := reserveNormalCapacity(root, file, lock, "sbx-first")
+			require.Error(t, err)
+			_, err = os.Stat(filepath.Join(root, "sbx-first"))
+			require.True(t, os.IsNotExist(err))
+		})
+	}
+}
+
+func TestHostBudgetEquivalentCPUPeriodSurvivesRestart(t *testing.T) {
+	t.Parallel()
+	for _, value := range []string{"200000 100000", "400000 200000", "2000 1000"} {
+		t.Run(value, func(t *testing.T) {
+			root, file, lock := budgetFixture(t)
+			require.NoError(t, os.WriteFile(filepath.Join(root, "cpu.max"), []byte(value), 0o600))
+			release, err := reserveNormalCapacity(root, file, lock, "sbx-first")
+			require.NoError(t, err)
+			release()
+		})
+	}
+	for _, value := range []string{"400001 200000", "199999 100000", "max 100000", "-200000 -100000", "2000 1000 extra", "0 0", "20000000 10000000"} {
+		t.Run(value, func(t *testing.T) {
+			root, file, lock := budgetFixture(t)
+			require.NoError(t, os.WriteFile(filepath.Join(root, "cpu.max"), []byte(value), 0o600))
+			_, err := reserveNormalCapacity(root, file, lock, "sbx-first")
+			require.Error(t, err)
+		})
+	}
+}
+
+func TestHostBudgetPublicOrInvalidReceiptNeverAdmits(t *testing.T) {
+	t.Parallel()
+	root, file, lock := budgetFixture(t)
+	require.NoError(t, os.Chmod(file, 0o644))
+	_, err := reserveNormalCapacity(root, file, lock, "sbx-first")
+	require.ErrorContains(t, err, "unowned")
+	require.NoError(t, os.Chmod(file, 0o600))
+	require.NoError(t, os.WriteFile(file, []byte(`{"format":"launchpad-host-capacity-v1","maxRunningVms":1}`), 0o600))
+	_, err = reserveNormalCapacity(root, file, lock, "sbx-first")
+	require.Error(t, err)
+}
+
+func TestHostBudgetUnconfiguredKeepsUpstreamBehavior(t *testing.T) {
+	t.Parallel()
+	root := t.TempDir()
+	release, err := reserveNormalCapacity(root, filepath.Join(root, "absent.json"), filepath.Join(root, "host.lock"), "sbx-first")
+	require.NoError(t, err)
+	release()
+	_, err = os.Stat(filepath.Join(root, "host.lock"))
+	require.True(t, os.IsNotExist(err))
+}
+
+// This test is dispatched only on an empty, dedicated host with an operator
+// budget. The child is placed atomically in this test's exact reserved cgroup.
+func TestHostBudgetRealAdmission(t *testing.T) {
+	if os.Getenv("LAUNCHPAD_E2B_CAPACITY_PROOF") != "1" {
+		t.Skip("dedicated host proof only")
+	}
+	require.Equal(t, 0, os.Geteuid())
+	entries, err := os.ReadDir(RootCgroupPath)
+	require.NoError(t, err)
+	for _, entry := range entries {
+		require.False(t, entry.IsDir(), "existing capacity reservation")
+	}
+	manager, err := NewManager()
+	require.NoError(t, err)
+	name := fmt.Sprintf("sbx-budget-proof-%d", os.Getpid())
+	handle, err := manager.Create(t.Context(), name)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, handle.Remove(t.Context())) })
+	child := exec.Command("/bin/sleep", "120")
+	child.SysProcAttr = &syscall.SysProcAttr{UseCgroupFD: true, CgroupFD: handle.GetFD()}
+	require.NoError(t, child.Start())
+	require.NoError(t, handle.ReleaseCgroupFD())
+	t.Cleanup(func() { require.NoError(t, handle.Kill(t.Context())); _ = child.Wait() })
+	_, err = manager.Create(t.Context(), name+"-second")
+	require.ErrorContains(t, err, "waiting")
+	processes, err := os.ReadFile(filepath.Join(RootCgroupPath, name, "cgroup.procs"))
+	require.NoError(t, err)
+	require.Contains(t, string(processes), fmt.Sprint(child.Process.Pid))
+	require.NoError(t, StopAndReleaseCapacity(t.Context(), name))
+	_ = child.Wait()
+	_, err = os.Stat(filepath.Join(RootCgroupPath, name))
+	require.True(t, os.IsNotExist(err))
+	require.NoError(t, handle.Remove(t.Context()))
+	second, err := manager.Create(t.Context(), name+"-second")
+	require.NoError(t, err)
+	require.NoError(t, second.ReleaseCgroupFD())
+	require.NoError(t, second.Remove(t.Context()))
+}
