+//go:build linux
+
+package cgroup
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+type hostCapacityBudget struct {
+	Format               string `json:"format"`
+	MaxRunningVMs        int    `json:"maxRunningVms"`
+	ReserveMemoryMiB     int    `json:"reserveMemoryMiB"`
+	ReserveCPUCount      int    `json:"reserveCpuCount"`
+	NormalMemoryMaxBytes int64  `json:"normalMemoryMaxBytes"`
+	NormalCPUCount       int    `json:"normalCpuCount"`
+	ProbeMemoryMaxBytes  int64  `json:"probeMemoryMaxBytes"`
+	ProbeCPUCount        int    `json:"probeCpuCount"`
+}
+
+// A cgroup directory reserves a normal slot before clone. It is kept until the
+// existing execution journal confirms physical stop and removes it. The host
+// lock also excludes cold probes and operator budget changes during admission.
+func reserveNormalCapacity(root, budgetPath, lockPath, name string) (func(), error) {
+	noop := func() {}
+	if _, err := os.Lstat(budgetPath); os.IsNotExist(err) {
+		// Upstream deployments without the Launchpad recovery budget retain
+		// their ordinary behavior. Cold verification refuses an absent budget.
+		return noop, nil
+	} else if err != nil {
+		return noop, err
+	}
+	lock, err := os.OpenFile(lockPath, os.O_CREATE|os.O_RDWR, 0o600)
+	if err != nil {
+		return noop, err
+	}
+	release := func() { _ = unix.Flock(int(lock.Fd()), unix.LOCK_UN); _ = lock.Close() }
+	if err := unix.Flock(int(lock.Fd()), unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		_ = lock.Close()
+		return noop, fmt.Errorf("host capacity is being reserved: %w", err)
+	}
+	admitted := false
+	defer func() {
+		if !admitted {
+			release()
+		}
+	}()
+	info, err := os.Lstat(budgetPath)
+	if err != nil {
+		return noop, err
+	}
+	owner, ok := info.Sys().(*syscall.Stat_t)
+	if !info.Mode().IsRegular() || info.Mode().Perm()&0o077 != 0 || !ok || owner.Uid != uint32(os.Geteuid()) || info.Size() > 4096 {
+		return noop, errors.New("unowned host capacity budget")
+	}
+	file, err := os.Open(budgetPath)
+	if err != nil {
+		return noop, err
+	}
+	defer file.Close()
+	decoder := json.NewDecoder(io.LimitReader(file, 4097))
+	decoder.DisallowUnknownFields()
+	var budget hostCapacityBudget
+	if err := decoder.Decode(&budget); err != nil {
+		return noop, err
+	}
+	var extra any
+	if err := decoder.Decode(&extra); !errors.Is(err, io.EOF) {
+		return noop, errors.New("invalid trailing host budget")
+	}
+	if budget.Format != "launchpad-host-capacity-v1" || budget.MaxRunningVMs < 1 || budget.MaxRunningVMs > 4096 ||
+		budget.ReserveMemoryMiB < 2048 || budget.ReserveCPUCount < 1 ||
+		budget.NormalMemoryMaxBytes != int64(budget.MaxRunningVMs)*5*1024*1024*1024 ||
+		budget.NormalCPUCount != budget.MaxRunningVMs*2 || budget.ProbeMemoryMaxBytes != 5*1024*1024*1024 || budget.ProbeCPUCount != 2 {
+		return noop, errors.New("unsupported host capacity budget")
+	}
+	limits := map[string]string{"memory.max": strconv.FormatInt(budget.NormalMemoryMaxBytes, 10),
+		"memory.swap.max": "0"}
+	for key, expected := range limits {
+		actual, err := os.ReadFile(filepath.Join(root, key))
+		if err != nil || strings.Join(strings.Fields(string(actual)), " ") != expected {
+			return noop, errors.New("ordinary VM limits differ from the protected host budget")
+		}
+	}
+	cpuLimit, err := os.ReadFile(filepath.Join(root, "cpu.max"))
+	if err != nil || !cpuLimitMatches(string(cpuLimit), budget.NormalCPUCount) {
+		return noop, errors.New("ordinary VM limits differ from the protected host budget")
+	}
+	if name == "" || filepath.Base(name) != name || name == "." || name == ".." {
+		return noop, errors.New("invalid VM cgroup identity")
+	}
+	entries, err := os.ReadDir(root)
+	if err != nil {
+		return noop, err
+	}
+	count := 0
+	for _, entry := range entries {
+		if entry.IsDir() {
+			count++
+			if entry.Name() == name {
+				return noop, errors.New("VM cgroup is already reserved")
+			}
+		}
+	}
+	if count >= budget.MaxRunningVMs {
+		return noop, errors.New("waiting for normal VM host capacity")
+	}
+	admitted = true
+	return release, nil
+}
+
+// E2B initializes a different scheduling period after restart. Equivalent
+// quota/period pairs enforce the same CPU count; unlimited or weaker limits fail.
+func cpuLimitMatches(value string, cpus int) bool {
+	fields := strings.Fields(value)
+	if len(fields) != 2 {
+		return false
+	}
+	quota, quotaErr := strconv.ParseInt(fields[0], 10, 64)
+	period, periodErr := strconv.ParseInt(fields[1], 10, 64)
+	return quotaErr == nil && periodErr == nil && period >= 1000 && period <= 1000000 && quota == int64(cpus)*period
+}
+
+// The execution journal has already fenced future clones of this exact group.
+// Release its capacity directory only after descendants are physically absent.
+func StopAndReleaseCapacity(ctx context.Context, name string) error {
+	if err := KillExisting(ctx, name); err != nil {
+		return err
+	}
+	if err := os.Remove(filepath.Join(RootCgroupPath, name)); err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	return nil
+}
