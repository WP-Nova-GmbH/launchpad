diff --git a/packages/api/internal/sandbox/reservations/redis/restore.go b/packages/api/internal/sandbox/reservations/redis/restore.go
new file mode 100644
--- /dev/null
+++ b/packages/api/internal/sandbox/reservations/redis/restore.go
@@ -0,0 +1,69 @@
+package redis
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"github.com/e2b-dev/infra/packages/api/internal/sandbox/sandboxtypes"
+	"github.com/google/uuid"
+	"github.com/redis/go-redis/v9"
+	"time"
+)
+
+// Restore admission shares normal creation's capacity count and Redis slot.
+// It has no expiry: a stale API worker cannot establish that a guest stopped.
+// Registered-but-not-yet-released entries may briefly count twice; this errs
+// toward retaining capacity, and the durable restore worker retries release.
+var reserveRestoreScript = redis.NewScript(`
+ local owner=redis.call('HGET',KEYS[3],ARGV[1])
+ if owner then
+  if owner==ARGV[2] then return 0 end
+  return 4
+ end
+ if redis.call('SISMEMBER',KEYS[1],ARGV[1])==1 then return 1 end
+ redis.call('ZREMRANGEBYSCORE',KEYS[2],'-inf',ARGV[4])
+ if redis.call('ZSCORE',KEYS[2],ARGV[1]) then return 4 end
+ local limit=tonumber(ARGV[3])
+ if limit>=0 and redis.call('SCARD',KEYS[1])+redis.call('ZCARD',KEYS[2])+redis.call('HLEN',KEYS[3])>=limit then return 3 end
+ redis.call('HSET',KEYS[3],ARGV[1],ARGV[2])
+ return 0
+`)
+var releaseRestoreScript = redis.NewScript(`
+ local owner=redis.call('HGET',KEYS[1],ARGV[1])
+ if not owner then return 0 end
+ if owner~=ARGV[2] then return 4 end
+ redis.call('HDEL',KEYS[1],ARGV[1])
+ return 0
+`)
+
+func (s *ReservationStorage) ReserveRestore(ctx context.Context, teamID uuid.UUID, sandboxID string, operationID uuid.UUID, limit int) error {
+	if teamID == uuid.Nil || operationID == uuid.Nil || sandboxID == "" {
+		return errors.New("invalid restore reservation identity")
+	}
+	team := teamID.String()
+	result, err := reserveRestoreScript.Run(ctx, s.redisClient, []string{getStorageIndexKey(team), getPendingSetKey(team), getRestoreReservationsKey(team)}, sandboxID, operationID.String(), limit, time.Now().Add(-staleTTL).Unix()).Int()
+	if err != nil {
+		return fmt.Errorf("reserve restore capacity: %w", err)
+	}
+	switch result {
+	case reserveResultReserved, reserveResultAlreadyInStorage:
+		return nil
+	case reserveResultLimitExceeded:
+		return &sandboxtypes.LimitExceededError{TeamID: teamID}
+	default:
+		return errors.New("restore capacity reservation identity conflicts")
+	}
+}
+func (s *ReservationStorage) ReleaseRestore(ctx context.Context, teamID uuid.UUID, sandboxID string, operationID uuid.UUID) error {
+	if teamID == uuid.Nil || operationID == uuid.Nil || sandboxID == "" {
+		return errors.New("invalid restore reservation identity")
+	}
+	result, err := releaseRestoreScript.Run(ctx, s.redisClient, []string{getRestoreReservationsKey(teamID.String())}, sandboxID, operationID.String()).Int()
+	if err != nil {
+		return fmt.Errorf("release restore capacity: %w", err)
+	}
+	if result != 0 {
+		return errors.New("restore capacity reservation identity conflicts")
+	}
+	return nil
+}
