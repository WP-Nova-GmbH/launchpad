@@ -0,0 +1,85 @@
+package redis
+
+import (
+	"context"
+	"github.com/e2b-dev/infra/packages/api/internal/sandbox/sandboxtypes"
+	"github.com/google/uuid"
+	goredis "github.com/redis/go-redis/v9"
+	"github.com/stretchr/testify/require"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestRestoreReservationSharesCapacityAndSurvivesOrdinaryExpiry(t *testing.T) {
+	t.Parallel()
+	s, client := setupTestReservationStorage(t)
+	team, op := uuid.New(), uuid.New()
+	require.NoError(t, s.ReserveRestore(t.Context(), team, "restore", op, 1))
+	// An API process restart creates another adapter against the same state.
+	recovered := NewReservationStorage(client, s.notifier)
+	require.NoError(t, recovered.ReserveRestore(t.Context(), team, "restore", op, 0), "admitted work survives a reduced cap")
+	require.NoError(t, client.ZAdd(t.Context(), getPendingSetKey(team.String()), goredis.Z{Score: float64(time.Now().Add(-2 * staleTTL).Unix()), Member: "old-ordinary"}).Err())
+	_, _, err := recovered.Reserve(t.Context(), team, "ordinary", 1)
+	require.ErrorAs(t, err, new(*sandboxtypes.LimitExceededError))
+	require.NoError(t, s.Release(t.Context(), team, "restore"), "ordinary cleanup cannot release a durable restore reservation")
+	require.ErrorAs(t, recovered.ReserveRestore(t.Context(), team, "another", uuid.New(), 1), new(*sandboxtypes.LimitExceededError))
+	require.Equal(t, int64(-1), client.TTL(t.Context(), getRestoreReservationsKey(team.String())).Val().Nanoseconds(), "restore reservation has no expiration")
+	require.Error(t, recovered.ReleaseRestore(t.Context(), team, "restore", uuid.New()))
+	require.Error(t, recovered.ReserveRestore(t.Context(), team, "restore", uuid.New(), 3))
+	require.NoError(t, recovered.ReleaseRestore(t.Context(), team, "restore", op))
+	require.NoError(t, recovered.ReleaseRestore(t.Context(), team, "restore", op))
+	finish, _, err := recovered.Reserve(t.Context(), team, "ordinary", 1)
+	require.NoError(t, err)
+	require.NotNil(t, finish)
+	finish(sandboxtypes.Sandbox{}, context.Canceled)
+}
+
+func TestRestoreReservationRacesOrdinaryAdmissionAtomically(t *testing.T) {
+	t.Parallel()
+	s, client := setupTestReservationStorage(t)
+	team := uuid.New()
+	var admitted atomic.Int32
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	for i := range 24 {
+		wg.Go(func() {
+			<-start
+			id := uuid.NewString()
+			var err error
+			if i%2 == 0 {
+				err = s.ReserveRestore(t.Context(), team, id, uuid.New(), 3)
+			} else {
+				_, _, err = s.Reserve(t.Context(), team, id, 3)
+			}
+			if err == nil {
+				admitted.Add(1)
+			}
+		})
+	}
+	close(start)
+	wg.Wait()
+	require.Equal(t, int32(3), admitted.Load())
+	total := client.ZCard(t.Context(), getPendingSetKey(team.String())).Val() + client.HLen(t.Context(), getRestoreReservationsKey(team.String())).Val()
+	require.Equal(t, int64(3), total)
+}
+
+func TestRestoreReservationCountsRunningVMsAndPromotesOnce(t *testing.T) {
+	t.Parallel()
+	s, client := setupTestReservationStorage(t)
+	team, op := uuid.New(), uuid.New()
+	index := getStorageIndexKey(team.String())
+	require.NoError(t, client.SAdd(t.Context(), index, "ordinary").Err())
+	require.ErrorAs(t, s.ReserveRestore(t.Context(), team, "restore", op, 1), new(*sandboxtypes.LimitExceededError))
+	require.NoError(t, s.ReserveRestore(t.Context(), team, "restore", op, 2))
+	// Registration happened but its reply was lost. A retry keeps the same slot
+	// until the destination is recognized and the operation explicitly releases.
+	require.NoError(t, client.SAdd(t.Context(), index, "restore").Err())
+	require.NoError(t, s.ReserveRestore(t.Context(), team, "restore", op, 2))
+	require.NoError(t, s.ReleaseRestore(t.Context(), team, "restore", op))
+	require.NoError(t, s.ReserveRestore(t.Context(), team, "restore", op, 2))
+	require.Zero(t, client.HLen(t.Context(), getRestoreReservationsKey(team.String())).Val())
+	_, _, err := s.Reserve(t.Context(), team, "third", 2)
+	require.ErrorAs(t, err, new(*sandboxtypes.LimitExceededError))
+}
