+	testutils.UpsertTestSnapshot(t, t.Context(), db, "paused-tip-"+uuid.NewString(), paused, p.TeamID, p.SandboxID)
+	_, retired, err := store.RetireStoppedRestoreTemplate(t.Context(), p.TeamID, p.SandboxID)
+	require.ErrorIs(t, err, executions.ErrRestoreTemplateInUse)
+	require.False(t, retired)
+	assertRestoreTemplateLive(t, db, p.SandboxID)
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), "DELETE FROM snapshots WHERE team_id=$1 AND sandbox_id=$2", p.TeamID, paused))
+	op := uuid.New()
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), `INSERT INTO sandbox_restore_operations(team_id,operation_id,request_sha256,request_payload,source_template_id,source_build_id,prepared_build_id,sandbox_id,execution_id,cluster_id,node_id,generation,state,reserved_bytes)
+      VALUES($1,$2,repeat('b',64),'{}',$3,$4,$5,$6,$7,$8,$9,'4','preparing',0)`, p.TeamID, op, p.SandboxID, build, uuid.New(), "pending-"+uuid.NewString(), uuid.New(), p.ClusterID, p.NodeID))
+	require.NoError(t, db.SqlcClient.PinRestoreBuild(t.Context(), queries.PinRestoreBuildParams{TeamID: p.TeamID, OperationID: op, BuildID: build}))
+	_, retired, err = store.RetireStoppedRestoreTemplate(t.Context(), p.TeamID, p.SandboxID)
