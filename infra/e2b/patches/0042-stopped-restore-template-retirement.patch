+package handlers
+
+import (
+	"context"
+	"testing"
+
+	"github.com/e2b-dev/infra/packages/db/pkg/buildretention"
+	"github.com/e2b-dev/infra/packages/db/pkg/executions"
+	"github.com/e2b-dev/infra/packages/db/pkg/testutils"
+	"github.com/e2b-dev/infra/packages/db/queries"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+)
+
+func TestExecutionStopRetiresOnlyOwnedRestoredDestinationTemplate(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	team := testutils.CreateTestTeam(t, db)
+	source := testutils.CreateTestTemplate(t, db, team)
+	sourceBuild := testutils.CreateTestBuild(t, t.Context(), db, source, "uploaded")
+	store := executions.Store{DB: db.SqlcClient}
+	makeRestore := func(generation string) (queries.InsertExecutionAttemptParams, uuid.UUID) {
+		p := queries.InsertExecutionAttemptParams{TeamID: team, SandboxID: "restored-" + uuid.NewString(), ExecutionID: uuid.New(), NodeID: "host"}
+		op, prepared := uuid.New(), uuid.New()
+		require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), `INSERT INTO sandbox_restore_operations(team_id,operation_id,request_sha256,request_payload,source_template_id,source_build_id,prepared_build_id,sandbox_id,execution_id,cluster_id,node_id,generation,state,reserved_bytes,manifest)
+          VALUES($1,$2,repeat('a',64),'{}',$3,$4,$5,$6,$7,$8,$9,$10,'activating',0,'{}')`, team, op, source, sourceBuild, prepared, p.SandboxID, p.ExecutionID, p.ClusterID, p.NodeID, generation))
+		require.NoError(t, db.SqlcClient.CreateRestoreBuild(t.Context(), queries.CreateRestoreBuildParams{TeamID: team, OperationID: op}))
+		_, err := db.SqlcClient.CreateSnapshotTemplateEnv(t.Context(), queries.CreateSnapshotTemplateEnvParams{SnapshotID: p.SandboxID, TeamID: team, SandboxID: p.SandboxID, OriginNodeID: &p.NodeID, BuildID: &prepared, Tag: "default"})
+		require.NoError(t, err)
+		require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), "UPDATE sandbox_restore_operations SET state='active' WHERE operation_id=$1", op))
+		require.NoError(t, store.Register(t.Context(), p, prepared, true))
+		return p, prepared
+	}
+	stopped, prepared := makeRestore("3")
+	other, _ := makeRestore("4")
+	// A resume changes the current execution. Cleanup must still recognize the
+	// original activation's historical build root after permanent stop.
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), "UPDATE sandbox_execution_fences SET state='paused' WHERE team_id=$1 AND sandbox_id=$2", team, stopped.SandboxID))
+	resumed := stopped
+	resumed.ExecutionID = uuid.New()
+	require.NoError(t, store.Register(t.Context(), resumed, uuid.New(), true))
+	alias := testutils.CreateTestTemplateAlias(t, db, stopped.SandboxID)
+	_, err := store.BeginStop(t.Context(), team, stopped.SandboxID)
+	require.NoError(t, err)
+	n, err := db.SqlcClient.ConfirmExecutionStopped(t.Context(), queries.ConfirmExecutionStoppedParams{TeamID: team, SandboxID: stopped.SandboxID})
+	require.NoError(t, err)
+	require.EqualValues(t, 1, n)
+	server := &APIStore{sqlcDB: db.SqlcClient}
+	for range 2 {
+		ctx, response := restoreHTTPContext(t, team, nil)
+		server.StopLaunchpadExecution(ctx, stopped.SandboxID)
+		require.Equal(t, 200, response.Code)
+	}
+	_, tx, err := db.SqlcClient.WithTx(t.Context())
+	require.NoError(t, err)
+	defer tx.Rollback(context.WithoutCancel(t.Context()))
+	var retired, sourceLive, otherLive bool
+	var aliases int
+	require.NoError(t, tx.QueryRow(t.Context(), "SELECT deleted_at IS NOT NULL FROM envs WHERE id=$1", stopped.SandboxID).Scan(&retired))
+	require.True(t, retired, "a physically stopped restored VM must release its private activation template")
+	require.NoError(t, tx.QueryRow(t.Context(), "SELECT deleted_at IS NULL FROM envs WHERE id=$1", source).Scan(&sourceLive))
+	require.True(t, sourceLive, "the retained source snapshot/template is independent")
+	require.NoError(t, tx.QueryRow(t.Context(), "SELECT deleted_at IS NULL FROM envs WHERE id=$1", other.SandboxID).Scan(&otherLive))
+	require.True(t, otherLive, "another generation's serving VM stays intact")
+	require.NoError(t, tx.QueryRow(t.Context(), "SELECT count(*) FROM env_aliases WHERE alias=$1", alias).Scan(&aliases))
+	require.Zero(t, aliases)
+	require.NoError(t, tx.Rollback(t.Context()))
+	require.NoError(t, buildretention.WithPinnedCatalog(t.Context(), db.SqlcClient, func(c buildretention.Catalog) error {
+		require.NotContains(t, c.Roots, prepared, "only descendant block lineage may retain the retired disk")
+		require.Contains(t, c.Roots, sourceBuild)
+		return nil
+	}))
+}
