+			require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), "UPDATE sandbox_execution_fences SET state=$3 WHERE team_id=$1 AND sandbox_id=$2", p.TeamID, other.SandboxID, state))
+			stopRestoredFixture(t, db, store, p)
