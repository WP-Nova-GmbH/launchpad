+func stoppedRestoreFixture(t *testing.T, db *testutils.Database) (executions.Store, queries.InsertExecutionAttemptParams, uuid.UUID, uuid.UUID) {
+	t.Helper()
+	team := testutils.CreateTestTeam(t, db)
+	source := testutils.CreateTestTemplate(t, db, team)
+	base := testutils.CreateTestBuild(t, t.Context(), db, source, "uploaded")
+	p := queries.InsertExecutionAttemptParams{TeamID: team, SandboxID: "restored-" + uuid.NewString(), ExecutionID: uuid.New(), NodeID: "host"}
+	op, prepared := uuid.New(), uuid.New()
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), `INSERT INTO sandbox_restore_operations(team_id,operation_id,request_sha256,request_payload,source_template_id,source_build_id,prepared_build_id,sandbox_id,execution_id,cluster_id,node_id,generation,state,reserved_bytes,manifest)
+      VALUES($1,$2,repeat('a',64),'{}',$3,$4,$5,$6,$7,$8,$9,'3','activating',0,'{}')`, team, op, source, base, prepared, p.SandboxID, p.ExecutionID, p.ClusterID, p.NodeID))
+	require.NoError(t, db.SqlcClient.CreateRestoreBuild(t.Context(), queries.CreateRestoreBuildParams{TeamID: team, OperationID: op}))
+	_, err := db.SqlcClient.CreateSnapshotTemplateEnv(t.Context(), queries.CreateSnapshotTemplateEnvParams{SnapshotID: p.SandboxID, TeamID: team, SandboxID: p.SandboxID, OriginNodeID: &p.NodeID, BuildID: &prepared, Tag: "default"})
+	require.NoError(t, err)
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), "UPDATE sandbox_restore_operations SET state='active' WHERE operation_id=$1", op))
+	store := executions.Store{DB: db.SqlcClient}
+	require.NoError(t, store.Register(t.Context(), p, prepared, true))
+	return store, p, op, prepared
+}
+
+func stopRestoredFixture(t *testing.T, db *testutils.Database, store executions.Store, p queries.InsertExecutionAttemptParams) {
+	t.Helper()
+	_, err := store.BeginStop(t.Context(), p.TeamID, p.SandboxID)
+	require.NoError(t, err)
+	n, err := db.SqlcClient.ConfirmExecutionStopped(t.Context(), queries.ConfirmExecutionStoppedParams{TeamID: p.TeamID, SandboxID: p.SandboxID})
+	require.NoError(t, err)
+	require.EqualValues(t, 1, n)
+}
+
+func assertRestoreTemplateLive(t *testing.T, db *testutils.Database, sandbox string) {
+	t.Helper()
+	_, tx, err := db.SqlcClient.WithTx(t.Context())
+	require.NoError(t, err)
+	defer tx.Rollback(context.WithoutCancel(t.Context()))
+	var live bool
+	require.NoError(t, tx.QueryRow(t.Context(), "SELECT deleted_at IS NULL FROM envs WHERE id=$1", sandbox).Scan(&live))
+	require.True(t, live)
+}
+
+func TestStoppedRestoreTemplateRejectsUnstoppedFences(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	for _, state := range []string{"active", "paused", "stopping"} {
+		t.Run(state, func(t *testing.T) {
+			store, p, _, _ := stoppedRestoreFixture(t, db)
+			require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), "UPDATE sandbox_execution_fences SET state=$3 WHERE team_id=$1 AND sandbox_id=$2", p.TeamID, p.SandboxID, state))
+			_, retired, err := store.RetireStoppedRestoreTemplate(t.Context(), p.TeamID, p.SandboxID)
+			require.ErrorIs(t, err, executions.ErrFenced)
+			require.False(t, retired)
+			assertRestoreTemplateLive(t, db, p.SandboxID)
+		})
+	}
+}
+
+func TestStoppedRestoreTemplateRequiresExactActivationProvenance(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), "INSERT INTO clusters(id,name,endpoint,token) VALUES('00000000-0000-0000-0000-000000000001','other-test-cluster','unused','unused')"))
+	for _, mutation := range []string{
+		"UPDATE envs SET source='template' WHERE id=$1",
+		"UPDATE snapshot_templates SET origin_node_id='other-host' WHERE env_id=$1",
+		"UPDATE snapshot_templates SET sandbox_id='other-sandbox' WHERE env_id=$1",
+		"UPDATE sandbox_restore_operations SET state='failed' WHERE sandbox_id=$1",
+		"UPDATE sandbox_restore_operations SET source_template_id=sandbox_id WHERE sandbox_id=$1",
+		"DELETE FROM sandbox_execution_build_roots WHERE sandbox_id=$1",
+		"UPDATE envs SET cluster_id='00000000-0000-0000-0000-000000000001' WHERE id=$1",
+	} {
+		t.Run(mutation, func(t *testing.T) {
+			store, p, _, _ := stoppedRestoreFixture(t, db)
+			stopRestoredFixture(t, db, store, p)
+			require.NoError(t, db.SqlcClient.TestsRawSQL(t.Context(), mutation, p.SandboxID))
+			_, retired, err := store.RetireStoppedRestoreTemplate(t.Context(), p.TeamID, p.SandboxID)
+			require.NoError(t, err)
+			require.False(t, retired)
+			assertRestoreTemplateLive(t, db, p.SandboxID)
+		})
+	}
+	store, p, _, _ := stoppedRestoreFixture(t, db)
+	stopRestoredFixture(t, db, store, p)
+	_, retired, err := store.RetireStoppedRestoreTemplate(t.Context(), uuid.New(), p.SandboxID)
+	require.Error(t, err)
+	require.False(t, retired)
+	assertRestoreTemplateLive(t, db, p.SandboxID)
+	newBuild := testutils.CreateTestBuild(t, t.Context(), db, p.SandboxID, "uploaded")
+	testutils.CreateTestBuildAssignment(t, t.Context(), db, p.SandboxID, newBuild, "other")
+	_, retired, err = store.RetireStoppedRestoreTemplate(t.Context(), p.TeamID, p.SandboxID)
+	require.NoError(t, err)
+	require.False(t, retired, "a repurposed template must not be retired")
+	assertRestoreTemplateLive(t, db, p.SandboxID)
+}
