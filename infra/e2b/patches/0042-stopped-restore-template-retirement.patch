+package executions
+
+import (
+	"context"
+	"errors"
+
+	"github.com/e2b-dev/infra/packages/db/queries"
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+)
+
+var ErrRestoreTemplateInUse = errors.New("stopped restore template is still in use")
+
+// RetireStoppedRestoreTemplate releases only the private template created by
+// restore activation. Its flattened disk is independent of the retained source;
+// physical collection still follows every surviving build's block ancestry.
+func (s Store) RetireStoppedRestoreTemplate(ctx context.Context, team uuid.UUID, sandboxID string) ([]string, bool, error) {
+	db, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return nil, false, err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	state, err := db.LockExecutionFence(ctx, queries.LockExecutionFenceParams{TeamID: team, SandboxID: sandboxID})
+	if err != nil {
+		return nil, false, err
+	}
+	if state != "stopped" {
+		return nil, false, ErrFenced
+	}
+	// The env lock also serializes restore admission and build registration. Use
+	// a fresh statement afterwards to see pins/assignments committed before it.
+	var template string
+	err = tx.QueryRow(ctx, `SELECT id FROM public.envs
+        WHERE id=$2 AND team_id=$1 AND source='snapshot_template' FOR UPDATE`, team, sandboxID).Scan(&template)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, false, nil
+	}
+	if err != nil {
+		return nil, false, err
+	}
+	var build uuid.UUID
+	err = tx.QueryRow(ctx, `SELECT o.prepared_build_id
+        FROM public.sandbox_restore_operations o
+        JOIN public.envs e ON e.id=o.sandbox_id AND e.team_id=o.team_id
+        JOIN public.snapshot_templates st ON st.env_id=e.id AND st.sandbox_id=o.sandbox_id
+          AND st.build_id=o.prepared_build_id AND st.origin_node_id=o.node_id
+        JOIN public.sandbox_execution_build_roots r
+          ON r.team_id=o.team_id AND r.sandbox_id=o.sandbox_id AND r.execution_id=o.execution_id
+          AND r.cluster_id=o.cluster_id AND r.node_id=o.node_id AND r.build_id=o.prepared_build_id
+        WHERE o.team_id=$1 AND o.sandbox_id=$2 AND o.state='active'
+          AND o.prepared_build_id<>o.source_build_id AND o.source_template_id<>o.sandbox_id
+          AND e.cluster_id IS NOT DISTINCT FROM NULLIF(o.cluster_id,'00000000-0000-0000-0000-000000000000'::uuid)
+          AND NOT EXISTS(SELECT 1 FROM public.env_build_assignments a
+            WHERE a.env_id=e.id AND a.build_id<>o.prepared_build_id)`, team, sandboxID).Scan(&build)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, false, nil // an ordinary or repurposed template is not ours to retire
+	}
+	if err != nil {
+		return nil, false, err
+	}
+	pinned, err := db.HasRestoreTemplatePins(ctx, template)
+	if err != nil {
+		return nil, false, err
+	}
+	var used bool
+	if err := tx.QueryRow(ctx, `SELECT EXISTS(
+        SELECT 1 FROM public.sandbox_execution_build_roots r
+        JOIN public.sandbox_execution_fences f USING(team_id,sandbox_id)
+        WHERE r.build_id=$1 AND f.state<>'stopped'
+        UNION ALL SELECT 1 FROM public.snapshots WHERE base_env_id=$2)`, build, template).Scan(&used); err != nil {
+		return nil, false, err
+	}
+	if pinned || used {
+		return nil, false, ErrRestoreTemplateInUse
+	}
+	if _, err := db.SoftDeleteTemplate(ctx, queries.SoftDeleteTemplateParams{TeamID: team, TemplateID: template}); err != nil && !errors.Is(err, pgx.ErrNoRows) {
+		return nil, false, err
+	}
+	aliases, err := db.ReleaseTemplateAliases(ctx, template)
+	if err != nil {
+		return nil, false, err
+	}
+	if err := db.DeleteActiveTemplateBuilds(ctx, template); err != nil {
+		return nil, false, err
+	}
+	return aliases, true, tx.Commit(ctx)
+}
