+func TestRestoreAdmissionRejectsSingleOversizedReservationWithoutSideEffects(t *testing.T) {
+	t.Parallel()
+	db := testutils.SetupDatabase(t)
+	store := restorestore.Store{DB: db.SqlcClient}
+	p := newOperation(t, db)
+	_, err := store.Create(t.Context(), p, p.ReservedBytes-1)
+	require.ErrorIs(t, err, restorestore.ErrRequestTooLarge)
+	require.NotErrorIs(t, err, restorestore.ErrCapacity)
+	_, err = db.SqlcClient.GetRestoreOperation(t.Context(), queries.GetRestoreOperationParams{TeamID: p.TeamID, OperationID: p.OperationID})
+	require.ErrorIs(t, err, pgx.ErrNoRows)
+	reserved, err := db.SqlcClient.RestoreReservedBytes(t.Context(), queries.RestoreReservedBytesParams{ClusterID: p.ClusterID, NodeID: p.NodeID})
+	require.NoError(t, err)
+	require.Zero(t, reserved)
+	pinned, err := db.SqlcClient.HasRestoreBuildPins(t.Context(), p.SourceBuildID)
+	require.NoError(t, err)
+	require.False(t, pinned)
+	_, err = store.Create(t.Context(), p, p.ReservedBytes)
+	require.NoError(t, err, "a later operator budget change can admit a new attempt")
+}
+
+func TestRestoreAdmissionReconcilesExistingOperationAfterBudgetShrinks(t *testing.T) {
+	t.Parallel()
+	db := testutils.SetupDatabase(t)
+	store := restorestore.Store{DB: db.SqlcClient}
+	p := newOperation(t, db)
+	first, err := store.Create(t.Context(), p, p.ReservedBytes)
+	require.NoError(t, err)
+	retry, err := store.Create(t.Context(), p, p.ReservedBytes-1)
+	require.NoError(t, err, "a lower current budget must not reject already admitted work")
+	require.Equal(t, first.PreparedBuildID, retry.PreparedBuildID)
+	require.Equal(t, first.SandboxID, retry.SandboxID)
+	require.Equal(t, first.ReservedBytes, retry.ReservedBytes)
+	p.Generation = "changed-generation"
+	_, err = store.Create(t.Context(), p, p.ReservedBytes-1)
+	require.ErrorIs(t, err, restorestore.ErrConflict, "identity conflicts still take precedence over the budget")
+}
