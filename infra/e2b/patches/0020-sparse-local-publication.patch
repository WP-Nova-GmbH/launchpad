+// StoreFile publishes verified VM disks containing large free zeroed regions.
+// A kernel file copy can allocate those holes again and exhaust restore capacity.
+// Copy every byte, leaving zero chunks sparse and preserving trailing geometry.
+func copySparseFile(dst, src *os.File) (int64, error) {
+	buffer := make([]byte, 1<<20)
+	zero := make([]byte, len(buffer))
+	var offset int64
+	for {
+		n, err := io.ReadFull(src, buffer)
+		if n > 0 {
+			if !bytes.Equal(buffer[:n], zero[:n]) {
+				if _, writeErr := dst.WriteAt(buffer[:n], offset); writeErr != nil {
+					return offset, writeErr
+				}
+			}
+			offset += int64(n)
+		}
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return offset, dst.Truncate(offset)
+		}
+		if err != nil {
+			return offset, err
+		}
+	}
