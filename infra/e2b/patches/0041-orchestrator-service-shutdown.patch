--- a/packages/orchestrator/pkg/factories/shutdown.go
+++ b/packages/orchestrator/pkg/factories/shutdown.go
@@ -0,0 +1,22 @@
+package factories
+
+import (
+	"context"
+	"errors"
+	"fmt"
+)
+
+type serviceDoneError struct{ name string }
+
+func (e serviceDoneError) Error() string { return fmt.Sprintf("service %s finished", e.name) }
+
+func waitForServices(cancel context.CancelFunc, wait func() error) error {
+	// Stop context-bound workers before joining them. Normal shutdown calls
+	// this only after draining sandboxes and closing their dependencies.
+	cancel()
+	var done serviceDoneError
+	if err := wait(); err != nil && !errors.As(err, &done) {
+		return err
+	}
+	return nil
+}
--- a/packages/orchestrator/pkg/factories/shutdown_test.go
+++ b/packages/orchestrator/pkg/factories/shutdown_test.go
@@ -0,0 +1,66 @@
+package factories
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestWaitForServicesStopsContextWorker(t *testing.T) {
+	for _, mode := range []string{"normal shutdown", "early return", "panic"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(t.Context())
+			defer cancel()
+			signalCtx, signal := context.WithCancel(ctx)
+			signal()
+			<-signalCtx.Done()
+			if ctx.Err() != nil {
+				t.Fatal("signal cancelled the parent before drain")
+			}
+			cleanupCtx := context.WithoutCancel(ctx)
+			var workers sync.WaitGroup
+			workers.Go(func() { <-ctx.Done() })
+			stopped := make(chan error, 1)
+			go func() {
+				wait := func() error { workers.Wait(); return serviceDoneError{name: "routing"} }
+				if mode != "normal shutdown" {
+					func() {
+						defer func() { _ = recover() }()
+						defer func() { stopped <- waitForServices(cancel, wait) }()
+						if mode == "panic" {
+							panic("startup failed")
+						}
+					}()
+				} else {
+					stopped <- waitForServices(cancel, wait)
+				}
+			}()
+			select {
+			case err := <-stopped:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("shutdown waited for a context worker before cancelling it")
+			}
+			if cleanupCtx.Err() != nil {
+				t.Fatal("telemetry cleanup lost its live context")
+			}
+		})
+	}
+}
+
+func TestWaitForServicesPreservesFailure(t *testing.T) {
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	want := errors.New("service failed")
+	err := waitForServices(cancel, func() error { return want })
+	if !errors.Is(err, want) {
+		t.Fatalf("failure replaced: %v", err)
+	}
+	if ctx.Err() == nil {
+		t.Fatal("failure path left context workers running")
+	}
+}
