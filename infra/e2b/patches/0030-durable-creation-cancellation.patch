+package executions_test
+
+import (
+	"context"
+	"github.com/e2b-dev/infra/packages/db/pkg/executions"
+	"github.com/e2b-dev/infra/packages/db/pkg/testutils"
+	"github.com/e2b-dev/infra/packages/db/queries"
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+	"github.com/stretchr/testify/require"
+	"sync"
+	"testing"
+)
+
+func creationMetadata(op uuid.UUID) map[string]string {
+	return map[string]string{"launchpad.managed": "thread-vm-v1", "launchpad.operation_id": op.String(), "launchpad.allocation_id": uuid.NewString(), "launchpad.thread_id": uuid.NewString(), "launchpad.generation": "2", "unrelated.secret": "must-not-persist"}
+}
+
+func TestCreationIdentitySurvivesFailedBootAndRestart(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	team := testutils.CreateTestTeam(t, db)
+	other := testutils.CreateTestTeam(t, db)
+	store := executions.Store{DB: db.SqlcClient}
+	op := uuid.New()
+	sid := uuid.NewString()
+	metadata := creationMetadata(op)
+	require.NoError(t, store.CaptureCreation(t.Context(), team, sid, metadata))
+	// No routing record, host RPC or successful VM create ever occurs.
+	reopened := executions.Store{DB: db.SqlcClient}
+	identity, err := reopened.GetCreation(t.Context(), team, op)
+	require.NoError(t, err)
+	require.Equal(t, sid, *identity.SandboxID)
+	require.Equal(t, metadata["launchpad.thread_id"], identity.Metadata["launchpad.thread_id"])
+	require.NotContains(t, identity.Metadata, "unrelated.secret")
+	_, err = reopened.GetCreation(t.Context(), other, op)
+	require.ErrorIs(t, err, pgx.ErrNoRows)
+	require.ErrorIs(t, reopened.CaptureCreation(t.Context(), team, uuid.NewString(), metadata), executions.ErrCreationConflict)
+	sealed, err := reopened.SealCreation(t.Context(), team, op)
+	require.NoError(t, err)
+	require.True(t, sealed.Cancelled)
+	require.Equal(t, sid, *sealed.SandboxID)
+	require.ErrorIs(t, reopened.CaptureCreation(t.Context(), team, uuid.NewString(), metadata), executions.ErrCreationConflict)
+	attempts, err := store.BeginStop(t.Context(), team, sid)
+	require.NoError(t, err)
+	require.Empty(t, attempts)
+	known, err := store.HasCapturedCreation(t.Context(), team, sid)
+	require.NoError(t, err)
+	require.True(t, known)
+	require.ErrorIs(t, store.Register(t.Context(), queries.InsertExecutionAttemptParams{TeamID: team, SandboxID: sid, ExecutionID: uuid.New(), NodeID: "late-host"}, uuid.New(), true), executions.ErrFenced)
+}
+
+func TestCreationSealRacesAndRejectsEveryLateCreate(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	team := testutils.CreateTestTeam(t, db)
+	store := executions.Store{DB: db.SqlcClient}
+	for range 8 {
+		op := uuid.New()
+		sid := uuid.NewString()
+		metadata := creationMetadata(op)
+		start := make(chan struct{})
+		var wg sync.WaitGroup
+		var capturedErr, sealedErr error
+		var sealed executions.CreationIdentity
+		wg.Go(func() { <-start; capturedErr = store.CaptureCreation(context.Background(), team, sid, metadata) })
+		wg.Go(func() { <-start; sealed, sealedErr = store.SealCreation(context.Background(), team, op) })
+		close(start)
+		wg.Wait()
+		require.NoError(t, sealedErr)
+		require.True(t, sealed.Cancelled)
+		if capturedErr == nil {
+			require.NotNil(t, sealed.SandboxID)
+			require.Equal(t, sid, *sealed.SandboxID)
+		} else {
+			require.ErrorIs(t, capturedErr, executions.ErrCreationConflict)
+			require.Nil(t, sealed.SandboxID)
+		}
+		require.ErrorIs(t, store.CaptureCreation(t.Context(), team, uuid.NewString(), metadata), executions.ErrCreationConflict)
+	}
+}
