diff --git a/packages/api/internal/handlers/launchpad_creation.go b/packages/api/internal/handlers/launchpad_creation.go
new file mode 100644
--- /dev/null
+++ b/packages/api/internal/handlers/launchpad_creation.go
@@ -0,0 +1,44 @@
+package handlers
+
+import (
+	"errors"
+	"net/http"
+
+	"github.com/e2b-dev/infra/packages/auth/pkg/auth"
+	"github.com/e2b-dev/infra/packages/db/pkg/executions"
+	"github.com/gin-gonic/gin"
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+)
+
+// GetLaunchpadCreation retains the original identity even if boot failed before routing publication.
+func (a *APIStore) GetLaunchpadCreation(c *gin.Context, operationID uuid.UUID) {
+	row, err := (executions.Store{DB: a.sqlcDB}).GetCreation(c.Request.Context(), auth.MustGetTeamID(c), operationID)
+	if err != nil {
+		if errors.Is(err, pgx.ErrNoRows) {
+			a.sendAPIStoreError(c, http.StatusNotFound, "Managed creation operation not found")
+		} else {
+			a.sendAPIStoreError(c, http.StatusServiceUnavailable, "Managed creation identity is unavailable")
+		}
+		return
+	}
+	c.JSON(http.StatusOK, row)
+}
+
+// CancelLaunchpadCreation seals before stopping, including requests still travelling to this API.
+// A response is a physical-stop receipt only after every assigned host has confirmed shutdown.
+func (a *APIStore) CancelLaunchpadCreation(c *gin.Context, operationID uuid.UUID) {
+	team := auth.MustGetTeamID(c)
+	row, err := (executions.Store{DB: a.sqlcDB}).SealCreation(c.Request.Context(), team, operationID)
+	if err != nil {
+		a.sendAPIStoreError(c, http.StatusServiceUnavailable, "Managed creation could not be cancelled")
+		return
+	}
+	if row.SandboxID != nil {
+		if status, message := a.stopLaunchpadExecution(c.Request.Context(), team, *row.SandboxID); status != 0 {
+			a.sendAPIStoreError(c, status, message)
+			return
+		}
+	}
+	c.JSON(http.StatusOK, gin.H{"operationID": operationID, "sandboxID": row.SandboxID, "metadata": row.Metadata, "cancelled": true, "physicallyStopped": true})
+}
diff --git a/packages/api/internal/handlers/launchpad_creation_test.go b/packages/api/internal/handlers/launchpad_creation_test.go
new file mode 100644
--- /dev/null
+++ b/packages/api/internal/handlers/launchpad_creation_test.go
@@ -0,0 +1,74 @@
+package handlers
+
+import (
+	"context"
+	"testing"
+
+	"github.com/e2b-dev/infra/packages/db/pkg/executions"
+	"github.com/e2b-dev/infra/packages/db/pkg/testutils"
+	"github.com/e2b-dev/infra/packages/db/queries"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+)
+
+func TestCreationCancelBeforeHostAdmissionAndAfterRestart(t *testing.T) {
+	db := testutils.SetupDatabase(t)
+	team := testutils.CreateTestTeam(t, db)
+	other := testutils.CreateTestTeam(t, db)
+	store := executions.Store{DB: db.SqlcClient}
+	op := uuid.New()
+	sandboxID := uuid.NewString()
+	labels := map[string]string{"launchpad.managed": "thread-vm-v1", "launchpad.operation_id": op.String(), "launchpad.allocation_id": uuid.NewString(), "launchpad.thread_id": uuid.NewString(), "launchpad.generation": "2"}
+	require.NoError(t, store.CaptureCreation(t.Context(), team, sandboxID, labels))
+	server := &APIStore{sqlcDB: db.SqlcClient}
+	ctx, res := restoreHTTPContext(t, team, nil)
+	server.GetLaunchpadCreation(ctx, op)
+	require.Equal(t, 200, res.Code)
+	require.Contains(t, res.Body.String(), sandboxID)
+	ctx, res = restoreHTTPContext(t, other, nil)
+	server.GetLaunchpadCreation(ctx, op)
+	require.Equal(t, 404, res.Code)
+	ctx, res = restoreHTTPContext(t, team, nil)
+	server.CancelLaunchpadCreation(ctx, op)
+	require.Equal(t, 200, res.Code)
+	require.Contains(t, res.Body.String(), `"physicallyStopped":true`)
+	require.Contains(t, res.Body.String(), sandboxID)
+	state, err := db.SqlcClient.LockExecutionFence(t.Context(), queries.LockExecutionFenceParams{TeamID: team, SandboxID: sandboxID})
+	require.NoError(t, err)
+	require.Equal(t, "stopped", state)
+	restarted := &APIStore{sqlcDB: db.SqlcClient}
