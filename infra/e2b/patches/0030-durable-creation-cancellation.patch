@@ -0,0 +1,118 @@
+package executions
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strconv"
+
+	"github.com/e2b-dev/infra/packages/db/queries"
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+)
+
+var ErrCreationConflict = errors.New("creation operation is already assigned or sealed")
+var ErrCreationIdentity = errors.New("invalid managed creation identity")
+
+type CreationIdentity struct {
+	OperationID uuid.UUID         `json:"operationID"`
+	SandboxID   *string           `json:"sandboxID"`
+	Metadata    map[string]string `json:"metadata"`
+	Cancelled   bool              `json:"cancelled"`
+}
+
+// CaptureCreation records identity and the admission fence before any host RPC.
+// A second request for the same operation cannot allocate another sandbox ID.
+func (s Store) CaptureCreation(ctx context.Context, team uuid.UUID, sandboxID string, metadata map[string]string) error {
+	op, err := uuid.Parse(metadata["launchpad.operation_id"])
+	generation, gerr := strconv.ParseUint(metadata["launchpad.generation"], 10, 64)
+	if err != nil || op == uuid.Nil || team == uuid.Nil || sandboxID == "" || gerr != nil || generation == 0 || metadata["launchpad.managed"] != "thread-vm-v1" {
+		return ErrCreationIdentity
+	}
+	selected := make(map[string]string, 5)
+	for _, key := range []string{"launchpad.managed", "launchpad.allocation_id", "launchpad.operation_id", "launchpad.thread_id", "launchpad.generation"} {
+		value := metadata[key]
+		if value == "" || len(value) > 256 {
+			return ErrCreationIdentity
+		}
+		selected[key] = value
+	}
+	raw, err := json.Marshal(selected)
+	if err != nil {
+		return err
+	}
+	db, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	var assigned string
+	err = tx.QueryRow(ctx, `INSERT INTO public.sandbox_creation_operations(team_id,operation_id,sandbox_id,metadata)
+ VALUES($1,$2,$3,$4) ON CONFLICT DO NOTHING RETURNING sandbox_id`, team, op, sandboxID, string(raw)).Scan(&assigned)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return ErrCreationConflict
+	}
+	if err != nil {
+		return err
+	}
+	if err = db.EnsureExecutionFence(ctx, queries.EnsureExecutionFenceParams{TeamID: team, SandboxID: sandboxID}); err != nil {
+		return err
+	}
+	return tx.Commit(ctx)
+}
+
+func (s Store) GetCreation(ctx context.Context, team, operation uuid.UUID) (CreationIdentity, error) {
+	_, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return CreationIdentity{}, err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	row := CreationIdentity{OperationID: operation}
+	var raw []byte
+	err = tx.QueryRow(ctx, `SELECT sandbox_id,metadata,cancelled FROM public.sandbox_creation_operations WHERE team_id=$1 AND operation_id=$2`, team, operation).Scan(&row.SandboxID, &raw, &row.Cancelled)
+	if err != nil {
+		return CreationIdentity{}, err
+	}
+	err = json.Unmarshal(raw, &row.Metadata)
+	return row, err
+}
+
+// SealCreation closes the operation even when its create request has not arrived.
+// An assigned ID still needs a physical-stop receipt; this tombstone alone is not one.
+func (s Store) SealCreation(ctx context.Context, team, operation uuid.UUID) (CreationIdentity, error) {
+	if team == uuid.Nil || operation == uuid.Nil {
+		return CreationIdentity{}, ErrCreationIdentity
+	}
+	_, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return CreationIdentity{}, err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	row := CreationIdentity{OperationID: operation}
+	var raw []byte
+	err = tx.QueryRow(ctx, `INSERT INTO public.sandbox_creation_operations(team_id,operation_id,cancelled) VALUES($1,$2,true)
+ ON CONFLICT(team_id,operation_id) DO UPDATE SET cancelled=true
+ RETURNING sandbox_id,metadata,cancelled`, team, operation).Scan(&row.SandboxID, &raw, &row.Cancelled)
+	if err != nil {
+		return CreationIdentity{}, err
+	}
+	if err = json.Unmarshal(raw, &row.Metadata); err != nil {
+		return CreationIdentity{}, err
+	}
+	if err = tx.Commit(ctx); err != nil {
+		return CreationIdentity{}, err
+	}
+	return row, nil
+}
+
+// HasCapturedCreation distinguishes a registered pre-boot intent from unknown legacy executions.
+func (s Store) HasCapturedCreation(ctx context.Context, team uuid.UUID, sandboxID string) (bool, error) {
+	_, tx, err := s.DB.WithTx(ctx)
+	if err != nil {
+		return false, err
+	}
+	defer tx.Rollback(context.WithoutCancel(ctx))
+	var found bool
+	err = tx.QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM public.sandbox_creation_operations WHERE team_id=$1 AND sandbox_id=$2)`, team, sandboxID).Scan(&found)
+	return found, err
+}
