+package storage
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestFSStoreFileCancelledPreservesExisting(t *testing.T) {
+	t.Parallel()
+	p := newTempProvider(t)
+	object, err := p.OpenSeekable(t.Context(), "published/rootfs.ext4")
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(p.getPath("published/rootfs.ext4"), []byte("verified prior disk"), 0600))
+	source := filepath.Join(t.TempDir(), "candidate.ext4")
+	require.NoError(t, os.WriteFile(source, bytes.Repeat([]byte{0x4b}, 2<<20), 0600))
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	_, _, err = object.StoreFile(ctx, source)
+	require.ErrorIs(t, err, context.Canceled)
+	data, err := os.ReadFile(p.getPath("published/rootfs.ext4"))
+	require.NoError(t, err)
+	require.Equal(t, "verified prior disk", string(data))
+	leftovers, err := filepath.Glob(filepath.Join(p.basePath, "published", ".rootfs.ext4.tmp-*"))
+	require.NoError(t, err)
+	require.Empty(t, leftovers)
+}
+
+func TestFSPutCancelledPreservesExisting(t *testing.T) {
+	t.Parallel()
+	p := newTempProvider(t)
+	object, err := p.OpenBlob(t.Context(), "retained/manifest.json")
+	require.NoError(t, err)
+	require.NoError(t, object.Put(t.Context(), []byte("verified prior manifest")))
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	require.ErrorIs(t, object.Put(ctx, []byte("cancelled replacement")), context.Canceled)
+	data, err := GetBlob(t.Context(), object)
+	require.NoError(t, err)
+	require.Equal(t, "verified prior manifest", string(data))
+}
+
+func TestFSMultipartCancelledPreservesExisting(t *testing.T) {
+	t.Parallel()
+	target := filepath.Join(t.TempDir(), "rootfs.ext4")
+	require.NoError(t, os.WriteFile(target, []byte("verified prior disk"), 0600))
+	upload := fsPartUploader{fullPath: target}
+	require.NoError(t, upload.Start(t.Context()))
+	require.NoError(t, upload.UploadPart(t.Context(), 0, []byte("cancelled compressed disk")))
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	require.ErrorIs(t, upload.Complete(ctx), context.Canceled)
+	data, err := os.ReadFile(target)
+	require.NoError(t, err)
+	require.Equal(t, "verified prior disk", string(data))
+}
+
+// Cancellation arriving during a source read must never publish a partial save.
+type cancellingPublicationReader struct {
+	cancel context.CancelFunc
+	reads  int
+}
+
+func (r *cancellingPublicationReader) Read(p []byte) (int, error) {
+	r.reads++
+	if r.reads > 1 {
+		return 0, io.EOF
+	}
+	r.cancel()
+	return copy(p, "cancelled candidate disk"), nil
+}
+func TestFSReplaceCancelledDuringReadPreservesExisting(t *testing.T) {
+	t.Parallel()
+	p := newTempProvider(t)
+	obj, err := p.OpenBlob(t.Context(), "rootfs.ext4")
+	require.NoError(t, err)
+	require.NoError(t, obj.Put(t.Context(), []byte("verified prior disk")))
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	_, err = obj.(*fsObject).replaceFrom(ctx, &cancellingPublicationReader{cancel: cancel})
+	require.ErrorIs(t, err, context.Canceled)
+	data, err := GetBlob(t.Context(), obj)
+	require.NoError(t, err)
+	require.Equal(t, "verified prior disk", string(data))
+	leftovers, err := filepath.Glob(filepath.Join(p.basePath, ".rootfs.ext4.tmp-*"))
+	require.NoError(t, err)
+	require.Empty(t, leftovers)
+}
+
+// Run this case under the Linux proof container's seccomp fsync=EIO profile.
+// The real syscall failure must prevent a newly copied disk replacing recovery.
+func TestFSStoreFileSyncFailurePreservesExisting(t *testing.T) {
+	if os.Getenv("LAUNCHPAD_TEST_FSYNC_FAILURE") != "1" {
+		t.Skip("requires syscall fault injection")
+	}
+	p := newTempProvider(t)
+	target := p.getPath("rootfs.ext4")
+	require.NoError(t, os.WriteFile(target, []byte("verified prior disk"), 0600))
+	object, err := p.OpenSeekable(t.Context(), "rootfs.ext4")
+	require.NoError(t, err)
+	source := filepath.Join(t.TempDir(), "candidate.ext4")
+	require.NoError(t, os.WriteFile(source, []byte("new candidate disk"), 0600))
+	_, _, err = object.StoreFile(t.Context(), source)
+	require.ErrorIs(t, err, syscall.EIO)
+	data, err := os.ReadFile(target)
+	require.NoError(t, err)
+	require.Equal(t, "verified prior disk", string(data))
+	leftovers, err := filepath.Glob(filepath.Join(p.basePath, ".rootfs.ext4.tmp-*"))
+	require.NoError(t, err)
+	require.Empty(t, leftovers)
+}
