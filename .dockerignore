# Keeps the executor-image build context small: dependencies install inside
# the image, and machine-local state never ships in an image.
.git
node_modules
**/node_modules
.t3
**/.t3
dist
**/dist
.repos
# Local credentials and Terraform state never enter a build context.
.env
**/.env
infra/hetzner/.terraform
infra/hetzner/terraform.tfstate*
infra/hetzner/terraform.tfvars
infra/hetzner/tfplan
